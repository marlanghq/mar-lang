module Frontend.Demos exposing (page)


import UI exposing
    ( navigationStack, navigationTitle
    , list, section
    , title, subtitle, paragraph, span
    , bold, link, image
    , hstack, spacer, size, px, fit
    )


-- The demo arcade: every project on this page is written in Mar,
-- end to end: game loops, chip-tune soundtracks, backends, auth,
-- databases, deploys. This page itself is Mar too. It exists to
-- answer one question fast: "what can this language actually do?"
--
-- Card titles live inside the section body (UI.title, 24px) instead
-- of `header`, which renders as a small grey caps label and is far
-- too quiet to carry a game name.
--
-- Screenshots live in public/demos/*.png, captured from the real
-- games running in a browser. Each card links to the live deployment
-- and to the source folder on GitHub.


type alias Model = ()


type Msg
    = NoOp


init : (Model, Cmd Msg)
init = ((), Cmd.none)


update : Msg -> Model -> (Model, Cmd Msg)
update _ _ = ((), Cmd.none)


srcUrl : String -> String
srcUrl folder =
    "https://github.com/marlanghq/mar-lang/tree/main/examples/" ++ folder


-- The card screenshot, rendered small on purpose: the PNGs are 2x
-- captures nearly as wide as the card, so unconstrained they dominate
-- the page. A fixed 340x220 frame keeps every card the same height,
-- fits a phone screen with room to spare, and `fit` letterboxes
-- whichever aspect the capture came in. The spacer pair centers it.
shotImage : String -> String -> View Msg
shotImage shot altText =
    hstack []
        [ spacer
        , image [ size (px 340) (px 220), fit ]
            { src = "/demos/" ++ shot ++ ".png"
            , alt = altText
            }
        , spacer
        ]


-- One playable demo card: title, screenshot, blurb, tech line, links.
gameCard : String -> String -> String -> String -> String -> String -> View Msg
gameCard name shot blurb tech playUrl folder =
    section []
        [ title name
        , shotImage shot (name ++ " gameplay screenshot")
        , paragraph
            [ span [] blurb ]
        , paragraph
            [ span [bold] "Built with: "
            , span [] tech
            ]
        , paragraph
            [ span [link playUrl] "▶ Play it in your browser" ]
        , paragraph
            [ span [link (srcUrl folder)] "Read the source" ]
        ]


-- A full-stack app card. Same shape as a game card, but the call to action
-- says "open the app" instead of "play", since these are things you use
-- rather than things you win.
appCard : String -> String -> String -> String -> String -> String -> View Msg
appCard name shot blurb tech playUrl folder =
    section []
        [ title name
        , shotImage shot (name ++ " screenshot")
        , paragraph
            [ span [] blurb ]
        , paragraph
            [ span [bold] "Built with: "
            , span [] tech
            ]
        , paragraph
            [ span [link playUrl] "▶ Open the live app" ]
        , paragraph
            [ span [link (srcUrl folder)] "Read the source" ]
        ]


view : Model -> View Msg
view _ =
    navigationStack [ navigationTitle "Demos" ]
        [ list []
            [ section []
                [ title "Everything here is written in Mar"
                , subtitle "Backends, auth, databases, game loops, 60fps canvas graphics, chip-tune soundtracks, deploys, and this page too."
                , paragraph
                    [ span [] "Each demo is real Mar, from a few hundred lines to many thousands, all in a single "
                    , span [link "https://github.com/marlanghq/mar-lang/tree/main/examples"] "examples folder"
                    , span [] ". Open the source next to the game and read along."
                    ]
                ]

            -- Ordered by what sells the language fastest, not by category:
            -- the app a reader can picture themselves writing comes first,
            -- then the games, then the heavier fullstack pieces.
            , appCard "Daily Checklist"
                "daily-checklist"
                "The classic starter app, taken seriously: per-user task lists with sign-in, drag-to-reorder, swipe-to-delete with confirmation, and a real database behind it. The reference example for Mar's UI toolkit and managed backend."
                "Fullstack: Auth, Repo persistence, reorderable lists, date picker, admin panel."
                "https://mar-daily-checklist.fly.dev"
                "daily-checklist"

            , appCard "Roll Call"
                "roll-call"
                "Attendance and rosters for a teacher: classes, students, and a day marked Present, Late or Absent in one pass, with per-student history and a thirty-day report."
                "Fullstack: Auth, four entities, a typed REST contract, presented routes, reorderable rosters."
                "https://mar-roll-call.fly.dev"
                "roll-call"

            , gameCard "Seasons GP"
                "seasons-gp"
                "A pseudo-3D endless racer that drives through four seasons: spring blossoms, summer heat, autumn winds and winter snow, each with its own palette and hazards. The road is classic segment-projection arcade math, all in integer arithmetic."
                "Pseudo-3D road projection, Device-aware touch pads, procedural scenery."
                "https://mar-seasons-gp.pages.dev"
                "seasons-gp"

            , gameCard "Iron Meridian"
                "iron-meridian"
                "A real-time strategy game on colonized Mars, in the lineage of Command & Conquer and StarCraft. Three factions with their own units and doctrines, a five-mission campaign whose story turns on you, and skirmish against a bot that builds, scouts and counterattacks."
                "Flow-field pathfinding, fog of war, a build-and-battle economy, a bot opponent, integer fixed-point sim at 30Hz."
                "https://mar-iron-meridian.pages.dev"
                "iron-meridian"

            , gameCard "Star Condor"
                "star-condor"
                "A vertical shoot-em-up across ten wonders of Latin America: the Amazon, Iguazu, Uyuni, Machu Picchu, Teotihuacan. Squadrons fly rings, loops and snaking waves, barriers wear the scenery, and every stage has its own parallax, boss and melody."
                "Canvas 2D, world-driven Sound engine, Keyboard + Gamepad + touch, 320x240 pixel art at 60fps."
                "https://mar-star-condor.pages.dev"
                "star-condor"

            , gameCard "Myrkheim"
                "myrkheim"
                "A Norse first-person dungeon crawler in the spirit of the earliest FPS games. Five floors of the barrow, seven creatures of the sagas, weapons hidden behind cracked walls, a minimap parchment, and a Jarl waiting at the bottom. The renderer is software raycasting: every wall strip is a Canvas rect placed by Mar code."
                "Raycasting on Canvas 2D, dual-stick touch controls, positional chip-tune SFX."
                "https://mar-myrkheim.pages.dev"
                "myrkheim"

            , gameCard "Pulse Runner"
                "pulse-runner"
                "A brutal one-button rhythm runner. Every spike, pit and platform sits on a beat line, and the only way through is to jump ON the beat. Nine 32-beat sections, each harder than the last, with music that grows as you go: the world fires the soundtrack itself, beat by beat. A checkpoint flag every loop, and a hardcore mode with none."
                "Beat-grid level design, world-driven soundtrack, an offline physics sim that proves the level is beatable."
                "https://mar-pulse-runner.pages.dev"
                "pulse-runner"

            , gameCard "Super Striker"
                "mini-soccer"
                "Fast 8-bit street football: two halves, slide tackles, a keeper with opinions and a CPU rival. Every sprite is rectangles and a hand-made 3x5 pixel font, with no image assets anywhere."
                "Canvas 2D sprites drawn from primitives, touch + keyboard controls, chip-tune crowd."
                "https://mar-mini-soccer.pages.dev"
                "mini-soccer"

            , gameCard "Lendas"
                "lendas"
                "An asynchronous two-player trading card game about Latin American legends, in Brazilian Portuguese. One rules engine written in shared Mar code is replayed identically by the Go backend and the JS client, so server and browser can never disagree about the board. Sign in, challenge a rival or the bot, and play at your own pace."
                "Fullstack: Auth, REST services, SQLite via Repo, canvas match board, one shared rules engine."
                "https://mar-lendas.fly.dev"
                "lendas"

            , gameCard "Quiz Duel"
                "quiz-duel"
                "A one-versus-one trivia duel: challenge a friend by email, answer the same ten questions, watch the scores land in real time. The whole loop of request, auth, persist and render in one small Mar codebase."
                "Fullstack: Auth with email codes, typed REST services, SQLite, server-checked answers."
                "https://mar-quiz-duel.fly.dev"
                "quiz-duel"

            , gameCard "Pocket Synth"
                "pocket-synth"
                "A two-octave synthesizer you can actually play. Twelve presets, a panel of live controls, and real polyphony: every finger on the screen sounds its own note, and sliding one across the keys carries that note with it. There are no samples anywhere, every voice is built from tone, sweep and vibrato at play time."
                "Canvas 2D for the panel and the keys, the Sound module for every voice, and both input mirrors at once: the fingers on the canvas and the computer keyboard."
                "https://mar-pocket-synth.pages.dev"
                "pocket-synth"
            ]
        ]


page : Page
page =
    Page.create
        { path = "/demos"
        , title = "Demos: apps and games built with Mar"
        , init = init
        , update = update
        , view = view
        , subscriptions = always Sub.none
        }
