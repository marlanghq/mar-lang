module Frontend.GetStarted exposing (page)


import UI exposing
    ( navigationStack, navigationTitle
    , list, section, header, footer
    , paragraph, span
    , code, link
    )


-- "Get started" page — the four-command path from zero to a deployed
-- app. Each step gets its own section so the reader can scan the
-- shape before reading the body text.


type alias Model = ()


type Msg
    = NoOp


init : (Model, Cmd Msg)
init = ((), Cmd.none)


update : Msg -> Model -> (Model, Cmd Msg)
update _ _ = ((), Cmd.none)


view : Model -> View Msg
view _ =
    navigationStack [ navigationTitle "Get started" ]
        [ list []
            [ section [ header "1. Install" ]
                [ paragraph
                    [ span [] "Download the "
                    , span [code] "mar"
                    , span [] " binary for your platform from "
                    , span [link "https://github.com/marlanghq/mar-lang/releases"] "the releases page"
                    , span [] " and drop it on your PATH. One binary, no package manager or runtime to install. Expect Windows to work; day-to-day development happens on macOS and Linux."
                    ]
                , paragraph
                    [ span [] "Verify with "
                    , span [code] "mar version"
                    , span [] "."
                    ]
                , paragraph
                    [ span [] "For syntax highlighting and completions, install the editor plugin: "
                    , span [link "https://marketplace.visualstudio.com/items?itemName=mar-lang.mar-language-support"] "VS Code"
                    , span [] " or "
                    , span [link "https://packagecontrol.io/packages/Mar"] "Sublime Text"
                    , span [] "."
                    ]
                ]
            , section [ header "2. Scaffold a project" ]
                [ paragraph
                    [ span [] "Run "
                    , span [code] "mar init my-app"
                    , span [] " and pick a starter (fullstack with auth, frontend-only, and more). You get a working "
                    , span [code] "my-app/"
                    , span [] " that runs as-is. Edit from there."
                    ]
                ]
            , section [ header "3. Run it locally" ]
                [ paragraph
                    [ span [] "Run "
                    , span [code] "mar dev"
                    , span [] ". It boots a hot-reload dev server: edit a "
                    , span [code] ".mar"
                    , span [] " file and the browser updates instantly. The admin panel is live at "
                    , span [code] "/_mar/admin"
                    , span [] "."
                    ]
                ]
            , section
                [ header "4. Deploy"
                , footer "A fuller deployment guide is coming on its own page."
                ]
                [ paragraph
                    [ span [] "A fullstack app compiles to a single self-contained binary (assets and all); a frontend-only app compiles to a folder of static files. Either way it runs on practically any provider that can run a binary or serve files. Deployment is one command: "
                    , span [code] "mar deploy"
                    , span [] " reads your project and ships a fullstack app to a "
                    , span [link "https://fly.io"] "Fly.io"
                    , span [] " VM, or a frontend-only app to "
                    , span [link "https://pages.cloudflare.com"] "Cloudflare Pages"
                    , span [] "."
                    ]
                ]
            ]
        ]


page : Page
page =
    Page.create
        { path = "/get-started"
        , title = "Get started"
        , init = init
        , update = update
        , view = view
        , subscriptions = always Sub.none
        }
