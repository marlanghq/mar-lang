module Frontend.Reference.Render exposing (moduleDoc, entryRow, detailSections, blurb, displayName)


import UI exposing
    ( navigationStack, navigationTitle
    , list, section, header, footer
    , paragraph, span, navigationLink
    , vstack
    , code, bold, italic
    )
import Frontend.Reference.Data exposing (Entry, Section, sectionsFor, entriesFor, sideFor)
import Frontend.Reference.Data
import Frontend.Reference.Routes


-- Shared rendering for the reference, in two forms:
--
--   entryRow  - a compact, tappable row: qualified name + signature only.
--               Used in the module lists and the search results. Tapping it
--               navigates to the function's detail page.
--   entryCard - the full detail: name + signature, description, and any worked
--               examples. Used on the detail page.
--
-- Both are pure and static, so they type as `View msg` for any msg. Entries,
-- signatures, and examples come from Frontend.Reference.Data, generated from
-- the compiler (examples compiled and run in the generator's tests), so nothing
-- here is maintained by hand per function.


-- How a function is spelled in real code. Everything is qualified except the
-- Basics group, which is the reference's shelf for the builtins that have no
-- module: you write `not`, never `Basics.not`, so printing the qualifier here
-- would document a name the compiler rejects.
displayName : String -> String -> String
displayName moduleName name =
    if moduleName == "Basics" then name else moduleName ++ "." ++ name


-- Where a function runs, in words rather than a code word.
--
-- The first draft printed the compiler's own label next to every signature, so a
-- row read "List.map : (a -> b) -> List a -> List b  both". "Both" of what was
-- never said, and it appeared on hundreds of rows that had nothing to disclose.
--
-- So the fact is stated once per module, as a sentence, on the module's own page
-- and again on each function's detail page. A row carries it ONLY when the
-- function disagrees with its module, which is the case worth interrupting a
-- list for: Auth and Service are single ideas with parts on each side, so
-- `Auth.protect` being server-side is news, while `UI.button` being client-side
-- inside a module the page already called client-side is not.
--
-- `both` says nothing at all, and says it 221 times out of 526. It is not a
-- fact about the function, it is the ABSENCE of a restriction: no side to
-- avoid, nothing that could stop compiling. So it is the silent default, and
-- only a real restriction gets a sentence. Documenting the absence reads like
-- promising a function does not throw.
--
-- The value comes from the compiler's side table, the same place the check that
-- enforces it reads, so this cannot disagree with the compiler the way a
-- hand-written "frontend only" in a description could.
sideLine : String -> String
sideLine side =
    if side == "frontend" then
        "Runs in the app: pages, and the code they reach."

    else if side == "backend" then
        "Runs on the server: services, and the code they reach."

    else if side == "entry point" then
        "Read when the app is built. It says which pages and services exist, and runs on neither side."

    else
        ""


-- The sentence as a list, so a caller splices it in and gets NOTHING when there
-- is nothing to say. Passing "" to `prose` would still build a paragraph, and
-- an empty paragraph is a blank row with the section's spacing around it.
sideProse : String -> List (View msg)
sideProse side =
    if sideLine side == "" then
        []

    else
        [ prose (sideLine side) ]


-- The short form, for the one place it has to fit beside a signature: a compact
-- row in a module list or a search result. The detail page has room for the
-- sentence and prints that instead, so the two never appear together.
--
-- Parenthesised so it cannot be misread as part of the type it follows.
sideTag : String -> String
sideTag side =
    if side == "frontend" then
        "  (in the app only)"

    else if side == "backend" then
        "  (on the server only)"

    else if side == "entry point" then
        "  (build time)"

    else
        "  (app and server)"


-- Prose from the generator, with its inline code rendered as code.
--
-- Descriptions and blurbs are authored in internal/refgen/content.go with the
-- backtick convention the rest of the docs use, because a few of them need to
-- name code mid-sentence: `not busy` rather than `!busy`, or the lambda
-- `\_ -> x`. Nothing rendered those, so the backticks reached the page as
-- literal characters and the code read as punctuation.
--
-- Splitting on the backtick alternates the two kinds: even pieces are prose,
-- odd pieces are what sat between a pair. A refgen test keeps every string's
-- backticks balanced, so a stray one cannot silently set the rest of a
-- sentence in monospace.
prose : String -> View msg
prose s =
    paragraph
        (List.indexedMap
            (\i piece ->
                if modBy 2 i == 0 then
                    span [] piece

                else
                    span [ code ] piece
            )
            (String.split "`" s))


-- An Inline, not a View: it sits inside the same paragraph as the signature.
-- Empty for all but the handful of functions that disagree with their module,
-- and the empty case is `span [] ""` rather than `empty`, which is a View and
-- would not fit here.
sideBadge : Entry -> Inline msg
sideBadge e =
    if e.side == sideFor e.moduleName then
        span [] ""

    else
        span [ italic ] (sideTag e.side)


-- Compact row: the whole row is a link into the detail page for this function.
entryRow : Entry -> View msg
entryRow e =
    navigationLink [] Frontend.Reference.Routes.detail { moduleName = e.moduleName, fn = e.name }
        (paragraph
            [ span [ code, bold ] (displayName e.moduleName e.name)
            , span [ code ] (" : " ++ e.signature)
            , sideBadge e
            ])


-- One worked example, shown in monospace: a list of lines, because some
-- examples need a declaration before the expression that uses it (a Path only
-- exists through an annotated binding). Every line the build has already
-- compiled, and single-expression ones it has evaluated to True.
--
-- The whole example is ONE row of the card. It used to be one row PER LINE,
-- which put a divider through the middle of a snippet and drew a snippet's
-- blank separator line as an empty row.
exampleBlock : List String -> View msg
exampleBlock lines =
    vstack [] (List.map (\line -> paragraph [ span [ code ] line ]) lines)


-- The detail page's body: a card with the signature and description, then a
-- separate, clearly-labelled card of worked examples (only when there are any),
-- so the example code never reads as loose code dropped onto the page.
detailSections : Entry -> List (View msg)
detailSections e =
    List.concat
        [ [ section []
                (List.concat
                    [ [ paragraph
                            [ span [ code, bold ] (displayName e.moduleName e.name)
                            , span [ code ] (" : " ++ e.signature)
                            ]
                      , prose e.description
                      ]
                    , sideProse e.side
                    ])
          ]
        , if List.isEmpty e.examples then
            []

          else
            [ section
                [ header (exampleHeader e.examples) ]
                (List.map exampleBlock e.examples)
            ]
        ]


exampleHeader : List a -> String
exampleHeader xs =
    if List.length xs == 1 then
        "Example"

    else
        "Examples"


-- The module one-liner. Generated alongside the entries, so a module added to
-- the reference arrives with its description already written; this used to be a
-- case expression here, and a new module meant a blank row until someone
-- remembered to come back and fill it in.
blurb : String -> String
blurb mod =
    Frontend.Reference.Data.blurbFor mod


sectionView : Section -> View msg
sectionView s =
    section [ header s.category ] (List.map entryRow s.entries)


moduleDoc : String -> View msg
moduleDoc mod =
    navigationStack [ navigationTitle mod ]
        [ list []
            (List.concat
                [ [ section
                        [ footer (String.fromInt (List.length (entriesFor mod)) ++ " functions") ]
                        (List.concat [ [ prose (blurb mod) ], sideProse (sideFor mod) ])
                  ]
                , List.map sectionView (sectionsFor mod)
                ])
        ]
