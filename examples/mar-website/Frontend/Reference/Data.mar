                    , { moduleName = "Keyboard", name = "ScrollLock", signature = "Keyboard.Key", side = "frontend", description = "True while scroll lock is held.", examples = [ [ "held keys = List.member Keyboard.ScrollLock keys.down" ] ] }
                    , { moduleName = "Keyboard", name = "Pause", signature = "Keyboard.Key", side = "frontend", description = "True while pause is held.", examples = [ [ "held keys = List.member Keyboard.Pause keys.down" ] ] }
                    , { moduleName = "Keyboard", name = "NumLock", signature = "Keyboard.Key", side = "frontend", description = "True while num lock is held.", examples = [ [ "held keys = List.member Keyboard.NumLock keys.down" ] ] }
                    , { moduleName = "Keyboard", name = "ContextMenu", signature = "Keyboard.Key", side = "frontend", description = "True while the context-menu key is held.", examples = [ [ "held keys = List.member Keyboard.ContextMenu keys.down" ] ] }
                    ]
              }
            ]

        "Gamepad" ->
            [ { category = "Watch"
              , entries =
                    [ { moduleName = "Gamepad", name = "watch", signature = "({ connected : Bool, leftX : Int, leftY : Int, rightX : Int, rightY : Int, down : List Gamepad.Button } -> a) -> Sub a", side = "frontend", description = "Mirrors the state of the first connected controller: whether one is there, both sticks as values from -100 to 100, and which buttons are held.", examples = [ [ "type Msg = StickMoved Int Int", "subscriptions model = Gamepad.watch (\\pad -> StickMoved pad.leftX pad.leftY)" ] ] }
                    ]
              }
            , { category = "Face buttons"
              , entries =
                    [ { moduleName = "Gamepad", name = "A", signature = "Gamepad.Button", side = "frontend", description = "The lower face button. Confirm, jump.", examples = [ [ "held pad = List.member Gamepad.A pad.down" ] ] }
                    , { moduleName = "Gamepad", name = "B", signature = "Gamepad.Button", side = "frontend", description = "The right face button. Cancel, back.", examples = [ [ "held pad = List.member Gamepad.B pad.down" ] ] }
                    , { moduleName = "Gamepad", name = "X", signature = "Gamepad.Button", side = "frontend", description = "The left face button.", examples = [ [ "held pad = List.member Gamepad.X pad.down" ] ] }
                    , { moduleName = "Gamepad", name = "Y", signature = "Gamepad.Button", side = "frontend", description = "The upper face button.", examples = [ [ "held pad = List.member Gamepad.Y pad.down" ] ] }
                    ]
              }
            , { category = "Shoulders and triggers"
              , entries =
                    [ { moduleName = "Gamepad", name = "L1", signature = "Gamepad.Button", side = "frontend", description = "The left shoulder button.", examples = [ [ "held pad = List.member Gamepad.L1 pad.down" ] ] }
                    , { moduleName = "Gamepad", name = "L2", signature = "Gamepad.Button", side = "frontend", description = "The left trigger.", examples = [ [ "held pad = List.member Gamepad.L2 pad.down" ] ] }
                    , { moduleName = "Gamepad", name = "R1", signature = "Gamepad.Button", side = "frontend", description = "The right shoulder button.", examples = [ [ "held pad = List.member Gamepad.R1 pad.down" ] ] }
                    , { moduleName = "Gamepad", name = "R2", signature = "Gamepad.Button", side = "frontend", description = "The right trigger.", examples = [ [ "held pad = List.member Gamepad.R2 pad.down" ] ] }
                    , { moduleName = "Gamepad", name = "L3", signature = "Gamepad.Button", side = "frontend", description = "Pressing the left stick in.", examples = [ [ "held pad = List.member Gamepad.L3 pad.down" ] ] }
                    , { moduleName = "Gamepad", name = "R3", signature = "Gamepad.Button", side = "frontend", description = "Pressing the right stick in.", examples = [ [ "held pad = List.member Gamepad.R3 pad.down" ] ] }
                    ]
              }
            , { category = "D-pad"
              , entries =
                    [ { moduleName = "Gamepad", name = "Up", signature = "Gamepad.Button", side = "frontend", description = "Up on the d-pad.", examples = [ [ "held pad = List.member Gamepad.Up pad.down" ] ] }
                    , { moduleName = "Gamepad", name = "Down", signature = "Gamepad.Button", side = "frontend", description = "Down on the d-pad.", examples = [ [ "held pad = List.member Gamepad.Down pad.down" ] ] }
                    , { moduleName = "Gamepad", name = "Left", signature = "Gamepad.Button", side = "frontend", description = "Left on the d-pad.", examples = [ [ "held pad = List.member Gamepad.Left pad.down" ] ] }
                    , { moduleName = "Gamepad", name = "Right", signature = "Gamepad.Button", side = "frontend", description = "Right on the d-pad.", examples = [ [ "held pad = List.member Gamepad.Right pad.down" ] ] }
                    ]
              }
            , { category = "Menu"
              , entries =
                    [ { moduleName = "Gamepad", name = "Select", signature = "Gamepad.Button", side = "frontend", description = "The select or view button.", examples = [ [ "held pad = List.member Gamepad.Select pad.down" ] ] }
                    , { moduleName = "Gamepad", name = "Start", signature = "Gamepad.Button", side = "frontend", description = "The start or menu button.", examples = [ [ "held pad = List.member Gamepad.Start pad.down" ] ] }
                    ]
              }
            ]

        "Device" ->
            [ { category = "Watch"
              , entries =
                    [ { moduleName = "Device", name = "watch", signature = "({ pointer : Pointer, anyFine : Bool, supportsHover : Bool, width : Int, height : Int, prefersDark : Bool, prefersReducedMotion : Bool } -> a) -> Sub a", side = "frontend", description = "Mirrors what kind of device this is and stays current: the pointer, the screen size, and whether dark mode or reduced motion is asked for. Read capabilities from here rather than guessing from a user agent string.", examples = [ [ "type Msg = Resized Int Int", "subscriptions model = Device.watch (\\device -> Resized device.width device.height)" ] ] }
                    ]
              }
            , { category = "Ask about it"
              , entries =
                    [ { moduleName = "Device", name = "touchOnly", signature = "{ pointer : Pointer, anyFine : Bool, supportsHover : Bool, width : Int, height : Int, prefersDark : Bool, prefersReducedMotion : Bool } -> Bool", side = "frontend", description = "True when the only pointer is a finger. The test for whether to show touch controls.", examples = [ [ "Device.watch (\\device -> Device.touchOnly device)" ] ] }
                    , { moduleName = "Device", name = "canHover", signature = "{ pointer : Pointer, anyFine : Bool, supportsHover : Bool, width : Int, height : Int, prefersDark : Bool, prefersReducedMotion : Bool } -> Bool", side = "frontend", description = "True when there is a pointer that can hover, so a hover state is worth showing at all.", examples = [ [ "Device.watch (\\device -> Device.canHover device)" ] ] }
                    ]
              }
            ]

        "Cmd" ->
            [ { category = "Common"
              , entries =
                    [ { moduleName = "Cmd", name = "none", signature = "Cmd a", side = "frontend", description = "Do nothing. What update returns when the message changed the model and nothing else.", examples = [ [ "Cmd.none" ] ] }
                    , { moduleName = "Cmd", name = "batch", signature = "List (Cmd a) -> Cmd a", side = "frontend", description = "Runs several commands together. There is no ordering between them.", examples = [ [ "Cmd.batch [ Nav.push \"/\", Sound.play (Sound.tone Sound.Square (Sound.c 5) 60) ]" ] ] }
                    , { moduleName = "Cmd", name = "perform", signature = "(a -> b) -> Task a -> Cmd b", side = "frontend", description = "Runs a task and hands the result back as a message. This is the bridge from the task world into update.", examples = [ [ "type Msg = GotNow Time", "started = Cmd.perform GotNow Time.now" ] ] }
                    ]
              }
            , { category = "Writing shared state"
              , entries =
                    [ { moduleName = "Cmd", name = "toShared", signature = "App.Shared a b -> b -> Cmd c", side = "frontend", description = "Send a message to the app-wide state built by App.shared. A page never assigns that state; it asks, and the shared update decides.", examples = [ [ "cart : App.Shared Int Bool", "cart =", "    App.shared", "        { init = (0, Cmd.none)", "        , update = \\_ model -> (model, Cmd.none)", "        , subscriptions = \\_ -> Sub.none", "        }", "emptyIt = Cmd.toShared cart True" ] ] }
                    ]
              }
            ]

        "Sub" ->
            [ { category = "Common"
              , entries =
                    [ { moduleName = "Sub", name = "none", signature = "Sub a", side = "frontend", description = "Subscribe to nothing.", examples = [ [ "Sub.none" ] ] }
                    , { moduleName = "Sub", name = "batch", signature = "List (Sub a) -> Sub a", side = "frontend", description = "Subscribes to several things at once.", examples = [ [ "Sub.batch [ Time.every (Time.seconds 1) (\\t -> Time.second t), Sub.none ]" ] ] }
                    ]
              }
            ]

        "Task" ->
            [ { category = "Create"
              , entries =
                    [ { moduleName = "Task", name = "succeed", signature = "a -> Task a", side = "both", description = "A task that immediately produces a value. Useful as the trivial branch of a chain.", examples = [ [ "Task.succeed 42" ] ] }
                    , { moduleName = "Task", name = "fail", signature = "String -> Task a", side = "both", description = "A task that immediately fails with a message.", examples = [ [ "Task.fail \"no such task\"" ] ] }
                    ]
              }
            , { category = "Chain"
              , entries =
                    [ { moduleName = "Task", name = "map", signature = "(a -> b) -> Task a -> Task b", side = "both", description = "Transforms the value a task produces, leaving failure alone.", examples = [ [ "Task.map (\\n -> n + 1) (Task.succeed 1)" ] ] }
                    , { moduleName = "Task", name = "andThen", signature = "(a -> Task b) -> Task a -> Task b", side = "both", description = "Chains tasks, where the second depends on the first result. A failure anywhere short-circuits the rest.", examples = [ [ "Task.andThen (\\n -> Task.succeed (n * 2)) (Task.succeed 21)" ] ] }
                    ]
              }
            , { category = "Many at once"
              , entries =
                    [ { moduleName = "Task", name = "sequence", signature = "List (Task a) -> Task (List a)", side = "both", description = "Runs a list of tasks and collects their results in order.", examples = [ [ "Task.sequence [ Task.succeed 1, Task.succeed 2 ]" ] ] }
                    , { moduleName = "Task", name = "forEach", signature = "(a -> Task ()) -> List a -> Task ()", side = "both", description = "Runs a task for each item in a list, for the effects rather than the results.", examples = [ [ "Task.forEach (\\n -> Task.succeed ()) [ 1, 2, 3 ]" ] ] }
                    ]
              }
            ]

        "Service" ->
            [ { category = "Declare and implement"
              , entries =
                    [ { moduleName = "Service", name = "declare", signature = "Method -> String -> Service a b", side = "both", description = "Declares an endpoint by verb and path. Both sides of the app share this one declaration, which is why a call and its implementation cannot disagree about the shape of a request.", examples = [ [ "Service.declare GET \"/tasks\"" ], [ "Service.declare POST \"/task/{id:Int}/done\"" ] ] }
                    , { moduleName = "Service", name = "implement", signature = "Service a b -> (a -> Task b) -> ExposedService", side = "backend", description = "Gives a declared service its backend behaviour, as a task over the request.", examples = [ [ "listTasks = Service.declare GET \"/tasks\"", "servedOnTheBackend = Service.implement listTasks (\\request -> Task.succeed [])" ] ] }
                    ]
              }
            , { category = "Call it"
              , entries =
                    [ { moduleName = "Service", name = "call", signature = "Service a b -> a -> (Result Service.Error b -> c) -> Cmd c", side = "frontend", description = "Calls a declared service from the frontend, handing the outcome back as a message. The result carries a typed error rather than a string, so every failure has to be handled by name.", examples = [ [ "listTasks = Service.declare GET \"/tasks\"", "fetchedFromTheFrontend = Service.call listTasks () (\\result -> result)" ] ] }
                    ]
              }
            , { category = "When it fails"
              , entries =
                    [ { moduleName = "Service", name = "Offline", signature = "Service.Error", side = "both", description = "The request never reached the server.", examples = [ [ "Service.errorToString Service.Offline" ] ] }
                    , { moduleName = "Service", name = "Unauthorized", signature = "Service.Error", side = "both", description = "The server refused because nobody is signed in, or the signed-in user may not do this.", examples = [ [ "Service.errorToString Service.Unauthorized" ] ] }
                    , { moduleName = "Service", name = "RateLimited", signature = "Service.Error", side = "both", description = "The server is asking for fewer requests. Wait and try again.", examples = [ [ "Service.errorToString Service.RateLimited" ] ] }
                    , { moduleName = "Service", name = "ServerError", signature = "String -> Service.Error", side = "both", description = "The server failed, with a message describing how.", examples = [ [ "Service.errorToString (Service.ServerError \"the database is unreachable\")" ] ] }
                    , { moduleName = "Service", name = "errorToString", signature = "Service.Error -> String", side = "both", description = "Turns a service error into a sentence fit to show a person.", examples = [ [ "Service.errorToString Service.Offline" ] ] }
                    ]
              }
            ]

        "Entity" ->
            [ { category = "Define a table"
              , entries =
                    [ { moduleName = "Entity", name = "define", signature = "{ name : String, columns : a, uniques : List (List String) } -> Entity b", side = "backend", description = "Defines a table: a name, its columns, and any groups of columns that have to be unique together. Migrations are derived from this, so the schema follows the code rather than being kept in step by hand.", examples = [ [ "tasks = Entity.define { name = \"task\", columns = { id = Entity.serial, title = Entity.text Entity.notNull, done = Entity.bool Entity.notNull }, uniques = [] }" ] ] }
                    ]
              }
            , { category = "Column types"
              , entries =
                    [ { moduleName = "Entity", name = "serial", signature = "Column Int", side = "backend", description = "An integer primary key the database fills in.", examples = [ [ "Entity.serial" ] ] }
                    , { moduleName = "Entity", name = "int", signature = "Constraint -> Column Int", side = "backend", description = "A whole-number column.", examples = [ [ "Entity.int Entity.notNull" ] ] }
                    , { moduleName = "Entity", name = "text", signature = "Constraint -> Column String", side = "backend", description = "A text column.", examples = [ [ "Entity.text Entity.notNull" ] ] }
                    , { moduleName = "Entity", name = "bool", signature = "Constraint -> Column Bool", side = "backend", description = "A true-or-false column.", examples = [ [ "Entity.bool Entity.notNull" ] ] }
                    , { moduleName = "Entity", name = "decimal", signature = "Int -> Constraint -> Column Decimal", side = "backend", description = "An exact decimal column, given how many digits to keep after the point. This is the one for money, where the small errors of a floating-point number are not acceptable.", examples = [ [ "Entity.decimal 2 Entity.notNull" ] ] }
                    , { moduleName = "Entity", name = "timestamp", signature = "Constraint -> Column Time", side = "backend", description = "A point-in-time column.", examples = [ [ "Entity.timestamp Entity.notNull" ] ] }
                    , { moduleName = "Entity", name = "enum", signature = "List a -> Constraint -> Column a", side = "backend", description = "A column limited to one of a fixed set of values.", examples = [ [ "Entity.enum [ \"todo\", \"doing\", \"done\" ] Entity.notNull" ] ] }
                    ]
              }
            , { category = "Constraints"
              , entries =
                    [ { moduleName = "Entity", name = "notNull", signature = "Constraint", side = "backend", description = "Requires the column to have a value.", examples = [ [ "Entity.text Entity.notNull" ] ] }
                    ]
              }
            ]

        "Repo" ->
            [ { category = "Read"
              , entries =
                    [ { moduleName = "Repo", name = "all", signature = "Entity a -> Task (List a)", side = "backend", description = "Every row of a table.", examples = [ [ "tasks = Entity.define { name = \"task\", columns = { id = Entity.serial, title = Entity.text Entity.notNull, done = Entity.bool Entity.notNull }, uniques = [] }", "everyTask = Repo.all tasks" ] ] }
                    , { moduleName = "Repo", name = "findById", signature = "Entity a -> Int -> Task (Maybe a)", side = "backend", description = "The row with this id, or Nothing when there is none.", examples = [ [ "tasks = Entity.define { name = \"task\", columns = { id = Entity.serial, title = Entity.text Entity.notNull, done = Entity.bool Entity.notNull }, uniques = [] }", "taskNumber7 = Repo.findById tasks 7" ] ] }
                    , { moduleName = "Repo", name = "findBy", signature = "Entity a -> b -> Task (List a)", side = "backend", description = "Every row matching the given fields.", examples = [ [ "tasks = Entity.define { name = \"task\", columns = { id = Entity.serial, title = Entity.text Entity.notNull, done = Entity.bool Entity.notNull }, uniques = [] }", "stillToDo = Repo.findBy tasks { done = False }" ] ] }
                    ]
              }
            , { category = "Write"
              , entries =
                    [ { moduleName = "Repo", name = "create", signature = "Entity a -> b -> Task a", side = "backend", description = "Inserts a row and gives back the stored version, including whatever the database filled in.", examples = [ [ "tasks = Entity.define { name = \"task\", columns = { id = Entity.serial, title = Entity.text Entity.notNull, done = Entity.bool Entity.notNull }, uniques = [] }", "added = Repo.create tasks { title = \"Buy milk\", done = False }" ] ] }
                    , { moduleName = "Repo", name = "update", signature = "Entity a -> Int -> b -> Task (Maybe a)", side = "backend", description = "Updates the given fields of one row, giving back the new version, or Nothing when the id matched nothing. Fields you leave out are left alone.", examples = [ [ "tasks = Entity.define { name = \"task\", columns = { id = Entity.serial, title = Entity.text Entity.notNull, done = Entity.bool Entity.notNull }, uniques = [] }", "markedDone = Repo.update tasks 7 { done = True }" ] ] }
                    , { moduleName = "Repo", name = "deleteById", signature = "Entity a -> Int -> Task ()", side = "backend", description = "Deletes the row with this id.", examples = [ [ "tasks = Entity.define { name = \"task\", columns = { id = Entity.serial, title = Entity.text Entity.notNull, done = Entity.bool Entity.notNull }, uniques = [] }", "removed = Repo.deleteById tasks 7" ] ] }
                    ]
              }
            ]

        "Auth" ->
            [ { category = "Configure"
              , entries =
                    [ { moduleName = "Auth", name = "config", signature = "a -> Auth b", side = "backend", description = "Turns on sign-in for the app and says how codes are sent.", examples = [ [ "Auth.config { from = \"hello@example.com\" }" ] ] }
                    ]
              }
            , { category = "Sign in"
              , entries =
                    [ { moduleName = "Auth", name = "requestCode", signature = "{ email : String } -> (Result Service.Error Auth.RequestOutcome -> a) -> Cmd a", side = "frontend", description = "Asks the server to mail a sign-in code to an address.", examples = [ [ "Auth.requestCode { email = \"you@example.com\" } (\\result -> result)" ] ] }
                    , { moduleName = "Auth", name = "verifyCode", signature = "{ email : String, code : String } -> (Result Service.Error (Auth.VerifyOutcome a) -> b) -> Cmd b", side = "frontend", description = "Sends a code back to be checked, signing the person in when it matches.", examples = [ [ "Auth.verifyCode { email = \"you@example.com\", code = \"123456\" } (\\result -> result)" ] ] }
                    , { moduleName = "Auth", name = "completeSignIn", signature = "Cmd a", side = "frontend", description = "Finishes signing in and moves on to the app, resetting the navigation history so back does not return to the sign-in screen.", examples = [ [ "Auth.completeSignIn" ] ] }
                    ]
              }
            , { category = "Requesting a code"
              , entries =
                    [ { moduleName = "Auth", name = "CodeSent", signature = "Auth.RequestOutcome", side = "both", description = "The code is on its way.", examples = [ [ "Auth.CodeSent" ] ] }
                    , { moduleName = "Auth", name = "InvalidEmail", signature = "Auth.RequestOutcome", side = "both", description = "That address is not one.", examples = [ [ "Auth.InvalidEmail" ] ] }
                    , { moduleName = "Auth", name = "RateLimited", signature = "Auth.RequestOutcome", side = "both", description = "Too many codes asked for too quickly. Wait before asking again.", examples = [ [ "Auth.RateLimited" ] ] }
                    ]
              }
            , { category = "Checking a code"
              , entries =
                    [ { moduleName = "Auth", name = "SignedIn", signature = "a -> Auth.VerifyOutcome a", side = "both", description = "The code matched, carrying the user who is now signed in.", examples = [ [ "Auth.SignedIn { email = \"you@example.com\" }" ] ] }
                    , { moduleName = "Auth", name = "WrongCode", signature = "Auth.VerifyOutcome a", side = "both", description = "That code is not the one, or it has expired.", examples = [ [ "Auth.WrongCode" ] ] }
                    , { moduleName = "Auth", name = "TooManyAttempts", signature = "Auth.VerifyOutcome a", side = "both", description = "Too many wrong codes. Start over with a fresh one.", examples = [ [ "Auth.TooManyAttempts" ] ] }
                    ]
              }
            , { category = "The current user"
              , entries =
                    [ { moduleName = "Auth", name = "me", signature = "(Result String (Maybe a) -> b) -> Cmd b", side = "frontend", description = "Asks who is signed in, giving Nothing when nobody is.", examples = [ [ "Auth.me (\\result -> result)" ] ] }
                    , { moduleName = "Auth", name = "logout", signature = "(Result String () -> a) -> Cmd a", side = "frontend", description = "Ends the session.", examples = [ [ "Auth.logout (\\result -> result)" ] ] }
                    ]
              }
            , { category = "Guard a service"
              , entries =
                    [ { moduleName = "Auth", name = "protect", signature = "Service a b -> (a -> c -> Task b) -> ExposedService", side = "backend", description = "Requires a signed-in user for a service, and hands that user to the implementation. Rejection happens before your code runs.", examples = [ [ "whoAmI = Service.declare GET \"/me\"", "signedInOnly = Auth.protect whoAmI (\\request user -> Task.succeed user)" ] ] }
                    , { moduleName = "Auth", name = "requireRole", signature = "a -> ExposedService -> ExposedService", side = "backend", description = "Further requires the signed-in user to hold a role.", examples = [ [ "stats = Service.implement (Service.declare GET \"/stats\") (\\request -> Task.succeed ())", "adminsOnly = Auth.requireRole \"admin\" stats" ] ] }
                    , { moduleName = "Auth", name = "requireOwner", signature = "(a -> b -> Task (Maybe c)) -> (c -> Int) -> ExposedService -> ExposedService", side = "backend", description = "Further requires the signed-in user to own the row being touched, given how to find the row and how to read its owner off it.", examples = [ [ "editTask = Service.implement (Service.declare POST \"/task\") (\\request -> Task.succeed ())", "findTheTask = \\request user -> Task.succeed Nothing", "ownersOnly = Auth.requireOwner findTheTask (\\task -> task.userId) editTask" ] ] }
                    , { moduleName = "Auth", name = "authorize", signature = "(a -> b -> Task (Maybe c)) -> (a -> b -> c -> Bool) -> ExposedService -> ExposedService", side = "backend", description = "The general form behind requireOwner: find the row a request is about, then decide whether this user may have it.", examples = [ [ "editTask = Service.implement (Service.declare POST \"/task\") (\\request -> Task.succeed ())", "findTheTask = \\request user -> Task.succeed Nothing", "mayEdit = \\request user task -> True", "guarded = Auth.authorize findTheTask mayEdit editTask" ] ] }
                    ]
              }
            ]

        "Http" ->
            [ { category = "Requests"
              , entries =
                    [ { moduleName = "Http", name = "get", signature = "String -> (Result String String -> a) -> Cmd a", side = "frontend", description = "Fetches a URL from the frontend, handing back the body or a failure message. This is the escape hatch for talking to somebody else's server; for your own backend, use Service. It exists on the client only: a backend service cannot make an outbound call, so anything needing a secret key has to be reached some other way.", examples = [ [ "Http.get \"https://example.com/ping\" (\\result -> result)" ] ] }
                    , { moduleName = "Http", name = "post", signature = "String -> String -> (Result String String -> a) -> Cmd a", side = "frontend", description = "Posts a body to a URL from the frontend, handing back the response or a failure message. Client only, like get.", examples = [ [ "Http.post \"https://example.com/echo\" \"hello\" (\\result -> result)" ] ] }
                    ]
              }
            ]

        "JSON" ->
            [ { category = "Convert"
              , entries =
                    [ { moduleName = "JSON", name = "encode", signature = "a -> String", side = "both", description = "Turns a value into JSON text.", examples = [ [ "JSON.encode { name = \"Ada\", born = 1815 }" ] ] }
                    , { moduleName = "JSON", name = "decode", signature = "String -> Result String a", side = "both", description = "Reads JSON text into a value, giving Err with a reason when it does not fit the type expected of it.", examples = [ [ "Result.withDefault 0 (JSON.decode \"1\")" ] ] }
                    ]
              }
            ]

        _ ->
            []


blurbFor : String -> String
blurbFor m =
    case m of
        "Basics" ->
            "The handful of builtins written without a module prefix."

        "List" ->
            "Build, transform, filter, and fold lists."

        "String" ->
            "Inspect and reshape text, character by character."

        "Maybe" ->
            "Work with values that might be absent."

        "Result" ->
            "Carry a value or the reason it could not be produced."

        "Tuple" ->
            "Read and rework the two halves of a pair."

        "Char" ->
            "Single characters: their codes, their case, what kind they are."

        "Dict" ->
            "Look values up by key, in sorted order."

        "Set" ->
            "A collection with no duplicates and no order of its own."

        "Decimal" ->
            "Exact decimal arithmetic, with rounding you choose rather than inherit."

        "Time" ->
            "Points in time and the distances between them."

        "Random" ->
            "Generators of random values, run only when you say so."

        "App" ->
            "The entry point: frontend, backend, or both."

        "Page" ->
            "Declare the screens of an app and what each one needs to render."

        "Nav" ->
            "Move between screens."

        "UI" ->
            "The view vocabulary: text, controls, layout, lists, and navigation."

        "Canvas" ->
            "Draw shapes, text, and colour to a surface, and read the pointer back."

        "Sound" ->
            "Build a sound out of waves, shape it, and play it."

        "Keyboard" ->
            "Which keys are held right now."

        "Gamepad" ->
            "The sticks and buttons of a connected controller."

        "Device" ->
            "What kind of device this is, and what it can do."

        "Cmd" ->
            "Things to do once, on the way out of update."

        "Sub" ->
            "Things to keep listening to for as long as the state asks."

        "Task" ->
            "Work that can fail, composed before it is run."

        "Service" ->
            "One endpoint declaration, shared by the frontend that calls it and the backend that answers."

        "Entity" ->
            "Describe a database table; migrations follow from it."

        "Repo" ->
            "Read and write rows of a table."

        "Auth" ->
            "Sign people in by mailed code, and guard what they may reach."

        "Http" ->
            "Call somebody else's server, from the frontend only."

        "JSON" ->
            "Turn values into JSON text and back."

        _ ->
            ""


sideFor : String -> String
sideFor m =
    case m of
        "Basics" ->
            "both"

        "List" ->
            "both"

        "String" ->
            "both"

        "Maybe" ->
            "both"

        "Result" ->
            "both"

        "Tuple" ->
            "both"

        "Char" ->
            "both"

        "Dict" ->
            "both"

        "Set" ->
            "both"

        "Decimal" ->
            "both"

        "Time" ->
            "both"

        "Random" ->
            "both"

        "App" ->
            "entry point"

        "Page" ->
            "frontend"

        "Nav" ->
            "frontend"

        "UI" ->
            "frontend"

        "Canvas" ->
            "frontend"

        "Sound" ->
            "frontend"

        "Keyboard" ->
            "frontend"

        "Gamepad" ->
            "frontend"

        "Device" ->
            "frontend"

        "Cmd" ->
            "frontend"

        "Sub" ->
            "frontend"

        "Task" ->
            "both"

        "Service" ->
            "both"

        "Entity" ->
            "backend"

        "Repo" ->
            "backend"

        "Auth" ->
            "both"

        "Http" ->
            "frontend"

        "JSON" ->
            "both"

        _ ->
            ""


entriesFor : String -> List Entry
entriesFor m =
    List.concatMap (\s -> s.entries) (sectionsFor m)
