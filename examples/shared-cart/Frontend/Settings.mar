module Frontend.Settings exposing (page)


import UI exposing
    ( navigationStack, navigationTitle
    , list, section, header, footer
    , text, button, navigationLink
    )
import Frontend.Global
import Frontend.Products
import Frontend.Routes


-- A preference no server owns. This is the second half of what shared is
-- for: not just "fetched once", but "client state that more than one screen
-- reads".
--
-- Toggle it here and walk back to the cart: the total is already right. No
-- refetch, no message passed between pages, no copy to keep in sync — the
-- cart's view function simply reads a value that changed.


type Msg
    = TaxToggled


init : ((), Cmd Msg)
init =
    ( (), Cmd.none )


update : Msg -> () -> ((), Cmd Msg)
update msg model =
    case msg of
        TaxToggled ->
            ( model, Cmd.toShared Frontend.Global.def Frontend.Global.TaxToggled )


view : Frontend.Global.Model -> () -> View Msg
view global _ =
    navigationStack [ navigationTitle "Settings" ]
        [ list []
            [ section
                [ header "Prices"
                , footer "Every screen that shows a price reads this. Change it and walk back."
                ]
                [ text [] (if global.withTax then "Showing prices with tax" else "Showing prices before tax")
                , button [] TaxToggled (if global.withTax then "Hide tax" else "Include 8% tax")
                ]
            , section [ header "Right now" ]
                [ text [] (String.fromInt (Frontend.Global.count global) ++ " item(s), "
                    ++ Frontend.Products.format (Frontend.Global.total global))
                , navigationLink [] Frontend.Routes.cart {} (text [] "Cart")
                , navigationLink [] Frontend.Routes.catalog {} (text [] "Catalog")
                ]
            ]
        ]


page : Page
page =
    Page.withShared Frontend.Global.def
        (\global ->
            Page.create
                { path = "/settings"
                , title = "Settings"
                , init = init
                , update = update
                , view = view global
                , subscriptions = always Sub.none
                }
        )
