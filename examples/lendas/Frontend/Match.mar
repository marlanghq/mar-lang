-- ====================================================================
-- PALETTE + SMALL HELPERS
-- ====================================================================


type alias Rgb =
    { r : Int, g : Int, b : Int }


type alias Pal =
    { felt  : Rgb
    , frame : Rgb
    , trim  : Rgb
    }


deckPal : String -> Pal
deckPal key =
    case key of
        "sol" ->
            { felt = { r = 74, g = 44, b = 26 }
            , frame = { r = 172, g = 120, b = 44 }
            , trim = { r = 240, g = 180, b = 70 }
            }

        "aguas" ->
            { felt = { r = 22, g = 46, b = 70 }
            , frame = { r = 60, g = 110, b = 150 }
            , trim = { r = 120, g = 200, b = 230 }
            }

        _ ->
            { felt = { r = 26, g = 52, b = 36 }
            , frame = { r = 62, g = 116, b = 74 }
            , trim = { r = 140, g = 210, b = 120 }
            }


deckKeyOf : Int -> String
deckKeyOf ix =
    case ix of
        1 -> "sol"
        2 -> "aguas"
        _ -> "floresta"


toC : Rgb -> Color
toC c =
    rgb c.r c.g c.b


shadeC : Rgb -> Int -> Color
shadeC c pct =
    rgb (c.r * pct // 100) (c.g * pct // 100) (c.b * pct // 100)


-- Canvas text neither wraps nor clips: a long name would bleed over the
-- card edges onto its neighbours. Shrink the font by name length so the
-- whole name fits the card width (hand cards are 82 wide, slots 76:
-- the longest name, "Múmia da Cordilheira", is 20 chars and needs the
-- smallest step).
nameSize : Int -> String -> Int
nameSize base nome =
    let
        n = String.length nome
    in
    if n <= 9 then
        base

    else if n <= 12 then
        base - 1

    else if n <= 15 then
        base - 2

    else
        base - 3


shortName : String -> String
shortName nome =
    case String.split "," nome of
        first :: _ ->
            first

        [] ->
            nome


initialOf : String -> String
initialOf nick =
    case String.toList nick of
        c :: _ ->
            String.fromList [ c ]

        [] ->
            "?"


imod2 : Int -> Int
imod2 n =
    Shared.imodP n 2


rangeN : Int -> List Int
rangeN n =
    List.indexedMap (\i _ -> i) (List.repeat n 0)


-- ====================================================================
-- PAGE
-- ====================================================================


subscriptions : Model -> Sub Msg
subscriptions model =
    let
        needPoll =
            case (model.dat, model.disp) of
                (Just d, Just st) ->
                    -- Desafio polls too: after the challenger's opening turn
                    -- the next change is the rival ACCEPTING (then moving).
                    (d.status == Ativa || d.status == Desafio)
                        && st.winner == 0
                        && (st.turnA /= d.souA || List.length model.queue > 0)

                (Just d, Nothing) ->
                    d.status == Ativa || d.status == Desafio

                _ ->
                    True
    in
    Sub.batch
        [ Time.every (Time.millis 33) Tick
        , if needPoll then
            Time.every (Time.seconds 3) Poll

          else
            Sub.none
        ]


page : Page
page =
    Page.dynamicProtected
        { path   = Frontend.Routes.partida
        , title  = "Partida"
        , init   = init
        , update = update
        , view   = view
        , subscriptions = \_ _ model -> subscriptions model
        }
