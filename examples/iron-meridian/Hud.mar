module Hud exposing (..)


import Types exposing (..)
import Balance exposing (..)
import Maps exposing (..)
import Draw exposing (..)
import Canvas exposing ( rect, circle, group, rgb, rgba)


-- IRON MERIDIAN: the command chrome, in screen coordinates. A slim top
-- bar (credits with a live ticker, power, supply, clock), the right
-- sidebar (minimap up top, then the C&C build tabs with hotkey chips
-- and progress fills), a bottom-left selection panel, alert toasts and
-- the help overlay. Everything is shapes plus Canvas.text.


-- Height of the top strip. 26px is right for a cursor and wrong for a thumb: the
-- MENU and HELP words live in it, and 26 is well under the 44px minimum. It grows
-- on touch and nothing moves on a desktop.
topH : Int
topH = 26


topBarH : HudState -> Int
topBarH hs =
    if hs.touch then 44 else topH


sideW : Int
sideW = 176


-- ===== the floating layout, in one place =====
--
-- The world is FULL-BLEED: it fills the canvas edge to edge, and the chrome
-- floats on top of it. Before this the bars were layout -- the map got
-- `w - sideW` by `h - topH - botH` and nothing else -- which on a phone in
-- landscape left a 668x280 slot out of 844x390, 57% of the screen for the only
-- thing anyone is looking at.
--
-- Everything below is read by BOTH halves: Hud draws these rectangles and Main
-- hit-tests them. That is the rule that keeps a floating HUD honest -- the
-- moment a panel is drawn from one number and clicked from another, presses
-- land a band-height from where the player is aiming, which is worse than a
-- fixed layout.


-- the four edges the chrome may use, once the platform's strips are removed
edgeL : HudState -> Int
edgeL hs = hs.insL


edgeR : HudState -> Int
edgeR hs = hs.w - hs.insR


edgeT : HudState -> Int
edgeT hs = hs.insT


edgeB : HudState -> Int
edgeB hs = hs.h - hs.insB


-- Middle of the space the chrome may use. Not w // 2: with the sidebar out,
-- half the canvas is under the panel, and a banner centred there sits visibly
-- off to one side of the map it is talking about.
midX : HudState -> Int
midX hs = (edgeL hs + sideX hs) // 2


-- the vertical room the sidebar column has
usableH : HudState -> Int
usableH hs = edgeB hs - edgeT hs


-- Left edge of the sidebar. Closed, the panel is simply not there and the
-- number collapses to the right edge, so every `x >= sideX` test keeps working
-- with no second spelling of "is the sidebar showing".
sideX : HudState -> Int
sideX hs =
    if hs.sideOpen then edgeR hs - sideW else edgeR hs


-- The grab tab that opens and closes the sidebar. It rides the panel's left
-- edge, so it is in the same place whether the panel is out or away, and it is
-- 44px wide because that is the smallest thing a thumb reliably hits.
handleRect : HudState -> { x : Int, y : Int, w : Int, h : Int }
handleRect hs =
    { x = sideX hs - 22, y = (edgeT hs + edgeB hs) // 2 - 30, w = 22, h = 60 }


-- Does the command console own the bottom strip right now? It is a PANEL only
-- when there is something selected to command; with nothing selected it shrinks
-- to one line of hint text over the map and stops taking presses, which is the
-- 84px the map gets back for free whenever you are just looking around.
--
-- Asked of the GAME, not of hs.sel alone: a selection whose units have since
-- died leaves ids in the list and nothing to draw, and a strip that swallows
-- presses while showing nothing is the worst of both. drawSelPanel branches on
-- exactly these two predicates, so the panel and the hit test cannot disagree.
-- ===== the controls a keyboard used to be =====
--
-- Everything below is a rectangle Hud draws and Main hit-tests, same as the rest
-- of the geometry block. They exist because a phone has no keyboard, and roughly
-- half of this game lived on one: pause, speed, both mutes, the manual, the log,
-- the briefing replay, restart, abandon, deselect and the rally point had no tap
-- path at all. An audit counted 43 of them.


-- MENU, in the top strip. The strip is the cheapest place in the game to put a
-- control: it already refuses every press (Main's band test), so 750x44 px of it
-- are dead input on a phone, and the right end of it was already spending ~90px
-- printing the words "H HELP  ESC MENU" at a player with neither key.
-- Wide enough for the label AND the key chip beside it, so the two never share
-- a pixel. A machine with no keys needs no chip and gets the narrow pill.
menuPillW : HudState -> Int
menuPillW hs =
    if hs.touch then 74 else 84


helpPillW : HudState -> Int
helpPillW hs =
    if hs.touch then 74 else 92


menuPillRect : HudState -> { x : Int, y : Int, w : Int, h : Int }
menuPillRect hs =
    { x = edgeR hs - 8 - menuPillW hs, y = edgeT hs, w = menuPillW hs, h = topBarH hs }


-- Laid out FROM the menu pill rather than from its own offset off the edge. The
-- two used to be independent constants, which is how a wider pill silently
-- overlaps its neighbour.
helpPillRect : HudState -> { x : Int, y : Int, w : Int, h : Int }
helpPillRect hs =
    { x = (menuPillRect hs).x - 6 - helpPillW hs
    , y = edgeT hs
    , w = helpPillW hs
    , h = topBarH hs
    }


-- The FIELD COMMAND card, and its rows. Two columns, because ten rows in one
-- column does not fit a 390px screen and five does.
menuCardRect : HudState -> { x : Int, y : Int, w : Int, h : Int }
menuCardRect hs =
    let
        w = min 420 (edgeR hs - edgeL hs - 32)

        h = min 300 (edgeB hs - edgeT hs - 24)
    in
    { x = (edgeL hs + edgeR hs) // 2 - w // 2
    , y = (edgeT hs + edgeB hs) // 2 - h // 2
    , w = w
    , h = h
    }


menuRowCount : Int
menuRowCount = 10


menuRowRect : HudState -> Int -> { x : Int, y : Int, w : Int, h : Int }
menuRowRect hs i =
    let
        c = menuCardRect hs

        colW = (c.w - 30) // 2

        rowH = (c.h - 56) // 5
    in
    { x = c.x + 10 + modBy 2 i * (colW + 10)
    , y = c.y + 46 + (i // 2) * rowH
    , w = colW
    , h = rowH - 6
    }


-- Every overlay gets a drawn X. A tap anywhere also closes them, but a modal
-- with no visible way out reads as a freeze -- and the footers used to say
-- "H closes" / "L closes" / "P resumes" to a player with no keys.
closeRect : { x : Int, y : Int, w : Int, h : Int } -> { x : Int, y : Int, w : Int, h : Int }
closeRect card =
    { x = card.x + card.w - 46, y = card.y + 6, w = 40, h = 40 }


conOn : Game -> HudState -> Bool
conOn g hs =
    bnot (List.isEmpty (consoleUnits g hs))
        || List.any (\b -> b.id == hs.selB) g.blds


-- what Main tells the HUD every frame
type alias HudState =
    { w : Int                -- full canvas size
    , h : Int
    -- The safe-area insets of that canvas, from Canvas.watchSize (ADR 0034).
    -- The WORLD runs under them -- losing a corner of dirt to a notch costs
    -- nothing -- and every panel, number and tap target here stays inside them.
    -- That split is the whole reason the map can be full-bleed.
    , insT : Int
    , insR : Int
    , insB : Int
    , insL : Int
    , sideOpen : Bool        -- is the command sidebar showing?
    , rallyArmed : Bool      -- waiting for a tap that places the rally flag
    -- Is this a touch-only machine (Device.touchOnly)? Two things read it: tap
    -- targets grow to the 44px a thumb reliably hits, and the little key chips
    -- stop being drawn -- a chip that names a key you do not have is not a hint,
    -- it is a lie about how to play.
    , touch : Bool
    , tab : Int              -- 0 structures, 1 units
    , kbMode : Int           -- 0 none, 1 structures grid, 2 units grid
    , shownCredits : Int     -- animated ticker value
    , sel : List Int
    , attackArmed : Bool
    , superArmed : Bool      -- superweapon is waiting for a target
    , paused : Bool
    , mutedMusic : Bool
    , mutedSfx : Bool
    , speed : Int            -- percent
    , helpOpen : Bool
    , logOpen : Bool         -- the story log (L)
    , logFactions : List String
    , logCast : List String
    , logSoFar : List String
    , objectives : List { text : String, done : Bool }
    , clock : Int            -- mission seconds
    , hoverCell : Int        -- hovered build/train slot, -1 = none
    , selB : Int             -- selected building id, -1 = none
    }


-- ===== frame =====
-- mmRuns: the mission's static terrain runs (Main owns them), reused by
-- the minimap at its own scale.


drawHud : Game -> Cam -> List Shape -> HudState -> List Shape
drawHud g cam miniTerrain hs =
    List.concat
        [ drawTopBar g hs
        , drawSidebar g cam miniTerrain hs
        , drawSelPanel g hs
        , drawAlerts g hs
        , drawObjectives hs
        , drawBanners g hs
        , if hs.helpOpen then drawHelp hs else []
        , if hs.logOpen then drawLog hs else []
        , if hs.paused then drawPaused hs else []
        ]


-- ===== top bar =====


drawTopBar : Game -> HudState -> List Shape
drawTopBar g hs =
    let
        s = playerSide g

        low = s.powUse > s.powMade

        powW = 46
        powFill =
            if s.powMade <= 0 then 0
            else min powW (powW * s.powMade // max 1 (s.powUse + 40))

        mm = hs.clock // 60
        ss = modBy 60 hs.clock

        clockStr =
            String.fromInt mm ++ ":" ++ (if ss < 10 then "0" else "") ++ String.fromInt ss

        t = edgeT hs

        -- The strip's own baseline, derived from its height. Every readout in
        -- here used to sit at a hard-coded t + 17, correct for the 26px desktop
        -- strip and 5px high in the 44px touch one.
        tb = t + topBarH hs // 2 + 4

        x0 = edgeL hs

        -- The strip is translucent now: the map runs underneath it, and a solid
        -- band across the top of a phone is 26px of the only thing worth
        -- looking at. Dark enough that white text still reads over bright sand.
        strip = rgba 24 20 24 216

        -- The right-hand readouts are a RIGHT-ALIGNED STACK, and they hang off
        -- the LEFTMOST pill rather than off the screen edge. They used to be
        -- three independent offsets, which is how SPEED landed on top of the
        -- menu words the first time the sidebar was put away.
        rx = (helpPillRect hs).x
    in
    List.concat
        [ [ rect x0 t (edgeR hs - x0) (topBarH hs) strip
          , rect x0 (t + topBarH hs - 2) (edgeR hs - x0) 2 (rgba 52 44 48 216)
          , Canvas.text (x0 + 12) tb 12 Canvas.Left (rgb 255 214 120) ("$ " ++ String.fromInt hs.shownCredits)
          ]
        , [ Canvas.text (x0 + 120) tb 10 Canvas.Left (rgb 160 168 180) "POWER"
          , rect (x0 + 168) (tb - 9) powW 10 (rgb 44 38 42)
          , rect (x0 + 168) (tb - 9) powFill 10 (if low then rgb 235 110 80 else rgb 120 220 130)
          ]
        , if low && modBy 2 (g.tick // 12) == 0 then
            [ Canvas.text (x0 + 222) tb 10 Canvas.Left (rgb 240 120 90) "LOW" ]
          else
            []
        , [ Canvas.text (x0 + 268) tb 10 Canvas.Left (rgb 160 168 180) "SUPPLY"
          , Canvas.text (x0 + 318) tb 11 Canvas.Left
                (if s.supUse >= s.supMax then rgb 240 180 90 else rgb 210 216 224)
                (String.fromInt s.supUse ++ "/" ++ String.fromInt s.supMax)
          ]
        , [ Canvas.text ((x0 + edgeR hs) // 2) tb 11 Canvas.Center (rgb 210 216 224) clockStr ]
        , [ Canvas.text (rx - 10) tb 10 Canvas.Right (rgb 160 168 180)
                ("SPEED x" ++ String.fromInt (hs.speed // 100) ++ (if modBy 100 hs.speed == 50 then ".5" else ""))
          ]
        -- Naming what is off beats a bare MUTED: with two switches, the
        -- interesting question is which one you hit.
        , if hs.mutedMusic || hs.mutedSfx then
            [ Canvas.text (rx - 96) tb 10 Canvas.Right (rgb 240 180 90)
                (if hs.mutedMusic && hs.mutedSfx then
                    "MUTED"

                 else if hs.mutedMusic then
                    "MUSIC OFF"

                 else
                    "SFX OFF")
            ]
          else
            []
        -- These two used to be the words "H HELP  ESC MENU": an instruction to
        -- press keys, printed in a strip that swallows every press. They are
        -- real buttons now, and they keep the key letter as a chip on a machine
        -- that has keys.
        , pill (helpPillRect hs) "MANUAL" (if hs.touch then "" else "H") hs.helpOpen
        , pill (menuPillRect hs) "MENU" (if hs.touch then "" else "ESC") False
        ]


-- A control in the top strip: a slab, a word, and the key that also does it.
--
-- One baseline, not two. The chip started out under the label, which is fine in
-- a 44px touch strip and impossible in the 26px desktop one: 4px apart, at font
-- sizes 10 and 8, they printed on top of each other. So with a chip the label
-- goes left and the chip right on the same line; with no chip the label centres.
pill : { x : Int, y : Int, w : Int, h : Int } -> String -> String -> Bool -> List Shape
pill r label key on =
    let
        base = r.y + r.h // 2 + 4
    in
    List.concat
        [ [ rect r.x (r.y + 3) r.w (r.h - 6) (if on then rgba 66 58 52 236 else rgba 44 38 44 216)
          , rect r.x (r.y + 3) r.w 2 (if on then rgb 255 214 120 else rgb 62 54 60)
          ]
        , if key == "" then
            [ Canvas.text (r.x + r.w // 2) base 10 Canvas.Center (rgb 224 218 210) label ]

          else
            [ Canvas.text (r.x + 8) base 10 Canvas.Left (rgb 224 218 210) label
            , Canvas.text (r.x + r.w - 8) base 9 Canvas.Right (rgb 255 214 120) key
            ]
        ]


playerSide : Game -> Side
playerSide g =
    case List.head (List.filter (\s -> s.id == 1) g.sides) of
        Just s -> s
        Nothing ->
            { id = 1, race = Compact, team = 1, human = True
            , credits = 0, supUse = 0, supMax = 0, powUse = 0, powMade = 0
            , sQueue = [], sProg = 0, sReady = 0 - 1, uQueue = [], uProg = 0
            , superCd = 0, aggro = 100, mind = { mode = 0, thinkAt = 0, waveAt = 0, waveSize = 0, buildIx = 0, targetX = 0, targetY = 0, scoutIx = 0 }
            , alive = True }


-- ===== sidebar =====


drawSidebar : Game -> Cam -> List Shape -> HudState -> List Shape
drawSidebar g cam miniTerrain hs =
    let
        x0 = sideX hs

        y0 = edgeT hs + topBarH hs
    in
    List.concat
        [ if hs.sideOpen then
            [ rect x0 y0 sideW (edgeB hs - y0) (rgba 30 26 30 236)
            , rect x0 y0 2 (edgeB hs - y0) (rgb 52 44 48)
            ]
          else
            []
        , drawHandle hs
        , drawMinimap g cam miniTerrain hs
        , if hs.sideOpen then
            List.concat [ drawTabs g hs, drawGrid g hs, drawSuperButton g hs ]
          else
            []
        ]


-- The grab tab. A chevron pointing the way the panel will go, so it reads as a
-- control rather than as decoration, and wide enough to hit with a thumb.
drawHandle : HudState -> List Shape
drawHandle hs =
    let
        r = handleRect hs

        cx = r.x + r.w // 2

        cy = r.y + r.h // 2

        -- ">" to put it away, "<" to bring it back
        dir = if hs.sideOpen then 1 else 0 - 1
    in
    [ rect r.x r.y r.w r.h (rgba 30 26 30 236)
    , rect r.x r.y 1 r.h (rgb 52 44 48)
    , rect (cx - dir * 3) (cy - 6) 2 6 (rgb 150 145 150)
    , rect (cx + dir * 1) (cy - 1) 2 2 (rgb 150 145 150)
    , rect (cx - dir * 3) (cy + 1) 2 6 (rgb 150 145 150)
    ]


-- The minimap, wherever it currently lives. With the panel out it is the top of
-- the column; with the panel away it is a small floating square in the corner,
-- because an RTS without a minimap is a game you play by scrolling blind.
mmX : HudState -> Int
mmX hs =
    if hs.sideOpen then sideX hs + 8 else edgeR hs - 22 - mmSizeClosed - 6


mmY : HudState -> Int
mmY hs = edgeT hs + topBarH hs + 8


-- ===== sidebar layout, derived from the canvas height =====
--
-- The sidebar is one column: minimap, tabs, a 5-row build grid, then the
-- superweapon button. These used to be constants summing to 456px. A phone in
-- landscape gives the canvas around 370px, so the column ran off the bottom:
-- the last grid row -- Airfield and the ARTILLERY BEACON -- and the
-- superweapon button were both drawn below the screen. On a phone you could
-- not build the superweapon, let alone fire it.
--
-- Everything under the minimap now derives from the height. The minimap gives
-- up room first (it is the most compressible), then the grid rows. Above
-- ~462px the numbers land exactly on the old constants, so nothing about the
-- desktop layout moves.


mmSizeMax : Int
mmSizeMax = 160


mmSizeMin : Int
mmSizeMin = 80


cellHMax : Int
cellHMax = 40


cellHMin : Int
cellHMin = 26


-- what sits under the minimap at a fixed size: the gap before the tabs (10),
-- the tab row (24), the gap before the super button (6) and the button (22)
sidebarFixed : Int
sidebarFixed = 62


-- The floating minimap's size when the panel is away. Fixed, because it is a
-- corner badge rather than a column: it has to be small enough to leave the map
-- alone and big enough to aim at.
mmSizeClosed : Int
mmSizeClosed = 92


-- room the column has under the minimap, keeping a 6px bottom margin.
--
-- The argument is the USABLE height -- the canvas minus the strips the platform
-- keeps -- not the raw canvas height. On a phone that difference is the home
-- indicator, and spending it would push the superweapon button back off the
-- bottom, which is the bug this whole family was written to fix.
-- The column starts under the top strip, so the strip's height is part of the
-- room it has. Taking the touch height in both cases would shrink the desktop
-- sidebar for nothing, so the caller passes the height it actually drew.
sidebarRoom : Int -> Int -> Int
sidebarRoom bar u = u - (bar + 8) - 6 - sidebarFixed


cellHFor : Int -> Int -> Int
cellHFor bar u = clampI cellHMin cellHMax ((sidebarRoom bar u - mmSizeMin) // 5)


mmSizeFor : Int -> Int -> Int
mmSizeFor bar u = clampI mmSizeMin mmSizeMax (sidebarRoom bar u - 5 * cellHFor bar u)


cellHOf : HudState -> Int
cellHOf hs = cellHFor (topBarH hs) (usableH hs)


mmSizeOf : HudState -> Int
mmSizeOf hs =
    if hs.sideOpen then mmSizeFor (topBarH hs) (usableH hs) else mmSizeClosed


tabsYOf : HudState -> Int
tabsYOf hs = mmY hs + mmSizeOf hs + 10


gridYOf : HudState -> Int
gridYOf hs = tabsYOf hs + 24


superYOf : HudState -> Int
superYOf hs = gridYOf hs + 5 * cellHOf hs + 6


-- world px -> minimap px
mmOfWorld : Game -> HudState -> Int -> Int -> { x : Int, y : Int }
mmOfWorld g hs wx wy =
    let
        mm = mmSizeOf hs
    in
    { x = mmX hs + wx * mm // (g.mapW * tileW)
    , y = mmY hs + wy * mm // (g.mapH * tileW)
    }


-- the race's power building, named for the radar-offline hint
powBldName : Race -> String
powBldName r =
    case r of
        Compact -> "Power Station"
        Combine -> "Junk Turbine"
        Vessari -> "Spire"


drawMinimap : Game -> Cam -> List Shape -> HudState -> List Shape
drawMinimap g cam miniTerrain hs =
    let
        x0 = mmX hs
        y0 = mmY hs
        mm = mmSizeOf hs

        radarUp =
            let
                s = playerSide g
            in
            s.powMade >= s.powUse
    in
    List.concat
        [ [ rect (x0 - 2) (y0 - 2) (mm + 4) (mm + 4) (rgb 52 44 48)
          , rect x0 y0 mm mm (rgb 40 22 18)
          ]
        , if bnot radarUp then
            [ rect x0 y0 mm mm (rgb 20 14 16)
            , Canvas.text (x0 + mm // 2) (y0 + mm // 2 - 8) 10 Canvas.Center
                (if modBy 2 (g.tick // 15) == 0 then rgb 240 120 90 else rgb 140 70 60)
                "RADAR OFFLINE"
            , Canvas.text (x0 + mm // 2) (y0 + mm // 2 + 8) 8 Canvas.Center (rgb 190 160 150)
                "Power shortage"
            , Canvas.text (x0 + mm // 2) (y0 + mm // 2 + 20) 8 Canvas.Center (rgb 210 180 120)
                ("Build a " ++ powBldName (playerSide g).race)
            ]
          else
            List.concat
                [ mmTerrain g miniTerrain x0 y0
                , mmFog mm g x0 y0
                , mmDots mm g x0 y0
                , mmPings g hs
                , mmCamBox g cam hs
                ]
        ]


-- the minimap terrain is static per mission: shapes are prebuilt at the
-- ORIGIN once (buildMiniTerrain) and translated into place per frame
mmTerrain : Game -> List Shape -> Int -> Int -> List Shape
mmTerrain g miniTerrain x0 y0 =
    [ group [ Canvas.Translate x0 y0 ] miniTerrain ]


buildMiniTerrain : Int -> Game -> Dict Int (List Run) -> List Shape
buildMiniTerrain mm g runs =
    List.concatMap
        (\row ->
            case Dict.get row runs of
                Just rr ->
                    List.map
                        (\run ->
                            -- span each cell to the NEXT grid line so rounding
                            -- never leaves 1px gaps between rows/runs (the stripes)
                            rect (run.x0 * mm // g.mapW)
                                (row * mm // g.mapH)
                                (max 1 ((run.x0 + run.w) * mm // g.mapW - run.x0 * mm // g.mapW))
                                (max 1 ((row + 1) * mm // g.mapH - row * mm // g.mapH))
                                (terraColor run.c)
                        )
                        rr

                Nothing ->
                    []
        )
        (List.range 0 (g.mapH - 1))


mmFog : Int -> Game -> Int -> Int -> List Shape
mmFog mm g x0 y0 =
    List.concatMap
        (\row ->
            case Dict.get row g.fogRows of
                Just rr ->
                    List.map
                        (\run ->
                            rect (x0 + run.x0 * mm // g.mapW)
                                (y0 + row * mm // g.mapH)
                                (max 1 ((run.x0 + run.w) * mm // g.mapW - run.x0 * mm // g.mapW))
                                (max 1 ((row + 1) * mm // g.mapH - row * mm // g.mapH))
                                (if run.c == 0 then rgb 12 8 9 else rgba 12 8 9 170)
                        )
                        rr

                Nothing ->
                    []
        )
        (List.range 0 (g.mapH - 1))


mmDots : Int -> Game -> Int -> Int -> List Shape
mmDots mm g x0 y0 =
    let
        unitDots =
            List.filterMap
                (\u ->
                    if u.side /= 1 && visAt g (upx u // tileW) (upy u // tileW) /= 2 then
                        Nothing
                    else
                        Just
                            (rect (x0 + upx u * mm // (g.mapW * tileW) - 1)
                                (y0 + upy u * mm // (g.mapH * tileW) - 1)
                                2 2
                                (col (sidePaint g u.side)))
                )
                g.units

        bldDots =
            List.filterMap
                (\b ->
                    if bldVisible g b then
                        Just
                            (rect (x0 + bpx b * mm // (g.mapW * tileW) - 1)
                                (y0 + bpy b * mm // (g.mapH * tileW) - 1)
                                3 3
                                (col (sidePaint g b.side)))
                    else
                        Nothing
                )
                g.blds
    in
    List.concat [ bldDots, unitDots ]


mmPings : Game -> HudState -> List Shape
mmPings g hs =
    List.concatMap
        (\p ->
            let
                m = mmOfWorld g hs p.x p.y
                age = g.tick - p.t
                r = 3 + modBy 24 age // 3
            in
            [ group [ Canvas.Blend Canvas.Add ]
                [ circle m.x m.y r (rgba 255 210 120 (170 - modBy 24 age * 6))
                , circle m.x m.y (max 1 (r - 2)) (rgba 20 12 10 255)
                ]
            ]
        )
        g.pings


-- The camera rectangle, CLIPPED to the minimap. The viewport is the whole
-- screen now, so on a wide window it is bigger than the map itself and the box
-- used to run off the frame in white lines.
mmCamBox : Game -> Cam -> HudState -> List Shape
mmCamBox g cam hs =
    let
        mm = mmSizeOf hs

        clampX = \v -> clampI (mmX hs) (mmX hs + mm) v

        clampY = \v -> clampI (mmY hs) (mmY hs + mm) v

        raw0 = mmOfWorld g hs cam.x cam.y

        raw1 = mmOfWorld g hs (cam.x + cam.w) (cam.y + cam.h)

        tl = { x = clampX raw0.x, y = clampY raw0.y }

        br = { x = clampX raw1.x, y = clampY raw1.y }

        w = max 6 (br.x - tl.x)
        h = max 6 (br.y - tl.y)
    in
    [ rect tl.x tl.y w 1 (rgb 230 234 240)
    , rect tl.x (tl.y + h) w 1 (rgb 230 234 240)
    , rect tl.x tl.y 1 h (rgb 230 234 240)
    , rect (tl.x + w) tl.y 1 (h + 1) (rgb 230 234 240)
    ]


-- ===== build tabs + grid =====


drawTabs : Game -> HudState -> List Shape
drawTabs g hs =
    let
        x0 = sideX hs + 8
    in
    List.concat
        [ tabBtn hs (tabsYOf hs) x0 "BUILD" (hs.tab == 0) "B"
        , tabBtn hs (tabsYOf hs) (x0 + 84) "UNITS" (hs.tab == 1) "T"
        ]


tabBtn : HudState -> Int -> Int -> String -> Bool -> String -> List Shape
tabBtn hs ty tx label active hot =
    List.concat
        [ [ rect tx ty 76 18 (if active then rgb 58 50 56 else rgb 38 32 38)
          , Canvas.text (tx + (if hs.touch then 38 else 30)) (ty + 13) 10 Canvas.Center
                (if active then rgb 235 225 210 else rgb 150 145 150) label
          ]
        , if hs.touch then
            []

          else
            [ rect (tx + 58) (ty + 4) 12 11 (rgb 24 20 24)
            , Canvas.text (tx + 64) (ty + 13) 9 Canvas.Center (rgb 255 214 120) hot
            ]
        ]


gridLetters : Int -> String
gridLetters i =
    case i of
        0 -> "Q"
        1 -> "W"
        2 -> "E"
        3 -> "R"
        4 -> "T"
        5 -> "A"
        6 -> "S"
        7 -> "D"
        8 -> "F"
        9 -> "G"
        10 -> "Z"
        11 -> "X"
        _ -> "C"


-- grid geometry shared with Main's hit testing
gridCellAt : HudState -> Int -> { x : Int, y : Int, w : Int, h : Int }
gridCellAt hs i =
    { x = sideX hs + 8 + modBy 2 i * 82
    , y = gridYOf hs + (i // 2) * cellHOf hs
    , w = 78
    , h = cellHOf hs - 4
    }


drawGrid : Game -> HudState -> List Shape
drawGrid g hs =
    let
        s = playerSide g
    in
    if hs.tab == 0 then
        List.concat
            (List.indexedMap
                (\i k -> drawBldCell g hs s i k)
                (raceBlds s.race))
    else
        List.concat
            (List.indexedMap
                (\i k -> drawUnitCell g hs s i k)
                (raceUnits s.race))


cellBase : HudState -> Int -> Bool -> Bool -> List Shape
cellBase hs i enabled highlight =
    let
        c = gridCellAt hs i
    in
    [ rect c.x c.y c.w c.h
        (if highlight then rgb 66 58 52
         else if enabled then rgb 44 38 44
         else rgb 34 30 34)
    , rect c.x c.y c.w 2
        (if highlight then rgb 255 214 120 else rgb 56 48 54)
    ]


hotkeyChip : HudState -> Int -> Bool -> List Shape
hotkeyChip hs i visible =
    let
        c = gridCellAt hs i
    in
    if visible then
        [ rect (c.x + c.w - 14) (c.y + 2) 12 11 (rgb 24 20 24)
        , Canvas.text (c.x + c.w - 8) (c.y + 11) 9 Canvas.Center (rgb 255 214 120) (gridLetters i)
        ]
    else
        []


drawBldCell : Game -> HudState -> Side -> Int -> BldKind -> List Shape
drawBldCell g hs s i k =
    let
        c = gridCellAt hs i

        unlocked = List.all (\need -> hasBldHud g s.id need) (bNeeds k)
        affordable = s.credits >= bCost k

        isHead =
            case List.head s.sQueue of
                Just q -> q == k
                Nothing -> False

        ready = s.sReady == bldCode k

        prog =
            if isHead then
                100 - s.sProg * 100 // max 1 (bBuild k)
            else
                0

        enabled = unlocked
        blink = modBy 2 (g.tick // 10) == 0
    in
    List.concat
        [ cellBase hs i enabled (ready && blink)
        , if isHead then
            [ rect c.x (c.y + c.h - 4) (c.w * prog // 100) 4 (rgb 120 220 130) ]
          else
            []
        -- The price line sat at a fixed +27, which falls outside the cell
        -- once the rows shrink on a short screen. Clamped to the cell's own
        -- floor; on a normal-height row (h 36) the min still picks 27, so
        -- the desktop grid is pixel-identical.
        , [ Canvas.text (c.x + 5) (c.y + 13) 9 Canvas.Left
                (if ready then rgb 255 230 150
                 else if enabled then rgb 220 214 206
                 else rgb 110 106 110)
                (bName k)
          , Canvas.text (c.x + 5) (min (c.y + 27) (c.y + c.h - 6)) 9 Canvas.Left
                (if ready then rgb 130 240 140
                 else if affordable && enabled then rgb 255 214 120
                 else rgb 150 120 90)
                (if ready then "CLICK MAP" else "$" ++ String.fromInt (bCost k))
          ]
        , hotkeyChip hs i (hs.kbMode == 1)
        ]


hasBldHud : Game -> Int -> BldKind -> Bool
hasBldHud g sid k =
    List.any (\b -> b.side == sid && b.prog == 0 && b.kind == k) g.blds


drawUnitCell : Game -> HudState -> Side -> Int -> UnitKind -> List Shape
drawUnitCell g hs s i k =
    let
        c = gridCellAt hs i

        unlocked = List.all (\need -> hasBldHud g s.id need) (uNeeds k)
        affordable = s.credits >= uCost k

        queued =
            List.length (List.filter (\q -> q == k) s.uQueue)

        isHead =
            case List.head s.uQueue of
                Just q -> q == k
                Nothing -> False

        prog =
            if isHead then
                100 - s.uProg * 100 // max 1 (uBuild k)
            else
                0

        -- trained but supply-blocked: the bar would sit at 100% doing
        -- nothing, so flag it (orange bar + blinking SUPPLY tag)
        stalled =
            isHead && s.uProg <= 1 && s.supUse + uSupply k > s.supMax

        blink = modBy 2 (g.tick // 10) == 0
    in
    List.concat
        [ cellBase hs i unlocked False
        , if isHead then
            [ rect c.x (c.y + c.h - 4) (c.w * prog // 100) 4
                (if stalled then rgb 240 150 90 else rgb 120 220 130) ]
          else
            []
        , [ Canvas.text (c.x + 5) (c.y + 13) 9 Canvas.Left
                (if unlocked then rgb 220 214 206 else rgb 110 106 110)
                (uName k)
          , Canvas.text (c.x + 5) (min (c.y + 27) (c.y + c.h - 6)) 9 Canvas.Left
                (if stalled then
                    (if blink then rgb 255 170 90 else rgb 190 120 70)
                 else if affordable && unlocked then rgb 255 214 120
                 else rgb 150 120 90)
                (if stalled then "SUPPLY" else "$" ++ String.fromInt (uCost k))
          ]
        , if queued > 0 then
            [ rect (c.x + c.w - 18) (c.y + c.h - 15) 16 13 (rgb 24 20 24)
            , Canvas.text (c.x + c.w - 10) (c.y + c.h - 5) 9 Canvas.Center (rgb 130 240 140) ("x" ++ String.fromInt queued)
            ]
          else
            []
        , hotkeyChip hs i (hs.kbMode == 2)
        ]


-- The name of the superweapon this side has built, for the aiming banner and
-- the button. Falls back to a generic word, which no live game should reach:
-- neither is drawn unless the building exists.
superName : Game -> String
superName g =
    case List.head (List.filter (\b -> b.side == 1 && b.prog == 0 && bIsSuper b.kind) g.blds) of
        Just b ->
            bName b.kind

        Nothing ->
            "Superweapon"


-- superweapon button under the grid
drawSuperButton : Game -> HudState -> List Shape
drawSuperButton g hs =
    let
        s = playerSide g

        hasSuper =
            List.any (\b -> b.side == 1 && b.prog == 0 && bIsSuper b.kind) g.blds

        y = superYOf hs
        x0 = sideX hs + 8

        readyPct =
            if superCooldown == 0 then 100
            else 100 - s.superCd * 100 // superCooldown

        ready = s.superCd == 0
        blink = modBy 2 (g.tick // 10) == 0
        armed = hs.superArmed && ready

        -- Three states, and the label says what the NEXT tap does. It used to
        -- read FIRE while ready, which promises the press finishes the job:
        -- it does not, it opens aiming, and the screen then looked unchanged.
        label =
            if armed then "CLICK A TARGET"
            else if ready then "V  AIM SUPERWEAPON"
            else "SUPERWEAPON CHARGING"
    in
    if bnot hasSuper then
        []
    else
        [ rect x0 y 160 22
            (if armed then rgb 122 62 40
             else if ready && blink then rgb 80 52 48
             else rgb 44 34 38)
        , rect x0 y (160 * readyPct // 100) 3 (rgb 240 150 90)
        , Canvas.text (x0 + 80) (y + 15) 10 Canvas.Center
            (if armed then rgb 255 226 180
             else if ready then rgb 255 190 120
             else rgb 150 130 120)
            label
        ]


-- ===== bottom command console =====
-- A panel that floats over the bottom of the map WHEN THERE IS SOMETHING TO
-- COMMAND. One unit shows a full stat card with its live sprite as the
-- portrait; a squad shows a portrait grid (Main lets a click single a unit
-- out); a building shows its card.
--
-- It used to be a reserved band, present even with nothing selected, when all
-- it had to say was a tip. That is 84px of map spent on advice you have already
-- read. With nothing selected it is now one line of text over the world, and it
-- takes no presses -- conOn is the single answer to "is the panel there?", read
-- by the drawing here and by Main's hit test.


botH : Int
botH = 84


csX : HudState -> Int
csX hs = edgeL hs


csY : HudState -> Int
csY hs = edgeB hs - botH


-- Right edge of the console, in absolute screen x. The rects below are laid out
-- from it, so the panel ends where the sidebar begins and grows into that space
-- the moment the sidebar is put away.
csR : HudState -> Int
csR hs = sideX hs


csW : HudState -> Int
csW hs = csR hs - csX hs


csMaxPortraits : Int
csMaxPortraits = 16


-- canonical order of the selected units: grouped by kind (cost is a stable
-- per-kind key), ties by id, so portraits never swap slots between frames
consoleUnits : Game -> HudState -> List Unit
consoleUnits g hs =
    List.sortBy (\u -> uCost u.kind * 100000 + modBy 100000 u.id)
        (List.filter (\u -> List.member u.id hs.sel) g.units)


csPortraitRect : HudState -> Int -> { x : Int, y : Int, w : Int, h : Int }
csPortraitRect hs i =
    { x = csX hs + 190 + modBy 8 i * 32
    , y = csY hs + 9 + (i // 8) * 34
    , w = 28
    , h = 30
    }


-- How tall a console button is. 30px is a mouse target; a thumb wants 44, and
-- the console band is 84 tall, so both fit without moving the panel.
csBtnH : HudState -> Int
csBtnH hs =
    if hs.touch then 44 else 30


csBtnY : HudState -> Int
csBtnY hs =
    csY hs + botH - 12 - csBtnH hs


-- the Demolish button for a selected own building (sells it for half back)
csDemolishRect : HudState -> { x : Int, y : Int, w : Int, h : Int }
csDemolishRect hs =
    { x = csR hs - 128, y = csBtnY hs, w = 104, h = csBtnH hs }


-- SET RALLY, for a selected producer. The rally point was right-click only, and
-- right-click on a phone is a long press that this canvas deliberately swallows
-- (the page kills the iOS callout), so on mobile Safari it had no path at all.
csRallyRect : HudState -> { x : Int, y : Int, w : Int, h : Int }
csRallyRect hs =
    { x = csR hs - 244, y = csBtnY hs, w = 104, h = csBtnH hs }


csOrderRect : HudState -> Int -> { x : Int, y : Int, w : Int, h : Int }
csOrderRect hs i =
    -- anchored so the last button clears the console's right edge with margin
    { x = csR hs - 222 + i * 66
    , y = csBtnY hs
    , w = 58
    , h = csBtnH hs
    }


-- CLEAR, to the left of the three orders. Deselecting is not a verb this game
-- ever had a control for: it exists only as a side effect of dragging an empty
-- box, and stage E4 deletes exactly that gesture when a drag becomes a pan. It
-- is drawn only when there IS a selection, which is when it means anything.
csClearRect : HudState -> { x : Int, y : Int, w : Int, h : Int }
csClearRect hs =
    { x = csR hs - 288, y = csBtnY hs, w = 58, h = csBtnH hs }


hpColor : Int -> Color
hpColor pct =
    if pct > 60 then rgb 110 230 120
    else if pct > 30 then rgb 240 210 90
    else rgb 240 110 90


classTint : Int -> Color
classTint c =
    if c == 2 then rgb 46 34 58
    else if c == 1 then rgb 54 42 32
    else rgb 34 44 60


roleLine : UnitKind -> String
roleLine k =
    let
        base =
            if uWorker k then "Worker"
            else if uCapturer k then "Engineer"
            else if uClass k == 2 then "Aircraft"
            else if uClass k == 1 then "Vehicle"
            else "Infantry"
    in
    if uDmg k == 0 then
        base ++ ", unarmed"
    else if uAA k then
        base ++ ", hits ground and air"
    else
        base ++ ", ground only"


drawSelPanel : Game -> HudState -> List Shape
drawSelPanel g hs =
    let
        mine = consoleUnits g hs

        bSel =
            List.head (List.filter (\b -> b.id == hs.selB) g.blds)
    in
    case bSel of
        Just b ->
            consoleFrame hs (bldConsole g hs b)

        Nothing ->
            case mine of
                -- conOn says the same thing to Main's hit test: no panel here,
                -- so a press at the bottom of the screen reaches the map.
                [] ->
                    emptyConsole hs

                [ u ] ->
                    consoleFrame hs (List.concat [ unitConsole g hs u, orderButtons hs ])

                _ ->
                    consoleFrame hs (List.concat [ squadConsole g hs mine, orderButtons hs ])


consoleFrame : HudState -> List Shape -> List Shape
consoleFrame hs inner =
    List.concat
        -- The background runs to x = 0 rather than to the safe-area edge: it is
        -- a dark band with nothing in it to read, and a band that stops short of
        -- the glass looks like a rendering bug. The CONTENT is what stays inside
        -- the insets, and it is anchored at csX.
        [ [ rect 0 (csY hs) (csR hs) botH (rgba 23 18 23 232)
          , rect 0 (csY hs) (csR hs) 2 (rgb 82 68 58)
          ]
        , inner
        ]


-- Nothing selected: no panel at all, just one line of advice riding the bottom
-- of the map. This is the 84px the map gets back for the whole time you are
-- scouting rather than commanding.
emptyConsole : HudState -> List Shape
emptyConsole hs =
    let
        y = edgeB hs - 8
    in
    [ Canvas.text (csX hs + 14) y 9 Canvas.Left (rgba 210 202 196 200)
        "Drag on the map to select units. Click a building to inspect it."
    , Canvas.text (csR hs - 14) y 9 Canvas.Right (rgba 210 202 196 160)
        (if hs.touch then "MENU for pause, speed, sound and the manual" else "B build    T units    H help")
    ]


-- the unit's own live sprite, scaled up, is its portrait
portraitSprite : Game -> Unit -> Int -> Int -> Int -> List Shape
portraitSprite g u cx cy pct =
    [ group [ Canvas.Translate cx cy, Canvas.Scale pct pct ] (unitArt g u 0 0) ]


unitConsole : Game -> HudState -> Unit -> List Shape
unitConsole g hs u =
    let
        y0 = csY hs

        x0 = csX hs

        pct = unitHpPct u
    in
    List.concat
        [ [ rect (x0 + 12) (y0 + 14) 56 56 (rgb 15 12 15)
          , rect (x0 + 12) (y0 + 14) 56 2 (col (sidePaint g u.side))
          ]
        , portraitSprite g u (x0 + 40) (y0 + 44) 240
        , [ Canvas.text (x0 + 80) (y0 + 26) 12 Canvas.Left (rgb 238 231 220) (uName u.kind)
          , Canvas.text (x0 + 80) (y0 + 41) 9 Canvas.Left (rgb 154 144 136) (roleLine u.kind)
          , rect (x0 + 80) (y0 + 52) 150 5 (rgb 30 30 34)
          , rect (x0 + 80) (y0 + 52) (150 * pct // 100) 5 (hpColor pct)
          , Canvas.text (x0 + 238) (y0 + 59) 9 Canvas.Left (rgb 190 182 172)
                (String.fromInt u.hp ++ " / " ++ String.fromInt (uHp u.kind))
          ]
        , if uDmg u.kind == 0 then
            [ Canvas.text (x0 + 330) (y0 + 44) 9 Canvas.Left (rgb 190 176 150) "Gathers resources" ]
          else
            [ Canvas.text (x0 + 330) (y0 + 28) 9 Canvas.Left (rgb 190 176 150) ("Damage " ++ String.fromInt (uDmg u.kind))
            , Canvas.text (x0 + 330) (y0 + 43) 9 Canvas.Left (rgb 190 176 150) ("Range " ++ String.fromInt (uRange u.kind))
            , Canvas.text (x0 + 330) (y0 + 58) 9 Canvas.Left (rgb 190 176 150) ("Speed " ++ String.fromInt (uSpeed u.kind))
            ]
        ]


squadConsole : Game -> HudState -> List Unit -> List Shape
squadConsole g hs mine =
    let
        y0 = csY hs

        n = List.length mine

        shown = List.take csMaxPortraits mine

        extra = n - List.length shown

        counts = kindCounts mine

        x0 = csX hs
    in
    List.concat
        [ [ Canvas.text (x0 + 14) (y0 + 22) 12 Canvas.Left (rgb 238 231 220)
                (String.fromInt n ++ " units")
          ]
        , List.concat
            (List.indexedMap
                (\i c ->
                    [ Canvas.text (x0 + 14) (y0 + 38 + i * 12) 9 Canvas.Left (rgb 154 144 136)
                        (String.fromInt c.n ++ "x " ++ c.name)
                    ]
                )
                (List.take 3 counts))
        , List.concat (List.indexedMap (\i u -> portraitCell g hs i u) shown)
        , if extra > 0 then
            [ Canvas.text (x0 + 190 + 8 * 32 + 8) (y0 + 28) 10 Canvas.Left (rgb 190 182 172)
                ("+" ++ String.fromInt extra)
            ]
          else
            []
        ]


portraitCell : Game -> HudState -> Int -> Unit -> List Shape
portraitCell g hs i u =
    let
        c = csPortraitRect hs i

        pct = unitHpPct u
    in
    List.concat
        [ [ rect c.x c.y c.w c.h (rgb 15 12 15)
          , rect c.x c.y c.w 2 (col (sidePaint g u.side))
          ]
        , portraitSprite g u (c.x + c.w // 2) (c.y + 14) 110
        , [ rect (c.x + 3) (c.y + c.h - 6) (c.w - 6) 3 (rgb 30 30 34)
          , rect (c.x + 3) (c.y + c.h - 6) ((c.w - 6) * pct // 100) 3 (hpColor pct)
          ]
        ]


kindCounts : List Unit -> List { name : String, n : Int }
kindCounts us =
    List.foldl
        (\u acc ->
            if List.any (\c -> c.name == uName u.kind) acc then
                List.map
                    (\c -> if c.name == uName u.kind then { c | n = c.n + 1 } else c)
                    acc
            else
                List.concat [ acc, [ { name = uName u.kind, n = 1 } ] ]
        )
        []
        us


-- A console button: slab, word, and the key that also does it. The key chip is
-- drawn only on a machine that HAS keys -- a chip reading "A" on a phone is not
-- a hint, it is a lie about how to give the order.
consoleBtn : HudState -> { x : Int, y : Int, w : Int, h : Int } -> String -> String -> Bool -> List Shape
consoleBtn hs r word key hot =
    List.concat
        [ [ rect r.x r.y r.w r.h (if hot then rgb 66 58 52 else rgb 44 38 44)
          , rect r.x r.y r.w 2 (if hot then rgb 255 214 120 else rgb 56 48 54)
          , Canvas.text (r.x + r.w // 2) (r.y + r.h // 2 + (if hs.touch then 4 else 0)) 9 Canvas.Center
                (rgb 224 218 210) word
          ]
        , if hs.touch || key == "" then
            []

          else
            [ Canvas.text (r.x + r.w // 2) (r.y + 24) 8 Canvas.Center (rgb 255 214 120) key ]
        ]


orderButtons : HudState -> List Shape
orderButtons hs =
    List.concat
        [ -- CLEAR first, on the left, away from the three that give orders: it
          -- undoes a selection rather than commanding one, and a thumb that
          -- misses Attack should not hit it.
          consoleBtn hs (csClearRect hs) "Clear" "" False
        , List.concat
            (List.indexedMap
                (\i b -> consoleBtn hs (csOrderRect hs i) b.word b.key (i == 0 && hs.attackArmed))
                [ { word = "Attack", key = "A" }
                , { word = "Stop", key = "S" }
                , { word = "Hold", key = "G" }
                ])
        ]


bldConsole : Game -> HudState -> Bld -> List Shape
bldConsole g hs b =
    let
        y0 = csY hs

        maxHp = bHp b.kind

        pct = 100 * b.hp // max 1 maxHp

        s = playerSide g

        wpx = bW b.kind * tileW

        hpx = bH b.kind * tileW

        -- scale the building art down so it fits the 56px photo box
        sc = min 90 (5200 // max 1 (max wpx hpx))

        x0 = csX hs
    in
    List.concat
        [ [ rect (x0 + 12) (y0 + 14) 56 56 (rgb 15 12 15)
          , rect (x0 + 12) (y0 + 14) 56 2 (col (sidePaint g b.side))
          ]
        , [ group
                [ Canvas.Translate (x0 + 40 - wpx * sc // 200) (y0 + 44 - hpx * sc // 200)
                , Canvas.Scale sc sc
                ]
                (bldArt g b 0 0 wpx hpx)
          ]
        , [ Canvas.text (x0 + 80) (y0 + 26) 12 Canvas.Left (rgb 238 231 220) (bName b.kind)
          , Canvas.text (x0 + 80) (y0 + 41) 9 Canvas.Left (rgb 154 144 136) (bDesc b.kind)
          , rect (x0 + 80) (y0 + 52) 180 5 (rgb 30 30 34)
          , rect (x0 + 80) (y0 + 52) (180 * pct // 100) 5 (hpColor pct)
          , Canvas.text (x0 + 268) (y0 + 59) 9 Canvas.Left (rgb 190 182 172)
                (String.fromInt b.hp ++ " / " ++ String.fromInt maxHp)
          ]
        , if b.side == 1 && bnot (bIsHQ b.kind) then
            let
                d = csDemolishRect hs
            in
            [ rect d.x d.y d.w d.h (rgb 66 38 38)
            , rect d.x d.y d.w 2 (rgb 200 90 80)
            , Canvas.text (d.x + d.w // 2) (d.y + d.h // 2 - 2) 9 Canvas.Center (rgb 232 205 200) "Demolish"
            , Canvas.text (d.x + d.w // 2) (d.y + d.h // 2 + 10) 8 Canvas.Center (rgb 205 155 130)
                ("+" ++ String.fromInt (bCost b.kind // 2))
            ]
          else
            []
        -- SET RALLY. The rally point was right-click only, which on mobile
        -- Safari is a long press this canvas deliberately swallows -- so on a
        -- phone the flag could not be moved at all.
        , if b.side == 1 && bProduces b.kind >= 0 then
            consoleBtn hs (csRallyRect hs) "Set rally" "" hs.rallyArmed

          else
            []
        , if bProduces b.kind >= 0 && b.side == 1 then
            [ Canvas.text (x0 + 80) (y0 + botH - 10) 8 Canvas.Left (rgb 130 122 116)
                ("Queue " ++ String.fromInt (List.length s.uQueue) ++ ". Set rally, then pick the spot.")
            ]
          else if b.side /= 1 then
            [ Canvas.text (x0 + 80) (y0 + botH - 10) 8 Canvas.Left (rgb 130 122 116) "Enemy structure." ]
          else
            []
        ]


-- ===== alerts + objectives + banners =====


drawAlerts : Game -> HudState -> List Shape
drawAlerts g hs =
    List.concat
        (List.indexedMap
            (\i a ->
                let
                    age = g.tick - a.t
                    fade = max 0 (200 - age)
                in
                [ Canvas.text (midX hs) (edgeT hs + topBarH hs + 18 + i * 14) 11 Canvas.Center
                    (rgba 255 220 150 (min 255 fade))
                    a.msg
                ]
            )
            (List.take 3 g.alerts))


drawObjectives : HudState -> List Shape
drawObjectives hs =
    let
        x0 = edgeL hs

        y0 = edgeT hs + topBarH hs
    in
    if List.isEmpty hs.objectives then
        []
    else
        List.concat
            [ [ Canvas.text (x0 + 12) (y0 + 16) 9 Canvas.Left (rgb 150 145 150) "OBJECTIVES" ]
            , List.concat
                (List.indexedMap
                    (\i o ->
                        [ rect (x0 + 12) (y0 + 24 + i * 13) 7 7 (rgba 44 38 44 216)
                        , if o.done then
                            rect (x0 + 14) (y0 + 26 + i * 13) 3 3 (rgb 130 240 140)
                          else
                            rect (x0 + 13) (y0 + 25 + i * 13) 5 5 (rgba 30 26 30 216)
                        , Canvas.text (x0 + 24) (y0 + 31 + i * 13) 9 Canvas.Left
                            (if o.done then rgb 130 200 140 else rgb 210 205 200)
                            o.text
                        ]
                    )
                    hs.objectives)
            ]


drawBanners : Game -> HudState -> List Shape
drawBanners g hs =
    let
        s = playerSide g
    in
    List.concat
        [ if hs.attackArmed then
            [ rect (midX hs - 90) (edgeT hs + topBarH hs + 4) 180 16 (rgba 90 40 34 220)
            , Canvas.text (midX hs) (edgeT hs + topBarH hs + 16) 10 Canvas.Center (rgb 255 170 140) "ATTACK MOVE: click a target"
            ]
          else
            []
        -- Same banner the other two aimed modes get. Without it, arming the
        -- superweapon changed nothing on screen and the next step was a guess.
        , if hs.superArmed then
            [ rect (midX hs - 145) (edgeT hs + topBarH hs + 4) 290 16 (rgba 96 44 30 230)
            , Canvas.text (midX hs) (edgeT hs + topBarH hs + 16) 10 Canvas.Center (rgb 255 190 120)
                (superName g ++ ": click a target (its button cancels)")
            ]
          else
            []
        , if hs.rallyArmed then
            [ rect (midX hs - 120) (edgeT hs + topBarH hs + 4) 240 16 (rgba 40 60 90 225)
            , Canvas.text (midX hs) (edgeT hs + topBarH hs + 16) 10 Canvas.Center (rgb 170 205 240)
                "RALLY POINT: pick a spot on the map"
            ]
          else
            []
        -- All three share one slot, and this one is drawn last, so it used to
        -- paint over whichever aim banner was up. A finished building waiting
        -- to be placed is the normal state during a fight, so that overlap was
        -- reachable any time you pressed A. The aim banner describes the click
        -- you are about to make and wins; this one is a standing reminder.
        , if s.sReady >= 0 && bnot (hs.attackArmed || hs.superArmed) then
            [ rect (midX hs - 130) (edgeT hs + topBarH hs + 4) 260 16 (rgba 40 70 40 220)
            , Canvas.text (midX hs) (edgeT hs + topBarH hs + 16) 10 Canvas.Center (rgb 170 240 170)
                ((bName (bldFromCode s.sReady)) ++ ": click the map to build (its icon cancels)")
            ]
          else
            []
        ]


drawPaused : HudState -> List Shape
drawPaused hs =
    [ rect 0 0 hs.w hs.h (rgba 10 8 10 140)
    , Canvas.text (midX hs) (hs.h // 2) 26 Canvas.Center (rgb 235 225 210) "PAUSED"
    , Canvas.text (midX hs) (hs.h // 2 + 22) 11 Canvas.Center (rgb 160 155 160)
        (if hs.touch then "tap to resume" else "P or a click resumes")
    ]


-- ===== FIELD COMMAND =====
--
-- Everything that acts on the MISSION rather than on something on screen. The
-- keyboard used to be the only way to reach any of it, which on a phone meant a
-- mission that stalled without triggering a loss had no exit at all.
--
-- The labels state the CURRENT state, not the action, for the toggles: a row
-- that says "MUSIC ON" is telling you what is true, and tapping it makes the
-- other thing true. Buttons that lie about which way they point are the oldest
-- bug in settings screens.


menuRowLabel : HudState -> Int -> String
menuRowLabel hs i =
    if i == 0 then "RESUME"
    else if i == 1 then (if hs.paused then "PAUSED" else "PAUSE")
    else if i == 2 then
        "SPEED x" ++ String.fromInt (hs.speed // 100) ++ (if modBy 100 hs.speed == 50 then ".5" else "")
    else if i == 3 then (if hs.mutedMusic then "MUSIC OFF" else "MUSIC ON")
    else if i == 4 then (if hs.mutedSfx then "EFFECTS OFF" else "EFFECTS ON")
    else if i == 5 then "FIELD MANUAL"
    else if i == 6 then "CAMPAIGN LOG"
    else if i == 7 then "REPLAY BRIEFING"
    else if i == 8 then "RESTART MISSION"
    else "ABANDON"


-- The two that end the mission read in the warning colour, so a thumb reaching
-- for RESUME does not land on ABANDON without noticing.
menuRowHot : Int -> Bool
menuRowHot i =
    i >= 8


drawMenu : HudState -> List Shape
drawMenu hs =
    let
        c = menuCardRect hs

        x = closeRect c
    in
    List.concat
        [ [ rect 0 0 hs.w hs.h (rgba 10 8 10 170)
          , rect c.x c.y c.w c.h (rgb 26 22 26)
          , rect c.x c.y c.w 3 (rgb 255 214 120)
          , Canvas.text (c.x + 16) (c.y + 28) 14 Canvas.Left (rgb 235 225 210) "FIELD COMMAND"
          , rect x.x x.y x.w x.h (rgba 44 38 44 200)
          , Canvas.text (x.x + x.w // 2) (x.y + x.h // 2 + 5) 14 Canvas.Center (rgb 220 214 206) "X"
          ]
        , List.concat
            (List.map
                (\i ->
                    let
                        r = menuRowRect hs i
                    in
                    [ rect r.x r.y r.w r.h (if menuRowHot i then rgb 58 36 36 else rgb 44 38 44)
                    , rect r.x r.y r.w 2 (if menuRowHot i then rgb 200 90 80 else rgb 62 54 60)
                    , Canvas.text (r.x + r.w // 2) (r.y + r.h // 2 + 4) 11 Canvas.Center
                        (if menuRowHot i then rgb 232 205 200 else rgb 220 214 206)
                        (menuRowLabel hs i)
                    ]
                )
                (List.range 0 (menuRowCount - 1)))
        ]


-- ===== the log =====
--
-- The campaign used to tell you the story once, in a briefing you could not
-- reopen, and then expect you to carry it for five missions. This is the
-- answer to "wait, who is Kesk again": the three sides, the four voices, and
-- where things currently stand, on one key.
drawLog : HudState -> List Shape
drawLog hs =
    let
        c = cardRect hs 500 400

        cx = c.x + c.w // 2

        -- Three sections, laid out in sequence instead of at fixed offsets. The
        -- old card was a 500x400 slab with every heading at a hard-coded y, so
        -- on a 390px screen its top and bottom were simply off the display --
        -- the same fault the briefing had.
        n1 = List.length hs.logFactions

        n2 = List.length hs.logCast

        n3 = List.length hs.logSoFar

        -- The pitch is derived, not chosen. The three sections plus their
        -- headings have to land inside the card, and on a short screen the card
        -- is short: at a fixed 13px the last section ran off the bottom and the
        -- footer printed over it.
        room = c.h - 56 - 24 - 3 * 18 - 2 * 10

        pitch = clampI 9 13 (room // max 1 (n1 + n2 + n3))

        y1 = c.y + 56

        y2 = y1 + 16 + n1 * pitch + 10

        y3 = y2 + 16 + n2 * pitch + 10
    in
    List.concat
        [ [ rect c.x c.y c.w c.h (rgba 18 15 18 244)
          , rect c.x c.y c.w 3 (rgb 255 214 120)
          , Canvas.text cx (c.y + 28) 15 Canvas.Center (rgb 235 225 210) "CAMPAIGN LOG"
          , Canvas.text (c.x + 24) y1 10 Canvas.Left (rgb 255 214 120) "WHO IS FIGHTING"
          ]
        , logRows pitch (c.x + 24) (y1 + 16) hs.logFactions
        , [ Canvas.text (c.x + 24) y2 10 Canvas.Left (rgb 255 214 120) "ON THE RADIO" ]
        , logRows pitch (c.x + 24) (y2 + 16) hs.logCast
        , [ Canvas.text (c.x + 24) y3 10 Canvas.Left (rgb 255 214 120) "WHERE WE ARE" ]
        , logRows pitch (c.x + 24) (y3 + 16) hs.logSoFar
        , closeGlyph c
        , [ Canvas.text cx (c.y + c.h - 14) 10 Canvas.Center (rgb 150 145 150)
                (if hs.touch then "tap to close    MENU replays the briefing" else "L closes    R replays this mission's briefing")
          ]
        ]


-- The X every overlay wears. A tap anywhere also closes, but a card with no
-- visible way out reads as a freeze -- and these cards used to instruct the
-- player to press a key instead.
closeGlyph : { x : Int, y : Int, w : Int, h : Int } -> List Shape
closeGlyph card =
    let
        r = closeRect card
    in
    [ rect r.x r.y r.w r.h (rgba 44 38 44 200)
    , Canvas.text (r.x + r.w // 2) (r.y + r.h // 2 + 5) 14 Canvas.Center (rgb 220 214 206) "X"
    ]


-- A centred card that fits the box it was given, insets included. Every overlay
-- in this game used to be a fixed slab sized for a desktop window, which on a
-- phone put its own edges off the screen.
cardRect : HudState -> Int -> Int -> { x : Int, y : Int, w : Int, h : Int }
cardRect hs wantW wantH =
    let
        w = min wantW (edgeR hs - edgeL hs - 24)

        h = min wantH (edgeB hs - edgeT hs - 16)
    in
    { x = (edgeL hs + edgeR hs) // 2 - w // 2
    , y = (edgeT hs + edgeB hs) // 2 - h // 2
    , w = w
    , h = h
    }


logRows : Int -> Int -> Int -> List String -> List Shape
logRows pitch x y rows =
    List.indexedMap
        (\i t -> Canvas.text x (y + i * pitch) 10 Canvas.Left (rgb 205 200 196) t)
        rows


-- ===== help =====


drawHelp : HudState -> List Shape
drawHelp hs =
    let
        c = cardRect hs 480 340

        cx = c.x + c.w // 2

        -- The manual is where the game teaches its own rules, and every line of
        -- it named a key. On a phone that is not a manual, it is a list of
        -- things you cannot do. Two manuals now, one per machine, and the touch
        -- one describes the controls that actually exist there.
        left =
            if hs.touch then
                [ "TAP a unit or building  select"
                , "DRAG on the map  box select"
                , "TAP the ground  move there"
                , "TAP an enemy  attack it"
                , "ATTACK  aim, then tap a target"
                , "STOP / HOLD  in the panel below"
                , "CLEAR  drop the selection"
                , "SET RALLY  then tap the spot"
                , "The tab on the right edge"
                , "opens and closes the sidebar."
                ]

            else
                [ "LEFT CLICK  select / order"
                , "DRAG  box select"
                , "A + CLICK  attack move"
                , "S STOP    G HOLD"
                , "SHIFT+1..5  assign group"
                , "1..5  recall group"
                , "Q  select army on screen"
                , "E  cycle production"
                , "ARROWS / WHEEL  scroll"
                , "SPACE  jump to last alert"
                ]

        right =
            if hs.touch then
                [ "MENU  pause, speed, sound,"
                , "this manual, the campaign log,"
                , "restart and abandon."
                , "The minimap jumps the camera;"
                , "drag it to keep scrolling."
                , "BUILD / UNITS  the two tabs"
                , "Tap a card, then tap the map."
                , "Capture derelicts with"
                , "your engineer; sappers"
                , "repair your buildings."
                ]

            else
                [ "B  structures tab + hotkeys"
                , "T  units tab + hotkeys"
                , "V + CLICK  fire superweapon"
                , "MINUS / EQUAL  game speed"
                , "P  pause    M  music    N  effects"
                , "ESC  cancel / menu"
                , "Capture derelicts with"
                , "your engineer; sappers"
                , "repair your buildings."
                , "RIGHT-CLICK  order / cancel"
                ]
    in
    List.concat
        [ [ rect c.x c.y c.w c.h (rgba 18 15 18 240)
          , rect c.x c.y c.w 3 (rgb 255 214 120)
          , Canvas.text cx (c.y + 30) 15 Canvas.Center (rgb 235 225 210) "FIELD MANUAL"
          ]
        , List.indexedMap (\i t -> helpLine c.x c.y i True t) left
        , List.indexedMap (\i t -> helpLine c.x c.y i False t) right
        , closeGlyph c
        , [ Canvas.text cx (c.y + c.h - 18) 10 Canvas.Center (rgb 150 145 150)
                (if hs.touch then "tap to close" else "H closes")
          ]
        ]


helpLine : Int -> Int -> Int -> Bool -> String -> Shape
helpLine x0 y0 i left textStr =
    Canvas.text (if left then x0 + 24 else x0 + 250) (y0 + 56 + modBy 10 i * 24) 11 Canvas.Left
        (rgb 210 205 200) textStr
