-- --- meridian engine (mission 5, finale): "aeolian weight". F natural minor
-- and only F natural minor -- F G Ab Bb C Db Eb -- from step 0 to step 383.
-- There is no E natural anywhere, so there is no dominant and no leading tone:
-- the cadence is always bVII to i. That is what keeps this off m1's ground,
-- which is a D minor war drum with a real A7 in it.
--
-- The finale as MASS rather than as speed. The other four themes are a
-- fanfare, a cold line that never resolves, a flat pulse and a fast attack;
-- this one moves in half notes, every lead note is 2 to 7 steps long, and
-- there is not one sixteenth-note run in the piece. The tempo grid is
-- untouched -- the note lengths do the work.
--
-- The theme is six bars: Ab4-C5, a rise of a minor sixth into F5 held seven
-- steps, then a sigh onto Eb5; a fall (C5 Bb4 Ab4 F4); a lift over Db; a climb;
-- the Ab5 peak in bar 7 braced by a third underneath; and a cadence bar that
-- walks home. It is stated twice, bars 3-8 and 15-20, note for note -- but at
-- bar 16 the counter order disagrees with the lead order by one index, so the
-- second statement is re-harmonised without the tune changing a note.
--
-- The counter has it FIRST. Bars 1 and 2 are the theme an octave down, low and
-- alone over the F pedal, before the lead has ever been heard, so bar 3 is the
-- lead TAKING it rather than starting it; the same low statement returns at
-- bar 13, the one hole, under a drum break with no lead over it.
--
-- Counterpoint is composed, not collided into: m5CounterOrder and m5LeadOrder
-- are the same list except at bar 16, so every sounding lead pattern meets the
-- one counter pattern written against it. Where it shadows it runs a third or
-- a sixth below and BREAKS the parallel by walking while the lead holds (bar 3:
-- the lead holds F5 seven steps while the counter walks Db5, Bb4, Ab4 -- one
-- held note producing a third, a fifth and a sixth in turn). Where the tune
-- leans it drops the shadow entirely: bars 5/12/17/22 put Eb4 under Db5, a
-- minor seventh, and bars 9/14/21 open into fourths and fifths. Measured over
-- the loop: 57.2% thirds and sixths, 28.4% unison/fourths/fifths, 14.4%
-- seconds and minor sevenths, and not one octave doubling in 285 shared steps,
-- so the counter is always audible as its own pitch.
--
-- The bass gains notes exactly once. It is half notes for 22 bars; at 19 and
-- 20 -- the peak of the second statement and its cadence -- it goes to straight
-- eighths, F Ab C F C Ab F C, the same three chord tones it has been holding,
-- now running. The machine coming up to speed is the form, not an effect, and
-- it lasts 4.8 seconds out of 57.6.
--
-- The whole loop is a moving floor. There is NO drum-silent bar (the thinnest,
-- bar 11, is a 28-velocity skin tick), the longest gap between drum hits
-- anywhere is 6 steps, and there is not one step in the 384 where all four
-- voices are empty. So the seam cannot bang: bar 24 is the quietest kit in the
-- piece (a 56 kick, tapering to a 16 skin on the last step) handing to bar 1's
-- 68, the same kick-on-1-and-9 skeleton one notch louder, over the same F
-- pedal, and Eb resolves to F minor across the barline.
--
-- Under gunfire: the lead never reaches 880 Hz. Its ceiling is Ab5 at 831, for
-- 10 steps of 384, and it lives between F4 and F5 the rest of the loop, so the
-- band the callouts and the phasers live in is clear for the whole 57.6 s.
-- Suggested voicing: bass Sound.Triangle 13, counter 7, lead 10.


m5Bass : Int -> List Note
m5Bass i =
    if i == 0 then
        -- the pedal. F2, twice, with a breath at each half bar
        [ nt 87 7, nt 0 1, nt 87 7, nt 0 1 ]

    else if i == 1 then
        -- i (Fm): the walking form, root and the two chord tones
        [ nt 87 6, nt 104 2, nt 87 4, nt 131 2, nt 104 2 ]

    else if i == 2 then
        -- bVI (Db)
        [ nt 69 7, nt 0 1, nt 104 6, nt 139 2 ]

    else if i == 3 then
        -- bVII (Eb)
        [ nt 78 7, nt 0 1, nt 117 6, nt 156 2 ]

    else if i == 4 then
        -- bIII (Ab)
        [ nt 104 7, nt 0 1, nt 156 6, nt 104 2 ]

    else if i == 5 then
        -- iv (Bb), bar 13 only, under the low restatement
        [ nt 117 7, nt 0 1, nt 175 4, nt 104 4 ]

    else if i == 6 then
        -- bars 19-20 ONLY: the same F chord tones, now running eighths
        [ nt 87 2, nt 104 2, nt 131 2, nt 175 2, nt 131 2, nt 104 2, nt 87 2, nt 131 2 ]

    else
        -- bar 24: the bare pedal again, for the hand-over
        [ nt 87 8, nt 0 2, nt 87 4, nt 0 2 ]


m5Counter : Int -> List Note
m5Counter i =
    if i == 0 then
        -- bars 1, 2, 13: the theme LOW and alone, before the lead exists
        [ nt 208 2, nt 262 2, nt 349 7, nt 0 1, nt 311 4 ]

    else if i == 1 then
        -- under the head: thirds, then it WALKS under the held F5
        [ nt 349 2, nt 415 2, nt 554 3, nt 466 2, nt 415 3, nt 0 2, nt 523 2 ]

    else if i == 2 then
        -- bar 4: a low arch against the falling answer, breathing where it moves
        [ nt 208 3, nt 0 2, nt 262 2, nt 349 3, nt 262 2, nt 0 1, nt 208 3 ]

    else if i == 3 then
        -- the leaning bar: Eb4 under Db5 is a minor seventh, on purpose
        [ nt 466 2, nt 554 3, nt 415 3, nt 0 1, nt 466 2, nt 311 5 ]

    else if i == 4 then
        -- the only G in the piece, and only over Eb bars
        [ nt 392 3, nt 415 3, nt 0 2, nt 349 4, nt 311 4 ]

    else if i == 5 then
        -- the peak bars: F4 under the Ab5, a third at the octave
        [ nt 415 2, nt 523 2, nt 466 4, nt 0 1, nt 349 5, nt 415 2 ]

    else if i == 6 then
        -- the cadence, the most mixed bar in the piece: fifth, seventh, thirds
        [ nt 466 3, nt 349 3, nt 0 1, nt 415 3, nt 349 2, nt 262 4 ]

    else
        -- the pedal figure: indifferent to the tune, opens into fourths
        [ nt 208 6, nt 262 4, nt 0 1, nt 233 2, nt 208 3 ]


m5Lead : Int -> List Note
m5Lead i =
    if i == 0 then
        -- bars 1, 2, 13
        [ nt 0 16 ]

    else if i == 1 then
        -- the head: a minor sixth up into F5, held seven steps, sighing to Eb5
        [ nt 415 2, nt 523 2, nt 698 7, nt 0 1, nt 622 4 ]

    else if i == 2 then
        -- the fall
        [ nt 523 3, nt 466 3, nt 415 5, nt 0 1, nt 349 4 ]

    else if i == 3 then
        -- the lift over Db
        [ nt 554 2, nt 698 6, nt 622 3, nt 0 1, nt 554 4 ]

    else if i == 4 then
        -- the climb
        [ nt 466 3, nt 523 3, nt 622 5, nt 0 1, nt 466 4 ]

    else if i == 5 then
        -- the peak: Ab5, the highest note in the loop, five steps
        [ nt 523 2, nt 622 2, nt 698 4, nt 831 5, nt 0 1, nt 698 2 ]

    else if i == 6 then
        -- the cadence: walks home to F4
        [ nt 698 3, nt 622 3, nt 523 4, nt 415 2, nt 0 1, nt 349 3 ]

    else
        -- the wide bar, all long tones
        [ nt 523 4, nt 622 4, nt 698 5, nt 0 1, nt 622 2 ]


m5Drum : Int -> List Int
m5Drum i =
