-- --- mission 2, The Silo Gambit: B minor pentatonic. Infiltration: the harmony barely moves and the pulse is distant and irregular, so its tempo never settles.
-- 86 bars, 4m35s. Movements (in bars): I 18, II 14, III 12, IV 10, V 14, VI 12, VII 6.
-- I drone, II the build, III the statement, IV the hollow, V pressure, VI the
-- wide part, VII the descent back into the drone, so bar 86 hands to bar 1
-- without a seam. The body voice runs from level 26 to 100 across those
-- seven, and with no percussion that spread is the whole architecture. ---

m2Pulse : Int -> List Note
m2Pulse i =
    if i == 0 then
        [ nt 0 16 ]

    else if i == 1 then
        [ ntv 46 2 54, nt 0 14 ]

    else if i == 2 then
        [ ntv 46 2 76, nt 0 6, ntv 62 2 76, nt 0 6 ]

    else if i == 3 then
        [ ntv 46 2 76, nt 0 14 ]

    else if i == 4 then
        [ ntv 46 2 76, nt 0 2, ntv 62 2 76, nt 0 10 ]

    else if i == 5 then
        [ nt 46 2, nt 0 6, nt 62 2, nt 0 6 ]

    else if i == 6 then
        [ nt 46 2, nt 0 2, nt 62 2, nt 0 2, nt 46 2, nt 0 6 ]

    else if i == 7 then
        [ nt 46 2, nt 0 6, nt 92 2, nt 0 6 ]

    else if i == 8 then
        [ ntv 46 2 70, nt 0 2, ntv 62 2 70, nt 0 10 ]

    else if i == 9 then
        [ ntv 46 2 70, nt 0 6, ntv 62 2 70, nt 0 6 ]

    else if i == 10 then
        [ ntv 46 2 70, nt 0 14 ]

    else
        [ ntv 46 2 42, nt 0 14 ]

