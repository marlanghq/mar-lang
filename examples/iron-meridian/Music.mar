module Music exposing (missionTheme, skirmishThemeCount)

import Sound


-- IRON MERIDIAN: the mission music.
--
-- The engine and the first four themes were lifted note for note from another
-- game of ours, a space shooter that lives outside this repository; only the
-- names changed on the way in. The fifth, for Meridian Engine, was written
-- here. Every note in this file is original.
--
-- Written the way a tracker is written: a handful of 16-step PATTERNS per
-- voice, and an ORDER LIST saying which pattern plays in which bar. Four
-- voices run at once (bass, a counter-melody in the middle, the lead, drums)
-- and each reads a DIFFERENT order over the same bars, which is what stops the
-- whole thing turning over as one block: the drums fill where the bass is
-- still holding, the counter enters before the lead does, the lead drops out
-- for the bridge.
--
-- It keeps Sound.loop's invariant true BY CONSTRUCTION rather than by anyone
-- counting: every pattern is exactly 16 steps and every voice plays the same
-- number of bars, so the four voices cannot drift apart. A voice that summed
-- short would slide a little further out of phase on every repeat until the
-- loop was mush. A generator checks it before this file is written.
--
-- Only missionTheme escapes the module. Everything below it is private, which
-- is what lets this file keep its own noteOf without colliding with the one in
-- Sfx.mar.

stepMs : Int
stepMs = 150


type alias Note =
    { hz : Int, n : Int }


nt : Int -> Int -> Note
nt hz n =
    { hz = hz, n = n }


-- Every note gives its last 30ms back as silence, so its total is exactly
-- n * stepMs however it is shaped.
-- ONE KNOB for how loud the music sits under the game.
--
-- The balance BETWEEN the voices is set per theme, where it belongs; this
-- scales all of them together, so turning it changes the level and never the
-- mix. The drums go through it too, and that is the point: the three pitched
-- voices take a volume argument and the kit does not, so trimming only the
-- voices would leave the drums untouched and therefore louder in relative
-- terms, which is the same complaint wearing a different hat.
musicGain : Int
musicGain = 80


gained : Int -> Int
gained v =
    max 1 (v * musicGain // 100)


noteOf : Sound.Wave -> Int -> Note -> Sound
noteOf wave vol n =
    if n.hz <= 0 then
        Sound.rest (n.n * stepMs)

    else
        Sound.sequence
            [ Sound.release 60 (Sound.volume (gained vol) (Sound.tone wave n.hz (n.n * stepMs - 30)))
            , Sound.rest 30
            ]


lineOf : Sound.Wave -> Int -> List Note -> Sound
lineOf wave vol notes =
    Sound.sequence (List.map (noteOf wave vol) notes)


-- The middle voice sits behind the lead: softer, rounder, and cut short so it
-- reads as accompaniment rather than as a second tune fighting the first.
counterNote : Int -> Note -> Sound
counterNote vol n =
    if n.hz <= 0 then
        Sound.rest (n.n * stepMs)

    else
        Sound.sequence
            [ Sound.release 100 (Sound.duty 25 (Sound.volume (gained vol) (Sound.tone Sound.Square n.hz (n.n * stepMs - 40))))
            , Sound.rest 40
            ]


counterOf : Int -> List Note -> Sound
counterOf vol notes =
    Sound.sequence (List.map (counterNote vol) notes)


-- the lead breathes: a slow vibrato and a narrow pulse to cut through
leadNote : Int -> Note -> Sound
leadNote vol n =
    if n.hz <= 0 then
        Sound.rest (n.n * stepMs)

    else
        Sound.sequence
            [ Sound.release 80
                (Sound.vibrato 18 6
                    (Sound.duty 40 (Sound.volume (gained vol) (Sound.tone Sound.Square n.hz (n.n * stepMs - 30))))
                )
            , Sound.rest 30
            ]


leadOf : Int -> List Note -> Sound
leadOf vol notes =
    Sound.sequence (List.map (leadNote vol) notes)


-- One drum step, always exactly stepMs long. Over 50 is a kick, under is skin.
--
-- The two halves are NOT on the same scale, and that was a real mistake: the
-- kick took a 28-point discount off its written value and the snare took none,
-- so a snare written 50 came out louder than a kick written 66 (which plays at
-- 38). The skin was the loudest thing in the mix. It is scaled to a bit under
-- half now, and the noise is cut lower so the hats sizzle instead of hissing:
-- 5200 Hz left most of the harshness in, and that band is exactly where a
-- phaser shot lives, so the drums were also fighting the gunfire.
drumHit : Int -> Sound
drumHit v =
    if v <= 0 then
        Sound.rest stepMs

    else if v > 50 then
        Sound.sequence
            [ Sound.volume (gained (v - 28)) (Sound.sweep 45 (Sound.tone Sound.Triangle 160 80))
            , Sound.rest (stepMs - 80)
            ]

    else
        Sound.sequence
            [ Sound.volume (gained (max 3 (v * 42 // 100)))
                (Sound.highCut 3000 (Sound.lowCut 260 (Sound.tone Sound.Noise 0 45)))
            , Sound.rest (stepMs - 45)
            ]


drumLine : List Int -> Sound
drumLine hits =
    Sound.sequence (List.map drumHit hits)


arrange : (Int -> List a) -> List Int -> List a
arrange pat order =
    List.concat (List.map pat order)


-- --- mission 1, Dust and Iron: D minor at 100 BPM (150 ms steps, 24 bars, a 58-second loop). Form: a two-bar G#dim7 fanfare on the Ab-D tritone (1-2), statement and answer (3-6), the war-bar and a real A7 cadence with the leading tone and E natural (7-8), an octave-up pass that the A7 lands on deceptively as Bb (9-10), a bridge that drops to Bb-C major and puts the hook over foreign harmony (11-13), one bar of drums alone on a break pattern heard nowhere else (14), a chromatic climb A2-C#3 in accelerating 16ths that holds the leading tone to the barline (15), then a restatement where the counter doubles the hook an octave below the lead and the bass walks Bb-C-D (16-19), a gallop peak on the dim7 bar (20-22), a C-augmented tension bar (23) and the climb again into bar 1. The hook is the rising fourth D4-G4: the held G is braced by a bass that moves underneath it, Dm to Bb to Gm, so the 11th turns into a root instead of hanging; the answer C4-F4-Eb4 leans the flat second down into the next tonic every single time; and from its second statement onward the hook sours its A to Ab against an Ab bass, so the part a player hums carries the tritone rather than leaving it to the connective bars. I disagreed with two notes. I did not exile bars 1-2 into a one-shot intro: the cure for a dead loop seam is to make bar 1 the biggest hit in the piece (the tritone fanfare at full weight, sparse drums, kick pushed to step 7) so bar 24's crescendo lands on an impact, not to hide it. And I left the E-natural call figure identical at bars 15 and 24 on purpose: it is the only dominant in the piece, and a fixed launch gesture is what makes a restatement read as an arrival instead of a repeat. ---

