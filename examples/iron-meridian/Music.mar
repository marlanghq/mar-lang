-- The theme for a mission, 1 to 5. Skirmish draws a number in this range
-- once when it starts and passes it here, so a skirmish sounds like one of
-- the campaign missions rather than needing a sixth piece of music.
missionTheme : Int -> Sound
missionTheme m =
    if m == 1 then
        -- Dust and Iron
        Sound.chord
            [ pulseOf 31 (arrange m1Pulse m1PulseOrder)
            , subOf 520 22 (arrange m1Sub m1SubOrder)
            , bodyOf 1600 31 (arrange m1Body m1BodyOrder)
            , airOf 2100 22 (arrange m1Air m1AirOrder)
            ]

    else if m == 2 then
        -- The Silo Gambit
        Sound.chord
            [ pulseOf 26 (arrange m2Pulse m2PulseOrder)
            , subOf 460 21 (arrange m2Sub m2SubOrder)
            , bodyOf 1300 29 (arrange m2Body m2BodyOrder)
            , airOf 1800 21 (arrange m2Air m2AirOrder)
            ]

    else if m == 3 then
        -- Static
        Sound.chord
            [ pulseOf 22 (arrange m3Pulse m3PulseOrder)
            , subOf 420 21 (arrange m3Sub m3SubOrder)
            , bodyOf 1100 30 (arrange m3Body m3BodyOrder)
            , airOf 1500 24 (arrange m3Air m3AirOrder)
            ]

    else if m == 4 then
        -- Scrap Truce
        Sound.chord
            [ pulseOf 33 (arrange m4Pulse m4PulseOrder)
            , subOf 560 22 (arrange m4Sub m4SubOrder)
            , bodyOf 1800 31 (arrange m4Body m4BodyOrder)
            , airOf 2300 22 (arrange m4Air m4AirOrder)
            ]

    else
        -- Meridian Engine, and the fallback for any number outside 1..5,
        -- which is what skirmish rides on when its draw lands here.
        Sound.chord
            [ pulseOf 26 (arrange m5Pulse m5PulseOrder)
            , subOf 600 18 (arrange m5Sub m5SubOrder)
            , bodyOf 1500 34 (arrange m5Body m5BodyOrder)
            , airOf 1900 23 (arrange m5Air m5AirOrder)
            ]


-- how many themes there are to draw from, so the draw and the table
-- cannot disagree
skirmishThemeCount : Int
skirmishThemeCount = 5
