-- --- mission 4, Scrap Truce: A minor pentatonic, and the one that moves: the heaviest pulse, the most harmonic motion, the most open filters.
-- 80 bars, 4m16s. Movements (in bars): I 12, II 12, III 12, IV 8, V 18, VI 12, VII 6.
-- I drone, II the build, III the statement, IV the hollow, V pressure, VI the
-- wide part, VII the descent back into the drone, so bar 80 hands to bar 1
-- without a seam. The body voice runs from level 30 to 100 across those
-- seven, and with no percussion that spread is the whole architecture. ---

m4Pulse : Int -> List Note
m4Pulse i =
    if i == 0 then
        [ nt 0 16 ]

    else if i == 1 then
        [ ntv 41 2 64, nt 0 6, ntv 55 2 64, nt 0 6 ]

    else if i == 2 then
        [ ntv 41 2 86, nt 0 2, ntv 55 2 86, nt 0 2, ntv 41 2 86, nt 0 2, ntv 55 2 86, nt 0 2 ]

    else if i == 3 then
        [ ntv 41 2 86, nt 0 2, ntv 55 2 86, nt 0 2, ntv 41 2 86, nt 0 2, ntv 110 2 86, nt 0 2 ]

    else if i == 4 then
        [ nt 41 2, nt 0 2, nt 55 2, nt 0 2, nt 41 2, nt 0 2, nt 55 2, nt 0 2 ]

    else if i == 5 then
        [ nt 41 1, nt 0 1, nt 55 1, nt 0 1, nt 41 1, nt 0 1, nt 55 1, nt 0 1, nt 41 1, nt 0 1, nt 55 1, nt 0 1, nt 41 1, nt 0 1, nt 55 1, nt 0 1 ]

    else if i == 6 then
        [ nt 41 2, nt 0 2, nt 55 2, nt 0 2, nt 41 2, nt 0 2, nt 110 2, nt 0 2 ]

    else if i == 7 then
        [ ntv 41 2 78, nt 0 2, ntv 41 2 78, nt 0 2, ntv 55 2 78, nt 0 2, ntv 55 2 78, nt 0 2 ]

    else if i == 8 then
        [ ntv 41 2 78, nt 0 2, ntv 55 2 78, nt 0 2, ntv 41 2 78, nt 0 2, ntv 55 2 78, nt 0 2 ]

    else if i == 9 then
        [ ntv 41 2 78, nt 0 6, ntv 55 2 78, nt 0 6 ]

    else
        [ ntv 41 2 58, nt 0 6, ntv 55 2 58, nt 0 6 ]

