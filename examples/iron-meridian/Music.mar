module Music exposing (missionTheme, skirmishThemeCount)

import Sound


-- IRON MERIDIAN: the mission music.
--
-- Five war beds, each past four minutes. Four voices: a war pulse, a sub, a
-- body, and a soft top. No percussion in the drum sense, no melody, and nothing
-- written above 392 Hz.
--
-- It took three passes to find, and each pass was wrong in a way worth writing
-- down, because each wrong turn is a thing that sounds reasonable in the
-- abstract:
--
--   A kit and a horn. The kit put a transient in the mix every half second and
--   the horn read as a voice asking for attention. Both thrown out whole.
--
--   Then no percussion at all, and heavily filtered. That fixed the noise and
--   created two new problems: it was too quiet to register, and with nothing
--   marking time it did not read as a war game. "Too quiet" turned out not to
--   mean too low -- it meant too FILTERED. The same note at 130 Hz with its
--   ceiling at 620 is a hum; at 1600 it has weight, and it is still 130 Hz.
--   Presence is harmonic content, not register.
--
--   Then tension written as DISSONANCE -- a held tritone, a flat ninth. A
--   listener heard it as weird rather than as tense, and was right. Measured,
--   14.9% of that version's interval time was minor seconds, tritones and major
--   sevenths.
--
-- What the pieces are built on now:
--
--   THE PENTATONIC. Every piece is a minor pentatonic and nothing else. A minor
--   pentatonic contains no semitone and no tritone between any two of its five
--   notes, so the intervals that read as weird cannot occur -- not by care, by
--   construction. All five measure 0.0% harsh, and the generator refuses to
--   write this file if any of them rises above 2%.
--
--   That rule came out of a single note. An earlier attempt used Bb as a "dark
--   minor sixth" over D, and Bb is a semitone from A -- which was the fifth in
--   three of the four voices. Every Bb was a latent semitone waiting for a bar
--   where the other voice held its A. Sixteen seconds of major seventh in one
--   piece, from one note that looked harmless.
--
--   THE PULSE, which is not a drum: a pitched low tone that sweeps down half an
--   octave and rings out, so it lands as an impact settling rather than a click.
--   It carries no noise and its ceiling is 760 Hz, so it cannot be harsh. It
--   enters and leaves as a MOVEMENT device -- absent in the drone, marching in
--   the pressure section, gone again in the hollow -- which is what makes it
--   read as a formation arriving rather than as a metronome. Verified as real:
--   the loudness envelope of a marching passage peaks at 1.25 Hz, one impact
--   every 800 ms, well clear of its neighbours.
--
--   THE FORM. Seven movements per piece, each with its own dynamic LEVEL as
--   well as its own patterns and its own pulse density. The last movement ends
--   where the first begins, so the loop seam has nothing to announce; measured,
--   the seams land within 8% of level, end against start.
--
-- Measured over the five: 4m10s to 4m42s each; loudness spread 7.7x to 12.6x
-- between each piece's quietest and loudest passages; 27% to 39% of every piece
-- below its own average; 0.96 to 2.04 note events a second. A-weighted, which
-- is how an ear weighs it rather than how a meter does, 20% to 44% of each piece
-- sits under 100 Hz and 41% to 77% in the 100-300 Hz band that a laptop speaker
-- actually reproduces. Raw energy says 65-88% under 100 Hz, and that reading is
-- what nearly caused a fifth pass to fix something that was not broken: at 44 Hz
-- A-weighting is about -30 dB, so unweighted energy exaggerates the bottom by
-- roughly fourfold and answers a question nobody asked.
--
-- Written the way a tracker is written: a handful of 16-step PATTERNS per voice
-- and an ORDER LIST saying which pattern plays in which bar. A step is 200 ms,
-- so a bar is 3.2 seconds and a whole-bar note is one sustained 3.2-second tone.
--
-- It keeps Sound.loop's invariant true BY CONSTRUCTION rather than by anyone
-- counting: every pattern is exactly 16 steps and every voice plays the same
-- number of bars, so the voices cannot drift apart. A voice that summed short
-- would slide further out of phase on every repeat until the loop was mush. A
-- generator checks that, the interval budget and the three-minute floor before
-- this file is written.
--
-- Only missionTheme escapes the module. Everything below it is private, which
-- is what lets this file keep its own note builders without colliding with the
-- ones in Sfx.mar.

stepMs : Int
stepMs = 200


type alias Note =
    { hz : Int, n : Int, v : Int }


-- `v` is the note's level as a percent of its voice's own volume, and with no
-- percussion it is the ONLY dynamic there is. The drone movements play at 34 to
-- 50, the pressure movements at 100. Without it the only way to get softer
-- would be to stop playing, and an arrangement whose one dynamic is on/off is
-- the flat wall this rewrite exists to avoid.
nt : Int -> Int -> Note
nt hz n =
    { hz = hz, n = n, v = 100 }


ntv : Int -> Int -> Int -> Note
ntv hz n v =
    { hz = hz, n = n, v = v }


-- One multiply, one divide: keeping the voice volume and the note level
-- together until the end stops integer truncation from flattening the soft
-- end, where two levels a fifth apart would otherwise round to the same value.
level : Int -> Int -> Int
level vol v =
    max 1 (vol * v * musicGain // 10000)


-- ONE KNOB for how loud the whole bed sits under the game. The balance BETWEEN
-- the voices is set per theme, where it belongs; this scales all of them
-- together, so turning it changes the level and never the mix.
musicGain : Int
musicGain = 96


-- Every voice is a triangle. That is the point rather than a shortcut: a
-- sawtooth or a pulse puts energy in the harmonics that make a sustained tone
-- read as an instrument playing AT you, and the previous pass proved it. A
-- triangle's harmonics fall off as 1/n squared, so what is left after the
-- ceiling below is close to a sine with a little body.
--
-- The three differ by register and by how much of their own top survives, which
-- is what keeps them separable without any of them being bright:
--
--   sub   the floor. 41-110 Hz, felt more than heard.
--   body  the part a small speaker actually reproduces, and the loudest of the
--         three. 110-262 Hz.
--   air   the top, and it is not a melody. 165-392 Hz, softest, whole bars.
-- The cut is passed IN rather than fixed here, because it is the loudness knob
-- that does not move the pitch. A note at 130 Hz with its ceiling at 620 is a
-- soft hum; the same note at 1600 has body and edge and is still 130 Hz. That
-- distinction is what "too quiet" turned out to mean: the pieces were not too
-- low, they were too filtered.
subOf : Int -> Int -> List Note -> Sound
subOf cut vol notes =
    Sound.sequence (List.map (voiceNote cut 900 1100 vol) notes)


bodyOf : Int -> Int -> List Note -> Sound
bodyOf cut vol notes =
    Sound.sequence (List.map (voiceNote cut 620 820 vol) notes)


airOf : Int -> Int -> List Note -> Sound
airOf cut vol notes =
    Sound.sequence (List.map (voiceNote cut 780 980 vol) notes)


-- The war pulse, and it is NOT a drum.
--
-- The kit in the first version was a synthesised kick plus a band of noise, and
-- it was the part that got thrown out whole. This is a pitched low tone that
-- sweeps down about half an octave over its own length and then rings out, so
-- what a player hears is an impact settling rather than a click: the same job a
-- war drum does, made of pitch instead of percussion. It carries no noise at
-- all, and its ceiling is low enough that it can never be harsh.
--
-- A piece that wants no pulse simply does not pass this voice.
pulseOf : Int -> List Note -> Sound
pulseOf vol notes =
    Sound.sequence (List.map (pulseNote vol) notes)


pulseNote : Int -> Note -> Sound
pulseNote vol n =
    if n.hz <= 0 then
        Sound.rest (n.n * stepMs)

    else
        Sound.sequence
            [ Sound.release (max 60 (n.n * stepMs - 90))
                (Sound.attack 22
                    (Sound.highCut 760
                        (Sound.volume (level vol n.v)
                            (Sound.sweep (max 28 (n.hz * 52 // 100))
                                (Sound.tone Sound.Triangle n.hz (n.n * stepMs - 30))
                            )
                        )
                    )
                )
            , Sound.rest 30
            ]


-- A sustained tone, shaped so it arrives and leaves without an edge.
--
-- The attack and release are long -- most of a second each -- and both are
-- clamped by the runtime to the note's own span, so a short note simply gets a
-- rounder shape rather than a clipped one. `cut` is the voice's ceiling.
--
-- The 25 ms of silence at the end of every note is what makes the invariant
-- hold: the tone is (n * stepMs - 25) long, the rest is 25, so the pair is
-- exactly n steps however the note is shaped.
voiceNote : Int -> Int -> Int -> Int -> Note -> Sound
voiceNote cut atk rel vol n =
    if n.hz <= 0 then
        Sound.rest (n.n * stepMs)

    else
        Sound.sequence
            [ Sound.release rel
                (Sound.attack atk
                    (Sound.highCut cut (Sound.volume (level vol n.v) (Sound.tone Sound.Triangle n.hz (n.n * stepMs - 25))))
                )
            , Sound.rest 25
            ]


arrange : (Int -> List a) -> List Int -> List a
arrange pat order =
    List.concat (List.map pat order)


-- --- mission 1, Dust and Iron: D minor: open fifths, a minor sixth for weight, a suspended fourth that never resolves. The style probe: the only piece with the war pulse, and the only one whose filters are open.
-- 78 bars, 4m10s. Movements (in bars): I 14, II 12, III 12, IV 8, V 14, VI 12, VII 6.
-- I drone, II the build, III the statement, IV the hollow, V pressure, VI the
-- wide part, VII the descent back into the drone, so bar 78 hands to bar 1
-- without a seam. The body voice runs from level 30 to 100 across those
-- seven, and with no percussion that spread is the whole architecture. ---

m1Pulse : Int -> List Note
m1Pulse i =
    if i == 0 then
        [ nt 0 16 ]

    else if i == 1 then
        [ ntv 37 2 62, nt 0 6, ntv 73 2 62, nt 0 6 ]

    else if i == 2 then
        [ ntv 37 2 86, nt 0 2, ntv 73 2 86, nt 0 2, ntv 37 2 86, nt 0 2, ntv 73 2 86, nt 0 2 ]

    else if i == 3 then
        [ ntv 37 2 86, nt 0 2, ntv 73 2 86, nt 0 2, ntv 55 2 86, nt 0 2, ntv 73 2 86, nt 0 2 ]

    else if i == 4 then
        [ nt 37 2, nt 0 2, nt 73 2, nt 0 2, nt 37 2, nt 0 2, nt 73 2, nt 0 2 ]

    else if i == 5 then
        [ nt 37 2, nt 0 2, nt 73 2, nt 0 2, nt 55 2, nt 0 2, nt 73 2, nt 0 2 ]

    else if i == 6 then
        [ nt 37 1, nt 0 3, nt 73 1, nt 0 3, nt 37 1, nt 0 3, nt 73 1, nt 0 1, nt 73 1, nt 0 1 ]

    else if i == 7 then
        [ ntv 37 2 76, nt 0 6, ntv 37 2 76, nt 0 2, ntv 73 2 76, nt 0 2 ]

    else if i == 8 then
        [ ntv 37 2 76, nt 0 6, ntv 73 2 76, nt 0 6 ]

    else
        [ ntv 37 2 46, nt 0 6, ntv 73 2 46, nt 0 6 ]

