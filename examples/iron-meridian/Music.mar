-- The theme for a mission, 1 to 5. Skirmish draws a number in this range
-- once when it starts and passes it here, so a skirmish sounds like one of
-- the campaign missions rather than needing a sixth piece of music.
missionTheme : Int -> Sound
missionTheme m =
    if m == 1 then
        -- Dust and Iron
        Sound.chord
            [ lineOf Sound.Sawtooth 13 (arrange m1Bass m1Order)
            , counterOf 8 (arrange m1Counter m1CounterOrder)
            , leadOf 11 (arrange m1Lead m1LeadOrder)
            , drumLine (arrange m1Drum m1DrumOrder)
            ]

    else if m == 2 then
        -- The Silo Gambit
        Sound.chord
            [ lineOf Sound.Triangle 14 (arrange m2Bass m2Order)
            , counterOf 7 (arrange m2Counter m2CounterOrder)
            , leadOf 9 (arrange m2Lead m2LeadOrder)
            , drumLine (arrange m2Drum m2DrumOrder)
            ]

    else if m == 3 then
        -- Static
        Sound.chord
            [ lineOf Sound.Square 11 (arrange m3Bass m3Order)
            , counterOf 6 (arrange m3Counter m3CounterOrder)
            , leadOf 7 (arrange m3Lead m3LeadOrder)
            , drumLine (arrange m3Drum m3DrumOrder)
            ]

    else if m == 4 then
        -- Scrap Truce
        Sound.chord
            [ lineOf Sound.Sawtooth 12 (arrange m4Bass m4Order)
            , counterOf 8 (arrange m4Counter m4CounterOrder)
            , leadOf 10 (arrange m4Lead m4LeadOrder)
            , drumLine (arrange m4Drum m4DrumOrder)
            ]

    else
        -- Meridian Engine, and the fallback for any number outside 1..5,
        -- which is what skirmish rides on when its draw lands here.
        Sound.chord
            [ lineOf Sound.Triangle 13 (arrange m5Bass m5Order)
            , counterOf 7 (arrange m5Counter m5CounterOrder)
            , leadOf 9 (arrange m5Lead m5LeadOrder)
            , drumLine (arrange m5Drum m5DrumOrder)
            ]


-- how many themes there are to draw from, so the draw and the table
-- cannot disagree
skirmishThemeCount : Int
skirmishThemeCount = 5
