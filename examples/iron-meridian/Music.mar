m5DrumOrder : List Int
m5DrumOrder =
    [ 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 2, 2, 3, 2, 2, 2, 3, 2, 2, 2, 3, 2, 4, 5
    , 4, 6, 4, 5, 4, 6, 4, 5, 4, 6, 7, 8, 7, 9, 7, 8, 7, 9, 7, 8, 7, 9, 10, 11
    , 10, 12, 10, 11, 10, 12, 10, 11, 13, 13, 14, 13, 13, 13, 14, 13, 13, 13, 15, 16, 15, 17, 15, 16
    , 15, 17, 15, 16, 15, 17, 18, 19, 20, 21, 19, 20, 21, 21
    ]


-- The theme for a mission, 1 to 5. Skirmish draws a number in this range once
-- when it starts and passes it here, so a skirmish sounds like one of the
-- campaign missions rather than needing a sixth piece of music.
missionTheme : Int -> Sound
missionTheme m =
    if m == 1 then
        -- Dust and Iron
        Sound.chord
            [ bassOf Sound.Sawtooth 26 (arrange m1Bass m1BassOrder)
            , counterOf 17 (arrange m1Counter m1CounterOrder)
            , leadOf 22 (arrange m1Lead m1LeadOrder)
            , drumLine 62 (arrange m1Drum m1DrumOrder)
            ]

    else if m == 2 then
        -- The Silo Gambit
        Sound.chord
            [ bassOf Sound.Triangle 28 (arrange m2Bass m2BassOrder)
            , counterOf 15 (arrange m2Counter m2CounterOrder)
            , leadOf 19 (arrange m2Lead m2LeadOrder)
            , drumLine 54 (arrange m2Drum m2DrumOrder)
            ]

    else if m == 3 then
        -- Static
        Sound.chord
            [ bassOf Sound.Square 24 (arrange m3Bass m3BassOrder)
            , counterOf 14 (arrange m3Counter m3CounterOrder)
            , leadOf 17 (arrange m3Lead m3LeadOrder)
            , drumLine 58 (arrange m3Drum m3DrumOrder)
            ]

    else if m == 4 then
        -- Scrap Truce
        Sound.chord
            [ bassOf Sound.Sawtooth 25 (arrange m4Bass m4BassOrder)
            , counterOf 13 (arrange m4Counter m4CounterOrder)
            , leadOf 21 (arrange m4Lead m4LeadOrder)
            , drumLine 60 (arrange m4Drum m4DrumOrder)
            ]

    else
        -- Meridian Engine, and the fallback for any number outside 1..5,
        -- which is what skirmish rides on when its draw lands here.
        Sound.chord
            [ bassOf Sound.Sawtooth 27 (arrange m5Bass m5BassOrder)
            , counterOf 17 (arrange m5Counter m5CounterOrder)
            , leadOf 22 (arrange m5Lead m5LeadOrder)
            , drumLine 62 (arrange m5Drum m5DrumOrder)
            ]


-- how many themes there are to draw from, so the draw and the table cannot
-- disagree
skirmishThemeCount : Int
skirmishThemeCount = 5
