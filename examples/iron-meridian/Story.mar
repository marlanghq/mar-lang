module Story exposing (..)


-- IRON MERIDIAN: campaign text.
--
-- WHAT THIS FILE LEARNED, TWICE.
--
-- The first lesson was that the premise has to be ON SCREEN. It used to live
-- in a comment up here, so the player reached mission 1 not knowing the
-- planet, the year, or which of the names being shouted was their own side.
--
-- The second lesson, and the reason this is a rewrite: a story can be fully
-- explained and still be hard to follow. The old version had it all on screen
-- and was still confusing, because it asked the player to hold too much at
-- once. Nine proper nouns before the first shot. Two words for the same army
-- (Compact and Wardens). Place names nobody needed (Tharsis, Coprates,
-- Erebus). Four characters with first and last names. And sentences that were
-- trying to sound good instead of trying to be understood.
--
-- So the rules are now:
--
--   * PLAIN WORDS. The Colony and the Scrappers, not the Compact and the Iron
--     Combine. The machines, not the Chorus. If a word needs a glossary, it
--     is the wrong word.
--   * NO PLACE NAMES the player cannot see. "The canyons", not "the Coprates
--     canyon belt". A name earns its place only when it labels something on
--     screen (Genesis Font is on a building, so it stays).
--   * SHORT SENTENCES, concrete nouns, no metaphors. Nobody eats their pride
--     and nothing folds its old lungs into a grid.
--   * FOUR VOICES, each labelled with its job, so the player never has to
--     remember who is who.
--   * A briefing is four or five lines. What is happening, then what to do.
--   * The reveal still arrives in three parts (missions 3, 4, 5), and each
--     part restates the one before, because repetition is what makes a thing
--     stick.
--
-- The plot in five lines, which is the whole test: two sides fight over
-- scrap. Machines come out of the ground. The machines are older than the
-- colony. They run the buried machine that keeps the air breathable. They
-- have decided to wipe the surface clean, and you have to stop that without
-- breaking the thing everyone needs.
--
-- Voices:
--   YOU      the player's commander
--   OKO      your engineer, notices things
--   COMMAND  your boss, sure of himself and wrong
--   KESK     leader of the Scrappers, enemy then ally
--   MACHINES the third side, speaking as a group


type alias Line =
    { who : Int              -- 0 YOU, 1 OKO, 2 COMMAND, 3 KESK, 4 MACHINES, 5 MISSION
    , text : String
    }


-- The label carries the JOB, not a name to memorise. A first-time player had
-- no way to tell that Voss was their commanding officer and Kesk was the
-- enemy: both were capitalised surnames shouting at them.
speakerName : Int -> String
speakerName who =
    case who of
        0 -> "YOU"
        1 -> "OKO / YOUR ENGINEER"
        2 -> "COMMAND / YOUR BOSS"
        3 -> "KESK / THE SCRAPPERS"
        4 -> "THE MACHINES"
        _ -> "MISSION"


missionTitle : Int -> String
missionTitle m =
    case m of
        1 -> "THE SCRAPFIELDS"
        2 -> "THE SILOS"
        3 -> "THE ICE OUTPOST"
        4 -> "SAVE THE CITY"
        _ -> "THE ENGINE"


missionPlace : Int -> String
missionPlace m =
    case m of
        1 -> "The scrapfields"
        2 -> "The canyons, six days later"
        3 -> "An outpost on the northern ice"
        4 -> "The Scrapper city"
        _ -> "The crater on the ridge"


-- ===== the premise, on screen, once =====
--
-- Shown before mission 1. Where, when, what went wrong, who is who, who you
-- are. Nothing later in the campaign assumes anything this screen does not
-- say, and it says it in about a hundred words.
prologue : List String
prologue =
    [ "MARS. THE YEAR IS 2231."
    , ""
    , "People have lived here for a hundred years. The air is thin"
    , "and cold, but you can breathe it."
    , ""
    , "Eleven years ago Earth stopped answering. No warning, no"
    , "last message. No ship has come since."
    , ""
    , "Two sides were left holding the planet."
    , ""
    , "THE COLONY. The old government. Its army is yours: you are"
    , "the commander."
    , ""
    , "THE SCRAPPERS. Towns that broke away after Earth went quiet."
    , "No cities, just crawlers and salvage. Kesk leads them."
    , ""
    , "There is also something under the ground. You have not met"
    , "it yet."
    , ""
    , "The war starts over scrap metal. It does not stay there."
    ]


-- ===== one sentence of what just happened =====
--
-- Drawn at the top of every briefing from mission 2 on. The campaign is
-- played over several evenings, and without this the player opens mission 4
-- with no idea why they are suddenly fighting alongside the enemy.
recap : Int -> String
recap m =
    case m of
        2 -> "LAST TIME: raiders hit one of our convoys, you burned their camp down, and Oko pulled a strange piece of metal out of the wreck. It hums."

        3 -> "LAST TIME: you took three silos in the canyons. The rock under them glows, and it is not ore."

        4 -> "LAST TIME: machines came up out of the ice. They are not from a ship. You destroyed the one that was jamming the outpost."

        5 -> "LAST TIME: you disobeyed your boss to save Kesk's city from the machines. She said she would tell you what is buried under the ridge, and she did."

        _ -> ""


briefing : Int -> List Line
briefing m =
    case m of
        1 ->
            [ { who = 5, text = "One of our supply convoys was ambushed in the scrapfields this morning. The survivors are stranded and the road north is cut." }
            , { who = 2, text = "Raiders took the convoy at dawn, Commander. Go out there and reopen the road." }
            , { who = 1, text = "Oko here. The convoy crew can build. Give me a refinery and I will have money coming in before the raiders come back." }
            , { who = 2, text = "Build your base first, then burn the raider camp off the north ridge." }
            , { who = 3, text = "Kesk speaking. Those raiders are my people and these fields feed us. Go home." }
            , { who = 0, text = "Keep off our convoys and we can both live. Dig in." }
            ]

        2 ->
            [ { who = 5, text = "Five sealed mining silos in the canyons still work. Whoever captures one gets what it pumps. The Scrappers are moving on them now." }
            , { who = 2, text = "Take three silos and hold them, Commander." }
            , { who = 1, text = "Walk an engineer up to a silo door and it opens for us. Free money, nobody to pay." }
            , { who = 2, text = "Then break Kesk's forward base and end the argument." }
            , { who = 1, text = "One thing. That piece of metal from the convoy. It hums louder the closer we get to this canyon." }
            , { who = 2, text = "Rock does not hum, Engineer. Move." }
            ]

        3 ->
            [ { who = 5, text = "Our outpost on the northern ice has been silent for 31 hours. The last thing it sent was a tone, repeating. Nothing human makes that sound." }
            , { who = 1, text = "Same note as my piece of metal. Same beat, over and over. That is a clock, Commander, and something is winding it." }
            , { who = 0, text = "Survivors first. Theories later." }
            , { who = 5, text = "WARNING: machines are climbing OUT OF the ice. No ships. No landing burn." }
            , { who = 1, text = "They did not arrive. They were already down there. They carry shields, so bring rockets." }
            , { who = 4, text = "YOU WOKE THE CLOCK. WE KEEP THE CLOCK." }
            , { who = 0, text = "Find our people, kill whatever is jamming us, and bring me one of those things." }
            ]

        4 ->
            [ { who = 5, text = "The Scrapper city is being torn apart by the same machines from the ice. Kesk is asking us for help." }
            , { who = 3, text = "Kesk. This hurts to say. They come up through the floor and my walls do nothing." }
            , { who = 2, text = "Denied. The Scrappers walked out on us. Hold position." }
            , { who = 0, text = "Those machines took an outpost in one night. If that city falls they own the south, and then they are at our door." }
            , { who = 2, text = "I said no, Commander." }
            , { who = 0, text = "Then write me up. Oko, move the army. Today we fight next to Kesk." }
            , { who = 1, text = "Two of those things sit down and grow all the rest. The name on their shell is Genesis Font. Kill both and the attack stops." }
            , { who = 3, text = "Do this and I will tell you what is buried under the ridge, and why Earth wanted it buried." }
            ]

        _ ->
            [ { who = 5, text = "The crater on the ridge is awake. A machine the size of a city is charging up, and it is pointed at every town we have." }
            , { who = 3, text = "Here is what I owe you. We found it first, and that is why we broke away. It is called the Engine." }
            , { who = 1, text = "And it is not a weapon. It is what keeps the air breathable. It has been running alone for eleven years. The machines look after it, and they think we are damaging it." }
            , { who = 4, text = "THE SURFACE IS UNSTABLE. THE CLOCK WILL BE CLEANED." }
            , { who = 0, text = "Cleaned means us. So we do not touch the Engine, because without it we all suffocate. We break the four towers feeding the blast instead." }
            , { who = 3, text = "Fair warning. Half my people want the whole thing destroyed and they will shoot at you to get there. Watch your east." }
            , { who = 2, text = "Commander. I was wrong about the rock. Do not make me wrong about you. Go." }
            ]


-- short in-mission radio lines, surfaced through the alert feed
radio : Int -> Int -> String
radio m idx =
    case m of
        1 ->
            case idx of
                0 -> "Kesk: Last warning. Leave the fields."
                1 -> "Oko: Raider camp is on the north ridge. Burn it and the road opens."
                _ -> "Oko: That metal from the wreck is still humming."

        2 ->
            case idx of
                0 -> "Oko: Silo is ours. Money coming in."
                1 -> "Command: Hold those silos, Commander."
                _ -> "Oko: The canyon floor is full of light. That is not ore."

        3 ->
            case idx of
                0 -> "Oko: Survivors are aboard. Patching their suits."
                1 -> "Oko: Another wave off the tone. Brace."
                _ -> "Machines: WE KEEP THE CLOCK."

        4 ->
            case idx of
                0 -> "Kesk: My walls thank you."
                1 -> "Kesk: Push east and I will hold the west."
                _ -> "Oko: Two flags, one wall. I like it."

        _ ->
            case idx of
                0 -> "Oko: Blast charging. MOVE the army."
                1 -> "Kesk: My rogues are shooting at everyone. I did warn you."
                _ -> "Command: Everyone is watching, Commander. Finish it."


victoryText : Int -> List String
victoryText m =
    case m of
        1 ->
            [ "The raider camp is burning and the road north is open"
            , "again."
            , ""
            , "In the wreck, Oko finds a piece of metal that came from"
            , "no factory we know. It hums, very quietly, and it hums"
            , "toward the east."
            ]

        2 ->
            [ "Three silos are ours and the Scrappers pull out of the"
            , "canyons."
            , ""
            , "At the bottom of the sinkhole, lines of light run to the"
            , "horizon. Command files it as a rock formation."
            , "Oko does not."
            ]

        3 ->
            [ "The jammer is down and the static clears off the ice."
            , "Our people are alive, and they all say the same thing:"
            , "the machines came up out of the ground."
            , ""
            , "So they were here before us. Older than the colony,"
            , "older than the terraforming. And they are counting"
            , "something."
            ]

        4 ->
            [ "The siege breaks. A Scrapper city keeps its walls"
            , "because our armour was standing on them, and Kesk pays"
            , "what she promised."
            , ""
            , "There is a machine under the ridge. It is what keeps"
            , "the air breathable. Earth knew, and Earth's last order"
            , "was to bury it and say nothing."
            , ""
            , "Eleven years of silence, and that was the secret."
            ]

        _ ->
            [ "The four towers are down. The charge drains away into"
            , "the sand, and the Engine goes back to the only job it"
            , "ever had: keeping Mars breathing."
            , ""
            , "For the first time in eleven years, something answers"
            , "a call. The machines agree to talk."
            , ""
            , "On the crater rim three flags stand in the same thin"
            , "wind: ours, the Scrappers', and one nobody can name."
            , ""
            , "IRON MERIDIAN. Thank you for playing."
            ]


defeatText : Int -> List String
defeatText m =
    case m of
        3 ->
            [ "The ice goes quiet again, and this time nothing answers"
            , "at all. Regroup and try once more."
            ]

        _ ->
            [ "The line breaks and the ground is theirs."
            , "Regroup, Commander. Try again."
            ]


-- ===== the log =====
--
-- Everything above is shown once and then gone forever, which is fine for a
-- film and wrong for a game played across several evenings. `L` opens this
-- during a mission: who the three sides are, who is talking to you, and where
-- the story currently stands.
logFactions : List String
logFactions =
    [ "THE COLONY (blue). The old government, and your side."
    , "You command its army."
    , ""
    , "THE SCRAPPERS (rust). Towns that broke away after Earth"
    , "went quiet. They live off salvage. Kesk leads them."
    , ""
    , "THE MACHINES. They live under the ground and were here"
    , "before the colony. They look after the Engine, the buried"
    , "machine that keeps the air breathable."
    ]


logCast : List String
logCast =
    [ "YOU. The commander of the Colony's army."
    , "OKO. Your engineer. Notices things."
    , "COMMAND. Your boss. Sure of himself."
    , "KESK. Leader of the Scrappers. Enemy, then ally."
    ]


-- Where the story stands as of the mission being played, in one or two lines.
logSoFar : Int -> List String
logSoFar m =
    case m of
        1 ->
            [ "Earth has been silent for eleven years. One of our"
            , "convoys was ambushed in the scrapfields, and the"
            , "Scrappers say the scrapfields are theirs."
            ]

        2 ->
            [ "The raiders are gone. Oko is carrying a piece of metal"
            , "from the wreck. It hums, and it hums louder the"
            , "further east you go."
            ]

        3 ->
            [ "The canyons are full of light that is not ore, and an"
            , "outpost on the ice has gone silent while broadcasting"
            , "the same note as Oko's piece of metal."
            ]

        4 ->
            [ "The machines came up out of the ice, not out of a ship."
            , "Now they are tearing apart the Scrapper city, and Kesk"
            , "is asking you for help."
            ]

        _ ->
            [ "Under the ridge there is a machine called the Engine."
            , "It is what keeps Mars breathable. Earth ordered it"
            , "buried. The machines that look after it have decided"
            , "the surface needs cleaning."
            ]
