module Maps exposing (..)


import Types exposing (..)
import Balance exposing (..)


-- IRON MERIDIAN: the map machinery. ASCII rows parse into a tile Dict;
-- terrain pre-merges into per-row color runs (drawn by View at any tile
-- scale); BFS distance fields drive group movement; fog of war is an
-- incremental visibility counter with per-row draw-run caching.
--
-- Map legend:
--   .  regolith          ,  regolith variant   #  basalt (blocked)
--   ~  chasm (blocked)   i  ice                v  verdant
--   /  ramp              o  ferrite ore        O  azurite ore
--   c  crater            t  prop (blocked)     1..3  side start spots
--   E  derelict extractor (neutral, capturable)


idxOf : Int -> Int -> Int -> Int
idxOf w tx ty =
    ty * w + tx


txOf : Int -> Int -> Int
txOf w idx =
    modBy w idx


tyOf : Int -> Int -> Int
tyOf w idx =
    idx // w


-- ===== parsing =====


type alias Spot =
    { side : Int
    , tx : Int
    , ty : Int
    }


type alias Parsed =
    { w : Int
    , h : Int
    , tiles : Dict Int Int
    , ore : Dict Int Int
    , starts : List Spot
    , exts : List Spot       -- derelict extractor spots (side field unused)
    }


emptyParsed : Parsed
emptyParsed =
    { w = 0, h = 0, tiles = Dict.empty, ore = Dict.empty, starts = [], exts = [] }


tileOfChar : Char -> Int
tileOfChar ch =
    if ch == ',' then tRego2
    else if ch == '#' then tRock
    else if ch == '~' then tChasm
    else if ch == 'i' then tIce
    else if ch == 'v' then tVerdant
    else if ch == '/' then tRamp
    else if ch == 'o' then tFerrite
    else if ch == 'O' then tAzurite
    else if ch == 'c' then tCrater
    else if ch == 't' then tProp
    else tRego


parse : List String -> Parsed
parse rows =
    let
        w =
            case List.head rows of
                Just r -> String.length r
                Nothing -> 0

        h = List.length rows

        folded =
            List.foldl
                (\row a ->
                    { row = a.row + 1
                    , p = parseRow w a.row row a.p
                    }
                )
                { row = 0, p = { emptyParsed | w = w, h = h } }
                rows
    in
    folded.p


parseRow : Int -> Int -> String -> Parsed -> Parsed
parseRow w row str acc =
    let
        folded =
            List.foldl
                (\ch a ->
                    { col = a.col + 1
                    , p = parseCell w a.col row ch a.p
                    }
                )
                { col = 0, p = acc }
                (String.toList str)
    in
    folded.p


-- parseCell: store the tile, then record ore / start spots / extractors.
parseCell : Int -> Int -> Int -> Char -> Parsed -> Parsed
parseCell w tx ty ch p =
    let
        i = idxOf w tx ty
        base = { p | tiles = Dict.insert i (tileOfChar ch) p.tiles }
    in
    if ch == 'o' then
        { base | ore = Dict.insert i ferriteValue base.ore }
    else if ch == 'O' then
        { base | ore = Dict.insert i azuriteValue base.ore }
    else if ch == '1' then
        { base | starts = List.concat [ base.starts, [ { side = 1, tx = tx, ty = ty } ] ] }
    else if ch == '2' then
        { base | starts = List.concat [ base.starts, [ { side = 2, tx = tx, ty = ty } ] ] }
    else if ch == '3' then
        { base | starts = List.concat [ base.starts, [ { side = 3, tx = tx, ty = ty } ] ] }
    else if ch == 'E' then
        { base | exts = List.concat [ base.exts, [ { side = 0, tx = tx, ty = ty } ] ] }
    else
        base


-- ===== terrain draw runs =====


tileAt : Dict Int Int -> Int -> Int
tileAt tiles i =
    Maybe.withDefault tRock (Dict.get i tiles)


-- ore tiles render as regolith under separate crystal art
drawCode : Int -> Int
drawCode t =
    if t == tFerrite || t == tAzurite then tRego else t


rowTerrainRuns : Dict Int Int -> Int -> Int -> List Run
rowTerrainRuns tiles w row =
    let
        folded =
            List.foldl
                (\tx acc ->
                    let
                        c = drawCode (tileAt tiles (idxOf w tx row))
                    in
                    if c == acc.c && acc.len > 0 then
                        { acc | len = acc.len + 1 }
                    else
                        { c = c
                        , x0 = tx
                        , len = 1
                        , out =
                            if acc.len > 0 then
                                { x0 = acc.x0, w = acc.len, c = acc.c } :: acc.out
                            else
                                acc.out
                        }
                )
                { c = 0 - 1, x0 = 0, len = 0, out = [] }
                (List.range 0 (w - 1))
    in
    if folded.len > 0 then
        { x0 = folded.x0, w = folded.len, c = folded.c } :: folded.out
    else
        folded.out


buildTerrainRuns : Dict Int Int -> Int -> Int -> Dict Int (List Run)
buildTerrainRuns tiles w h =
    List.foldl
        (\row acc -> Dict.insert row (rowTerrainRuns tiles w row) acc)
        Dict.empty
        (List.range 0 (h - 1))


-- the ore tiles as a list (crystal art + minimap dots + harvest search)
oreTiles : Parsed -> List Spot
oreTiles p =
    List.foldl
        (\pair acc ->
            case pair of
                ( i, _ ) ->
                    { side = 0, tx = txOf p.w i, ty = tyOf p.w i } :: acc
        )
        []
        (Dict.toList p.ore)


-- ===== building occupancy =====


bldTiles : Bld -> List Int
bldTiles b =
    let
        w = bW b.kind
        h = bH b.kind
    in
    List.concatMap
        (\dy -> List.map (\dx -> ( b.tx + dx, b.ty + dy )) (List.range 0 (w - 1)))
        (List.range 0 (h - 1))
        |> List.map (\pr -> case pr of ( ax, ay ) -> ay * 100000 + ax)


-- occupancy grid: tile idx -> building id (ground buildings block)
bldGrid : Int -> List Bld -> Dict Int Int
bldGrid w blds =
    List.foldl
        (\b acc ->
            List.foldl
                (\packed a2 ->
                    let
                        ax = modBy 100000 packed
                        ay = packed // 100000
                    in
                    Dict.insert (idxOf w ax ay) b.id a2
                )
                acc
                (bldTiles b)
        )
        Dict.empty
        blds


-- ===== BFS distance fields =====


passableIdx : Game -> Dict Int Int -> Int -> Bool
passableIdx g occ i =
    tilePassable (tileAt g.tiles i) && Dict.get i occ == Nothing


-- bfsField: distances outward from `start`, capped so huge maps stay
-- bounded. The field maps tile idx -> distance; missing = unreachable.
bfsField : Game -> Dict Int Int -> Int -> Dict Int Int
bfsField g occ start =
    bfsGo g occ [ start ] (Dict.insert start 0 Dict.empty) 1


bfsGo : Game -> Dict Int Int -> List Int -> Dict Int Int -> Int -> Dict Int Int
bfsGo g occ frontier dist d =
    if List.isEmpty frontier || d > 140 then
        dist
    else
        let
            folded =
                List.foldl
                    (\i acc ->
                        List.foldl
                            (\n a2 ->
                                if Dict.member n a2.dist then
                                    a2
                                else if passableIdx g occ n then
                                    { dist = Dict.insert n d a2.dist
                                    , next = n :: a2.next
                                    }
                                else
                                    a2
                            )
                            acc
                            (neighbors4 g.mapW g.mapH i)
                    )
                    { dist = dist, next = [] }
                    frontier
        in
        bfsGo g occ folded.next folded.dist (d + 1)


neighbors4 : Int -> Int -> Int -> List Int
neighbors4 w h i =
    let
        tx = txOf w i
        ty = tyOf w i
    in
    List.concat
        [ if tx > 0 then [ i - 1 ] else []
        , if tx < w - 1 then [ i + 1 ] else []
        , if ty > 0 then [ i - w ] else []
        , if ty < h - 1 then [ i + w ] else []
        ]


-- flowFor: fetch or build the BFS field toward a target tile. The MRU
-- cache lives in the Game so every unit ordered to one spot shares it.
flowFor : Game -> Int -> ( Game, Dict Int Int )
flowFor g key =
    case List.head (List.filter (\f -> f.key == key) g.flows) of
        Just f ->
            ( g, f.field )

        Nothing ->
            let
                occ = bldGrid g.mapW g.blds
                field = bfsField g occ key
                kept = List.take 7 g.flows
            in
            ( { g | flows = { key = key, field = field } :: kept }, field )


-- drop every cached flow (called when buildings change the walkable grid)
dropFlows : Game -> Game
dropFlows g =
    { g | flows = [] }


-- ===== fog of war =====


sightOffsets : Int -> List Spot
sightOffsets r =
    List.concatMap
        (\dy ->
            List.filterMap
                (\dx ->
                    if dx * dx + dy * dy <= r * r + r // 2 then
                        Just { side = 0, tx = dx, ty = dy }
                    else
                        Nothing
                )
                (List.range (0 - r) r)
        )
        (List.range (0 - r) r)


-- fogDelta: add (+1) or remove (-1) one sight circle. Touched rows are
-- marked dirty; Sim rebuilds their draw runs once at end of tick.
fogDelta : Int -> Int -> Int -> Int -> Game -> Game
fogDelta dir tx ty r g =
    List.foldl
        (\off acc ->
            let
                ax = tx + off.tx
                ay = ty + off.ty
            in
            if ax < 0 || ay < 0 || ax >= acc.mapW || ay >= acc.mapH then
                acc
            else
                let
                    i = idxOf acc.mapW ax ay
                    old =
                        Maybe.withDefault 0 (Dict.get i acc.fogVis)
                    nv = old + dir
                    seen2 =
                        if dir > 0 && old == 0 then
                            Dict.insert i 1 acc.fogSeen
                        else
                            acc.fogSeen
                in
                { acc
                    | fogVis = Dict.insert i nv acc.fogVis
                    , fogSeen = seen2
                    , fogDirty = Dict.insert ay 1 acc.fogDirty
                }
        )
        g
        (sightOffsets r)


visAt : Game -> Int -> Int -> Int
visAt g tx ty =
    let
        i = idxOf g.mapW tx ty
    in
    case Dict.get i g.fogVis of
        Just v ->
            if v > 0 then 2
            else if Dict.member i g.fogSeen then 1
            else 0

        Nothing ->
            if Dict.member i g.fogSeen then 1 else 0


-- fog draw runs for one row: c = 0 solid black (never seen), 1 dim (seen)
rowFogRuns : Game -> Int -> List Run
rowFogRuns g row =
    let
        folded =
            List.foldl
                (\tx acc ->
                    let
                        v = visAt g tx row
                        c = if v == 2 then 0 - 1 else v  -- -1 = no overlay
                        code = if c == 1 then 1 else (if c == 0 then 0 else 0 - 1)
                    in
                    if code == acc.c && acc.len > 0 then
                        { acc | len = acc.len + 1 }
                    else
                        { c = code
                        , x0 = tx
                        , len = 1
                        , out =
                            if acc.len > 0 && acc.c >= 0 then
                                { x0 = acc.x0, w = acc.len, c = acc.c } :: acc.out
                            else
                                acc.out
                        }
                )
                { c = 0 - 2, x0 = 0, len = 0, out = [] }
                (List.range 0 (g.mapW - 1))
    in
    if folded.len > 0 && folded.c >= 0 then
        { x0 = folded.x0, w = folded.len, c = folded.c } :: folded.out
    else
        folded.out


-- rebuild the cached fog runs for every dirty row, then clear the set
refreshFogRows : Game -> Game
refreshFogRows g =
    if Dict.isEmpty g.fogDirty then
        g
    else
        let
            rows2 =
                List.foldl
                    (\pair acc ->
                        case pair of
                            ( row, _ ) ->
                                Dict.insert row (rowFogRuns g row) acc
                    )
                    g.fogRows
                    (Dict.toList g.fogDirty)
        in
        { g | fogRows = rows2, fogDirty = Dict.empty }


-- seed the whole-map fog cache (mission start)
initFogRows : Game -> Game
initFogRows g =
    { g
        | fogRows =
            List.foldl
                (\row acc -> Dict.insert row (rowFogRuns g row) acc)
                Dict.empty
                (List.range 0 (g.mapH - 1))
        , fogDirty = Dict.empty
    }


-- ===== placement =====


-- would this footprint sit on buildable ground?
footprintFree : Game -> Dict Int Int -> BldKind -> Int -> Int -> Bool
footprintFree g occ k tx ty =
    let
        w = bW k
        h = bH k
    in
    tx >= 1 && ty >= 1 && tx + w < g.mapW - 1 && ty + h < g.mapH - 1
        && List.all
            (\dy ->
                List.all
                    (\dx ->
                        let
                            i = idxOf g.mapW (tx + dx) (ty + dy)
                            t = tileAt g.tiles i
                        in
                        tilePassable t
                            && t /= tFerrite
                            && t /= tAzurite
                            && Dict.get i occ == Nothing
                    )
                    (List.range 0 (w - 1))
            )
            (List.range 0 (h - 1))


-- adjacency: near an own building; Vessari need lattice instead
nearOwnBase : Game -> Int -> BldKind -> Int -> Int -> Bool
nearOwnBase g side k tx ty =
    let
        cx = tx * 2 + bW k     -- footprint center in half-tiles
        cy = ty * 2 + bH k

        vessari =
            case bRace k of
                Vessari -> True
                _ -> False

        anchors =
            List.filter
                (\b ->
                    b.side == side
                        && b.prog == 0
                        && (if vessari then
                                (case b.kind of
                                    Spire -> True
                                    GenesisFont -> True
                                    _ -> False)
                            else
                                True)
                )
                g.blds

        radius =
            if vessari then latticeRadius else baseRadius
    in
    List.any
        (\b ->
            let
                bx = b.tx * 2 + bW b.kind
                by = b.ty * 2 + bH b.kind
            in
            max (abs (bx - cx)) (abs (by - cy)) <= radius * 2
        )
        anchors


canPlaceAt : Game -> Int -> BldKind -> Int -> Int -> Bool
canPlaceAt g side k tx ty =
    let
        occ = bldGrid g.mapW g.blds

        unitsClear =
            List.all
                (\u ->
                    uFly u.kind
                        || u.x // tileFx < tx
                        || u.x // tileFx >= tx + bW k
                        || u.y // tileFx < ty
                        || u.y // tileFx >= ty + bH k
                )
                g.units
    in
    footprintFree g occ k tx ty
        && unitsClear
        && nearOwnBase g side k tx ty


type alias FoundSpot =
    { ok : Bool
    , tx : Int
    , ty : Int
    }


-- spiral search around (nearTx, nearTy) for a legal placement (bot use)
findSpot : Game -> Int -> BldKind -> Int -> Int -> FoundSpot
findSpot g side k nearTx nearTy =
    findSpotGo g side k nearTx nearTy 1


findSpotGo : Game -> Int -> BldKind -> Int -> Int -> Int -> FoundSpot
findSpotGo g side k nearTx nearTy r =
    if r > 11 then
        { ok = False, tx = nearTx, ty = nearTy }
    else
        let
            ring =
                List.concatMap
                    (\dy ->
                        List.filterMap
                            (\dx ->
                                if max (abs dx) (abs dy) == r then
                                    Just { side = 0, tx = nearTx + dx, ty = nearTy + dy }
                                else
                                    Nothing
                            )
                            (List.range (0 - r) r)
                    )
                    (List.range (0 - r) r)

            hit =
                List.head
                    (List.filter (\s -> canPlaceAt g side k s.tx s.ty) ring)
        in
        case hit of
            Just s ->
                { ok = True, tx = s.tx, ty = s.ty }

            Nothing ->
                findSpotGo g side k nearTx nearTy (r + 1)
