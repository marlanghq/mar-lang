m5 : MissionDef
m5 =
    let
        w = 84
        h = 73

        parsed =
            parse (baseRows 2 w h)
                |> stampRect tChasm 56 25 20 20   -- the Engine pit
                |> stampRect tRock 53 22 25 3
                |> stampRect tRock 53 45 25 3
                |> stampLane 53 31 6 3
                |> stampOre False 11 62 3
                |> stampOre False 14 14 3
                |> stampOre True 39 39 1
                |> stampExt 28 20
                |> stampExt 31 56
    in
    { id = 5
    , name = "Meridian Engine"
    , parsed = parsed
    , sides =
        -- m5 is the finale and should feel like one, but this is a demo, not a
        -- test of RTS skill. Two knobs were out of line with the rest of the
        -- campaign: aggro 115 was the only value above 100 anywhere in the
        -- game, and a first wave at 3600 (two minutes) landed earlier than any
        -- other mission -- earlier than m4's 4200 -- on the biggest map in the
        -- game, before a refinery is paying for itself. Both are pulled back
        -- to campaign-normal. This also offsets the win condition getting its
        -- teeth back: the Prime Conduit ring used to be beatable by killing a
        -- single spire (see conduitCount in Main), and now costs all four.
        [ { id = 1, race = Compact, team = 1, human = True, aggro = 100, credits = 4200, firstWave = 0 }
        , { id = 2, race = Vessari, team = 2, human = False, aggro = 105, credits = 5200, firstWave = 5400 }
        , { id = 3, race = Combine, team = 3, human = False, aggro = 100, credits = 3600, firstWave = 4800 }
        ]
    , blds =
        List.concat
            [ compactBase 1 8 62
            , [ { side = 1, kind = Foundry, tx = 15, ty = 64 } ]
            -- the Prime Conduit ring: four spires guarding the pit
            , [ { side = 2, kind = Spire, tx = 52, ty = 28 }
              , { side = 2, kind = Spire, tx = 52, ty = 39 }
              , { side = 2, kind = Spire, tx = 77, ty = 28 }
              , { side = 2, kind = Spire, tx = 77, ty = 39 }
              ]
            , vessariBase 2 62 6
            , [ { side = 2, kind = AscendantGate, tx = 70, ty = 11 }
              , { side = 2, kind = PurgeLens, tx = 56, ty = 14 }
              , { side = 2, kind = SkyCradle, tx = 50, ty = 8 }
              , { side = 2, kind = PylonThorn, tx = 53, ty = 27 }
              , { side = 2, kind = PylonThorn, tx = 53, ty = 42 }
              , { side = 2, kind = PylonThorn, tx = 76, ty = 27 }
              , { side = 2, kind = PylonThorn, tx = 76, ty = 42 }
              ]
            , combineBase 3 62 59
            , [ { side = 3, kind = ChopShop, tx = 70, ty = 62 }
              , { side = 3, kind = FlakRack, tx = 59, ty = 56 }
              ]
            ]
    , units =
        List.concat
            [ compactSquad 1 8 62
            , [ { side = 1, kind = Bulwark, x = px 17, y = px 67 }
              , { side = 1, kind = Bulwark, x = px 20, y = px 66 }
              , { side = 1, kind = Rocket, x = px 14, y = px 69 }
              ]
            , vessariSquad 2 62 6
            , [ { side = 2, kind = Colossus, x = px 64, y = px 34 } ]
            , combineSquad 3 62 59
            ]
    , camTx = 11
    , camTy = 64
    }


-- ===== skirmish =====


skirmishDef : Race -> Race -> Int -> MissionDef
skirmishDef playerRace enemyRace difficulty =
    let
        w = 70
        h = 64

        parsed =
            parse (baseRows 0 w h)
                |> stampRect tRock 31 20 8 6
                |> stampRect tRock 31 39 8 6
                |> stampChasmSides w h
                |> stampOre False 13 53 3
                |> stampOre False 57 10 3
                |> stampOre True 35 31 1
                |> stampOre False 13 11 1
                |> stampOre False 57 53 1
                |> stampExt 20 31
                |> stampExt 50 31
                |> stampExt 35 11
                |> stampExt 35 53

        aggro =
            if difficulty == 0 then 70
            else if difficulty == 1 then 100
            else 130

        firstWave =
            if difficulty == 0 then 9000
            else if difficulty == 1 then 6300
            else 4500
    in
    { id = 0
    , name = "Skirmish: Rust Basin"
    , parsed = parsed
    , sides =
        [ { id = 1, race = playerRace, team = 1, human = True, aggro = 100, credits = 3000, firstWave = 0 }
        , { id = 2, race = enemyRace, team = 2, human = False, aggro = aggro, credits = 3000, firstWave = firstWave }
        ]
    , blds =
        List.concat
            [ raceStartBlds playerRace 1 10 48
            , raceStartBlds enemyRace 2 55 7
            ]
    , units =
        List.concat
            [ raceStartUnits playerRace 1 10 48
            , raceStartUnits enemyRace 2 55 7
            ]
    , camTx = 13
    , camTy = 50
    }


stampChasmSides : Int -> Int -> Parsed -> Parsed
stampChasmSides w h p =
    p
        |> stampRect tChasm 2 (h // 2 - 2) 8 4
        |> stampRect tChasm (w - 10) (h // 2 - 2) 8 4


raceStartBlds : Race -> Int -> Int -> Int -> List BldSpawn
raceStartBlds r side tx ty =
    case r of
        Compact -> compactBase side tx ty
        Combine -> combineBase side tx ty
        Vessari -> vessariBase side tx ty


raceStartUnits : Race -> Int -> Int -> Int -> List UnitSpawn
raceStartUnits r side tx ty =
    case r of
        Compact -> compactSquad side tx ty
        Combine -> combineSquad side tx ty
        Vessari -> vessariSquad side tx ty


-- ===== building the live Game =====


emptyGame : Game
emptyGame =
    { tick = 0
    , seed = Random.initialSeed 20260715
    , mapW = 4
    , mapH = 4
    , tiles = Dict.empty
    , ore = Dict.empty
    , units = []
    , blds = []
    , shots = []
    , fxs = []
    , scraps = []
    , strikes = []
    , sides = []
    , flows = []
    , fogVis = Dict.empty
    , fogSeen = Dict.empty
    , fogRows = Dict.empty
    , fogDirty = Dict.empty
    , nextId = 1
    , alerts = []
    , pings = []
    , cues = []
    , winner = 0
    , msnPhase = 0
    , msnTimer = 0
    , flags = Dict.empty
    , supStall = False
    }


buildGame : MissionDef -> Game
buildGame def =
    let
        p = def.parsed

        g0 =
            { emptyGame
                | mapW = p.w
                , mapH = p.h
                , tiles = p.tiles
                , ore = p.ore
                , sides =
                    List.map
                        (\sd ->
                            let
                                s = freshSide sd.id sd.race sd.team sd.human sd.aggro
                            in
                            { s
                                | credits = sd.credits
                                , mind = { mode = 0, thinkAt = 30, waveAt = sd.firstWave, waveSize = 0, buildIx = 0, targetX = 0, targetY = 0, scoutIx = 0 }
                            }
                        )
                        def.sides
            }

        -- neutral derelict extractors from the map stamps
        g1 =
            List.foldl
                (\e acc -> mkBld 0 Derelict e.tx e.ty 0 acc)
                g0
                p.exts

        g2 =
            List.foldl
                (\b acc -> mkBld b.side b.kind b.tx b.ty 0 acc)
                g1
                def.blds

        g3 =
            List.foldl
                (\u acc -> mkUnit u.side u.kind u.x u.y acc)
                g2
                def.units

        -- finished bases: skip the unfold animation on mission start
        g4 =
            { g3 | blds = List.map (\b -> { b | prog = 0 }) g3.blds }
    in
    initFogRows g4
