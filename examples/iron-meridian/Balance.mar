module Balance exposing (..)


import Types exposing (..)


-- IRON MERIDIAN: every stat table. Pure case tables over UnitKind and
-- BldKind so the whole balance lives in one reviewable file. The sim
-- runs at 30 ticks per second: every duration here is in sim ticks,
-- every speed in fx (px*16) per tick, every range in plain px.
--
-- Damage types: 0 light, 1 piercing, 2 blast, 3 beam.
-- Producer classes: 0 infantry, 1 vehicle, 2 air.


-- ===== economy constants =====


startCredits : Int
startCredits = 3000


ferriteValue : Int
ferriteValue = 800


azuriteValue : Int
azuriteValue = 1600


harvestCarry : Int
harvestCarry = 400


-- credits gained per mining pulse (every 5 ticks while on the patch)
minePulse : Int
minePulse = 25


extractorTrickle : Int          -- credits per second to the owner
extractorTrickle = 5


captureTicks : Int
captureTicks = 90


superCooldown : Int
superCooldown = 3600            -- 2 minutes


shieldRegenDelay : Int
shieldRegenDelay = 90


lowPowerPercent : Int           -- production speed under low power
lowPowerPercent = 60


-- ===== damage vs armor =====
-- Armor classes: 0 infantry, 1 vehicle, 2 building, 3 air.


dmgMult : Int -> Int -> Int
dmgMult dt armor =
    case dt of
        0 ->
            case armor of
                0 -> 100
                1 -> 40
                2 -> 25
                _ -> 60

        1 ->
            case armor of
                0 -> 50
                1 -> 120
                2 -> 60
                _ -> 110

        2 ->
            case armor of
                0 -> 70
                1 -> 90
                2 -> 130
                _ -> 0

        _ ->
            90


