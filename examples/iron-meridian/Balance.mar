-- tooltip blurb: what it does + why you'd want it. Never repeats the name
-- (the title already shows it); leads with the function.
bDesc : BldKind -> String
bDesc k =
    case k of
        Bastion -> "Trains workers and anchors the whole base. Protect it at all costs."
        CrawlerHQ -> "Trains workers and anchors the whole base. Protect it at all costs."
        GenesisFont -> "Trains workers and anchors the whole base. Protect it at all costs."
        PowerStation -> "Feeds power to everything you build. Add more before you run short."
        JunkTurbine -> "Burns scrap into power. Stay ahead of demand or buildings stall."
        Spire -> "Powers Vessari structures. Raise more as the base grows."
        Refinery -> "Turns mined ore into credits."
        Smeltery -> "Turns mined ore into credits. The Combine's income engine."
        ExtractBloom -> "Turns mined ore into credits. Vessari's steady income."
        Billet -> "Raises your unit cap. Build before supply fills or training stops."
        Bunkroom -> "Raises your unit cap. Build before supply fills or training stops."
        Foundry -> "Trains infantry: cheap, dependable, your first army."
        RatDen -> "Breeds swarm infantry fast. Win fights by sheer numbers."
        Chrysalis -> "Grows Vessari infantry. Fragile bodies behind regenerating shields."
        MotorPool -> "Builds tanks and vehicles. Your main hitting power."
        ChopShop -> "Welds scrap into fast, cheap vehicles and raiders."
        ForgeWomb -> "Grows Vessari vehicles and walkers. Heavy, shielded punch."
        Airfield -> "Builds aircraft that fly over terrain and strike from above."
        Roost -> "Launches scrap flyers for raids and anti-air cover."
        SkyCradle -> "Births Vessari flyers to strike where the ground can't reach."
        Watchtower -> "Fixed gun against ground attackers. Guards your economy and chokes."
        SpikeNest -> "Fixed gun against ground attackers. Cheap perimeter defense."
        PylonThorn -> "Fixed gun that hits ground AND air. All-round base defense."
        FlakTower -> "Anti-air only: shreds aircraft, but ignores the ground."
        FlakRack -> "Anti-air only: shreds aircraft, but ignores the ground."
        AegisNode -> "Projects a shield aura that regenerates nearby units' armor."
        Armory -> "Unlocks advanced units and upgrades. Tech up to escalate."
        WarlordHall -> "Unlocks advanced units and upgrades. Tech up to escalate."
        AscendantGate -> "Unlocks advanced units and upgrades. Tech up to escalate."
        ArtilleryBeacon -> "Superweapon: call a heavy artillery barrage onto a target."
        ScrapMagnet -> "Superweapon: drop a scrap storm that wrecks an area."
        PurgeLens -> "Superweapon: sweep a wide purge beam across the battlefield."
        Derelict -> "Neutral ruin. Capture it with an engineer for extra income."


