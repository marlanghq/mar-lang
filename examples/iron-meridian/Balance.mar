-- one-line role blurb shown when the cursor rests on a train button
uDesc : UnitKind -> String
uDesc k =
    case k of
        Hauler -> "Worker. Mines ore into credits."
        Sapper -> "Engineer. Captures neutral derelicts."
        Rifle -> "Infantry. Cheap, fires on ground and air."
        Rocket -> "Missile infantry. Strong vs armor and air."
        ScoutCar -> "Fast recon car. Reveals ground, light gun."
        Bulwark -> "Battle tank. Heavy armor and cannon."
        Thumper -> "Artillery. Long range, weak up close."
        Kestrel -> "Gunship. Flies over terrain, hits ground."
        Reclaimer -> "Worker. Mines ore and hauls scrap for cash."
        Hijacker -> "Engineer. Seizes neutral derelicts."
        Scrapper -> "Swarm infantry. Cheap, ground and air."
        Spiker -> "Spike gunner. Anti-air and anti-infantry."
        DuneBike -> "Raider bike. Fast, harasses workers."
        Scorcher -> "Flamer. Devastates infantry up close."
        Warthog -> "Assault truck. Tough all-rounder."
        Vulture -> "Scrap flyer. Strafes ground and air."
        RamTruck -> "Suicide truck. Explodes on contact."
        TitheDrone -> "Worker. Channels ore into credits."
        Attuner -> "Acolyte. Converts neutral derelicts."
        Lancer -> "Energy infantry. Shielded, ground and air."
        Nullifier -> "EMP caster. Stuns clusters of enemies."
        Sliver -> "Blade skiff. Fast, shielded, short range."
        Colossus -> "Walker. Heavy shielded siege unit."
        RiftSkiff -> "Skiff. Shielded flyer, strikes ground."


