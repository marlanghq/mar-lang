-- the race's HQ / refinery / tech / supply kinds


raceHQ : Race -> BldKind
raceHQ r =
    case r of
        Compact -> Bastion
        Combine -> CrawlerHQ
        Vessari -> GenesisFont


raceWorker : Race -> UnitKind
raceWorker r =
    case r of
        Compact -> Hauler
        Combine -> Reclaimer
        Vessari -> TitheDrone


raceCapturer : Race -> UnitKind
raceCapturer r =
    case r of
        Compact -> Sapper
        Combine -> Hijacker
        Vessari -> Attuner


-- the buildable structure list per race, sidebar order
raceBlds : Race -> List BldKind
raceBlds r =
    case r of
        Compact ->
            [ PowerStation, Refinery, Billet, Foundry, Watchtower
            , MotorPool, FlakTower, Armory, Airfield, ArtilleryBeacon ]

        Combine ->
            [ JunkTurbine, Smeltery, Bunkroom, RatDen, SpikeNest
            , ChopShop, FlakRack, WarlordHall, Roost, ScrapMagnet ]

        Vessari ->
            [ Spire, ExtractBloom, Chrysalis, PylonThorn, ForgeWomb
            , AegisNode, AscendantGate, SkyCradle, PurgeLens ]


-- the trainable unit list per race, sidebar order
raceUnits : Race -> List UnitKind
raceUnits r =
    case r of
        Compact ->
            [ Hauler, Rifle, Rocket, Sapper, ScoutCar
            , Bulwark, Thumper, Kestrel ]

        Combine ->
            [ Reclaimer, Scrapper, Spiker, Hijacker, DuneBike
            , Warthog, Scorcher, RamTruck, Vulture ]

        Vessari ->
            [ TitheDrone, Lancer, Nullifier, Attuner, Sliver
            , Colossus, RiftSkiff ]


-- structure prerequisite: which building must exist first
bNeeds : BldKind -> List BldKind
bNeeds k =
    case k of
        Refinery -> [ PowerStation ]
        Foundry -> [ PowerStation ]
        Billet -> [ PowerStation ]
        MotorPool -> [ Refinery ]
        Watchtower -> [ Foundry ]
        FlakTower -> [ Foundry ]
        Armory -> [ MotorPool ]
        Airfield -> [ Armory ]
        ArtilleryBeacon -> [ Armory ]
        Smeltery -> [ JunkTurbine ]
        RatDen -> [ JunkTurbine ]
        Bunkroom -> [ JunkTurbine ]
        ChopShop -> [ Smeltery ]
        SpikeNest -> [ RatDen ]
        FlakRack -> [ RatDen ]
        WarlordHall -> [ ChopShop ]
        Roost -> [ WarlordHall ]
        ScrapMagnet -> [ WarlordHall ]
        ExtractBloom -> [ Spire ]
        Chrysalis -> [ Spire ]
        ForgeWomb -> [ ExtractBloom ]
        PylonThorn -> [ Chrysalis ]
        AegisNode -> [ Chrysalis ]
        AscendantGate -> [ ForgeWomb ]
        SkyCradle -> [ AscendantGate ]
        PurgeLens -> [ AscendantGate ]
        _ -> []


-- unit prerequisite: the producer plus (for tier 2) the tech building
uNeeds : UnitKind -> List BldKind
uNeeds k =
    let
        producer =
            case uClass k of
                0 ->
                    case uRace k of
                        Compact -> Foundry
                        Combine -> RatDen
                        Vessari -> Chrysalis

                1 ->
                    case uRace k of
                        Compact -> MotorPool
                        Combine -> ChopShop
                        Vessari -> ForgeWomb

                _ ->
                    case uRace k of
                        Compact -> Airfield
                        Combine -> Roost
                        Vessari -> SkyCradle

        tech =
            case uRace k of
                Compact -> Armory
                Combine -> WarlordHall
                Vessari -> AscendantGate
    in
    if uTier k >= 2 && uClass k /= 2 then
        [ producer, tech ]
    else
        [ producer ]


-- vessari lattice radius (tiles) from Spire / GenesisFont
latticeRadius : Int
latticeRadius = 7


-- adjacency radius (tiles) for normal base building
baseRadius : Int
baseRadius = 6


-- wrecks: vehicles leave scrap worth a share of their cost
scrapShare : Int -> Int
scrapShare cost =
    cost // 4


-- building center in plain px (needs the footprint tables, so it lives
-- here rather than in Types)
bpx : Bld -> Int
bpx b = b.tx * tileW + bW b.kind * tileW // 2


bpy : Bld -> Int
bpy b = b.ty * tileW + bH b.kind * tileW // 2
