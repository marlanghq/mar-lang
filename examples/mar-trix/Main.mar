module Main exposing (main)

-- Mar-Trix: a falling-block puzzle.
--
-- The playfield in this genre has a proper name: the matrix. That is the term
-- the guideline uses and the one competitive players say out loud, and it sits
-- one letter away from the language the game is written in. So the game is
-- named after its own matrix, and the matrix is named after Mar.
--
-- What makes the genre feel good is not the falling, it is everything AROUND
-- the falling, and all of it is here: a 7-bag so droughts cannot happen, a
-- ghost so a hard drop is a decision and not a gamble, hold, lock delay with a
-- reset budget, delayed auto-shift, wall kicks, combo and back-to-back. Take
-- any one of those out and the game still runs and stops being fun.
--
-- Everything is integer arithmetic, Mar has no floats, including the
-- gravity accumulator, which counts frames rather than seconds. That is not a
-- workaround: it means a given piece sequence lands identically on the web and
-- on iOS, frame for frame.
--
-- The effects follow the house rule: change the OBJECT, never the screen. A
-- cleared row lights up and collapses, a hard-dropped piece flashes where it
-- landed, the frame shifts colour on a level up. Nothing shakes, nothing
-- jitters, and the matrix never moves under your hands.

import Balance exposing (..)
import Draw exposing (..)
import Screens exposing (..)
import Sim exposing (..)
import Types exposing (..)
import Canvas exposing ( canvas, group, onTap, watchPointers, watchSize )


view : Model -> View Msg
view m =
    let
        lay = layout m

        sidebar =
            if lay.stack then
                phoneShapes m lay

            else
                panelShapes m lay

        playing =
            frameShapes m lay
                ++ gridLines lay
                ++ matrixTiles m lay
                ++ ghostTiles m lay
                ++ pieceTiles m.piece lay
                ++ [ group [ Canvas.Blend Canvas.Add ] (slamShapes m lay ++ flashShapes m lay) ]
                ++ clearBanner m lay
                ++ sidebar

        scene =
            case m.phase of
                Title ->
                    titleShapes m lay

                Over ->
                    frameShapes m lay
                        ++ gridLines lay
                        ++ matrixTiles m lay
                        ++ sidebar
                        ++ overShapes m lay

                Playing ->
                    playing

                Clearing ->
                    playing
    in
    canvas Crisp
        [ onTap Tapped, watchSize Resized, watchPointers Pointers ]
        (backdropShapes m lay ++ scene ++ vignette m)


-- Every phase ticks, including the two that are not playing: the title
-- screen drifts and the game-over prompt pulses, and both read the frame
-- counter. A phase that drew something moving but subscribed to nothing would
-- render one frozen frame and look broken.
subscriptions : Model -> Sub Msg
subscriptions m =
    Sub.batch
        [ Time.every (Time.millis (1000 // fps)) (\_ -> Tick)
        , Keyboard.watch KeysChanged
        , Gamepad.watch PadChanged
        , Device.watch DeviceChanged
        ]


page : Page
page =
    Page.create
        { path = "/"
        , title = "Mar-Trix"
        , init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }


main : Cmd ()
main =
    App.frontend [ page ]
