module Main exposing (main)


-- STAR CONDOR — a vertical shoot-em-up in the spirit of the cute 16-bit
-- arcade shooters (TwinBee-class): bright colors, chunky sprites, bell-like
-- powerups, bosses with big silly silhouettes. Built with ZERO language
-- changes on the Mar Canvas draw-list.
--
-- STORY (an optimistic Latin America, played straight): the nations of the
-- continent pooled their engineers into A.L.A.S. — the Alianza
-- Latinoamericana del Espacio ("alas" = wings). When a swarm of derelict
-- war-machines from a forgotten century wakes up over the continent's
-- greatest places, A.L.A.S. launches its first defender: the CONDOR.
-- Ten stages sweep the map — the Amazon, Iguazu, the Pampas, Patagonia,
-- Atacama, Uyuni, Machu Picchu, Galapagos, Panama, Teotihuacan — each with
-- its own parallax scenery, groove and boss. The ending does not blow the
-- enemy up: A.L.A.S. rewires the old machine to watch the weather.
--
-- CONTROLS
--   Keyboard: arrows / WASD move, SPACE fire (hold = autofire), M mute,
--             ENTER pause.
--   Gamepad:  stick or d-pad moves, A fires, Start pauses.
--   Touch:    drag anywhere to fly (the ship follows your finger) —
--             autofire is always on while touching.
--
-- POWERUPS (kept simple: color = weapon, gold = stronger):
--   GOLD star  = power +1 (up to 3)      BLUE star = BEAM  (fast, narrow)
--   RED star   = SPREAD (wide fan)       GREEN star = WAVE (weaving pair)
--   PINK heart = +1 hull ENERGY
--   Stars drop from the striped pinata drones — pop them!
--
-- PACING: the ship flies on 5 cells of ENERGY. A hit costs one cell, the
-- ship keeps its position and blinks through a grace window — no snap-back.
-- Everything moves deliberately (slow orbs in numbers, dodge the weave);
-- enemies arrive in SCRIPTED FORMATIONS (V / row / column / pincer / arc)
-- from a fixed per-stage battle plan, plus scrolling stone BARRIERS with a
-- gap to thread (they also eat your shots). Stage intros and clears wait
-- for a button (with a forced reading beat); the boss dies in a chained
-- explosion sequence and the ship's own death is a slow fireball before
-- the game over screen.
--
-- MUSIC: entirely world-driven (the pulse-runner lesson): the game loop
-- fires one groove beat per 30 ticks (CBeat) plus one melody beat of two
-- eighth notes (CMel), so the soundtrack pauses with the game and never
-- drifts. Each stage carries TWO 8-beat phrases played A A B A over a
-- 32-beat cycle whose backing walks Am F Dm G while the kit builds layer
-- by layer (drums, hats, arps, open-hat accents) and closes every cycle
-- with a snare fill. Three regional rhythm flavors rotate across stages;
-- bosses switch to an Am/E double-kick drive.
--
-- PERFORMANCE: logical 320x240 canvas, Pixelated, letterboxed. The frame
-- budget is the draw-list length: 3 parallax layers (~70 shapes), capped
-- entities (16 foes / 40 player bullets / 36 enemy shots / 24 particles),
-- everything culled off-screen. Comparable to mini-rpg, which holds 60fps.
--
-- Run: mar dev examples/star-condor   (port 3032)


import Canvas exposing
    ( canvas, rect, triangle, circle, group, rgb
    , onTap, watchSize, onDrag, onRelease
    )
import Time


-- ===== constants =====


fps : Int
fps = 60


gameW : Int
gameW = 320


gameH : Int
gameH = 240


-- The whole HUD is one row deep at the top: score, hull cells, the shared
-- centre slot, the weapon readout, the mute icon. Nothing sits at the
-- bottom on purpose. In a vertical shmup the bottom strip is where the
-- player actually lives, so spending it on a readout costs the fight; the
-- ship gets the floor and the readouts get the sky, which is the half of
-- the screen a player only visits.
--
-- Both bounds are derived from the sprite instead of eyeballed: the nose
-- reaches 11px above the ship's centre and the engine flames 14px below it.
-- So the ceiling clears the HUD row by one pixel, the floor puts the flame
-- tips exactly on the bottom edge, and editing the HUD moves the ceiling
-- with it.
hudTopRow : Int
hudTopRow = 13            -- lowest pixel of the HUD row (mute icon, boss bar)


playTop : Int
playTop = hudTopRow + 11 + 1


playBot : Int
playBot = gameH - 14 - 1


fp : Int
fp = 16                   -- fixed-point scale for entity positions


stageTicks : Int
stageTicks = 3600         -- waves end here (60s); the boss warning begins


bossTick : Int
bossTick = 3720           -- the boss flies in


-- ===== small Int helpers (no Basics in Mar) =====




iclamp : Int -> Int -> Int -> Int
iclamp lo hi v = max lo (min hi v)


absI : Int -> Int
absI n = if n < 0 then 0 - n else n


approach : Int -> Int -> Int -> Int
approach current target amount =
    if current < target then min target (current + amount)
    else if current > target then max target (current - amount)
    else current



-- octagonal distance: cheap length approx for aiming shots
octd : Int -> Int -> Int
octd dx dy =
    let
        ax = absI dx
        ay = absI dy
    in
    max ax ay + min ax ay // 2


-- ===== types =====


type Mode
    = Title
    | Story                  -- the opening: why the Condor flies
    | Intro
    | Play
    | BossFall               -- the boss's death sequence (chained explosions)
    | Dying                  -- the ship's death sequence before game over
    | Clear
    | Over
    | Ending


type Cue
    = CBeat Int
    | CMel Int Int           -- one melody beat: two eighth notes (hz; 0 = rest)
    | CShot Int              -- weapon index
    | CHit                   -- the boss took a hit
    | CHitFoe                -- a tough enemy took a hit (damage feedback)
    | CBoomK Int             -- an enemy died: explosion varies by kind
    | CBigBoom
    | CShipBoom              -- the player's ship goes down
    | CStar
    | CHeal
    | CHurt
    | CWarn
    | CTurbineCharge
    | CTurbineBeam
    | CJIntro
    | CJClear
    | CJOver
    | CJEnd
    | CBlip


type Msg
    = Resized Int Int
    | Tick
    | Tapped Int Int
    | Dragged Int Int
    | Released Int Int
    | KeysChanged { down : List Keyboard.Key }
    | PadChanged { connected : Bool, leftX : Int, leftY : Int, rightX : Int, rightY : Int, down : List Gamepad.Button }
    | DeviceChanged Device


-- kinds: 0 drone (sway), 1 diver, 2 floater (shoots), 3 zig (bouncer),
-- 4 pinata (carries the star kind in `gift`)
-- movement modes (mv): 0 = by kind (straight/diver/floater/zig/pinata),
-- 1 = sine wave crossing the screen, 2 = ring orbit around a sinking
-- anchor, 3 = galaga loop then dive, 4 = snake weaving down a lane.
-- For mv 1/2/4 `gift` doubles as amplitude/radius in px; ph is the phase.
type alias Foe =
    { kind : Int
    , mv : Int
    , x : Int, y : Int          -- fixed-point
    , ax : Int, ay : Int        -- anchor / baseline (fixed-point)
    , ph : Int
    , vx : Int, vy : Int
    , hp : Int
    , t : Int
    , gift : Int                -- pinata star kind / path amplitude
    , hurtT : Int               -- white damage-flash ticks
    }


-- a scrolling stone barrier segment; rows leave one gap to fly through
type alias Wall =
    { x : Int, y : Int, w : Int }   -- x/w in px, y in fixed-point


-- one entry of a stage's battle plan
type alias WaveEv =
    { t : Int, f : Int, x : Int, k : Int }


type alias Bul =
    { x : Int, y : Int, vx : Int, vy : Int, w : Int, t : Int }


type alias Shot =
    { x : Int, y : Int, vx : Int, vy : Int }


-- star kinds: 0 gold power, 1 blue beam, 2 red spread, 3 green wave, 4 heart
type alias Star =
    { x : Int, y : Int, kind : Int, t : Int }


type alias Part =
    { x : Int, y : Int, vx : Int, vy : Int, t : Int, k : Int }


type alias BossS =
    { hp : Int, mx : Int, x : Int, y : Int, t : Int, ph : Int }


type alias Model =
    { w : Int
    , h : Int
    , mode : Mode
    , stage : Int             -- 1..10
    , tick : Int              -- global clock (menus blink)
    , st : Int                -- ticks inside the current mode
    , seed : Random.Seed
    , px : Int, py : Int      -- player, plain pixels
    , kU : Bool, kD : Bool, kL : Bool, kR : Bool
    , firing : Bool
    , fireT : Int
    , padX : Int, padY : Int
    , keysDown : List Keyboard.Key       -- raw held set (keyboard mirror)
    , padDown : List Gamepad.Button      -- raw held set (gamepad mirror)
    , dragOn : Bool
    , ltx : Int, lty : Int    -- last touch point (logical px)
    , weapon : Int            -- 0 beam, 1 spread, 2 wave
    , power : Int             -- 1..3
    , energy : Int            -- 0..5 hull energy (hits drain it, hearts heal)
    , score : Int
    , hi : Int
    , buls : List Bul
    , shots : List Shot
    , foes : List Foe
    , stars : List Star
    , parts : List Part
    , walls : List Wall
    , boss : Maybe BossS
    , invulnT : Int
    , paused : Bool
    , muted : Bool
    , dev : Maybe Device
    , sfx : List Cue
    }


