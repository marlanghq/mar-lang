        4 -> [ Sound.e 5, 0, 0, Sound.d 5, Sound.c 5, 0, Sound.b 4, 0, Sound.a 4, 0, Sound.e 4, Sound.g 4, Sound.a 4, 0, 0, 0 ]
        5 -> [ Sound.a 5, 0, Sound.g 5, Sound.a 5, Sound.e 5, 0, Sound.d 5, Sound.e 5, Sound.b 4, 0, Sound.c 5, Sound.d 5, Sound.e 5, Sound.g 5, Sound.a 5, 0 ]
        6 -> [ Sound.e 5, Sound.g 5, Sound.a 5, Sound.c 6, Sound.a 5, Sound.g 5, Sound.e 5, 0, Sound.c 5, Sound.e 5, Sound.g 5, Sound.a 5, Sound.g 5, Sound.e 5, Sound.c 5, 0 ]
        7 -> [ Sound.a 5, 0, Sound.g 5, Sound.e 5, Sound.g 5, Sound.a 5, Sound.g 5, Sound.e 5, Sound.d 5, Sound.e 5, Sound.c 5, Sound.d 5, Sound.e 5, 0, Sound.e 5, 0 ]
        8 -> [ Sound.g 5, 0, Sound.e 5, Sound.g 5, Sound.a 5, 0, Sound.g 5, Sound.e 5, Sound.d 5, 0, Sound.e 5, Sound.d 5, Sound.c 5, Sound.d 5, Sound.e 5, 0 ]
