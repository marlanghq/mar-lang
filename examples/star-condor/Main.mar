        2 -> [ Sound.c 6, 0, Sound.a 5, Sound.g 5, Sound.e 5, Sound.g 5, Sound.a 5, 0, Sound.g 5, Sound.e 5, Sound.d 5, Sound.c 5, Sound.d 5, Sound.e 5, Sound.c 5, 0 ]
