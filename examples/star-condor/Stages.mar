             , det = rgb 244 200 90, acc = rgb 255 170 40 }


nthI : Int -> List Int -> Int
nthI i xs =
    List.foldl
        (\x acc -> { j = acc.j + 1, v = if acc.j == i then x else acc.v })
        { j = 0, v = 440 }
        xs
        |> (\r -> r.v)
