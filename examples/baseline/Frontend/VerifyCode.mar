module Frontend.VerifyCode exposing (page)


import Shared
import Frontend.Routes
import UI exposing
    ( navigationStack, navigationTitle
    , form, section, footer, text, textField, button, errorText
    , numericCode, submit, empty, disabled
    , width, chars
    )


-- Code entry, mounted at /sign-in/verify/{email:String}. The address
-- travels in the path rather than in a model, so the URL is the source
-- of truth: pasting it into a fresh tab still works, and Back returns
-- to the email step for a retry.


type alias Model =
    { draft : String
    , error : Maybe String
    , busy  : Bool
    }


type Msg
    = DraftChanged String
    | Submitted
    | CodeVerified (Result Service.Error (Auth.VerifyOutcome Shared.User))


init : { email : String } -> (Model, Cmd Msg)
init _ =
    ( { draft = "", error = Nothing, busy = False }, Cmd.none )


update : { email : String } -> Msg -> Model -> (Model, Cmd Msg)
update params msg model =
    case msg of
        DraftChanged value ->
            ( { model | draft = value, error = Nothing }, Cmd.none )

        Submitted ->
            if model.busy then
                ( model, Cmd.none )
            else
                ( { model | busy = True, error = Nothing }
                , Auth.verifyCode { email = params.email, code = model.draft } CodeVerified
                )

        CodeVerified (Ok (Auth.SignedIn _)) ->
            ( { model | busy = False, draft = "" }, Auth.completeSignIn )

        CodeVerified (Ok Auth.WrongCode) ->
            ( { model | busy = False, draft = "", error = Just "That code didn't work. Check your email or request a new one." }
            , Cmd.none
            )

        CodeVerified (Ok Auth.TooManyAttempts) ->
            ( { model | busy = False, draft = "", error = Just "Too many tries with this code. Request a new one." }
            , Cmd.none
            )

        CodeVerified (Err why) ->
            ( { model | busy = False, draft = "", error = Just (Service.errorToString why) }
            , Cmd.none
            )


view : { email : String } -> Model -> View Msg
view params model =
    navigationStack [ navigationTitle "Check your email" ]
        [ form
            [ section [ footer "The code is good for a few minutes. If it expires, go back and ask for another." ]
                [ text [] ("We sent a 6-digit code to " ++ params.email ++ ".")
                , textField
                    [ numericCode, submit Submitted, width (chars 6), disabled model.busy ]
                    "Code" model.draft DraftChanged
                , errorView model.error
                ]
            , section []
                [ button [ disabled model.busy ] Submitted "Verify" ]
            ]
        ]


errorView : Maybe String -> View Msg
errorView maybeErr =
    case maybeErr of
        Nothing ->
            empty

        Just message ->
            errorText message


page : Page
page =
    Page.dynamic
        { path   = Frontend.Routes.verifyCode
        , title  = "Verify code"
        , init   = init
        , update = update
        , view   = view
        , subscriptions = \_ _ -> Sub.none
        }
