init : (Model, Cmd Msg)
init =
    ( initModel, Cmd.none )




cellAt : Dict Int Int -> Int -> Int -> Int
cellAt grid cx cy =
    if cx < 0 || cx > 23 || cy < 0 || cy > 23 then
        1
    else
        Dict.get (cy * 24 + cx) grid |> Maybe.withDefault 0


-- the minimap pre-bakes each row of solid cells into horizontal runs so
-- drawing it costs ~100 rects, not 576. Doors are skipped here (drawn
-- separately in their own color) and cracked walls look like plain stone,
-- so secrets stay secret. Recomputed only when the grid actually changes
-- (barrow start, a door opening, a wall shattering)
computeRuns : Dict Int Int -> List { x : Int, y : Int, w : Int }
computeRuns grid =
    List.concatMap (\y -> rowRuns grid y 0 Nothing []) (range 24)


rowRuns : Dict Int Int -> Int -> Int -> Maybe Int -> List { x : Int, y : Int, w : Int } -> List { x : Int, y : Int, w : Int }
rowRuns grid y x open acc =
    let
        code = cellAt grid x y
        solid = x < 24 && code > 0 && code /= 4 && code /= 5
    in
    if x >= 24 then
        case open of
            Just x0 -> { x = x0, y = y, w = x - x0 } :: acc
            Nothing -> acc
    else
        case open of
            Just x0 ->
                if solid then
                    rowRuns grid y (x + 1) open acc
                else
                    rowRuns grid y (x + 1) Nothing ({ x = x0, y = y, w = x - x0 } :: acc)

            Nothing ->
                if solid then
                    rowRuns grid y (x + 1) (Just x) acc
                else
                    rowRuns grid y (x + 1) Nothing acc


solidAtPt : Dict Int Int -> Int -> Int -> Bool
solidAtPt grid x y =
    cellAt grid (x // k1) (y // k1) > 0


canStand : Dict Int Int -> Int -> Int -> Bool
canStand grid x y =
    (solidAtPt grid (x - playerR) (y - playerR)
        || solidAtPt grid (x + playerR) (y - playerR)
        || solidAtPt grid (x - playerR) (y + playerR)
        || solidAtPt grid (x + playerR) (y + playerR))
        == False


-- straight-line sight test, sampled every ~quarter cell. Cheap and good
-- enough for AI; the renderer never uses this (it has real rays)
losClear : Dict Int Int -> Int -> Int -> Int -> Int -> Bool
losClear grid ax ay bx by =
    let
        n = iclamp 1 48 (octDist (bx - ax) (by - ay) // 224)
    in
    losStep grid ax ay bx by n 1


losStep : Dict Int Int -> Int -> Int -> Int -> Int -> Int -> Int -> Bool
losStep grid ax ay bx by n i =
    if i >= n then
        True
    else if solidAtPt grid (ax + (bx - ax) * i // n) (ay + (by - ay) * i // n) then
        False
    else
        losStep grid ax ay bx by n (i + 1)
