module Sfx exposing (..)

-- The sounds of the barrow, including the war drums that play under a fight.

import Types exposing (..)




-- funeral march voices. mnote = one melody attack: the tune doubled an
-- octave up (Chopin wrote the theme in right-hand octaves) with a slow
-- vibrato so the held notes sing instead of sitting static.
-- a brassy horn note for the victory jingles: a bright square carrying the
-- tune over a triangle an octave below for body (a chiptune bugle).
--
-- The tune is played by TWO horns, not one: the same note twice, nine cents
-- apart and a little way out to either side. Nine cents is about a beat a
-- second at this pitch, which is what two players who agree on the note and
-- not on the hundredth of it actually do, and what separates a horn section
-- from an oscillator. The triangle underneath is the body of the section and
-- stays dead centre, because the low octave is what holds the fanfare down.
blare : Int -> Int -> Sound
blare hz dur =
    Sound.chord
        [ Sound.pan (0 - 24) (Sound.volume 16 (Sound.tone Sound.Square hz dur))
        , Sound.pan 24 (Sound.detune 9 (Sound.volume 12 (Sound.tone Sound.Square hz dur)))
        , Sound.volume 11 (Sound.tone Sound.Triangle (hz // 2) dur)
        ]


cueSound : Cue -> Sound
cueSound c =
    case c of
        -- a cue that knows where it happened. The sim wraps the world's own
        -- noises in their bearing so the barrow speaks from the side it is
        -- on; everything you do yourself stays centred, because it is.
        CPan p inner ->
            Sound.pan p (cueSound inner)

        CThrow ->
            -- the spear LEAVES: loudest in the hand, thinner as it goes
            Sound.decay 80 0 (Sound.volume 30 (Sound.sweep 40 (Sound.tone Sound.Sawtooth 340 90)))

        CReturn ->
            Sound.volume 13 (Sound.sweep 200 (Sound.tone Sound.Sawtooth 150 70))

        CHitF ->
            Sound.decay 50 0
                (Sound.chord
                    [ Sound.volume 34 (Sound.tone Sound.Noise 0 55)
                    , Sound.volume 26 (Sound.sweep 60 (Sound.tone Sound.Triangle 160 80))
                    ])

        CDieD ->
            -- a death SCENE, not a blip (~0.8s): the creature's long guttural
            -- groan sags from mid pitch down into the floor under a rough,
            -- slow vibrato, a chest subharmonic underneath, while ragged
            -- noise pulses gurgle in the throat (blood), and only at the END
            -- of the groan the body thuds down onto the barrow stone.
            --
            -- The groan also runs OUT: it falls away as the breath does
            -- rather than holding full and stopping. The thud does the
            -- opposite of a voice and collapses, because it is struck.
            Sound.chord
                [ Sound.decay 700 12 (Sound.volume 22 (Sound.vibrato 28 9 (Sound.sweep 38 (Sound.tone Sound.Sawtooth 165 820))))
                , Sound.decay 620 10 (Sound.volume 12 (Sound.vibrato 14 6 (Sound.sweep 30 (Sound.tone Sound.Square 84 780))))
                , Sound.decay 60 0
                    (Sound.sequence
                        [ Sound.rest 90
                        , Sound.volume 13 (Sound.tone Sound.Noise 0 70)
                        , Sound.rest 80
                        , Sound.volume 10 (Sound.tone Sound.Noise 0 55)
                        , Sound.rest 90
                        , Sound.volume 7 (Sound.tone Sound.Noise 0 45)
                        ])
                , Sound.sequence
                    [ Sound.rest 640
                    , Sound.decay 130 0
                        (Sound.chord
                            [ Sound.volume 17 (Sound.tone Sound.Noise 0 110)
                            , Sound.volume 14 (Sound.sweep 30 (Sound.tone Sound.Triangle 70 160))
                            ])
                    ]
                ]

        CYelp ->
            -- the varg's death cry (~0.7s): a sharp "KAI!" leaping up, then a
            -- long pained fall with a slow, deep waver (a crying tremble, not
            -- a growl), fading into one low final whimper.
            --
            -- The leap up keeps its full shape (it is an intake, it arrives);
            -- the fall and the whimper lose energy, which is what makes the
            -- animal sound like it is emptying rather than switching off.
            Sound.sequence
                [ Sound.volume 19 (Sound.sweep 950 (Sound.tone Sound.Sawtooth 520 60))
                , Sound.decay 420 10 (Sound.volume 18 (Sound.vibrato 34 9 (Sound.sweep 190 (Sound.tone Sound.Sawtooth 900 480))))
                , Sound.decay 120 0 (Sound.volume 9 (Sound.sweep 90 (Sound.tone Sound.Triangle 180 140)))
                ]

        CGroan ->
            -- a TELEGRAPH: something is winding up to hit you. Left flat on
            -- purpose. A voice is pushed by breath, and a warning that fades
            -- is a warning you miss.
            Sound.volume 22 (Sound.sweep 70 (Sound.vibrato 14 5 (Sound.tone Sound.Sawtooth 84 380)))

        CWhine ->
            Sound.volume 15 (Sound.sweep 240 (Sound.tone Sound.Triangle 250 340))

        CBolt ->
            -- something was loosed at you: it cracks and then trails
            Sound.decay 200 8 (Sound.volume 18 (Sound.sweep 45 (Sound.duty 25 (Sound.tone Sound.Square 520 260))))

        CDoor ->
            -- the shove, then the slab keeps grinding: the effort is at the
            -- start and the stone carries on moving after it
            Sound.decay 150 55
                (Sound.chord
                    [ Sound.volume 26 (Sound.sweep 55 (Sound.tone Sound.Triangle 52 300))
                    , Sound.volume 13 (Sound.tone Sound.Noise 0 180)
                    ])

        CLocked ->
            Sound.decay 55 0
                (Sound.sequence
                    [ Sound.volume 24 (Sound.tone Sound.Triangle 90 60)
                    , Sound.rest 40
                    , Sound.volume 16 (Sound.duty 25 (Sound.tone Sound.Square 70 50))
                    ])

        CRune ->
            Sound.decay 110 18
                (Sound.sequence
                    [ Sound.volume 20 (Sound.duty 25 (Sound.tone Sound.Square 440 70))
                    , Sound.volume 22 (Sound.duty 25 (Sound.tone Sound.Square 554 70))
                    , Sound.volume 24 (Sound.duty 25 (Sound.tone Sound.Square 659 140))
                    ])

        CGold ->
            Sound.decay 40 0 (Sound.volume 18 (Sound.duty 25 (Sound.tone Sound.Square 940 50)))

        CHorn ->
            -- mead horn: a BLOWN note, held for as long as there is breath
            -- behind it. Nothing here is struck, so nothing here decays.
            Sound.chord
                [ Sound.volume 20 (Sound.tone Sound.Triangle 220 280)
                , Sound.volume 13 (Sound.tone Sound.Triangle 330 280)
                ]

        CHurt ->
            Sound.decay 100 6
                (Sound.chord
                    [ Sound.volume 30 (Sound.tone Sound.Noise 0 60)
                    , Sound.volume 30 (Sound.sweep 55 (Sound.tone Sound.Triangle 110 130))
                    ])

        CBell ->
            -- a bell IS its decay, and the thing that makes it metal rather
            -- than a chord is that the partials do not die together: the
            -- octave goes first, then the fifth, and the fundamental is left
            -- ringing alone. Held flat, these three triangles were an organ.
            Sound.chord
                [ Sound.decay 640 0 (Sound.volume 26 (Sound.tone Sound.Triangle 440 700))
                , Sound.decay 340 0 (Sound.volume 17 (Sound.tone Sound.Triangle 660 700))
                , Sound.decay 190 0 (Sound.volume 11 (Sound.tone Sound.Triangle 880 700))
                ]

        CJarl ->
            Sound.volume 34 (Sound.vibrato 10 5 (Sound.sweep 80 (Sound.tone Sound.Sawtooth 72 700)))

        CDawn ->
            Sound.sequence
                [ Sound.volume 18 (Sound.tone Sound.Triangle 262 170)
                , Sound.volume 20 (Sound.tone Sound.Triangle 330 170)
                , Sound.volume 22 (Sound.tone Sound.Triangle 392 170)
                , Sound.chord
                    [ Sound.volume 24 (Sound.tone Sound.Triangle 523 800)
                    , Sound.volume 16 (Sound.tone Sound.Triangle 659 800)
                    ]
                ]

        CFanfare ->
            -- a barrow cleared: a short brass horn-call in D major, a
            -- rising figure that turns and lands on a bright major chord.
            -- The landing chord SETTLES: horns lean into the arrival and
            -- then hold, which is a chord being played rather than a switch
            -- being thrown. Its two inner voices sit either side of the
            -- melody so the D major opens out instead of stacking in one
            -- spot; the low D stays centre, where the bottom of a chord
            -- belongs.
            Sound.sequence
                [ blare 587 170, blare 740 170, blare 880 360
                , blare 988 160, blare 880 160, blare 784 160
                , Sound.decay 600 76
                    (Sound.chord
                        [ Sound.volume 22 (Sound.tone Sound.Square 587 950)
                        , Sound.pan (0 - 30) (Sound.volume 15 (Sound.tone Sound.Triangle 740 950))
                        , Sound.pan 30 (Sound.volume 15 (Sound.tone Sound.Triangle 880 950))
                        , Sound.volume 12 (Sound.tone Sound.Triangle 294 950)
                        ])
                ]

        CTriumph ->
            -- dawn at the root of the world: the full victory fanfare, a
            -- longer horn melody climbing to the octave and settling on a
            -- wide, sustained D-major sunrise chord over a deep bass D
            Sound.sequence
                [ blare 587 240, blare 740 240, blare 880 240, blare 1175 560
                , blare 988 200, blare 880 200, blare 784 200
                , blare 740 260, blare 587 260
                , Sound.decay 900 78
                    (Sound.chord
                        [ Sound.volume 22 (Sound.tone Sound.Square 587 1600)
                        , Sound.pan (0 - 32) (Sound.volume 16 (Sound.tone Sound.Triangle 740 1600))
                        , Sound.pan 32 (Sound.volume 16 (Sound.tone Sound.Triangle 880 1600))
                        , Sound.volume 14 (Sound.tone Sound.Triangle 294 1600)
                        , Sound.volume 12 (Sound.tone Sound.Triangle 147 1600)
                        ])
                ]

        CStart ->
            Sound.decay 70 0 (Sound.volume 22 (Sound.duty 25 (Sound.tone Sound.Square 660 80)))

        CBow ->
            -- the string is PLUCKED: that is the whole sound
            Sound.decay 60 0
                (Sound.chord
                    [ Sound.volume 22 (Sound.sweep 55 (Sound.duty 25 (Sound.tone Sound.Square 620 70)))
                    , Sound.volume 12 (Sound.tone Sound.Noise 0 30)
                    ])

        CAxeT ->
            -- the axe tumbles AWAY from you: the vibrato is the blade coming
            -- round, and it thins as the head travels
            Sound.decay 230 22 (Sound.volume 26 (Sound.vibrato 30 9 (Sound.sweep 70 (Sound.tone Sound.Sawtooth 210 240))))

        CFuse ->
            -- the lit flask sails off: the sizzle goes with it
            Sound.decay 250 40 (Sound.volume 12 (Sound.tone Sound.Noise 0 260))

        CBoom ->
            -- Surtr-fire. The front is noise and it dies fastest; under it a
            -- SINE falls out of the audible into the floor, which is the
            -- thump a hiss cannot make on its own (a wave with no harmonics
            -- is nothing but body); the sawtooth rips underneath both. All
            -- three collapse, because a blast has one moment and then only
            -- what is left of it.
            Sound.chord
                [ Sound.decay 220 0 (Sound.volume 46 (Sound.tone Sound.Noise 0 240))
                , Sound.decay 300 0 (Sound.volume 40 (Sound.sweep 38 (Sound.tone Sound.Sine 150 340)))
                , Sound.decay 260 0 (Sound.volume 16 (Sound.sweep 45 (Sound.tone Sound.Sawtooth 60 300)))
                ]

        CClank ->
            Sound.decay 30 0 (Sound.volume 18 (Sound.sweep 60 (Sound.tone Sound.Square 320 40)))

        CHowl ->
            -- a wolf throat: rises, holds, breaks downward
            Sound.sequence
                [ Sound.volume 20 (Sound.sweep 210 (Sound.vibrato 9 5 (Sound.tone Sound.Sawtooth 160 260)))
                , Sound.volume 22 (Sound.vibrato 9 5 (Sound.tone Sound.Sawtooth 340 280))
                , Sound.volume 16 (Sound.sweep 55 (Sound.tone Sound.Sawtooth 330 260))
                ]

        CSnarl ->
            Sound.chord
                [ Sound.volume 20 (Sound.sweep 70 (Sound.vibrato 40 12 (Sound.tone Sound.Sawtooth 120 190)))
                , Sound.volume 12 (Sound.tone Sound.Noise 0 120)
                ]

        CDeathCry ->
            -- Vigdis falls: a long, throat-deep dying groan that sags in
            -- pitch under a wide, failing vibrato as the breath runs out:
            -- it plays the whole time the eyes are sliding shut. A hiss of
            -- escaping air rides over it, and near the end the dull thud of
            -- the body settling on the barrow floor.
            --
            -- "As the breath runs out" was written into the pitch and not
            -- into the LEVEL: for two and a half seconds this held its full
            -- volume and then stopped. Now it empties, and the hiss empties
            -- with it, so the last half second is nearly gone before the
            -- body lands.
            Sound.chord
                [ Sound.decay 2300 10 (Sound.volume 32 (Sound.vibrato 30 7 (Sound.sweep 48 (Sound.tone Sound.Sawtooth 250 2600))))
                , Sound.decay 2200 8 (Sound.volume 14 (Sound.holdPitch 900 (Sound.sweep 150 (Sound.tone Sound.Triangle 250 2600))))
                , Sound.decay 1300 6 (Sound.volume 12 (Sound.tone Sound.Noise 0 1500))
                , Sound.sequence
                    [ Sound.rest 2100
                    , Sound.decay 150 0
                        (Sound.chord
                            [ Sound.volume 30 (Sound.sweep 35 (Sound.tone Sound.Triangle 72 180))
                            , Sound.volume 16 (Sound.tone Sound.Noise 0 80)
                            ])
                    ]
                ]

        CBark ->
            -- a hoarse howl-bark, "aaauu!": the voice jumps UP for a short
            -- attack ("a-"), then sags in one long fall to a low tail
            -- ("-aaauu"), with a rough mid-speed vibrato for the growl edge.
            -- Hoarseness comes from a quiet bed of ragged noise riding the
            -- WHOLE cry (breath in the throat), plus a low square chest
            -- resonance that joins under the falling part.
            --
            -- The "a-" keeps its shape: it is the animal filling its chest.
            -- Everything after it is the chest emptying, so it does.
            Sound.chord
                [ Sound.sequence
                    [ Sound.volume 19 (Sound.sweep 780 (Sound.tone Sound.Sawtooth 380 80))
                    , Sound.decay 400 8 (Sound.volume 22 (Sound.vibrato 26 15 (Sound.sweep 140 (Sound.tone Sound.Sawtooth 600 480))))
                    ]
                , Sound.decay 420 12 (Sound.volume 9 (Sound.tone Sound.Noise 0 520))
                , Sound.sequence
                    [ Sound.rest 60
                    , Sound.decay 380 12 (Sound.volume 10 (Sound.sweep 70 (Sound.tone Sound.Square 190 460)))
                    ]
                ]

        CBlink ->
            -- the volva's blink: a warbling whoosh as she tears out of here,
            -- then a bright rising shimmer as she snaps back into being
            -- somewhere else: loud enough to catch across the room.
            -- Leaving thins out; arriving does not.
            Sound.sequence
                [ Sound.decay 140 6 (Sound.vibrato 45 22 (Sound.volume 28 (Sound.sweep 170 (Sound.tone Sound.Sawtooth 780 150))))
                , Sound.volume 10 (Sound.tone Sound.Noise 0 60)
                , Sound.vibrato 30 26 (Sound.volume 24 (Sound.sweep 940 (Sound.tone Sound.Triangle 300 190)))
                ]

        CShatter ->
            Sound.decay 110 0
                (Sound.sequence
                    [ Sound.chord
                        [ Sound.volume 30 (Sound.tone Sound.Noise 0 140)
                        , Sound.volume 18 (Sound.sweep 50 (Sound.tone Sound.Triangle 240 120))
                        ]
                    , Sound.volume 12 (Sound.sweep 60 (Sound.tone Sound.Triangle 160 90))
                    ])

        CSecret ->
            -- secret found! A tiny three-note reveal chime (Zelda 1 spirit,
            -- our notes): a rest so the wall's crash lands first, then a
            -- quick NES-pulse rise up the D-major arpeggio, the last note
            -- held with vibrato over a triangle for sparkle.
            -- The two rising pulses stay square and flat, which is the sound
            -- being quoted; only the landing note rings out.
            Sound.sequence
                [ Sound.rest 200
                , Sound.volume 23 (Sound.duty 25 (Sound.tone Sound.Square 587 95))
                , Sound.volume 24 (Sound.duty 25 (Sound.tone Sound.Square 740 95))
                , Sound.decay 480 22
                    (Sound.chord
                        [ Sound.vibrato 12 7 (Sound.volume 26 (Sound.duty 25 (Sound.tone Sound.Square 880 560)))
                        , Sound.volume 12 (Sound.tone Sound.Triangle 440 560)
                        ])
                ]

        CArmor ->
            Sound.decay 70 25
                (Sound.sequence
                    [ Sound.volume 20 (Sound.duty 25 (Sound.tone Sound.Square 520 50))
                    , Sound.volume 22 (Sound.duty 25 (Sound.tone Sound.Square 780 90))
                    ])

        CClick ->
            Sound.decay 20 0 (Sound.volume 14 (Sound.tone Sound.Square 140 30))


-- held bed: a low drone that leans a few Hz sharper while anything is
-- hunting you (the ambient key retunes in place, so it GLIDES).
--
-- No decay here, and not for want of trying it: a drone is the one thing in
-- the barrow that is not struck, and the held path holds a level rather than
-- travelling to one anyway.
drone : Model -> Sound
drone m =
    Sound.volume (if m.hp <= 2 then 15 else 12)
        (Sound.vibrato 8 3
            (Sound.tone Sound.Triangle
                (50
                    + m.barrow * 8
                    + (if m.combatT > 0 then 7 else 0)
                    -- a wounded Vigdis hears the drone go WRONG: a minor
                    -- second against itself
                    + (if m.hp <= 2 then 13 else 0))
                800))


-- combat drums: 8 beats at 120 BPM = 4000 ms per voice, seamless.
--
-- Nothing in this kit is panned. Every voice of it lives below 170 Hz, and
-- low frequencies carry no direction: a drum placed off to one side down
-- there is not heard over there, it just makes the whole fight lean.


-- a kick is a SINE with a pitch envelope on it: 165 Hz falling to the floor
-- in the time a skin takes to stop moving. A triangle was an impression of a
-- kick and this is a kick, because the harmonics a triangle spends its
-- energy on are exactly the part of a drum that is not the drum.
-- 130 + 370 = 500 ms, the beat every voice of warDrums has to sum to.
drumKick : Sound
drumKick =
    Sound.sequence [ Sound.decay 120 0 (Sound.volume 48 (Sound.sweep 46 (Sound.tone Sound.Sine 165 130))), Sound.rest 370 ]


drumTom : Sound
drumTom =
    Sound.sequence [ Sound.rest 250, Sound.decay 100 0 (Sound.volume 26 (Sound.sweep 70 (Sound.tone Sound.Triangle 95 110))), Sound.rest 140 ]


-- the one voice that must NOT collapse: it is the pedal that fills the gap
-- the hits leave, and a war rhythm with nothing between the strikes is a
-- metronome
drumPulse : Sound
drumPulse =
    Sound.sequence [ Sound.volume 13 (Sound.duty 12 (Sound.tone Sound.Square 55 430)), Sound.rest 70 ]


warDrums : Sound
warDrums =
    Sound.chord
        [ Sound.sequence [ drumKick, drumKick, drumKick, drumKick, drumKick, drumKick, drumKick, drumKick ]
        , Sound.sequence [ drumTom, drumTom, drumTom, drumTom, drumTom, drumTom, drumTom, drumTom ]
        , Sound.sequence [ drumPulse, drumPulse, drumPulse, drumPulse, drumPulse, drumPulse, drumPulse, drumPulse ]
        ]
