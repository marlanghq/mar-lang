module Palette exposing (..)

-- One palette per barrow, and the distance-fog band that decides how much of
-- a colour survives the dark. The dark IS the renderer here, so these tables
-- are what the game looks like.

import Types exposing (..)
import Canvas exposing ( rgb )


stoneRGB : Int -> Rgb
stoneRGB b =
    case b of
        0 -> { r = 116, g = 128, b = 148 }
        1 -> { r = 138, g = 92, b = 60 }
        2 -> { r = 84, g = 122, b = 94 }
        3 -> { r = 70, g = 104, b = 128 }
        _ -> { r = 104, g = 64, b = 58 }


carvedRGB : Int -> Rgb
carvedRGB b =
    case b of
        0 -> { r = 98, g = 134, b = 158 }
        1 -> { r = 156, g = 108, b = 48 }
        2 -> { r = 70, g = 138, b = 104 }
        3 -> { r = 84, g = 132, b = 152 }
        _ -> { r = 140, g = 74, b = 60 }


torchRGB : Int -> Rgb
torchRGB b =
    case b of
        0 -> { r = 208, g = 148, b = 74 }
        1 -> { r = 224, g = 138, b = 58 }
        2 -> { r = 150, g = 196, b = 96 }
        3 -> { r = 110, g = 198, b = 208 }
        _ -> { r = 230, g = 96, b = 58 }


-- door bodies are DARKER than any barrow's stone, so a doorway never
-- melts into the wall around it; the bright timber frame does the rest
doorRGB : Bool -> Rgb
doorRGB rune =
    if rune then { r = 74, g = 54, b = 128 } else { r = 96, g = 66, b = 40 }


floorRGB : Int -> Rgb
floorRGB b =
    case b of
        0 -> { r = 66, g = 62, b = 70 }
        1 -> { r = 58, g = 42, b = 34 }
        2 -> { r = 34, g = 48, b = 38 }
        3 -> { r = 30, g = 46, b = 58 }
        _ -> { r = 44, g = 28, b = 26 }


ceilRGB : Int -> Rgb
ceilRGB b =
    case b of
        0 -> { r = 40, g = 44, b = 56 }
        1 -> { r = 34, g = 24, b = 20 }
        2 -> { r = 18, g = 28, b = 22 }
        3 -> { r = 16, g = 26, b = 36 }
        _ -> { r = 24, g = 14, b = 12 }


bloodRGB : Rgb
bloodRGB = { r = 132, g = 18, b = 22 }


boneRGB : Rgb
boneRGB = { r = 202, g = 192, b = 166 }


-- distance-fog band: percentage of the base color that survives the dark
bandPct : Int -> Int
bandPct d =
    if d < 1536 then 100
    else if d < 3072 then 74
    else if d < 5632 then 50
    else if d < 8704 then 30
    else 12


-- fog + dawn in one place: f is the surviving percentage, dawn (0..100)
-- floods everything toward morning gold when the rune goes home
shade : Int -> Rgb -> Int -> Color
shade dawn c f =
    let
        r0 = c.r * f // 100
        g0 = c.g * f // 100
        b0 = c.b * f // 100
    in
    rgb (r0 + (250 - r0) * dawn // 100)
        (g0 + (190 - g0) * dawn // 100)
        (b0 + (90 - b0) * dawn // 100)
