module Main exposing (main)

-- MYRKHEIM: a Wolfenstein-3D-class first-person shooter in Mar, with ZERO
-- language changes. The draugr jarl Skalli Half-Rot stole the Dawn Rune and
-- the sun cannot rise; you are Vigdis, last shieldmaiden of the waystone,
-- descending three barrows to take it back. Your spear carries Gungnir's
-- blessing: it never misses what it is aimed at and always returns to your
-- hand (which is the fiction for hitscan with no ammo).
--
-- HOW THE 3D WORKS (docs in SPEC.md §4): a DDA raycaster in Int fixed point,
-- one map cell = 1024 units. The heading is QUANTIZED to 240 steps of 1.5°
-- and the direction vector comes from Math.sin and Math.cos, which read one
-- table built into every runtime, so a heading means the same on all three.
-- Each frame casts 160 rays (one per 2px column of the 320x200 view); wall
-- strips are flat-shaded by face side + distance-fog bands; enemies, gore,
-- pickups and bolts are billboard sprites depth-tested against the wall
-- distance at their screen column. The dark IS the renderer.
--
-- Controls: W/S move, A/D strafe, arrows turn, Space throw, M mute.
--   Gamepad: left stick moves and strafes, right stick turns, A throws,
--            Start/A starts, D-pad picks the saga on the title.
--   Touch: left pad walks AND steers (push to move, tilt to turn), right pad
--          strafes, the fire button throws, the button above it swaps weapon.
--
-- Run: mar dev examples/myrkheim   (port 3028)

import Balance exposing (..)
import Draw exposing (..)
import Hud exposing (..)
import Screens exposing (..)
import Sfx exposing (..)
import Sim exposing (..)
import Types exposing (..)
import World exposing (..)
import Canvas exposing ( canvas, group, onTap, rect, rgb, watchSize )




view : Model -> View Msg
view model =
    let
        lay = layout model
        scene =
            case model.mode of
                Title -> titleShapes model
                Intro -> introShapes model
                Play -> List.concat [ worldShapes model, hudShapes model ]
                Cleared -> List.concat [ worldShapes model, clearedShapes model ]
                Dead -> List.concat [ worldShapes model, dieShapes model ]
                Won -> List.concat [ worldShapes model, wonShapes model ]
    in
    -- onTap still carries the MENUS (title, dismiss, mute); the pointer
    -- mirror carries play, because only it says which finger is which.
    canvas Pixelated [ watchSize Resized, onTap Tapped, watchPointers Pointers ]
        (List.concat
            [ [ rect 0 0 model.w model.h (rgb 4 4 6)
              , group [ Canvas.Translate lay.ox lay.oy, Canvas.Scale lay.scale lay.scale ]
                    (List.concat [ scene, muteIcon model ])
              ]
            , touchPadShapes model
            ])




subscriptions : Model -> Sub Msg
subscriptions model =
    Sub.batch
        [ Time.every (Time.millis (1000 // fps)) (\_ -> Tick)
        , Keyboard.watch KeysChanged
        , Gamepad.watch PadChanged
        , Device.watch DeviceChanged
        , if model.mode == Play then
            Sound.glide (drone model)
          else
            Sub.none
        , if model.mode == Play && model.combatT > 0 then
            Sound.loop warDrums
          else
            Sub.none
        ]


page : Page
page =
    Page.create
        { path = "/"
        , title = "Myrkheim"
        , init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }


main : Cmd ()
main =
    App.frontend [ page ]
