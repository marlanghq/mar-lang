module Main exposing (main)


-- MYRKHEIM — a Wolfenstein-3D-class first-person shooter in Mar, with ZERO
-- language changes. The draugr jarl Skalli Half-Rot stole the Dawn Rune and
-- the sun cannot rise; you are Vigdis, last shieldmaiden of the waystone,
-- descending three barrows to take it back. Your spear carries Gungnir's
-- blessing: it never misses what it is aimed at and always returns to your
-- hand (which is the fiction for hitscan with no ammo).
--
-- HOW THE 3D WORKS (docs in SPEC.md §4): a DDA raycaster in Int fixed point,
-- one map cell = 1024 units. The heading is QUANTIZED to 240 steps of 1.5°
-- and the direction vector comes from a pasted lookup table (dirTable,
-- generated by tools/gen_tables.py) — no trig at runtime, no rotation drift.
-- Each frame casts 160 rays (one per 2px column of the 320x200 view); wall
-- strips are flat-shaded by face side + distance-fog bands; enemies, gore,
-- pickups and bolts are billboard sprites depth-tested against the wall
-- distance at their screen column. The dark IS the renderer.
--
-- Controls: W/S move, A/D strafe, arrows turn, Space throw, M mute.
--   Gamepad: left stick moves and strafes, right stick turns, A throws,
--            Start/A starts, D-pad picks the saga on the title.
--   Touch: left pad walks AND steers (push to move, tilt to turn), right pad
--          strafes, the fire button throws, the button above it swaps weapon.
--
-- Run: mar dev examples/myrkheim   (port 3028)


import Canvas exposing
    ( canvas, rect, triangle, circle, group, rgb
    , onTap, watchSize, onDrag, onRelease
    )
import Time


-- ===== logical screen (scaled to fit the window, pixels stay chunky) =====


gameW : Int
gameW = 320


gameH : Int
gameH = 200


fps : Int
fps = 60


-- ===== raycaster constants =====


k1 : Int
k1 = 1024                 -- one map cell, in fixed-point units


nCols : Int
nCols = 160               -- rays per frame (2px columns)


fovP : Int
fovP = 683                -- camera plane length /1024 (~67 degree FOV)


maxDda : Int
maxDda = 40               -- DDA step cap (a 24x24 map never needs more)


farD : Int
farD = 11264              -- treat anything past 11 cells as pitch black


-- ===== gameplay constants =====


playerR : Int
playerR = 240             -- collision radius, units


walkF : Int
walkF = 60                -- forward speed, units/tick


walkS : Int
walkS = 45                -- strafe / backpedal speed


-- weapon ids: 0 seax (melee, a arma inicial), 1 Gungnir spear (hitscan,
-- FOUND on a pedestal), 2 hunting bow (found; uses arrows), 3 hewing axe
-- (heavy projectile), 4 Surtr-fire flask (lobbed, explodes). Everything
-- past the seax is FOUND in the barrows — classic FPS progression
wcool : Int -> Int
wcool w =
    case w of
        0 -> 22
        2 -> 20
        3 -> 46
        4 -> 62
        _ -> 36


-- ===== small Int helpers (no Basics in Mar) =====




iclamp : Int -> Int -> Int -> Int
iclamp lo hi v = max lo (min hi v)


absI : Int -> Int
absI n = if n < 0 then 0 - n else n



range : Int -> List Int
range n =
    List.indexedMap (\i _ -> i) (List.repeat n 0)


-- octagonal length approximation: within ~7% of the true distance and
-- needs no square root — plenty for ranges, pickups and normalization
octDist : Int -> Int -> Int
octDist dx dy =
    let
        ax = absI dx
        ay = absI dy
    in
    max ax ay + min ax ay * 3 // 8


-- Threads a Random.Seed through the sim so gore and wraith moods are random
-- but the model stays a plain record (dev-dock time travel keeps working). A
-- thin adapter over the stdlib: value first out of Random.step, seed flipped to
-- the front so the (seed, value) call sites stay unchanged.
rnd : Random.Seed -> Int -> (Random.Seed, Int)
rnd seed n =
    let
        (v, s2) = Random.step (Random.int 0 (max 1 n - 1)) seed
    in
    ( s2, v )


