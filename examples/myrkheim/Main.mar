-- how many barrows the crawl runs; the last one's waystone is dawn
barrowCount : Int
barrowCount = 5


lastBarrow : Int
lastBarrow = barrowCount - 1


barrowName : Int -> String
barrowName b =
    case b of
        0 -> "HOWE OF ASH"
        1 -> "IRON DEEP"
        2 -> "HELS THRESHOLD"
        3 -> "THE DROWNED VAULT"
        _ -> "JAWS OF NIDHOGG"


barrowLine : Int -> String
barrowLine b =
    case b of
        0 -> "THE COLD REMEMBERS YOU"
        1 -> "IRON DOES NOT RUST DOWN HERE. IT WAITS"
        2 -> "THE DOOR TO HEL OPENS INWARD"
        3 -> "THE TIDE TOOK THEM. IT LEFT THEIR HUNGER"
        _ -> "AT THE ROOT OF THE WORLD, SOMETHING CHEWS"


spawnHeading : Int -> Int
spawnHeading b =
    case b of
        0 -> 0            -- east
        1 -> 180          -- north
        _ -> 0            -- east


-- ===== palettes (per barrow) =====


type alias Rgb =
    { r : Int, g : Int, b : Int }


stoneRGB : Int -> Rgb
stoneRGB b =
    case b of
        0 -> { r = 116, g = 128, b = 148 }
        1 -> { r = 138, g = 92, b = 60 }
        2 -> { r = 84, g = 122, b = 94 }
        3 -> { r = 70, g = 104, b = 128 }
        _ -> { r = 104, g = 64, b = 58 }


carvedRGB : Int -> Rgb
carvedRGB b =
    case b of
        0 -> { r = 98, g = 134, b = 158 }
        1 -> { r = 156, g = 108, b = 48 }
        2 -> { r = 70, g = 138, b = 104 }
        3 -> { r = 84, g = 132, b = 152 }
        _ -> { r = 140, g = 74, b = 60 }


torchRGB : Int -> Rgb
torchRGB b =
    case b of
        0 -> { r = 208, g = 148, b = 74 }
        1 -> { r = 224, g = 138, b = 58 }
        2 -> { r = 150, g = 196, b = 96 }
        3 -> { r = 110, g = 198, b = 208 }
        _ -> { r = 230, g = 96, b = 58 }


-- door bodies are DARKER than any barrow's stone, so a doorway never
-- melts into the wall around it; the bright timber frame does the rest
doorRGB : Bool -> Rgb
doorRGB rune =
    if rune then { r = 74, g = 54, b = 128 } else { r = 96, g = 66, b = 40 }


floorRGB : Int -> Rgb
floorRGB b =
    case b of
        0 -> { r = 66, g = 62, b = 70 }
        1 -> { r = 58, g = 42, b = 34 }
        2 -> { r = 34, g = 48, b = 38 }
        3 -> { r = 30, g = 46, b = 58 }
        _ -> { r = 44, g = 28, b = 26 }


ceilRGB : Int -> Rgb
ceilRGB b =
    case b of
        0 -> { r = 40, g = 44, b = 56 }
        1 -> { r = 34, g = 24, b = 20 }
        2 -> { r = 18, g = 28, b = 22 }
        3 -> { r = 16, g = 26, b = 36 }
        _ -> { r = 24, g = 14, b = 12 }


bloodRGB : Rgb
bloodRGB = { r = 132, g = 18, b = 22 }


boneRGB : Rgb
boneRGB = { r = 202, g = 192, b = 166 }


-- distance-fog band: percentage of the base color that survives the dark
bandPct : Int -> Int
bandPct d =
    if d < 1536 then 100
    else if d < 3072 then 74
    else if d < 5632 then 50
    else if d < 8704 then 30
    else 12


-- fog + dawn in one place: f is the surviving percentage, dawn (0..100)
-- floods everything toward morning gold when the rune goes home
shade : Int -> Rgb -> Int -> Color
shade dawn c f =
    let
        r0 = c.r * f // 100
        g0 = c.g * f // 100
        b0 = c.b * f // 100
    in
    rgb (r0 + (250 - r0) * dawn // 100)
        (g0 + (190 - g0) * dawn // 100)
        (b0 + (90 - b0) * dawn // 100)


-- ===== types =====


type Mode
    = Title
    | Intro
    | Play
    | Cleared
    | Dead
    | Won


type St
    = ASleep
    | AChase
    | AWind Int
    | ARec Int
    | ASum Int
    | ADie Int


type Cue
    = CThrow
    | CReturn
    | CHitF
    | CDieD
    | CYelp
    | CGroan
    | CWhine
    | CBolt
    | CDoor
    | CLocked
    | CRune
    | CGold
    | CHorn
    | CHurt
    | CBell
    | CJarl
    | CDawn
    | CStart
    | CBow
    | CAxeT
    | CFuse
    | CBoom
    | CClank
    | CHowl
    | CSnarl
    | CBark
    | CDeathCry
    | CBlink
    | CShatter
    | CSecret
    | CArmor
    | CClick
    | CFanfare
    | CTriumph


type alias Actor =
    { kind : Int              -- 0 draugr, 1 wraith, 2 jarl, 3 varg, 4 skjald, 5 volva, 6 archer
    , x : Int
    , y : Int
    , hp : Int
    , st : St
    , sdir : Int              -- wraith/volva strafe direction
    , fT : Int                -- hit-flash ticks
    , bt : Int                -- volva blink cooldown (idle for the others)
    , idx : Int               -- stable index, staggers AI checks
    }


type alias Door =
    { cx : Int, cy : Int, rune : Bool, openT : Int }   -- openT -1 shut, >0 draining


type alias Item =
    { kind : Int              -- 0 rune, 1 horn, 2 gold, 3 waystone
    , x : Int
    , y : Int
    , taken : Bool
    }


type alias Pile =
    { x : Int, y : Int, big : Bool }


type alias Bolt =
    { x : Int, y : Int, vx : Int, vy : Int }


-- player-side projectiles: kind 1 arrow, 2 axe, 3 flask, 9 spear tracer
-- (pure light, no damage — the hit already resolved by hitscan)
type alias PBolt =
    { x : Int, y : Int, vx : Int, vy : Int, kind : Int, t : Int }


type alias Boom =
    { x : Int, y : Int, t : Int }


type alias Gib =
    { x : Int, y : Int, vx : Int, vy : Int, t : Int }


type alias Model =
    { mode : Mode
    , modeT : Int
    , hardcore : Bool
    , sel : Int
    , barrow : Int
    , tick : Int
    , seed : Random.Seed
    , w : Int
    , h : Int
    , px : Int
    , py : Int
    , heading : Int
    , cool : Int
    , hp : Int
    , invulnT : Int
    , hurtT : Int
    , hasRune : Bool
    , runeBlink : Int
    , pickMsg : String        -- last item grabbed (discreet on-screen note)
    , pickT : Int             -- ticks the note lingers
    , gold : Int
    , kills : Int
    , timeT : Int
    , snapGold : Int
    , snapKills : Int
    , weapon : Int
    , hasSpear : Bool
    , hasBow : Bool
    , arrows : Int
    , axes : Int
    , flasks : Int
    , armor : Int
    , secretsFound : Int
    , secretsTotal : Int
    , mapRuns : List { x : Int, y : Int, w : Int }
    , snapArrows : Int
    , snapAxes : Int
    , snapFlasks : Int
    , snapArmor : Int
    , grid : Dict Int Int
    , doors : List Door
    , actors : List Actor
    , bolts : List Bolt
    , pbolts : List PBolt
    , booms : List Boom
    , items : List Item
    , piles : List Pile
    , gibs : List Gib
    , jarlS1 : Bool
    , jarlS2 : Bool
    , combatT : Int
    , lockT : Int
    , kF : Bool
    , kB : Bool
    , kSL : Bool
    , kSR : Bool
    , kTL : Bool
    , kTR : Bool
    , fireHeld : Bool
    , fireQ : Bool
    , padA : Bool
    , padX : Int
    , padY : Int
    , padRX : Int                         -- right analog stick X = look/turn
    , keysDown : List Keyboard.Key        -- held-key mirror (Keyboard.watch)
    , padDown : List Gamepad.Button       -- held-button mirror (Gamepad.watch)
    , padMove : Maybe { dx : Int, dy : Int }
    , padTurn : Maybe Int
    , lastDragX : Maybe Int
    , dev : Maybe Device
    , muted : Bool
    , sfx : List Cue
    }


type Msg
    = Tick
    | Resized Int Int
    | Tapped Int Int
    | Dragged Int Int
    | Released Int Int
    | KeysChanged { down : List Keyboard.Key }
    | PadChanged { connected : Bool, leftX : Int, leftY : Int, rightX : Int, rightY : Int, down : List Gamepad.Button }
    | DeviceChanged Device


-- ===== world building =====


type alias Cell =
    { x : Int, y : Int, ch : Char }


type alias World =
    { pairs : List (Int, Int)
    , doors : List Door
    , actors : List Actor
    , items : List Item
    , piles : List Pile
    , sx : Int
    , sy : Int
    }


solidCode : Char -> Int
solidCode ch =
    case ch of
        '#' -> 1
        '%' -> 2
        'T' -> 3
        'd' -> 4
        'D' -> 5
        'C' -> 6
        _ -> 0


parseCells : List String -> List Cell
parseCells rows =
    List.concat
        (List.indexedMap
            (\y row ->
                List.indexedMap (\x ch -> { x = x, y = y, ch = ch }) (String.toList row))
            rows)


emptyWorld : World
emptyWorld =
    { pairs = [], doors = [], actors = [], items = [], piles = [], sx = 2048, sy = 2048 }


maxHpOf : Int -> Int
maxHpOf kind =
    case kind of
        0 -> 4          -- draugr: the workhorse melee, one more pip now
        1 -> 5          -- wraith: the caster hangs back, so give it teeth
        2 -> 30         -- the Jarl: a longer boss fight
        3 -> 3          -- varg: still glassy, but no longer one-shot
        4 -> 6          -- skjaldmaer: her shield already stalls you; tankier
        6 -> 5          -- draug-archer: the ranged bowman (new)
        _ -> 8          -- volva: the elite blinker, tankiest


actorFor : Int -> Int -> Int -> Actor
actorFor kind cx cy =
    { kind = kind
    , x = cx * k1 + 512
    , y = cy * k1 + 512
    , hp = maxHpOf kind
    , st = ASleep
    , sdir = 1
    , fT = 0
    , bt = 40 + modBy 80 (cx * 7 + cy * 13)
    , idx = 0
    }


itemFor : Int -> Int -> Int -> Item
itemFor kind cx cy =
    { kind = kind, x = cx * k1 + 512, y = cy * k1 + 512, taken = False }


buildWorld : List String -> World
buildWorld rows =
    let
        step =
            \c acc ->
                let
                    code = solidCode c.ch
                    key = c.y * 24 + c.x
                in
                if code > 0 then
                    let
                        acc2 = { acc | pairs = (key, code) :: acc.pairs }
                    in
                    if code == 4 || code == 5 then
                        { acc2 | doors = { cx = c.x, cy = c.y, rune = code == 5, openT = 0 - 1 } :: acc2.doors }
                    else
                        acc2
                else
                    case c.ch of
                        'P' -> { acc | sx = c.x * k1 + 512, sy = c.y * k1 + 512 }
                        'E' -> { acc | actors = actorFor 0 c.x c.y :: acc.actors }
                        'W' -> { acc | actors = actorFor 1 c.x c.y :: acc.actors }
                        'J' -> { acc | actors = actorFor 2 c.x c.y :: acc.actors }
                        'v' -> { acc | actors = actorFor 3 c.x c.y :: acc.actors }
                        'k' -> { acc | actors = actorFor 4 c.x c.y :: acc.actors }
                        'q' -> { acc | actors = actorFor 5 c.x c.y :: acc.actors }
                        'y' -> { acc | actors = actorFor 6 c.x c.y :: acc.actors }
                        'R' -> { acc | items = itemFor 0 c.x c.y :: acc.items }
                        'H' -> { acc | items = itemFor 1 c.x c.y :: acc.items }
                        'G' -> { acc | items = itemFor 2 c.x c.y :: acc.items }
                        'X' -> { acc | items = itemFor 3 c.x c.y :: acc.items }
                        'o' -> { acc | items = itemFor 4 c.x c.y :: acc.items }
                        'x' -> { acc | items = itemFor 5 c.x c.y :: acc.items }
                        'f' -> { acc | items = itemFor 6 c.x c.y :: acc.items }
                        'a' -> { acc | items = itemFor 7 c.x c.y :: acc.items }
                        'A' -> { acc | items = itemFor 8 c.x c.y :: acc.items }
                        'u' -> { acc | items = itemFor 9 c.x c.y :: acc.items }
                        'b' -> { acc | items = itemFor 10 c.x c.y :: acc.items }
                        'p' -> { acc | piles = { x = c.x * k1 + 512, y = c.y * k1 + 512, big = False } :: acc.piles }
                        _ -> acc
    in
    List.foldl step emptyWorld (parseCells rows)


-- (re)enter a barrow: fresh world, fresh actors, score snapshot for Saga
initBarrow : Int -> Model -> Model
initBarrow b model =
    let
        w = buildWorld (mapFor b)
    in
    { model
        | mode = Intro
        , modeT = 0
        , barrow = b
        , px = w.sx
        , py = w.sy
        , heading = spawnHeading b
        , cool = 0
        , hp = 6
        , invulnT = 0
        , hurtT = 0
        , hasRune = False
        , runeBlink = 0
        , pickMsg = ""
        , pickT = 0
        , timeT = 0
        , snapGold = model.gold
        , snapKills = model.kills
        , snapArrows = model.arrows
        , snapAxes = model.axes
        , snapFlasks = model.flasks
        , snapArmor = model.armor
        , secretsFound = 0
        , secretsTotal =
            List.length (List.filter (\c -> c.ch == 'C') (parseCells (mapFor b)))
        , items =
            List.filter
                (\it -> (it.kind == 9 && model.hasSpear) == False && (it.kind == 10 && model.hasBow) == False)
                w.items
        , pbolts = []
        , booms = []
        , grid = Dict.fromList w.pairs
        , mapRuns = computeRuns (Dict.fromList w.pairs)
        , doors = w.doors
        , actors = List.indexedMap (\i a -> { a | idx = i }) w.actors
        , bolts = []
        , piles = w.piles
        , gibs = []
        , jarlS1 = False
        , jarlS2 = False
        , combatT = 0
        , lockT = 0
        , kF = False
        , kB = False
        , kSL = False
        , kSR = False
        , kTL = False
        , kTR = False
        , fireHeld = False
        , fireQ = False
        , padA = False
        , padMove = Nothing
        , padTurn = Nothing
        , lastDragX = Nothing
        , sfx = CStart :: model.sfx
    }


initModel : Model
initModel =
    { mode = Title
    , modeT = 0
    , hardcore = False
    , sel = 0
    , barrow = 0
    , tick = 0
    , seed = Random.initialSeed 20260707
    , w = 960
    , h = 600
    , px = 2048
    , py = 2048
    , heading = 0
    , cool = 0
    , hp = 6
    , invulnT = 0
    , hurtT = 0
    , hasRune = False
    , runeBlink = 0
    , pickMsg = ""
    , pickT = 0
    , gold = 0
    , kills = 0
    , timeT = 0
    , snapGold = 0
    , snapKills = 0
    , weapon = 0
    , hasSpear = False
    , hasBow = False
    , arrows = 0
    , axes = 0
    , flasks = 0
    , armor = 0
    , secretsFound = 0
    , secretsTotal = 0
    , mapRuns = []
    , snapArrows = 0
    , snapAxes = 0
    , snapFlasks = 0
    , snapArmor = 0
    , grid = Dict.fromList []
    , doors = []
    , actors = []
    , bolts = []
    , pbolts = []
    , booms = []
    , items = []
    , piles = []
    , gibs = []
    , jarlS1 = False
    , jarlS2 = False
    , combatT = 0
    , lockT = 0
    , kF = False
    , kB = False
    , kSL = False
    , kSR = False
    , kTL = False
    , kTR = False
    , fireHeld = False
    , fireQ = False
    , padA = False
    , padX = 0
    , padY = 0
    , padRX = 0
    , keysDown = []
    , padDown = []
    , padMove = Nothing
    , padTurn = Nothing
    , lastDragX = Nothing
    , dev = Nothing
    , muted = False
    , sfx = []
    }


init : (Model, Cmd Msg)
init =
    ( initModel, Cmd.none )


-- ===== grid queries =====


cellAt : Dict Int Int -> Int -> Int -> Int
cellAt grid cx cy =
    if cx < 0 || cx > 23 || cy < 0 || cy > 23 then
        1
    else
        Dict.get (cy * 24 + cx) grid |> Maybe.withDefault 0


-- the minimap pre-bakes each row of solid cells into horizontal runs so
-- drawing it costs ~100 rects, not 576. Doors are skipped here (drawn
-- separately in their own color) and cracked walls look like plain stone,
-- so secrets stay secret. Recomputed only when the grid actually changes
-- (barrow start, a door opening, a wall shattering)
computeRuns : Dict Int Int -> List { x : Int, y : Int, w : Int }
computeRuns grid =
    List.concatMap (\y -> rowRuns grid y 0 Nothing []) (range 24)


rowRuns : Dict Int Int -> Int -> Int -> Maybe Int -> List { x : Int, y : Int, w : Int } -> List { x : Int, y : Int, w : Int }
rowRuns grid y x open acc =
    let
        code = cellAt grid x y
        solid = x < 24 && code > 0 && code /= 4 && code /= 5
    in
    if x >= 24 then
        case open of
            Just x0 -> { x = x0, y = y, w = x - x0 } :: acc
            Nothing -> acc
    else
        case open of
            Just x0 ->
                if solid then
                    rowRuns grid y (x + 1) open acc
                else
                    rowRuns grid y (x + 1) Nothing ({ x = x0, y = y, w = x - x0 } :: acc)

            Nothing ->
                if solid then
                    rowRuns grid y (x + 1) (Just x) acc
                else
                    rowRuns grid y (x + 1) Nothing acc


solidAtPt : Dict Int Int -> Int -> Int -> Bool
solidAtPt grid x y =
    cellAt grid (x // k1) (y // k1) > 0


canStand : Dict Int Int -> Int -> Int -> Bool
canStand grid x y =
    (solidAtPt grid (x - playerR) (y - playerR)
        || solidAtPt grid (x + playerR) (y - playerR)
        || solidAtPt grid (x - playerR) (y + playerR)
        || solidAtPt grid (x + playerR) (y + playerR))
        == False


-- straight-line sight test, sampled every ~quarter cell. Cheap and good
-- enough for AI; the renderer never uses this (it has real rays)
losClear : Dict Int Int -> Int -> Int -> Int -> Int -> Bool
losClear grid ax ay bx by =
    let
        n = iclamp 1 48 (octDist (bx - ax) (by - ay) // 224)
    in
    losStep grid ax ay bx by n 1


losStep : Dict Int Int -> Int -> Int -> Int -> Int -> Int -> Int -> Bool
losStep grid ax ay bx by n i =
    if i >= n then
        True
    else if solidAtPt grid (ax + (bx - ax) * i // n) (ay + (by - ay) * i // n) then
        False
    else
        losStep grid ax ay bx by n (i + 1)


-- ===== the raycaster =====


type alias Hit =
    { d : Int, side : Int, code : Int, cx : Int, cy : Int, fr : Int }


type alias CastEnv =
    { grid : Dict Int Int
    , px : Int
    , py : Int
    , dx : Int
    , dy : Int
    , plx : Int
    , ply : Int
    }


castEnv : Model -> CastEnv
castEnv m =
    let
        d = dirAt m.heading
    in
    { grid = m.grid
    , px = m.px
    , py = m.py
    , dx = d.x
    , dy = d.y
    , plx = (0 - d.y) * fovP // k1
    , ply = d.x * fovP // k1
    }


-- one ray: classic DDA over the cell grid, everything x1024 fixed point.
-- t is scaled so crossing one full cell straight-on costs 1024.
castCol : CastEnv -> Int -> Hit
castCol env col =
    let
        camX = k1 * (2 * col - (nCols - 1)) // (nCols - 1)
        rdx0 = env.dx + env.plx * camX // k1
        rdy0 = env.dy + env.ply * camX // k1
        rdx = if rdx0 == 0 then 1 else rdx0
        rdy = if rdy0 == 0 then 1 else rdy0
        mapX = env.px // k1
        mapY = env.py // k1
        dltX = absI (1048576 // rdx)
        dltY = absI (1048576 // rdy)
        sx = if rdx < 0 then 0 - 1 else 1
        sy = if rdy < 0 then 0 - 1 else 1
        sideX = if rdx < 0 then (env.px - mapX * k1) * dltX // k1 else ((mapX + 1) * k1 - env.px) * dltX // k1
        sideY = if rdy < 0 then (env.py - mapY * k1) * dltY // k1 else ((mapY + 1) * k1 - env.py) * dltY // k1
    in
    dda env mapX mapY sideX sideY dltX dltY sx sy rdx rdy 0


dda : CastEnv -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> Hit
dda env mapX mapY sideX sideY dltX dltY sx sy rdx rdy n =
    if n > maxDda then
        { d = farD, side = 0, code = 1, cx = mapX, cy = mapY, fr = 512 }
    else if sideX < sideY then
        let
            mx = mapX + sx
            code = cellAt env.grid mx mapY
        in
        if code > 0 then
            let
                d = max 40 sideX
            in
            { d = d, side = 0, code = code, cx = mx, cy = mapY, fr = modBy k1 (env.py + rdy * d // k1) }
        else
            dda env mx mapY (sideX + dltX) sideY dltX dltY sx sy rdx rdy (n + 1)
    else
        let
            my = mapY + sy
            code = cellAt env.grid mapX my
        in
        if code > 0 then
            let
                d = max 40 sideY
            in
            { d = d, side = 1, code = code, cx = mapX, cy = my, fr = modBy k1 (env.px + rdx * d // k1) }
        else
            dda env mapX my sideX (sideY + dltY) dltX dltY sx sy rdx rdy (n + 1)


colDepth : List Hit -> Int -> Int
colDepth cols c =
    List.drop c cols
        |> List.head
        |> Maybe.map (\h -> h.d)
        |> Maybe.withDefault farD


-- ===== update =====


emit : Model -> (Model, Cmd Msg)
emit model =
    if List.length model.sfx == 0 then
        ( model, Cmd.none )
    else
        ( { model | sfx = [] }
        , Cmd.batch (List.map (\c -> Sound.play (cueSound c)) model.sfx)
        )


update : Msg -> Model -> (Model, Cmd Msg)
update msg model =
    case msg of
        Resized w h ->
            ( { model | w = w, h = h }, Cmd.none )

        Tick ->
            case model.mode of
                Play -> emit (stepPlay model)
                Title -> ( { model | tick = model.tick + 1 }, Cmd.none )
                Won -> emit { model | tick = model.tick + 1, modeT = model.modeT + 1 }
                _ ->
                    -- between-screens (Intro / Cleared / Dead) only advance
                    -- the clock; the phase NEVER starts on its own — the
                    -- player presses a key to descend (see advance / Tapped)
                    ( { model | tick = model.tick + 1, modeT = model.modeT + 1 }, Cmd.none )

        Tapped x y ->
            if inMuteZone model x y then
                toggleMute model
            else
                case model.mode of
                    Play -> ( applyTouch True model x y, Cmd.none )
                    Title -> emit (titleTap model x y)
                    _ ->
                        if canDismiss model then emit (advance model) else ( model, Cmd.none )

        Dragged x y ->
            if model.mode == Play then
                ( applyTouch False model x y, Cmd.none )
            else
                ( model, Cmd.none )

        Released x y ->
            ( releaseTouch model x y, Cmd.none )

        KeysChanged st ->
            -- held movement/fire is mirrored wholesale (syncHeld, gated to
            -- Play so a menu-dismiss key can't seed a step or a spear-throw
            -- into the barrow's first frame); weapon/mute/menu actions fire
            -- on the press-edge (keys NEW to the set). Releases are automatic
            -- — a key simply leaves the set, so syncHeld drops it next frame.
            let
                pressed = List.filter (\k -> List.member k model.keysDown == False) st.down
                m1 = { model | keysDown = st.down }
                base = if model.mode == Play then syncHeld m1 else m1
            in
            List.foldl applyKeyPress ( base, Cmd.none ) pressed

        PadChanged p ->
            -- ONE snapshot carries BOTH sticks: LEFT (leftX/leftY) moves and
            -- strafes, RIGHT (rightX) turns/looks. The analog axes are stored
            -- straight from the snapshot; A-held fire and the weapon/menu
            -- edges fold in from p.down. rightY is unused (turning rides X).
            let
                pressed = List.filter (\b -> List.member b model.padDown == False) p.down
                m1 = { model | padDown = p.down, padX = p.leftX, padY = p.leftY, padRX = p.rightX }
                base = if model.mode == Play then syncHeld m1 else m1
            in
            List.foldl applyPadPress ( base, Cmd.none ) pressed

        DeviceChanged d ->
            ( { model | dev = Just d }, Cmd.none )


-- the held movement/fire mirror: recompute the digital held bools from the
-- raw key/button sets. Called only while playing, so a menu-dismiss press
-- can never seed movement or a spear-throw into the first frame of a barrow.
-- The analog sticks (padX/padY/padRX) are set straight from the snapshot in
-- update; releases need no code — a key just leaves keysDown/padDown and the
-- next syncHeld drops it (keyboard AND gamepad feed their own bools, summed
-- later in stepMove: keys are digital, the sticks analog).
syncHeld : Model -> Model
syncHeld m =
    let
        k = \key -> List.member key m.keysDown
    in
    { m
        | kF = k Keyboard.KeyW || k Keyboard.ArrowUp
        , kB = k Keyboard.KeyS || k Keyboard.ArrowDown
        , kSL = k Keyboard.KeyA
        , kSR = k Keyboard.KeyD
        , kTL = k Keyboard.ArrowLeft
        , kTR = k Keyboard.ArrowRight
        , fireHeld = k Keyboard.Space
        , padA = List.member Gamepad.A m.padDown
    }


-- discrete on-DOWN keys while playing: the number row picks a weapon, Q
-- cycles. Movement/fire keys are held (syncHeld), so they no-op here.
playKeyEdge : Keyboard.Key -> Model -> Model
playKeyEdge key m =
    case key of
        Keyboard.Digit1 -> setWeapon 0 m
        Keyboard.Digit2 -> setWeapon 1 m
        Keyboard.Digit3 -> setWeapon 2 m
        Keyboard.Digit4 -> setWeapon 3 m
        Keyboard.Digit5 -> setWeapon 4 m
        Keyboard.KeyQ -> cycleWeapon m
        _ -> m


-- press-edge for one key that JUST went down (folded over, threading the
-- Cmd). M mutes in any mode; otherwise Play switches weapons, Title moves
-- the saga cursor / starts, and a between-screen advances once its hold has
-- elapsed. Play edges queue their click in sfx for the next Tick (exactly as
-- the old KeyDown did — Cmd.none); menu edges emit right away.
applyKeyPress : Keyboard.Key -> (Model, Cmd Msg) -> (Model, Cmd Msg)
applyKeyPress key acc =
    let
        (m, cmd) = acc
    in
    if key == Keyboard.KeyM then
        let
            (m2, c2) = toggleMute m
        in
        ( m2, Cmd.batch [ cmd, c2 ] )
    else
        case m.mode of
            Play ->
                ( playKeyEdge key m, cmd )

            Title ->
                let
                    (m2, c2) = emit (titleKey m key)
                in
                ( m2, Cmd.batch [ cmd, c2 ] )

            _ ->
                if canDismiss m then
                    let
                        (m2, c2) = emit (advance m)
                    in
                    ( m2, Cmd.batch [ cmd, c2 ] )
                else
                    ( m, cmd )


-- press-edge for one gamepad button. Play: B cycles the weapon (the A-fire is
-- held via syncHeld, so it is not an edge here). Title: Start/A starts, D-pad
-- up/down moves the saga cursor. Between-screens: Start/A advances once
-- dismissable. Mirrors the old PadDown per-mode branching.
applyPadPress : Gamepad.Button -> (Model, Cmd Msg) -> (Model, Cmd Msg)
applyPadPress btn acc =
    let
        (m, cmd) = acc
    in
    case m.mode of
        Play ->
            if btn == Gamepad.B then
                ( cycleWeapon m, cmd )
            else
                ( m, cmd )

        Title ->
            if btn == Gamepad.Start || btn == Gamepad.A then
                let
                    (m2, c2) = emit (startGame m)
                in
                ( m2, Cmd.batch [ cmd, c2 ] )
            else if btn == Gamepad.Up then
                let
                    (m2, c2) = emit { m | sel = 0 }
                in
                ( m2, Cmd.batch [ cmd, c2 ] )
            else if btn == Gamepad.Down then
                let
                    (m2, c2) = emit { m | sel = 1 }
                in
                ( m2, Cmd.batch [ cmd, c2 ] )
            else
                ( m, cmd )

        _ ->
            if canDismiss m && (btn == Gamepad.Start || btn == Gamepad.A) then
                let
                    (m2, c2) = emit (advance m)
                in
                ( m2, Cmd.batch [ cmd, c2 ] )
            else
                ( m, cmd )


setWeapon : Int -> Model -> Model
setWeapon w model =
    if w == model.weapon then
        model
    else if hasAmmo w model then
        { model | weapon = w, cool = min model.cool 8, sfx = CClick :: model.sfx }
    else
        { model | sfx = CClick :: model.sfx }


-- a arma está no cinto? (a seleção exige POSSE; disparar sem munição
-- vira o clique seco)
hasAmmo : Int -> Model -> Bool
hasAmmo w m =
    case w of
        1 -> m.hasSpear
        2 -> m.hasBow
        3 -> m.axes > 0
        4 -> m.flasks > 0
        _ -> True


-- Q steps to the next weapon that actually has ammo (spear always does)
cycleWeapon : Model -> Model
cycleWeapon model =
    let
        pick =
            List.filter (\w -> hasAmmo w model)
                [ modBy 5 (model.weapon + 1)
                , modBy 5 (model.weapon + 2)
                , modBy 5 (model.weapon + 3)
                , modBy 5 (model.weapon + 4)
                ]
    in
    setWeapon (Maybe.withDefault 0 (List.head pick)) model


toggleMute : Model -> (Model, Cmd Msg)
toggleMute model =
    let
        m2 = model.muted == False
    in
    ( { model | muted = m2 }, Sound.setMuted m2 )


titleKey : Model -> Keyboard.Key -> Model
titleKey model key =
    case key of
        Keyboard.KeyW -> { model | sel = 0 }
        Keyboard.ArrowUp -> { model | sel = 0 }
        Keyboard.KeyS -> { model | sel = 1 }
        Keyboard.ArrowDown -> { model | sel = 1 }
        Keyboard.Enter -> startGame model
        Keyboard.Space -> startGame model
        _ -> model


titleTap : Model -> Int -> Int -> Model
titleTap model x y =
    let
        lay = layout model
        ly = (y - lay.oy) * 100 // max 1 lay.scale
    in
    if ly >= 112 && ly < 136 then
        startGame { model | sel = 0 }
    else if ly >= 136 && ly < 160 then
        startGame { model | sel = 1 }
    else
        model


startGame : Model -> Model
startGame model =
    initBarrow 0
        { model
            | hardcore = model.sel == 1
            , gold = 0
            , kills = 0
            , weapon = 0
            , hasSpear = False
            , hasBow = False
            , arrows = 0
            , axes = 0
            , flasks = 0
            , armor = 0
        }


-- how long a between-screen must stay up before ANY input can dismiss
-- it. Most screens just debounce a key held over from the frame before
-- (12 ticks); the death screen holds ~3.5s so it can breathe while the
-- funeral march opens — you were fighting, holding fire, and shouldn't
-- blink past your own death.
holdTicks : Mode -> Int
holdTicks mode =
    case mode of
        -- Dead: eyes close (0..190), a beat of black silence (190..240),
        -- the verdict + hint fade in (240), then dismissable at 262
        Dead -> 262
        -- the between-barrow and victory screens lock for a few seconds so
        -- a shot fired the instant the waystone lit can't skip them unread
        Cleared -> 170
        Won -> 220
        _ -> 12


-- a between-screen accepts a dismissal only once its hold has elapsed
canDismiss : Model -> Bool
canDismiss model =
    model.modeT >= holdTicks model.mode


-- what a keypress does on the between screens
advance : Model -> Model
advance model =
    case model.mode of
        Intro -> { model | mode = Play, modeT = 0 }
        Cleared ->
            if model.barrow < lastBarrow then
                initBarrow (model.barrow + 1) model
            else
                { model | mode = Title, modeT = 0 }
        Dead ->
            if model.hardcore then
                { model | mode = Title, modeT = 0 }
            else
                let
                    restored =
                        { model
                            | gold = model.snapGold
                            , kills = model.snapKills
                            , arrows = model.snapArrows
                            , axes = model.snapAxes
                            , flasks = model.snapFlasks
                            , armor = model.snapArmor
                        }
                    -- the rollback can un-own the selected weapon (axes /
                    -- flasks picked up THIS run roll back to the entry
                    -- snapshot) — a dead slot must not stay selected. Fall
                    -- back to Gungnir if she has it, else the seax
                    rearmed =
                        if hasAmmo restored.weapon restored then
                            restored
                        else
                            { restored | weapon = if restored.hasSpear then 1 else 0 }
                in
                initBarrow model.barrow rearmed
        Won ->
            -- the hold is enforced by canDismiss (holdTicks Won); once it
            -- elapses, any key returns to the title
            { model | mode = Title, modeT = 0 }
        _ -> model


-- ===== touch pads =====


type alias Layout =
    { scale : Int, ox : Int, oy : Int }


layout : Model -> Layout
layout model =
    let
        -- Touch-only hardware with a TALL canvas (tablets): reserve a bottom
        -- strip so the twin sticks get a real bezel instead of sitting on top
        -- of the view and the weapon HUD (iPad landscape has no side bezels —
        -- its 4:3-ish aspect lets the picture fill the screen). Phones in
        -- landscape are too short to give anything up (their side bezels
        -- already host the sticks); desktop never shows pads.
        reserve = if padsWanted model.dev && model.h >= 640 then 132 else 0
        hAvail = model.h - reserve
        s = max 60 (min (model.w * 100 // gameW) (hAvail * 100 // gameH))
        slack = hAvail - gameH * s // 100
    in
    { scale = s
    , ox = (model.w - gameW * s // 100) // 2
    -- Portrait phones: seat the picture in the UPPER area (top margin = 1/6 of
    -- the vertical slack) instead of dead centre, so the roomy space BELOW
    -- holds the touch controls — padSpots already drops the pads into that
    -- bottom bezel. Landscape (wider than tall) stays vertically centred.
    , oy = if model.h > model.w then slack // 6 else slack // 2
    }


type alias Pads =
    { mcx : Int, mcy : Int, tcx : Int, tcy : Int, fx : Int, fy : Int }


padSpots : Model -> Pads
padSpots model =
    let
        lay = layout model
        gw = gameW * lay.scale // 100
        gh = gameH * lay.scale // 100
        bezL = lay.ox
        bezB = model.h - lay.oy - gh
        m =
            if bezL >= 96 then
                { x = bezL // 2, y = model.h * 2 // 3 }
            else if bezB >= 96 then
                { x = model.w // 4, y = lay.oy + gh + bezB // 2 }
            else
                { x = lay.ox + 76, y = lay.oy + gh - 76 }
        t =
            if bezL >= 96 then
                { x = model.w - bezL // 2, y = model.h * 2 // 3 }
            else if bezB >= 96 then
                { x = model.w * 3 // 4, y = lay.oy + gh + bezB // 2 }
            else
                { x = lay.ox + gw - 76, y = lay.oy + gh - 76 }

        -- ATK + switch: above the turn stick when there is head room (side
        -- bezels, deep portrait bezel), BESIDE it in a short bottom strip
        -- (tablet landscape) where "above" would poke into the picture.
        f =
            if bezL < 96 && bezB >= 96 && bezB < 230 then
                { x = min (model.w - 44) (t.x + 148), y = t.y + 16 }
            else
                { x = t.x, y = t.y - 98 }
    in
    { mcx = m.x, mcy = m.y, tcx = t.x, tcy = t.y, fx = f.x, fy = f.y }


inBox : Int -> Int -> Int -> Int -> Int -> Bool
inBox x y cx cy r =
    absI (x - cx) <= r && absI (y - cy) <= r


-- isPress = a fresh touch-down (Tapped); drags re-aim the sticks but must
-- NOT retrigger the SWITCH button — a button fires once per press
applyTouch : Bool -> Model -> Int -> Int -> Model
applyTouch isPress m x y =
    let
        p = padSpots m
    in
    if inBox x y p.fx (p.fy - 62) 24 then
        if isPress then cycleWeapon m else m
    else if inBox x y p.fx p.fy 34 then
        { m | fireQ = True }
    else if inBox x y p.mcx p.mcy 84 then
        { m | padMove = Just { dx = iclamp (0 - 60) 60 (x - p.mcx), dy = iclamp (0 - 60) 60 (y - p.mcy) } }
    else if inBox x y p.tcx p.tcy 84 then
        { m | padTurn = Just (iclamp (0 - 60) 60 (x - p.tcx)) }
    else
        -- free drag anywhere over the picture turns the view (desktop
        -- mouse included); 3 px of drag = one 1.5 degree heading step
        case m.lastDragX of
            Nothing ->
                { m | lastDragX = Just x }

            Just x0 ->
                let
                    ds = (x - x0) // 3
                in
                if ds == 0 then
                    m
                else
                    { m
                        | heading = modBy 240 (m.heading + ds + 240)
                        , lastDragX = Just (x0 + ds * 3)
                    }


releaseTouch : Model -> Int -> Int -> Model
releaseTouch model x y =
    let
        p = padSpots model
    in
    if inBox x y p.mcx p.mcy 108 then
        { model | padMove = Nothing, lastDragX = Nothing }
    else if inBox x y p.tcx p.tcy 108 || inBox x y p.fx p.fy 40 then
        { model | padTurn = Nothing, lastDragX = Nothing }
    else
        { model | lastDragX = Nothing, padMove = Nothing, padTurn = Nothing }


inMuteZone : Model -> Int -> Int -> Bool
inMuteZone model x y =
    let
        lay = layout model
        lx = (x - lay.ox) * 100 // max 1 lay.scale
        ly = (y - lay.oy) * 100 // max 1 lay.scale
    in
    lx >= 296 && lx <= 318 && ly >= 2 && ly <= 20


-- ===== the Play tick =====


stepPlay : Model -> Model
stepPlay model =
    model
        |> stepMove
        |> stepDoors
        |> stepFire
        |> stepActors
        |> stepBolts
        |> stepPBolts
        |> stepBooms
        |> stepGibs
        |> stepPickups
        |> stepTimers


stepMove : Model -> Model
stepMove m =
    let
        d = dirAt m.heading
        tp = Maybe.withDefault { dx = 0, dy = 0 } m.padMove
        -- Twin-stick, standard-FPS layout: LEFT stick moves (Y = forward/back,
        -- X = strafe), RIGHT stick turns (X = look). Gamepad.watch feeds padRX.
        stickF = if absI m.padY > 24 then (0 - m.padY) * walkF // 100 else 0
        stickS = if absI m.padX > 24 then m.padX * walkS // 100 else 0
        stickT = if absI m.padRX > 24 then m.padRX // 30 else 0
        fwd =
            iclamp (0 - walkS) walkF
                ((if m.kF then walkF else 0)
                    - (if m.kB then walkS else 0)
                    + stickF
                    + (0 - tp.dy) * walkF // 60)
        strafe =
            iclamp (0 - walkS) walkS
                ((if m.kSR then walkS else 0)
                    - (if m.kSL then walkS else 0)
                    + stickS
                    -- LEFT stick's horizontal strafes (standard dual-stick)
                    + tp.dx * walkS // 60)
        -- arrows turn a bit slower than a flat 2 steps/frame: alternate 1 and
        -- 2 by tick (~1.5 avg). A flat 2 felt too fast.
        aStep = 1 + modBy 2 m.tick
        turn =
            (if m.kTR then aStep else 0)
                - (if m.kTL then aStep else 0)
                + stickT
                -- RIGHT stick steers the view (look/turn)
                + (case m.padTurn of
                    Just off -> off // 20
                    Nothing -> 0)
        h2 = modBy 240 (m.heading + iclamp (0 - 4) 4 turn + 240)
        mvx = (d.x * fwd - d.y * strafe) // k1
        mvy = (d.y * fwd + d.x * strafe) // k1
        -- walls AND bodies block: without the actor check you could walk
        -- INSIDE a draugr, its center would sit behind you, and the spear's
        -- dot > 0 aim test could never find it. A body only blocks moves
        -- that CLOSE the distance: retreating out of a clinch always works
        free =
            \x y ->
                canStand m.grid x y
                    && List.any
                        (\a ->
                            isDead a.st == False
                                && octDist (a.x - x) (a.y - y) < 430
                                && octDist (a.x - x) (a.y - y) < octDist (a.x - m.px) (a.y - m.py))
                        m.actors
                        == False
        nx = if free (m.px + mvx) m.py then m.px + mvx else m.px
        ny = if free nx (m.py + mvy) then m.py + mvy else m.py
        -- walking into a shut door is the interact: probe half a cell ahead
        probe = cellAt m.grid ((nx + d.x * 480 // k1) // k1) ((ny + d.y * 480 // k1) // k1)
        m2 = { m | px = nx, py = ny, heading = h2 }
    in
    if fwd > 0 && (probe == 4 || probe == 5) then
        touchDoor m2 ((ny + d.y * 480 // k1) // k1) ((nx + d.x * 480 // k1) // k1)
    else
        m2


touchDoor : Model -> Int -> Int -> Model
touchDoor m cy cx =
    let
        hit = List.filter (\dr -> dr.cx == cx && dr.cy == cy && dr.openT < 0) m.doors
    in
    case List.head hit of
        Nothing ->
            m

        Just dr ->
            if dr.rune && m.hasRune == False then
                if m.lockT == 0 then
                    { m | lockT = 40, runeBlink = 40, sfx = CLocked :: m.sfx }
                else
                    m
            else
                { m
                    | doors =
                        List.map
                            (\o ->
                                if o.cx == cx && o.cy == cy then { o | openT = 18 } else o)
                            m.doors
                    , sfx = CDoor :: m.sfx
                }


stepDoors : Model -> Model
stepDoors m =
    let
        opened = List.filter (\dr -> dr.openT == 1) m.doors
        grid2 =
            List.foldl (\dr g -> Dict.insert (dr.cy * 24 + dr.cx) 0 g) m.grid opened
        doors2 =
            List.map (\dr -> if dr.openT > 0 then { dr | openT = dr.openT - 1 } else dr) m.doors
    in
    { m
        | grid = grid2
        , doors = doors2
        , mapRuns = if List.length opened > 0 then computeRuns grid2 else m.mapRuns
    }


-- the spear: hitscan along the center ray. Gungnir's blessing — if it is
-- aimed at flesh with a clear line, it hits, whatever the range
stepFire : Model -> Model
stepFire m =
    let
        want = (m.fireHeld || m.padA || m.fireQ) && m.cool == 0
        m0 = { m | fireQ = False }
    in
    if want == False then
        m0
    else if m.weapon == 0 then
        seaxSwing m0
    else if m.weapon == 2 then
        loose m0 1 150 (CBow :: m0.sfx) m0.arrows (\mm -> { mm | arrows = mm.arrows - 1 })
    else if m.weapon == 3 then
        loose m0 2 95 (CAxeT :: m0.sfx) m0.axes (\mm -> { mm | axes = mm.axes - 1 })
    else if m.weapon == 4 then
        loose m0 3 70 (CFuse :: m0.sfx) m0.flasks (\mm -> { mm | flasks = mm.flasks - 1 })
    else
        let
            d = dirAt m.heading
            aimed =
                List.filter
                    (\a ->
                        let
                            relX = a.x - m.px
                            relY = a.y - m.py
                            dot = d.x * relX + d.y * relY
                            perp = (d.x * relY - d.y * relX) // k1
                            rad = if a.kind == 2 then 470 else 310
                            -- point-blank forgiveness: inside ~1.5 cells the
                            -- sprite fills the view, so the body counts —
                            -- without this you can whiff through a draugr
                            -- that is chewing on your face
                            blank = dot // k1 < 1500 && absI perp < (if a.kind == 2 then 980 else 760)
                        in
                        isDead a.st == False
                            && dot > 0
                            && (absI perp < rad || blank)
                            && losClear m.grid m.px m.py a.x a.y)
                    m.actors
            best =
                List.sortBy (\a -> d.x * (a.x - m.px) + d.y * (a.y - m.py)) aimed
                    |> List.head
            wall = castCol (castEnv m0) (nCols // 2)
            tracer =
                { x = m0.px + d.x * 300 // k1
                , y = m0.py + d.y * 300 // k1
                , vx = d.x * 340 // k1
                , vy = d.y * 340 // k1
                , kind = 9
                , t = 26
                }
            m1 =
                { m0
                    | cool = wcool 0
                    , sfx = CThrow :: m0.sfx
                    , pbolts = tracer :: m0.pbolts
                }
        in
        case best of
            Nothing ->
                -- no flesh on the line: maybe the spear finds a crack
                crackCheck m1 wall

            Just t ->
                hurtActorN m1 t 1


-- seax: swing curto e largo. Sem alcance, sem munição — a fiel companheira
-- do primeiro corredor (e do pânico)
seaxSwing : Model -> Model
seaxSwing m =
    let
        d = dirAt m.heading
        near =
            List.filter
                (\a ->
                    let
                        relX = a.x - m.px
                        relY = a.y - m.py
                        dot = d.x * relX + d.y * relY
                        perp = (d.x * relY - d.y * relX) // k1
                    in
                    isDead a.st == False && dot > 0 && dot // k1 < 1350 && absI perp < 720)
                m.actors
        best =
            List.sortBy (\a -> d.x * (a.x - m.px) + d.y * (a.y - m.py)) near
                |> List.head
        m1 = { m | cool = wcool 0, sfx = CThrow :: m.sfx }
    in
    case best of
        Nothing ->
            crackCheck m1 (castCol (castEnv m1) (nCols // 2))

        Just t ->
            hurtActorN m1 t 1


-- shared launcher for the ammo weapons: spends a round, spawns the
-- projectile, starts the cooldown. Empty chamber = a dry click
loose : Model -> Int -> Int -> List Cue -> Int -> (Model -> Model) -> Model
loose m kind speed cues left spend =
    if left <= 0 then
        { m | cool = 14, sfx = CClick :: m.sfx }
    else
        let
            d = dirAt m.heading
            b =
                { x = m.px + d.x * 300 // k1
                , y = m.py + d.y * 300 // k1
                , vx = d.x * speed // k1
                , vy = d.y * speed // k1
                , kind = kind
                , t = 140
                }
            thrown = spend { m | cool = wcool kind, sfx = cues, pbolts = b :: m.pbolts }
        in
        -- if that was the LAST shot (this weapon's ammo was 1 before the
        -- throw), auto-fall-back to the seax (weapon 0) — you're never left
        -- holding a spent weapon that only clicks. cycleWeapon already hides
        -- empty weapons; this covers the one you deplete in your own hand.
        -- Covers arrows / axes / flasks alike, since `left` is the real count.
        if left <= 1 then { thrown | weapon = 0 } else thrown


-- a cracked wall shatters when anything hard hits it: the way to secrets
crackCheck : Model -> Hit -> Model
crackCheck m wall =
    if wall.code == 6 && wall.d < 6144 then
        shatter m wall.cx wall.cy
    else
        m


shatter : Model -> Int -> Int -> Model
shatter m cx cy =
    let
        wx = cx * k1 + 512
        wy = cy * k1 + 512
        (s2, a0) = rnd m.seed 240
    in
    let
        grid2 = Dict.insert (cy * 24 + cx) 0 m.grid
    in
    { m
        | grid = grid2
        , mapRuns = computeRuns grid2
        , secretsFound = m.secretsFound + 1
        , seed = s2
        , gibs = List.take 30 (spawnGibs s2 wx wy 7 a0 m.gibs)
        , sfx = CSecret :: CShatter :: m.sfx
        , pickMsg = "SECRET FOUND"
        , pickT = 130
    }


isDead : St -> Bool
isDead st =
    case st of
        ADie _ -> True
        _ -> False


isAwake : St -> Bool
isAwake st =
    case st of
        ASleep -> False
        ADie _ -> False
        _ -> True


-- the skjaldmaer BLOCKS whatever meets her shield while she simply
-- advances (AChase); the openings are her own swing, her recover and her
-- sleep. Surtr-fire wraps around a shield, so explosions go in raw.
hurtActorN : Model -> Actor -> Int -> Model
hurtActorN m t dmg =
    if t.kind == 4 && t.st == AChase then
        { m | sfx = CClank :: m.sfx, combatT = 200 }
    else
        hurtActorRaw m t dmg


hurtActorRaw : Model -> Actor -> Int -> Model
hurtActorRaw m t dmg =
    let
        hp2 = t.hp - dmg
        killed = hp2 <= 0
        (s2, spread) = rnd m.seed 240
        actors2 =
            List.map
                (\a ->
                    if a.idx == t.idx then
                        { a
                            | hp = hp2
                            , fT = 5
                            , st =
                                if killed then ADie 12
                                else if a.st == ASleep then AChase
                                else a.st
                        }
                    else
                        a)
                m.actors
        burst = if killed then 9 else 3
        gibs2 = List.take 30 (spawnGibs s2 t.x t.y burst spread m.gibs)
        (s3, roll) = rnd s2 6
        drops =
            if killed && t.kind == 0 && roll < 2 then
                [ { kind = 4, x = t.x, y = t.y, taken = False } ]
            else if killed && t.kind == 0 && roll == 2 then
                [ { kind = 5, x = t.x, y = t.y, taken = False } ]
            else
                []
    in
    { m
        | actors = actors2
        , seed = s3
        , gibs = gibs2
        , items = List.concat [ m.items, drops ]
        , kills = m.kills + (if killed then 1 else 0)
        , combatT = 200
        -- a varg (wolf, kind 3) yelps when it dies; the draugr-kin grunt
        , sfx = (if killed then (if t.kind == 3 then CYelp else CDieD) else CHitF) :: m.sfx
    }


spawnGibs : Random.Seed -> Int -> Int -> Int -> Int -> List Gib -> List Gib
spawnGibs seed x y n a0 acc =
    if n <= 0 then
        acc
    else
        let
            (s2, a) = rnd seed 240
            d = dirAt (modBy 240 (a0 + a))
        in
        spawnGibs s2 x y (n - 1) a
            ({ x = x, y = y, vx = d.x * 42 // k1, vy = d.y * 42 // k1, t = 14 } :: acc)


-- ===== actors =====


type alias ActAcc =
    { acs : List Actor
    , piles : List Pile
    , newItems : List Item
    , bolts : List Bolt
    , cues : List Cue
    , dmg : Int
    , seed : Random.Seed
    , s1 : Bool
    , s2 : Bool
    , alert : Bool
    }


stepActors : Model -> Model
stepActors m =
    let
        acc0 =
            { acs = []
            , piles = m.piles
            , newItems = []
            , bolts = []
            , cues = []
            , dmg = 0
            , seed = m.seed
            , s1 = m.jarlS1
            , s2 = m.jarlS2
            , alert = False
            }
        acc = List.foldl (\actor a -> stepActor m a actor) acc0 m.actors
        m2 =
            { m
                | actors = acc.acs
                , piles = acc.piles
                , items = List.concat [ m.items, acc.newItems ]
                , bolts = List.concat [ m.bolts, acc.bolts ]
                , seed = acc.seed
                , jarlS1 = acc.s1
                , jarlS2 = acc.s2
                , combatT = if acc.alert then 200 else m.combatT
                , sfx = List.concat [ acc.cues, m.sfx ]
            }
    in
    if acc.dmg > 0 then
        hurtPlayer m2 acc.dmg
    else
        m2


hurtPlayer : Model -> Int -> Model
hurtPlayer m dmg =
    if m.invulnT > 0 then
        m
    else
        let
            -- byrnie rule, Doom-school: while you wear iron, every blow
            -- loses one pip (never below one) and the iron loses one
            dmg2 = if m.armor > 0 then max 1 (dmg - 1) else dmg
            armor2 = if m.armor > 0 then m.armor - 1 else 0
            hp2 = m.hp - dmg2
        in
        if hp2 <= 0 then
            -- the death blow: the dying cry (grunt + breath + the body's
            -- thud) fires once here; the funeral march itself rides the
            -- Sound.once sub gated on mode == Dead, so a restart cuts it.
            { m | hp = 0, armor = armor2, mode = Dead, modeT = 0, hurtT = 20, sfx = CDeathCry :: m.sfx }
        else
            { m | hp = hp2, armor = armor2, hurtT = 14, invulnT = 42, sfx = CHurt :: m.sfx }


stepActor : Model -> ActAcc -> Actor -> ActAcc
stepActor m acc a0 =
    let
        a = { a0 | fT = max 0 (a0.fT - 1) }
        relX = m.px - a.x
        relY = m.py - a.y
        d = octDist relX relY
        awake =
            case a.st of
                ASleep -> False
                ADie _ -> False
                _ -> True
        acc1 = if awake then { acc | alert = True } else acc
    in
    case a.st of
        ADie t ->
            if t <= 1 then
                -- the body comes apart: a pool and bones stay on the floor,
                -- and the Jarl gives up the Dawn Rune he swallowed
                let
                    p = { x = a.x, y = a.y, big = a.kind == 2 }
                    acc2 = { acc1 | piles = p :: acc1.piles }
                in
                if a.kind == 2 then
                    { acc2
                        | newItems = { kind = 0, x = a.x, y = a.y, taken = False } :: acc2.newItems
                        , cues = CBell :: acc2.cues
                    }
                else
                    acc2
            else
                { acc1 | acs = { a | st = ADie (t - 1) } :: acc1.acs }

        ASleep ->
            let
                -- stagger the sight checks so 12 sleepers don't all pay LOS
                -- on the same tick
                sees =
                    modBy 12 (m.tick + a.idx * 5) == 0
                        && d < (if a.kind == 1 || a.kind == 5 || a.kind == 6 then 10240 else 9216)
                        && losClear m.grid a.x a.y m.px m.py
                -- vargs hunt as a pack: one waking calls the rest of it
                packCall =
                    a.kind == 3
                        && modBy 12 (m.tick + a.idx * 5) == 6
                        && List.any
                            (\o -> o.kind == 3 && o.idx /= a.idx && isAwake o.st && octDist (o.x - a.x) (o.y - a.y) < 6144)
                            m.actors
            in
            if sees || packCall then
                { acc1
                    | acs = { a | st = AChase } :: acc1.acs
                    , cues = (if a.kind == 3 then CHowl else CGroan) :: acc1.cues
                    , alert = True
                }
            else
                { acc1 | acs = a :: acc1.acs }

        AWind t ->
            if t <= 1 then
                windupResolve m acc1 a d relX relY
            else
                { acc1 | acs = { a | st = AWind (t - 1) } :: acc1.acs }

        ARec t ->
            { acc1 | acs = { a | st = if t <= 1 then AChase else ARec (t - 1) } :: acc1.acs }

        ASum t ->
            if t <= 1 then
                summon m acc1 a
            else
                { acc1 | acs = { a | st = ASum (t - 1) } :: acc1.acs }

        AChase ->
            if a.kind == 1 then
                wraithChase m acc1 a d relX relY
            else if a.kind == 3 then
                vargChase m acc1 a d relX relY
            else if a.kind == 5 then
                volvaChase m acc1 a d relX relY
            else if a.kind == 6 then
                archerChase m acc1 a d relX relY
            else
                draugrChase m acc1 a d relX relY


windupResolve : Model -> ActAcc -> Actor -> Int -> Int -> Int -> ActAcc
windupResolve m acc a d relX relY =
    if a.kind == 1 || a.kind == 5 || a.kind == 6 then
        -- ranged attackers loose bolts (octagonal-normalized, dodgeable):
        -- the wraith a single fast bolt, the volva a TWIN fan you slip
        -- between, the draug-archer a HARD-driven arrow (much faster, so
        -- you dodge on the telegraph, not the bolt). All bolts fly faster
        -- now than before, and the casters recover sooner to fire again.
        let
            n = max 1 (octDist relX relY)
            thrown =
                if a.kind == 5 then
                    [ { x = a.x, y = a.y, vx = (relX * 102 - relY * 18) // n, vy = (relY * 102 + relX * 18) // n }
                    , { x = a.x, y = a.y, vx = (relX * 102 + relY * 18) // n, vy = (relY * 102 - relX * 18) // n }
                    ]
                else if a.kind == 6 then
                    [ { x = a.x, y = a.y, vx = relX * 156 // n, vy = relY * 156 // n } ]
                else
                    [ { x = a.x, y = a.y, vx = relX * 112 // n, vy = relY * 112 // n } ]
        in
        { acc
            | acs = { a | st = ARec (if a.kind == 5 then 38 else if a.kind == 6 then 30 else 34) } :: acc.acs
            , bolts = List.concat [ thrown, acc.bolts ]
            , cues = CBolt :: acc.cues
        }
    else
        let
            -- the draugr's swing bites FURTHER than it looks: backing off
            -- during its (short) windup no longer guarantees a clean escape
            reach = if a.kind == 2 then 1150 else if a.kind == 3 then 1100 else if a.kind == 0 then 1250 else 1000
            hit = d < reach && losClear m.grid a.x a.y m.px m.py
            dmgN = if a.kind == 3 then 1 else 2
        in
        { acc
            | acs = { a | st = ARec (if a.kind == 2 then 30 else if a.kind == 3 then 26 else 22) } :: acc.acs
            , dmg = acc.dmg + (if hit then dmgN else 0)
        }


-- wake up to two bone piles as fresh draugr — including the piles the
-- player just made. The dead are a resource down here
summon : Model -> ActAcc -> Actor -> ActAcc
summon m acc a =
    let
        near =
            List.filter (\p -> octDist (p.x - a.x) (p.y - a.y) < 7168) acc.piles
                |> List.take 2
        rest =
            List.filter
                (\p -> List.any (\q -> q.x == p.x && q.y == p.y) near == False)
                acc.piles
        risen =
            List.indexedMap
                (\i p ->
                    let
                        b = actorFor 0 (p.x // k1) (p.y // k1)
                    in
                    { b | st = ARec 30, idx = 200 + m.tick + i })
                near
    in
    { acc
        | acs = List.concat [ risen, [ { a | st = ARec 30 } ], acc.acs ]
        , piles = rest
    }


draugrChase : Model -> ActAcc -> Actor -> Int -> Int -> Int -> ActAcc
draugrChase m acc a d relX relY =
    let
        isJarl = a.kind == 2
    in
    -- the Jarl calls the dead at 16 and 8 HP, once each
    if isJarl && a.hp <= 16 && acc.s1 == False then
        { acc | acs = { a | st = ASum 60 } :: acc.acs, s1 = True, cues = CJarl :: acc.cues }
    else if isJarl && a.hp <= 8 && acc.s2 == False then
        { acc | acs = { a | st = ASum 60 } :: acc.acs, s2 = True, cues = CJarl :: acc.cues }
    else if d < (if isJarl then 900 else 760) then
        -- the plain draugr swings briskly (34 ticks ~0.57s): readable, but
        -- you dodge by moving, not by strolling backward. Skjald keeps her
        -- long telegraph (the shield window IS her design); the Jarl is fair
        { acc | acs = { a | st = AWind (if a.kind == 4 then 46 else if a.kind == 0 then 34 else 42) } :: acc.acs, cues = CGroan :: acc.cues }
    else if d > 15360 then
        { acc | acs = { a | st = ASleep } :: acc.acs }
    else
        let
            spd = if isJarl then 20 else if a.kind == 4 then 18 else 26
            n = max 1 d
            a2 = slideActor m.grid acc.acs m.tick a (relX * spd // n) (relY * spd // n)
        in
        { acc | acs = a2 :: acc.acs }


wraithChase : Model -> ActAcc -> Actor -> Int -> Int -> Int -> ActAcc
wraithChase m acc a d relX relY =
    let
        n = max 1 d
        -- keep 3..6 cells: back off, close in, or circle
        mv =
            if d < 3072 then
                { x = 0 - relX * 18 // n, y = 0 - relY * 18 // n }
            else if d > 6144 then
                { x = relX * 18 // n, y = relY * 18 // n }
            else
                { x = (0 - relY) * a.sdir * 16 // n, y = relX * a.sdir * 16 // n }
        a2 = slideActor m.grid acc.acs m.tick a mv.x mv.y
        blocked = a2.x == a.x && a2.y == a.y
        (s2, flip) = rnd acc.seed 2
        a3 =
            if blocked || (modBy 90 (m.tick + a.idx * 13) == 0 && flip == 1) then
                { a2 | sdir = 0 - a2.sdir }
            else
                a2
        wantsFire =
            modBy 96 (m.tick + a.idx * 7) == 0
                && d < 9216
                && losClear m.grid a.x a.y m.px m.py
    in
    if wantsFire then
        { acc | acs = { a3 | st = AWind 42 } :: acc.acs, cues = CWhine :: acc.cues, seed = s2 }
    else
        { acc | acs = a3 :: acc.acs, seed = s2 }


-- the draug-archer: a ranged BOWMAN, not a caster. It holds the middle
-- distance like a wraith but keeps its face to you and looses fast arrows
-- often. No blink, no circling magic - just relentless, physical volleys
-- you have to break line-of-sight or close on to stop.
archerChase : Model -> ActAcc -> Actor -> Int -> Int -> Int -> ActAcc
archerChase m acc a d relX relY =
    let
        n = max 1 d
        -- hold 4..8 cells: back off if crowded, close if too far, else hold
        mv =
            if d < 4096 then
                { x = 0 - relX * 20 // n, y = 0 - relY * 20 // n }
            else if d > 8192 then
                { x = relX * 20 // n, y = relY * 20 // n }
            else
                { x = 0, y = 0 }
        a2 = slideActor m.grid acc.acs m.tick a mv.x mv.y
        wantsFire =
            modBy 84 (m.tick + a.idx * 9) == 0
                && d < 10240
                && losClear m.grid a.x a.y m.px m.py
    in
    if wantsFire then
        { acc | acs = { a2 | st = AWind 30 } :: acc.acs, cues = CWhine :: acc.cues }
    else
        { acc | acs = a2 :: acc.acs }


-- the varg is a running bite: no caution, no circling. Straight in with
-- a hound's weave, and a SHORT lunge telegraph you learn to respect
vargChase : Model -> ActAcc -> Actor -> Int -> Int -> Int -> ActAcc
vargChase m acc a d relX relY =
    if d < 860 then
        { acc | acs = { a | st = AWind 22 } :: acc.acs, cues = CSnarl :: acc.cues }
    else if d > 17408 then
        { acc | acs = { a | st = ASleep } :: acc.acs }
    else
        let
            n = max 1 d
            weave = if modBy 2 (m.tick // 20 + a.idx * 7) == 0 then 1 else 0 - 1
            a2 =
                slideActor m.grid acc.acs m.tick a
                    (relX * 34 // n + (0 - relY) * weave * 10 // n)
                    (relY * 34 // n + relX * weave * 10 // n)
            -- a hunting hound BARKS: every ~2.3s per varg, staggered by idx
            -- so a pack sounds like scattered yaps, and only in earshot —
            -- barking IS the warning that the pack is coming
            barks = modBy 140 (m.tick + a.idx * 29) == 0 && d < 11264
        in
        { acc
            | acs = a2 :: acc.acs
            , cues = if barks then CBark :: acc.cues else acc.cues
        }


-- the volva holds the middle distance, and when her wind is ready she is
-- simply SOMEWHERE ELSE - reappearing with the next cast already rising
volvaChase : Model -> ActAcc -> Actor -> Int -> Int -> Int -> ActAcc
volvaChase m acc a0 d relX relY =
    let
        a1 = { a0 | bt = max 0 (a0.bt - 1) }
        -- when the blink is ready, ONE line-of-sight ray decides: blink
        -- now, or back off the check for 18 ticks. Without the backoff a
        -- wall between us meant a full LOS walk EVERY tick, forever
        ready = a1.bt == 0 && d < 10240
        canBlink = ready && losClear m.grid a1.x a1.y m.px m.py
        a = if ready && canBlink == False then { a1 | bt = 18 } else a1
    in
    if canBlink then
        blinkAway m acc a
    else
        let
            n = max 1 d
            mv =
                if d < 4096 then
                    { x = 0 - relX * 16 // n, y = 0 - relY * 16 // n }
                else if d > 7168 then
                    { x = relX * 14 // n, y = relY * 14 // n }
                else
                    { x = (0 - relY) * a.sdir * 12 // n, y = relX * a.sdir * 12 // n }
            a2 = slideActor m.grid acc.acs m.tick a mv.x mv.y
            a3 = if a2.x == a.x && a2.y == a.y then { a2 | sdir = 0 - a2.sdir } else a2
            wantsFire =
                modBy 120 (m.tick + a.idx * 11) == 0
                    && d < 9216
                    && losClear m.grid a.x a.y m.px m.py
        in
        if wantsFire then
            { acc | acs = { a3 | st = AWind 36 } :: acc.acs, cues = CWhine :: acc.cues }
        else
            { acc | acs = a3 :: acc.acs }


-- eight candidate cells in a ring; take the first free one that is not
-- point-blank on the player
blinkAway : Model -> ActAcc -> Actor -> ActAcc
blinkAway m acc a =
    let
        (s2, r0) = rnd acc.seed 8
        pick =
            List.filter
                (\c ->
                    cellAt m.grid c.cx c.cy == 0
                        && c.cx > 0 && c.cx < 23 && c.cy > 0 && c.cy < 23
                        && octDist (c.cx * k1 + 512 - m.px) (c.cy * k1 + 512 - m.py) > 2048)
                (List.map
                    (\i ->
                        let
                            o = blinkOffset (modBy 8 (r0 + i))
                        in
                        { cx = a.x // k1 + o.x, cy = a.y // k1 + o.y })
                    (range 8))
                |> List.head
    in
    case pick of
        Just c ->
            { acc
                | acs = { a | x = c.cx * k1 + 512, y = c.cy * k1 + 512, bt = 170, st = AWind 30 } :: acc.acs
                , cues = CBlink :: acc.cues
                , seed = s2
            }

        Nothing ->
            { acc | acs = { a | bt = 90 } :: acc.acs, seed = s2 }


blinkOffset : Int -> { x : Int, y : Int }
blinkOffset i =
    case i of
        0 -> { x = 3, y = 0 }
        1 -> { x = 0 - 3, y = 0 }
        2 -> { x = 0, y = 3 }
        3 -> { x = 0, y = 0 - 3 }
        4 -> { x = 2, y = 2 }
        5 -> { x = 0 - 2, y = 2 }
        6 -> { x = 2, y = 0 - 2 }
        _ -> { x = 0 - 2, y = 0 - 2 }


-- axis-separated slide with wall checks and a little body-blocking so a
-- pack does not collapse into one sprite. If BOTH axes are blocked (wedged
-- on a corner with the other component rounded to zero — the classic
-- pursuit deadlock), sidestep perpendicular to the desired move so the
-- draugr shuffles along the wall until the opening lines up.
slideActor : Dict Int Int -> List Actor -> Int -> Actor -> Int -> Int -> Actor
slideActor grid others tick a mvx mvy =
    let
        r = 220
        freeAt =
            \x y ->
                (solidAtPt grid (x - r) (y - r)
                    || solidAtPt grid (x + r) (y - r)
                    || solidAtPt grid (x - r) (y + r)
                    || solidAtPt grid (x + r) (y + r)
                    || List.any (\o -> isDead o.st == False && octDist (o.x - x) (o.y - y) < 380) others)
                    == False
        nx = if mvx /= 0 && freeAt (a.x + mvx) a.y then a.x + mvx else a.x
        ny = if mvy /= 0 && freeAt nx (a.y + mvy) then a.y + mvy else a.y
    in
    if nx == a.x && ny == a.y then
        let
            jig = if modBy 2 (tick // 45 + a.idx * 3) == 0 then 22 else 0 - 22
        in
        if freeAt a.x (a.y + jig) then
            { a | y = a.y + jig }
        else if freeAt a.x (a.y - jig) then
            { a | y = a.y - jig }
        else if freeAt (a.x + jig) a.y then
            { a | x = a.x + jig }
        else if freeAt (a.x - jig) a.y then
            { a | x = a.x - jig }
        else
            a
    else
        { a | x = nx, y = ny }


-- ===== player projectiles and explosions =====


type alias PbAcc =
    { bs : List PBolt, hits : List { a : Actor, dmg : Int }, boomAt : List Boom, cues : List Cue, cracks : List { cx : Int, cy : Int } }


stepPBolts : Model -> Model
stepPBolts m =
    let
        step =
            \b acc ->
                let
                    nx = b.x + b.vx
                    ny = b.y + b.vy
                    target =
                        List.filter
                            (\a -> isDead a.st == False && octDist (a.x - nx) (a.y - ny) < 340)
                            m.actors
                            |> List.head
                    cellCode = cellAt m.grid (nx // k1) (ny // k1)
                in
                if b.kind == 9 then
                    -- the spear tracer is pure light: dies on walls or timeout
                    if b.t <= 1 || cellCode > 0 then
                        acc
                    else
                        { acc | bs = { b | x = nx, y = ny, t = b.t - 1 } :: acc.bs }
                else if b.kind == 3 then
                    -- the flask goes off on ANY contact (or its fuse)
                    case target of
                        Just _ ->
                            { acc | boomAt = { x = nx, y = ny, t = 14 } :: acc.boomAt }

                        Nothing ->
                            if cellCode > 0 || b.t <= 1 then
                                { acc | boomAt = { x = b.x, y = b.y, t = 14 } :: acc.boomAt }
                            else
                                { acc | bs = { b | x = nx, y = ny, t = b.t - 1 } :: acc.bs }
                else
                    case target of
                        Just a ->
                            { acc | hits = { a = a, dmg = if b.kind == 2 then 3 else 1 } :: acc.hits }

                        Nothing ->
                            if cellCode == 6 then
                                { acc | cracks = { cx = nx // k1, cy = ny // k1 } :: acc.cracks, cues = CClank :: acc.cues }
                            else if cellCode > 0 || b.t <= 1 then
                                { acc | cues = CClank :: acc.cues }
                            else
                                { acc | bs = { b | x = nx, y = ny, t = b.t - 1 } :: acc.bs }
        r = List.foldl step { bs = [], hits = [], boomAt = [], cues = [], cracks = [] } m.pbolts
        m1 = { m | pbolts = r.bs, sfx = List.concat [ r.cues, m.sfx ] }
        m2 = List.foldl (\h mm -> hurtActorN mm h.a h.dmg) m1 r.hits
        m3 = List.foldl (\c mm -> shatter mm c.cx c.cy) m2 r.cracks
    in
    List.foldl explode m3 r.boomAt


-- Surtr-fire: everything within two cells burns, including you. The
-- classic lesson is taught the classic way
explode : Boom -> Model -> Model
explode b m =
    let
        m1 = { m | booms = b :: m.booms, sfx = CBoom :: m.sfx, combatT = 200 }
        near =
            List.filter
                (\a -> isDead a.st == False && octDist (a.x - b.x) (a.y - b.y) < 2048)
                m1.actors
        m2 = List.foldl (\a mm -> hurtActorRaw mm a 3) m1 near
        -- a blast that kills leaves remains on the floor; scorching bare
        -- stone leaves nothing the Jarl could call back up
        m3 =
            if List.length near > 0 then
                { m2 | piles = { x = b.x, y = b.y, big = True } :: m2.piles }
            else
                m2
    in
    if octDist (m3.px - b.x) (m3.py - b.y) < 1536 then
        hurtPlayer m3 2
    else
        m3


stepBooms : Model -> Model
stepBooms m =
    { m | booms = List.filterMap (\b -> if b.t <= 1 then Nothing else Just { b | t = b.t - 1 }) m.booms }


-- ===== bolts, gibs, pickups, timers =====


stepBolts : Model -> Model
stepBolts m =
    let
        step =
            \b acc ->
                let
                    nx = b.x + b.vx
                    ny = b.y + b.vy
                in
                if solidAtPt m.grid nx ny then
                    acc
                else if octDist (nx - m.px) (ny - m.py) < 340 then
                    { acc | dmg = acc.dmg + 1 }
                else
                    { acc | bs = { b | x = nx, y = ny } :: acc.bs }
        r = List.foldl step { bs = [], dmg = 0 } m.bolts
        m2 = { m | bolts = r.bs }
    in
    if r.dmg > 0 then
        hurtPlayer m2 r.dmg
    else
        m2


stepGibs : Model -> Model
stepGibs m =
    { m
        | gibs =
            List.filterMap
                (\g ->
                    if g.t <= 1 then
                        Nothing
                    else
                        Just { g | x = g.x + g.vx, y = g.y + g.vy, vx = g.vx * 7 // 8, vy = g.vy * 7 // 8, t = g.t - 1 })
                m.gibs
    }


stepPickups : Model -> Model
stepPickups m =
    List.foldl touchItem m m.items


-- pickups are grabbed within ~0.7 of a cell now (was ~0.4) — you no
-- longer have to stand ON the thing. Each grab drops a discreet on-screen
-- note (pickMsg/pickT) so you can tell WHAT you just picked up.
pickupR : Int
pickupR = 820


-- stamp the little "what did I grab" note
noted : String -> Model -> Model
noted label mm =
    { mm | pickMsg = label, pickT = 130 }


touchItem : Item -> Model -> Model
touchItem it m =
    if it.taken || octDist (it.x - m.px) (it.y - m.py) > pickupR then
        m
    else
        let
            take =
                { m
                    | items =
                        List.map
                            (\o -> if o.x == it.x && o.y == it.y && o.kind == it.kind then { o | taken = True } else o)
                            m.items
                }
        in
        case it.kind of
            0 ->
                noted "DAWN RUNE" { take | hasRune = True, sfx = CRune :: take.sfx }

            1 ->
                if m.hp >= 6 then
                    noted "HEALTH FULL" m
                else
                    noted "MEAD HORN" { take | hp = min 6 (m.hp + 2), sfx = CHorn :: take.sfx }

            2 ->
                noted "GOLD RING" { take | gold = take.gold + 1, sfx = CGold :: take.sfx }

            4 ->
                if m.arrows >= 30 then noted "ARROWS FULL" m else noted "ARROWS" { take | arrows = min 30 (m.arrows + 6), sfx = CGold :: take.sfx }

            5 ->
                if m.axes >= 10 then
                    noted "AXES FULL" m
                else
                    -- first axe equips immediately (new weapon!)
                    noted (if m.axes == 0 then "HEWING AXE" else "AXES")
                        { take
                            | axes = min 10 (m.axes + 2)
                            , weapon = if m.axes == 0 then 3 else take.weapon
                            , sfx = (if m.axes == 0 then CArmor else CGold) :: take.sfx
                        }

            6 ->
                if m.flasks >= 3 then
                    noted "FLASKS FULL" m
                else
                    noted (if m.flasks == 0 then "SURTR FLASK" else "FIRE FLASK")
                        { take
                            | flasks = min 3 (m.flasks + 1)
                            , weapon = if m.flasks == 0 then 4 else take.weapon
                            , sfx = (if m.flasks == 0 then CArmor else CFuse) :: take.sfx
                        }

            9 ->
                noted "GUNGNIR SPEAR" { take | hasSpear = True, weapon = 1, sfx = CBell :: take.sfx }

            10 ->
                noted "HUNTING BOW" { take | hasBow = True, weapon = 2, sfx = CBell :: take.sfx }

            7 ->
                if m.armor >= 8 then noted "ARMOR FULL" m else noted "LEATHER ARMOR" { take | armor = min 8 (m.armor + 4), sfx = CArmor :: take.sfx }

            8 ->
                if m.armor >= 8 then noted "ARMOR FULL" m else noted "IRON BYRNIE" { take | armor = 8, sfx = CArmor :: take.sfx }

            _ ->
                -- the waystone: barrow cleared — or, at the bottom, dawn
                if m.barrow >= lastBarrow then
                    { take | mode = Won, modeT = 0, sfx = CTriumph :: CDawn :: take.sfx }
                else
                    { take | mode = Cleared, modeT = 0, sfx = CFanfare :: CBell :: take.sfx }


stepTimers : Model -> Model
stepTimers m =
    { m
        | tick = m.tick + 1
        , timeT = m.timeT + 1
        , cool = max 0 (m.cool - 1)
        , invulnT = max 0 (m.invulnT - 1)
        , hurtT = max 0 (m.hurtT - 1)
        , lockT = max 0 (m.lockT - 1)
        , runeBlink = max 0 (m.runeBlink - 1)
        , pickT = max 0 (m.pickT - 1)
        , combatT = max 0 (m.combatT - 1)
        , sfx = if m.cool == 11 then CReturn :: m.sfx else m.sfx
    }


-- ===== sounds =====


-- funeral march voices. mnote = one melody attack: the tune doubled an
-- octave up (Chopin wrote the theme in right-hand octaves) with a slow
-- vibrato so the held notes sing instead of sitting static.
-- a brassy horn note for the victory jingles: a bright square carrying the
-- tune over a triangle an octave below for body (a chiptune bugle)
blare : Int -> Int -> Sound
blare hz dur =
    Sound.chord
        [ Sound.volume 22 (Sound.tone Sound.Square hz dur)
        , Sound.volume 11 (Sound.tone Sound.Triangle (hz // 2) dur)
        ]



cueSound : Cue -> Sound
cueSound c =
    case c of
        CThrow ->
            Sound.volume 30 (Sound.sweep 40 (Sound.tone Sound.Sawtooth 340 90))

        CReturn ->
            Sound.volume 13 (Sound.sweep 200 (Sound.tone Sound.Sawtooth 150 70))

        CHitF ->
            Sound.chord
                [ Sound.volume 34 (Sound.tone Sound.Noise 0 55)
                , Sound.volume 26 (Sound.sweep 60 (Sound.tone Sound.Triangle 160 80))
                ]

        CDieD ->
            -- a death SCENE, not a blip (~0.8s): the creature's long guttural
            -- groan sags from mid pitch down into the floor under a rough,
            -- slow vibrato — a chest subharmonic underneath — while ragged
            -- noise pulses gurgle in the throat (blood), and only at the END
            -- of the groan the body thuds down onto the barrow stone.
            Sound.chord
                [ Sound.volume 22 (Sound.vibrato 28 9 (Sound.sweep 38 (Sound.tone Sound.Sawtooth 165 820)))
                , Sound.volume 12 (Sound.vibrato 14 6 (Sound.sweep 30 (Sound.tone Sound.Square 84 780)))
                , Sound.sequence
                    [ Sound.rest 90
                    , Sound.volume 13 (Sound.tone Sound.Noise 0 70)
                    , Sound.rest 80
                    , Sound.volume 10 (Sound.tone Sound.Noise 0 55)
                    , Sound.rest 90
                    , Sound.volume 7 (Sound.tone Sound.Noise 0 45)
                    ]
                , Sound.sequence
                    [ Sound.rest 640
                    , Sound.chord
                        [ Sound.volume 17 (Sound.tone Sound.Noise 0 110)
                        , Sound.volume 14 (Sound.sweep 30 (Sound.tone Sound.Triangle 70 160))
                        ]
                    ]
                ]

        CYelp ->
            -- the varg's death cry (~0.7s): a sharp "KAI!" leaping up, then a
            -- long pained fall with a slow, deep waver (a crying tremble, not
            -- a growl), fading into one low final whimper.
            Sound.sequence
                [ Sound.volume 19 (Sound.sweep 950 (Sound.tone Sound.Sawtooth 520 60))
                , Sound.volume 18 (Sound.vibrato 34 9 (Sound.sweep 190 (Sound.tone Sound.Sawtooth 900 480)))
                , Sound.volume 9 (Sound.sweep 90 (Sound.tone Sound.Triangle 180 140))
                ]

        CGroan ->
            Sound.volume 22 (Sound.sweep 70 (Sound.vibrato 14 5 (Sound.tone Sound.Sawtooth 84 380)))

        CWhine ->
            Sound.volume 15 (Sound.sweep 240 (Sound.tone Sound.Triangle 250 340))

        CBolt ->
            Sound.volume 18 (Sound.sweep 45 (Sound.duty 25 (Sound.tone Sound.Square 520 260)))

        CDoor ->
            Sound.chord
                [ Sound.volume 26 (Sound.sweep 55 (Sound.tone Sound.Triangle 52 300))
                , Sound.volume 13 (Sound.tone Sound.Noise 0 180)
                ]

        CLocked ->
            Sound.sequence
                [ Sound.volume 24 (Sound.tone Sound.Triangle 90 60)
                , Sound.rest 40
                , Sound.volume 16 (Sound.duty 25 (Sound.tone Sound.Square 70 50))
                ]

        CRune ->
            Sound.sequence
                [ Sound.volume 18 (Sound.duty 25 (Sound.tone Sound.Square 440 70))
                , Sound.volume 20 (Sound.duty 25 (Sound.tone Sound.Square 554 70))
                , Sound.volume 22 (Sound.duty 25 (Sound.tone Sound.Square 659 140))
                ]

        CGold ->
            Sound.volume 15 (Sound.duty 25 (Sound.tone Sound.Square 940 50))

        CHorn ->
            Sound.chord
                [ Sound.volume 20 (Sound.tone Sound.Triangle 220 280)
                , Sound.volume 13 (Sound.tone Sound.Triangle 330 280)
                ]

        CHurt ->
            Sound.chord
                [ Sound.volume 30 (Sound.tone Sound.Noise 0 60)
                , Sound.volume 30 (Sound.sweep 55 (Sound.tone Sound.Triangle 110 130))
                ]

        CBell ->
            Sound.chord
                [ Sound.volume 24 (Sound.tone Sound.Triangle 440 700)
                , Sound.volume 15 (Sound.tone Sound.Triangle 660 700)
                , Sound.volume 9 (Sound.tone Sound.Triangle 880 700)
                ]

        CJarl ->
            Sound.volume 34 (Sound.vibrato 10 5 (Sound.sweep 80 (Sound.tone Sound.Sawtooth 72 700)))

        CDawn ->
            Sound.sequence
                [ Sound.volume 18 (Sound.tone Sound.Triangle 262 170)
                , Sound.volume 20 (Sound.tone Sound.Triangle 330 170)
                , Sound.volume 22 (Sound.tone Sound.Triangle 392 170)
                , Sound.chord
                    [ Sound.volume 24 (Sound.tone Sound.Triangle 523 800)
                    , Sound.volume 16 (Sound.tone Sound.Triangle 659 800)
                    ]
                ]

        CFanfare ->
            -- a barrow cleared: a short brass horn-call in D major, a
            -- rising figure that turns and lands on a bright major chord
            Sound.sequence
                [ blare 587 170, blare 740 170, blare 880 360
                , blare 988 160, blare 880 160, blare 784 160
                , Sound.chord
                    [ Sound.volume 22 (Sound.tone Sound.Square 587 950)
                    , Sound.volume 15 (Sound.tone Sound.Triangle 740 950)
                    , Sound.volume 15 (Sound.tone Sound.Triangle 880 950)
                    , Sound.volume 12 (Sound.tone Sound.Triangle 294 950)
                    ]
                ]

        CTriumph ->
            -- dawn at the root of the world: the full victory fanfare, a
            -- longer horn melody climbing to the octave and settling on a
            -- wide, sustained D-major sunrise chord over a deep bass D
            Sound.sequence
                [ blare 587 240, blare 740 240, blare 880 240, blare 1175 560
                , blare 988 200, blare 880 200, blare 784 200
                , blare 740 260, blare 587 260
                , Sound.chord
                    [ Sound.volume 22 (Sound.tone Sound.Square 587 1600)
                    , Sound.volume 16 (Sound.tone Sound.Triangle 740 1600)
                    , Sound.volume 16 (Sound.tone Sound.Triangle 880 1600)
                    , Sound.volume 14 (Sound.tone Sound.Triangle 294 1600)
                    , Sound.volume 12 (Sound.tone Sound.Triangle 147 1600)
                    ]
                ]

        CStart ->
            Sound.volume 20 (Sound.duty 25 (Sound.tone Sound.Square 660 80))

        CBow ->
            Sound.chord
                [ Sound.volume 22 (Sound.sweep 55 (Sound.duty 25 (Sound.tone Sound.Square 620 70)))
                , Sound.volume 12 (Sound.tone Sound.Noise 0 30)
                ]

        CAxeT ->
            Sound.volume 26 (Sound.vibrato 30 9 (Sound.sweep 70 (Sound.tone Sound.Sawtooth 210 240)))

        CFuse ->
            Sound.volume 12 (Sound.tone Sound.Noise 0 260)

        CBoom ->
            Sound.chord
                [ Sound.volume 46 (Sound.tone Sound.Noise 0 240)
                , Sound.volume 36 (Sound.sweep 30 (Sound.tone Sound.Triangle 90 320))
                , Sound.volume 18 (Sound.sweep 45 (Sound.tone Sound.Sawtooth 60 300))
                ]

        CClank ->
            Sound.volume 16 (Sound.sweep 60 (Sound.tone Sound.Square 320 40))

        CHowl ->
            -- a wolf throat: rises, holds, breaks downward
            Sound.sequence
                [ Sound.volume 20 (Sound.sweep 210 (Sound.vibrato 9 5 (Sound.tone Sound.Sawtooth 160 260)))
                , Sound.volume 22 (Sound.vibrato 9 5 (Sound.tone Sound.Sawtooth 340 280))
                , Sound.volume 16 (Sound.sweep 55 (Sound.tone Sound.Sawtooth 330 260))
                ]

        CSnarl ->
            Sound.chord
                [ Sound.volume 20 (Sound.sweep 70 (Sound.vibrato 40 12 (Sound.tone Sound.Sawtooth 120 190)))
                , Sound.volume 12 (Sound.tone Sound.Noise 0 120)
                ]

        CDeathCry ->
            -- Vigdis falls: a long, throat-deep dying groan that sags in
            -- pitch under a wide, failing vibrato as the breath runs out —
            -- it plays the whole time the eyes are sliding shut. A hiss of
            -- escaping air rides over it, and near the end the dull thud of
            -- the body settling on the barrow floor.
            Sound.chord
                [ Sound.volume 32 (Sound.vibrato 30 7 (Sound.sweep 48 (Sound.tone Sound.Sawtooth 250 2600)))
                , Sound.volume 14 (Sound.holdPitch 900 (Sound.sweep 150 (Sound.tone Sound.Triangle 250 2600)))
                , Sound.volume 12 (Sound.tone Sound.Noise 0 1500)
                , Sound.sequence
                    [ Sound.rest 2100
                    , Sound.chord
                        [ Sound.volume 30 (Sound.sweep 35 (Sound.tone Sound.Triangle 72 180))
                        , Sound.volume 16 (Sound.tone Sound.Noise 0 80)
                        ]
                    ]
                ]

        CBark ->
            -- a hoarse howl-bark, "aaauu!": the voice jumps UP for a short
            -- attack ("a-"), then sags in one long fall to a low tail
            -- ("-aaauu"), with a rough mid-speed vibrato for the growl edge.
            -- Hoarseness comes from a quiet bed of ragged noise riding the
            -- WHOLE cry (breath in the throat), plus a low square chest
            -- resonance that joins under the falling part.
            Sound.chord
                [ Sound.sequence
                    [ Sound.volume 19 (Sound.sweep 780 (Sound.tone Sound.Sawtooth 380 80))
                    , Sound.volume 22 (Sound.vibrato 26 15 (Sound.sweep 140 (Sound.tone Sound.Sawtooth 600 480)))
                    ]
                , Sound.volume 9 (Sound.tone Sound.Noise 0 520)
                , Sound.sequence
                    [ Sound.rest 60
                    , Sound.volume 10 (Sound.sweep 70 (Sound.tone Sound.Square 190 460))
                    ]
                ]

        CBlink ->
            -- the volva's blink: a warbling whoosh as she tears out of here,
            -- then a bright rising shimmer as she snaps back into being
            -- somewhere else — loud enough to catch across the room
            Sound.sequence
                [ Sound.vibrato 45 22 (Sound.volume 28 (Sound.sweep 170 (Sound.tone Sound.Sawtooth 780 150)))
                , Sound.volume 10 (Sound.tone Sound.Noise 0 60)
                , Sound.vibrato 30 26 (Sound.volume 24 (Sound.sweep 940 (Sound.tone Sound.Triangle 300 190)))
                ]

        CShatter ->
            Sound.sequence
                [ Sound.chord
                    [ Sound.volume 30 (Sound.tone Sound.Noise 0 140)
                    , Sound.volume 18 (Sound.sweep 50 (Sound.tone Sound.Triangle 240 120))
                    ]
                , Sound.volume 12 (Sound.sweep 60 (Sound.tone Sound.Triangle 160 90))
                ]

        CSecret ->
            -- secret found! A tiny three-note reveal chime (Zelda 1 spirit,
            -- our notes): a rest so the wall's crash lands first, then a
            -- quick NES-pulse rise up the D-major arpeggio, the last note
            -- held with vibrato over a triangle for sparkle
            Sound.sequence
                [ Sound.rest 200
                , Sound.volume 23 (Sound.duty 25 (Sound.tone Sound.Square 587 95))
                , Sound.volume 24 (Sound.duty 25 (Sound.tone Sound.Square 740 95))
                , Sound.chord
                    [ Sound.vibrato 12 7 (Sound.volume 26 (Sound.duty 25 (Sound.tone Sound.Square 880 560)))
                    , Sound.volume 12 (Sound.tone Sound.Triangle 440 560)
                    ]
                ]

        CArmor ->
            Sound.sequence
                [ Sound.volume 20 (Sound.duty 25 (Sound.tone Sound.Square 520 50))
                , Sound.volume 22 (Sound.duty 25 (Sound.tone Sound.Square 780 90))
                ]

        CClick ->
            Sound.volume 12 (Sound.tone Sound.Square 140 30)

-- held bed: a low drone that leans a few Hz sharper while anything is
-- hunting you (the ambient key retunes in place, so it GLIDES)
drone : Model -> Sound
drone m =
    Sound.volume (if m.hp <= 2 then 15 else 12)
        (Sound.vibrato 8 3
            (Sound.tone Sound.Triangle
                (50
                    + m.barrow * 8
                    + (if m.combatT > 0 then 7 else 0)
                    -- a wounded Vigdis hears the drone go WRONG: a minor
                    -- second against itself
                    + (if m.hp <= 2 then 13 else 0))
                800))


-- combat drums: 8 beats at 120 BPM = 4000 ms per voice, seamless
drumKick : Sound
drumKick =
    Sound.sequence [ Sound.volume 46 (Sound.sweep 45 (Sound.tone Sound.Triangle 130 85)), Sound.rest 415 ]


drumTom : Sound
drumTom =
    Sound.sequence [ Sound.rest 250, Sound.volume 24 (Sound.sweep 70 (Sound.tone Sound.Triangle 95 110)), Sound.rest 140 ]


drumPulse : Sound
drumPulse =
    Sound.sequence [ Sound.volume 13 (Sound.duty 12 (Sound.tone Sound.Square 55 430)), Sound.rest 70 ]


warDrums : Sound
warDrums =
    Sound.chord
        [ Sound.sequence [ drumKick, drumKick, drumKick, drumKick, drumKick, drumKick, drumKick, drumKick ]
        , Sound.sequence [ drumTom, drumTom, drumTom, drumTom, drumTom, drumTom, drumTom, drumTom ]
        , Sound.sequence [ drumPulse, drumPulse, drumPulse, drumPulse, drumPulse, drumPulse, drumPulse, drumPulse ]
        ]


-- ===== view =====


view : Model -> View Msg
view model =
    let
        lay = layout model
        scene =
            case model.mode of
                Title -> titleShapes model
                Intro -> introShapes model
                Play -> List.concat [ worldShapes model, hudShapes model ]
                Cleared -> List.concat [ worldShapes model, clearedShapes model ]
                Dead -> List.concat [ worldShapes model, dieShapes model ]
                Won -> List.concat [ worldShapes model, wonShapes model ]
    in
    canvas Pixelated [ watchSize Resized, onTap Tapped, onDrag Dragged, onRelease Released ]
        (List.concat
            [ [ rect 0 0 model.w model.h (rgb 4 4 6)
              , group [ Canvas.Translate lay.ox lay.oy, Canvas.Scale lay.scale lay.scale ]
                    (List.concat [ scene, muteIcon model ])
              ]
            , touchPadShapes model
            ])


dawnPct : Model -> Int
dawnPct m =
    if m.mode == Won then iclamp 0 100 (m.modeT * 2 // 3) else 0


-- the whole 3D frame: backdrop, wall strips, then every billboard sorted
-- far-to-near and depth-tested per column
worldShapes : Model -> List Shape
worldShapes m =
    let
        env = castEnv m
        dawn = dawnPct m
        cols = List.map (castCol env) (range nCols)
        fc = floorRGB m.barrow
        cc = ceilRGB m.barrow
        -- Wall base colours depend only on the barrow (constant this frame), so
        -- derive them ONCE here instead of re-deriving carvedRGB / torchRGB /
        -- stoneRGB / doorRGB inside every one of the 160 wall strips.
        pal =
            { carved = carvedRGB m.barrow
            , torch = torchRGB m.barrow
            , stone = stoneRGB m.barrow
            , doorN = doorRGB False
            , doorR = doorRGB True
            }
        back =
            [ rect 0 0 320 55 (shade dawn cc 62)
            , rect 0 55 320 45 (shade dawn cc 30)
            , rect 0 100 320 45 (shade dawn fc 30)
            , rect 0 145 320 27 (shade dawn fc 58)
            , rect 0 172 320 28 (shade dawn fc 92)
            ]
        strips =
            List.concat (List.indexedMap (\i h -> stripShape m pal dawn i h) cols)
        sprites = spriteShapes m env cols dawn
        drips =
            -- Hel's Threshold sweats: slow green drops falling in the dark
            if m.barrow == 2 then
                List.concat
                    (List.indexedMap
                        (\i _ ->
                            let
                                ci = modBy nCols (i * 53 + (m.tick // 160) * 31)
                                fy = modBy 240 (m.tick * 2 + i * 397) - 20
                            in
                            if colDepth cols ci > 4200 && fy > 6 && fy < 190 then
                                [ rect (ci * 2) fy 2 4 (rgb 70 120 80) ]
                            else
                                [])
                        (List.repeat 6 0))
            else
                []
        overlayL =
            -- the reticle only belongs while you're actually aiming: hide it
            -- during the death scene (and the cleared/won holds) so it doesn't
            -- hang over Vigdis' last moment.
            List.concat
                [ weaponShapes m
                , if m.mode == Play then crossShapes else []
                , hurtFrame m
                , dreadFrame m
                ]
    in
    List.concat [ back, strips, sprites, drips, overlayL ]


type alias WallPal =
    { carved : Rgb, torch : Rgb, stone : Rgb, doorN : Rgb, doorR : Rgb }


stripShape : Model -> WallPal -> Int -> Int -> Hit -> List Shape
stripShape m pal dawn i hit =
    let
        hh = iclamp 12 1600 (200 * k1 // hit.d)
        y0 = max 0 (100 - hh // 2)
        y1 = min 200 (100 + hh // 2)
        base =
            if hit.code == 2 then pal.carved
            else if hit.code == 3 then pal.torch
            else if hit.code == 4 then pal.doorN
            else if hit.code == 5 then pal.doorR
            else pal.stone
        drainF =
            -- an opening door bleeds out of the world over 18 ticks
            if hit.code == 4 || hit.code == 5 then
                case List.head (List.filter (\dr -> dr.cx == hit.cx && dr.cy == hit.cy && dr.openT > 0) m.doors) of
                    Just dr -> dr.openT * 100 // 18
                    Nothing -> 100
            else
                100
        flick = if hit.code == 3 then 30 + modBy 4 (m.tick // 2 + hit.cx * 5) * 4 else 0
        litBand = iclamp 0 100 (bandPct hit.d + flick)
        sideF = if hit.side == 1 then 82 else 100
        f = litBand * sideF * drainF // 10000
        hh2 = max 1 (y1 - y0)
        wallC = shade dawn base f
    in
    -- the COMMON column (plain stone/torch) takes the single-cons fast
    -- path: no empty crack/door lists, no List.concat — this runs 160
    -- times a frame, so the allocations it skips are the frame budget
    if hit.code == 4 || hit.code == 5 then
        -- doors read as DOORS: bright timber frame down both edges, iron
        -- straps + centre seam up close, and the rune door's violet
        -- sigil, which ignores distance — the lock glows in the dark
        let
            ironC = shade dawn { r = 34, g = 34, b = 44 } f
        in
        if hit.fr < 96 || hit.fr > 928 then
            [ rect (i * 2) y0 2 hh2 (shade dawn { r = 198, g = 184, b = 146 } (f * 94 // 100)) ]
        else if hit.code == 5 && hit.fr >= 352 && hit.fr < 672 && modBy 2 (hit.fr // 64) == 0 then
            [ rect (i * 2) y0 2 hh2 wallC
            , rect (i * 2) (y0 + hh2 * 42 // 100) 2 (max 1 (hh2 * 14 // 100)) (shade 0 { r = 196, g = 150, b = 255 } (60 + modBy 5 (m.tick // 3) * 10))
            ]
        else if hit.d >= 8704 then
            [ rect (i * 2) y0 2 hh2 wallC ]
        else if hit.fr >= 484 && hit.fr < 540 then
            [ rect (i * 2) y0 2 hh2 ironC ]
        else
            [ rect (i * 2) y0 2 hh2 wallC
            , rect (i * 2) (y0 + hh2 * 24 // 100) 2 (max 1 (hh2 * 6 // 100)) ironC
            , rect (i * 2) (y0 + hh2 * 70 // 100) 2 (max 1 (hh2 * 6 // 100)) ironC
            ]
    else if hit.code == 6 && modBy 4 (hit.fr // 96) == 1 then
        -- cracked walls keep their fissure: the secret tell
        [ rect (i * 2) y0 2 hh2 wallC
        , rect (i * 2) (y0 + hh2 // 4 + modBy 5 (hit.fr // 48) * hh2 // 12) 2 (max 2 (hh2 * 2 // 5)) (shade dawn base (f * 55 // 100))
        ]
    else if hit.code == 3 then
        -- a wall TORCH reads as FIRE, not a yellow strip: the wall stays
        -- stone, and a bright flickering flame licks up from a bracket in
        -- the centre of the cell. The flame ignores fog (it is a light) so
        -- it pops as a landmark across the dark
        let
            stoneC = shade dawn pal.stone (litBand * sideF // 100)
            fl = modBy 6 (m.tick // 3 + hit.cx * 7)
        in
        if hit.fr >= 400 && hit.fr < 624 then
            let
                fy = y0 + hh2 * (28 - fl) // 100
                fh = max 2 (hh2 * (30 + fl) // 100)
            in
            [ rect (i * 2) y0 2 hh2 stoneC
            , rect (i * 2) (y0 + hh2 * 58 // 100) 2 (max 1 (hh2 * 10 // 100)) (shade dawn { r = 40, g = 30, b = 24 } f)
            , rect (i * 2) fy 2 fh (rgb (238 - fl * 4) (150 + fl * 8) 52)
            , rect (i * 2) fy 2 (max 1 (fh // 3)) (rgb 255 (226 + fl * 4) 150)
            ]
        else
            [ rect (i * 2) y0 2 hh2 (shade dawn { r = 116, g = 92, b = 66 } (litBand * sideF // 100)) ]
    else
        [ rect (i * 2) y0 2 hh2 wallC ]


-- ===== billboards =====


type alias Spr =
    { d : Int, shapes : List Shape }


project : CastEnv -> List Hit -> Int -> Int -> Maybe { col : Int, size : Int, d : Int }
project env cols wx wy =
    let
        relX = wx - env.px
        relY = wy - env.py
        dRaw = env.plx * env.dy - env.dx * env.ply
        tY = ((0 - env.ply) * relX + env.plx * relY) * k1 // dRaw
        tX = (env.dy * relX - env.dx * relY) * k1 // dRaw
    in
    if tY < 120 then
        Nothing
    else
        let
            col = 80 + 80 * tX // tY
        in
        if col < 0 - 30 || col > nCols + 30 then
            Nothing
        else if colDepth cols (iclamp 0 (nCols - 1) col) + 280 < tY then
            Nothing
        else
            Just { col = col, size = 200 * k1 // tY, d = tY }


spriteShapes : Model -> CastEnv -> List Hit -> Int -> List Shape
spriteShapes m env cols dawn =
    let
        -- past the last fog band (12% shade) ground clutter is invisible:
        -- don't build shapes for it at all. Glowing things are exempt —
        -- the rune (kind 0) is MEANT to be seen across the dark
        pileS =
            List.filterMap
                (\p ->
                    project env cols p.x p.y
                        |> Maybe.andThen
                            (\pr ->
                                if pr.d > 8704 then
                                    Nothing

                                else
                                    Just { d = pr.d, shapes = pileShape pr p.big }))
                m.piles
        itemS =
            List.filterMap
                (\it ->
                    if it.taken then
                        Nothing
                    else
                        project env cols it.x it.y
                            |> Maybe.andThen
                                (\pr ->
                                    if pr.d > 8704 && it.kind /= 0 then
                                        Nothing

                                    else
                                        Just { d = pr.d, shapes = itemShape m pr it.kind }))
                m.items
        boltS =
            List.filterMap
                (\b ->
                    project env cols b.x b.y
                        |> Maybe.map (\pr -> { d = pr.d, shapes = boltShape pr }))
                m.bolts
        pboltS =
            List.filterMap
                (\b ->
                    project env cols b.x b.y
                        |> Maybe.map (\pr -> { d = pr.d, shapes = pboltShape m pr b.kind }))
                m.pbolts
        boomS =
            List.filterMap
                (\b ->
                    project env cols b.x b.y
                        |> Maybe.map (\pr -> { d = pr.d, shapes = boomShape pr b.t }))
                m.booms
        gibS =
            List.filterMap
                (\g ->
                    project env cols g.x g.y
                        |> Maybe.andThen
                            (\pr ->
                                if pr.d > 8704 then
                                    Nothing

                                else
                                    Just { d = pr.d, shapes = gibShape pr g.t }))
                m.gibs
        actS =
            List.filterMap
                (\a ->
                    project env cols a.x a.y
                        |> Maybe.map (\pr -> { d = pr.d, shapes = actorShape m pr a }))
                m.actors
        all = List.concat [ pileS, itemS, boltS, pboltS, boomS, gibS, actS ]
    in
    List.sortBy (\s -> 0 - s.d) all
        |> List.concatMap (\s -> s.shapes)


fogF : Int -> Int
fogF d = bandPct d


-- billboard rects must be clipped to the logical screen by hand: the
-- scaled root group does not clip, so a point-blank sprite would spill
-- over the letterbox (the seasons-gp lesson)
clipR : Int -> Int -> Int -> Int -> Color -> List Shape
clipR x y w h c =
    let
        x0 = max 0 x
        y0 = max 0 y
        x1 = min 320 (x + w)
        y1 = min 200 (y + h)
    in
    if x1 > x0 && y1 > y0 then [ rect x0 y0 (x1 - x0) (y1 - y0) c ] else []


-- a slain thing on the floor: dark pool, thrown bones
pileShape : { col : Int, size : Int, d : Int } -> Bool -> List Shape
pileShape pr big =
    let
        s = pr.size * (if big then 30 else 20) // 100
        w = pr.size * (if big then 84 else 60) // 100
        x = pr.col * 2 - w // 2
        y = 100 + pr.size // 2 - s // 2
        f = fogF pr.d
        pool = shade 0 bloodRGB f
        bone = shade 0 boneRGB f
    in
    List.concat
        [ clipR x y w (max 1 (s // 2)) pool
        , clipR (x + w // 5) (y - s // 4) (max 1 (w // 6)) (max 1 (s // 3)) bone
        , clipR (x + w * 3 // 5) (y - s // 5) (max 1 (w // 7)) (max 1 (s // 4)) bone
        ]


itemShape : Model -> { col : Int, size : Int, d : Int } -> Int -> List Shape
itemShape m pr kind =
    let
        f = fogF pr.d
        bot = 100 + pr.size // 2
        cx = pr.col * 2
    in
    case kind of
        0 ->
            -- the rune: a bright glyph, pulsing — ignores fog, it GLOWS
            let
                s = pr.size * 26 // 100
                p = modBy 4 (m.tick // 6)
                w = s - p
            in
            List.concat
                [ clipR (cx - w // 2) (bot - s - s // 2) w s (rgb 178 120 255)
                , clipR (cx - w // 4) (bot - s - s // 4) (max 1 (w // 2)) (max 1 (s // 2)) (rgb 240 220 255)
                ]

        1 ->
            let
                s = pr.size * 20 // 100
            in
            List.concat
                [ clipR (cx - s // 2) (bot - s) s (max 1 (s * 2 // 3)) (shade 0 { r = 214, g = 176, b = 110 } f)
                , clipR (cx + s // 3) (bot - s - s // 4) (max 1 (s // 3)) (max 1 (s // 2)) (shade 0 boneRGB f)
                ]

        2 ->
            let
                s = max 2 (pr.size * 12 // 100)
                tw = modBy 3 (m.tick // 8 + pr.col)
            in
            clipR (cx - s // 2) (bot - s) s s (shade 0 { r = 232, g = 190, b = 70 } (iclamp 0 100 (f + tw * 10)))

        4 ->
            -- a quiver of arrows
            let
                s = max 3 (pr.size * 18 // 100)
            in
            List.concat
                [ clipR (cx - s // 3) (bot - s) (max 1 (s * 2 // 3)) s (shade 0 { r = 130, g = 100, b = 64 } f)
                , clipR (cx - s // 3) (bot - s - s // 4) (max 1 (s // 5)) (max 1 (s // 3)) (shade 0 boneRGB f)
                , clipR (cx + s // 8) (bot - s - s // 4) (max 1 (s // 5)) (max 1 (s // 3)) (shade 0 boneRGB f)
                ]

        5 ->
            -- a pair of hewing axes on the stone
            let
                s = max 3 (pr.size * 16 // 100)
            in
            List.concat
                [ clipR (cx - s // 2) (bot - s) (max 1 (s // 4)) s (shade 0 { r = 120, g = 96, b = 66 } f)
                , clipR (cx - s // 2 - s // 4) (bot - s) (max 1 (s * 3 // 4)) (max 2 (s // 3)) (shade 0 { r = 200, g = 204, b = 214 } f)
                , clipR (cx + s // 4) (bot - s * 3 // 4) (max 1 (s // 4)) (max 1 (s * 3 // 4)) (shade 0 { r = 120, g = 96, b = 66 } f)
                ]

        6 ->
            -- Surtr-fire flask: green glass, live fuse (glows through fog)
            let
                s = max 3 (pr.size * 16 // 100)
                fl = modBy 2 (m.tick // 3 + pr.col)
            in
            List.concat
                [ clipR (cx - s // 2) (bot - s) s s (shade 0 { r = 96, g = 130, b = 70 } f)
                , clipR (cx - s // 8) (bot - s - s // 3) (max 1 (s // 4)) (max 1 (s // 3)) (if fl == 0 then rgb 255 190 70 else rgb 235 120 40)
                ]

        7 ->
            -- leather cuirass on a stand
            let
                s = max 3 (pr.size * 22 // 100)
            in
            List.concat
                [ clipR (cx - s // 2) (bot - s) s (max 1 (s * 3 // 4)) (shade 0 { r = 140, g = 96, b = 58 } f)
                , clipR (cx - s // 3) (bot - s - s // 6) (max 1 (s * 2 // 3)) (max 1 (s // 5)) (shade 0 { r = 160, g = 112, b = 66 } f)
                ]

        8 ->
            -- the iron byrnie: it catches what little light there is
            let
                s = max 3 (pr.size * 24 // 100)
                gl = modBy 4 (m.tick // 5 + pr.col)
            in
            List.concat
                [ clipR (cx - s // 2) (bot - s) s (max 1 (s * 3 // 4)) (shade 0 { r = 150, g = 158, b = 176 } (iclamp 0 100 (f + gl * 4)))
                , clipR (cx - s // 3) (bot - s - s // 6) (max 1 (s * 2 // 3)) (max 1 (s // 5)) (shade 0 { r = 180, g = 188, b = 205 } f)
                , clipR (cx - s // 6) (bot - s + s // 5) (max 1 (s // 3)) (max 1 (s // 8)) (rgb 220 226 240)
                ]

        9 ->
            -- GUNGNIR num pedestal de pedra: a lança espera por uma mão digna
            let
                s = pr.size * 44 // 100
                gl = modBy 3 (m.tick // 5)
            in
            List.concat
                [ clipR (cx - s // 3) (bot - s // 3) (max 2 (s * 2 // 3)) (max 1 (s // 3)) (shade 0 { r = 130, g = 140, b = 156 } f)
                , clipR (cx - s // 12) (bot - s) (max 1 (s // 6)) s (shade 0 { r = 148, g = 118, b = 82 } f)
                , clipR (cx - s // 8) (bot - s - s // 5) (max 1 (s // 4)) (max 1 (s // 4)) (rgb (200 + gl * 15) 240 255)
                ]

        10 ->
            -- o arco de caça encostado numa pedra
            let
                s = pr.size * 36 // 100
            in
            List.concat
                [ clipR (cx - s // 3) (bot - s // 4) (max 2 (s * 2 // 3)) (max 1 (s // 4)) (shade 0 { r = 120, g = 126, b = 140 } f)
                , clipR (cx - s // 8) (bot - s) (max 1 (s // 5)) s (shade 0 { r = 110, g = 84, b = 52 } f)
                , clipR (cx + s // 8) (bot - s + s // 8) (max 1 (s // 12)) (max 1 (s * 3 // 4)) (rgb 210 206 190)
                ]

        _ ->
            -- the waystone: a standing stone with a lit crown
            let
                s = pr.size * 64 // 100
                w = pr.size * 26 // 100
            in
            List.concat
                [ clipR (cx - w // 2) (bot - s) w s (shade 0 { r = 150, g = 160, b = 176 } f)
                , clipR (cx - w // 2) (bot - s) w (max 1 (s // 6)) (rgb 255 224 130)
                ]


boltShape : { col : Int, size : Int, d : Int } -> List Shape
boltShape pr =
    let
        s = max 2 (pr.size * 12 // 100)
        cx = pr.col * 2
        cy = 100 + pr.size // 2 - pr.size * 40 // 100
    in
    List.concat
        [ clipR (cx - s // 2) (cy - s // 2) s s (rgb 190 255 140)
        , clipR (cx - s // 4) (cy - s // 4) (max 1 (s // 2)) (max 1 (s // 2)) (rgb 250 255 230)
        ]


pboltShape : Model -> { col : Int, size : Int, d : Int } -> Int -> List Shape
pboltShape m pr kind =
    let
        cx = pr.col * 2
        cy = 100 + pr.size // 2 - pr.size * 42 // 100
    in
    case kind of
        9 ->
            -- Gungnir's wake: a sliver of light where the spear flew
            let
                s = max 2 (pr.size * 10 // 100)
            in
            List.concat
                [ clipR (cx - s // 2) (cy - s // 6) s (max 1 (s // 3)) (rgb 190 235 255)
                , clipR (cx - s // 4) (cy - s // 4) (max 1 (s // 2)) (max 1 (s // 2)) (rgb 245 252 255)
                ]

        1 ->
            -- vista por trás, a flecha é um dardo: ponta clara e emplumado
            let
                s = max 2 (pr.size * 7 // 100)
            in
            List.concat
                [ clipR (cx - s // 2) (cy - s // 2) s s (rgb 230 230 235)
                , clipR (cx - s // 4) (cy + s // 2) (max 1 (s // 2)) (max 1 (s // 2)) (rgb 214 196 150)
                ]

        2 ->
            -- the hewing axe tumbles as it flies
            let
                s = max 3 (pr.size * 16 // 100)
                sp = modBy 2 (m.tick // 3)
            in
            List.concat
                [ clipR (cx - s // 2) (cy - s // 2) s s (rgb 120 96 66)
                , if sp == 0 then
                    clipR (cx - s // 2) (cy - s // 2) s (max 2 (s // 2)) (rgb 210 214 222)
                  else
                    clipR (cx - s // 2) (cy - s // 2) (max 2 (s // 2)) s (rgb 210 214 222)
                ]

        _ ->
            -- the flask: glass and a burning fuse
            let
                s = max 3 (pr.size * 14 // 100)
                fl = modBy 2 (m.tick // 2)
            in
            List.concat
                [ clipR (cx - s // 2) (cy - s // 2) s s (rgb 96 130 70)
                , clipR (cx - s // 6) (cy - s) (max 1 (s // 3)) (max 1 (s // 2)) (if fl == 0 then rgb 255 190 70 else rgb 255 120 40)
                ]


boomShape : { col : Int, size : Int, d : Int } -> Int -> List Shape
boomShape pr t =
    let
        grow = (14 - t) * pr.size // 16
        cx = pr.col * 2
        cy = 100 + pr.size // 2 - pr.size * 30 // 100
        core = max 3 (grow * 55 // 100)
    in
    List.concat
        [ clipR (cx - grow // 2) (cy - grow // 2) grow grow (if modBy 2 t == 0 then rgb 255 160 40 else rgb 255 90 30)
        , clipR (cx - core // 2) (cy - core // 2) core core (rgb 255 240 190)
        ]


gibShape : { col : Int, size : Int, d : Int } -> Int -> List Shape
gibShape pr t =
    let
        s = max 1 (pr.size * (4 + t // 3) // 100)
        cx = pr.col * 2
        cy = 100 + pr.size // 2 - pr.size * (10 + t * 3) // 100
    in
    clipR (cx - s // 2) (cy - s // 2) s s (rgb 150 22 26)


actorShape : Model -> { col : Int, size : Int, d : Int } -> Actor -> List Shape
actorShape m pr a =
    let
        dying =
            case a.st of
                ADie t -> t
                _ -> 12
        hFull =
            case a.kind of
                1 -> pr.size * 70 // 100
                2 -> pr.size * 118 // 100
                3 -> pr.size * 46 // 100
                4 -> pr.size * 86 // 100
                5 -> pr.size * 96 // 100
                _ -> pr.size * 82 // 100
        h = hFull * dying // 12
        w = hFull * (if a.kind == 3 then 150 else if a.kind == 5 then 48 else 55) // 100
        bob =
            if a.kind == 1 || a.kind == 5 then
                pr.size * (2 + modBy 6 (m.tick // 5 + a.idx)) // 100
            else
                0
        bot = 100 + pr.size // 2 - bob
        x = pr.col * 2 - w // 2
        y = bot - h
        f = fogF pr.d
        flash = a.fT > 0
        wind =
            case a.st of
                AWind _ -> True
                ASum _ -> True
                _ -> False
        bodyC =
            if flash then
                rgb 255 90 80
            else if a.kind == 1 then
                shade 0 { r = 96, g = 84, b = 128 } f
            else if a.kind == 2 then
                shade 0 { r = 108, g = 96, b = 70 } f
            else if a.kind == 3 then
                shade 0 { r = 74, g = 64, b = 54 } f
            else if a.kind == 4 then
                shade 0 { r = 92, g = 102, b = 88 } f
            else if a.kind == 5 then
                shade 0 { r = 58, g = 46, b = 88 } f
            else if a.kind == 6 then
                shade 0 { r = 120, g = 108, b = 84 } f
            else
                shade 0 { r = 78, g = 96, b = 82 } f
        headC = if flash then rgb 255 140 120 else shade 0 boneRGB f
        eyeC =
            if a.kind == 1 then rgb 214 140 255
            else if a.kind == 2 then rgb 255 170 60
            else if a.kind == 3 then rgb 255 186 60
            else if a.kind == 5 then rgb 150 255 170
            else if a.kind == 6 then rgb 255 150 60
            else rgb 120 230 255
        eyeGlow = if wind then max 2 (w // 6) else max 1 (w // 8)
        wounded = a.hp * 2 <= maxHpOf a.kind
        armY = if wind then y - h // 8 else y + h // 4
        -- past the last fog band only the EYES survive (they already
        -- ignore fog by design) — the body would render at 12% of its
        -- color, unreadable, and cost a dozen clipped rects per actor
        farDark = pr.d > 8704 && dying == 12
        walking = a.st == AChase && a.kind /= 1 && a.kind /= 5 && a.kind /= 6
        step0 = modBy 2 (m.tick // 7 + a.idx * 5) == 0
        legL = if walking && step0 then h // 7 else 0
        legR = if walking && step0 == False then h // 7 else 0
        body =
            if a.kind == 3 then
                -- the varg: a low running slab of pelt, head thrown forward.
                -- Its whole silhouette is half a man's height and twice as wide
                let
                    headY = if wind then y + h * 30 // 100 else y + h * 4 // 100
                in
                List.concat
                    [ clipR x (y + h * 34 // 100) (w * 76 // 100) (max 1 (h * 42 // 100)) bodyC
                    , clipR (x + w * 6 // 100) (y + h * 70 // 100) (max 1 (w * 10 // 100)) (max 1 (h * 30 // 100 - legL)) bodyC
                    , clipR (x + w * 28 // 100) (y + h * 70 // 100) (max 1 (w * 10 // 100)) (max 1 (h * 30 // 100 - legR)) bodyC
                    , clipR (x + w * 50 // 100) (y + h * 70 // 100) (max 1 (w * 10 // 100)) (max 1 (h * 30 // 100 - legR)) bodyC
                    , clipR (x + w * 66 // 100) (y + h * 70 // 100) (max 1 (w * 10 // 100)) (max 1 (h * 30 // 100 - legL)) bodyC
                    , clipR (x + w * 64 // 100) headY (max 1 (w * 30 // 100)) (max 1 (h * 38 // 100)) bodyC
                    , clipR (x + w * 68 // 100) (headY - h * 12 // 100) (max 1 (w * 7 // 100)) (max 1 (h * 14 // 100)) bodyC
                    , clipR (x + w * 82 // 100) (headY - h * 12 // 100) (max 1 (w * 7 // 100)) (max 1 (h * 14 // 100)) bodyC
                    , clipR (x + w * 70 // 100) (headY + h * 10 // 100) eyeGlow eyeGlow eyeC
                    , clipR (x + w * 84 // 100) (headY + h * 10 // 100) eyeGlow eyeGlow eyeC
                    ]
            else if a.kind == 5 then
                -- the volva floats: a hooded pillar of robe over nothing,
                -- a rune stitched into the skirt that catches the torchlight
                List.concat
                    [ clipR (x + w // 6) (y + h * 24 // 100) (max 1 (w * 2 // 3)) (max 1 (h * 28 // 100)) bodyC
                    , clipR x (y + h * 48 // 100) w (max 1 (h * 46 // 100)) bodyC
                    , clipR (x + w // 5) y (max 1 (w * 3 // 5)) (max 1 (h * 26 // 100)) (shade 0 { r = 40, g = 30, b = 62 } f)
                    , clipR (x + w * 30 // 100) (y + h * 10 // 100) eyeGlow eyeGlow eyeC
                    , clipR (x + w - w * 30 // 100 - eyeGlow) (y + h * 10 // 100) eyeGlow eyeGlow eyeC
                    , if modBy 5 (m.tick // 3 + a.idx) < 3 then
                        clipR (x + w * 40 // 100) (y + h * 58 // 100) (max 1 (w * 20 // 100)) (max 1 (h * 14 // 100)) (rgb 176 146 255)
                      else
                        []
                    ]
            else
                List.concat
                    [ clipR x (y + h // 4) w (max 1 (h * 5 // 9)) bodyC
                    , clipR (x + w // 8) (y + h * 7 // 9) (max 1 (w // 3)) (max 1 (h * 2 // 9 - legL)) bodyC
                    , clipR (x + w * 5 // 9) (y + h * 7 // 9) (max 1 (w // 3)) (max 1 (h * 2 // 9 - legR)) bodyC
                    , clipR (x + w // 6) y (max 1 (w * 2 // 3)) (max 1 (h // 3)) headC
                    , clipR (x + w // 5) (y + h // 9) eyeGlow eyeGlow eyeC
                    , clipR (x + w - w // 5 - eyeGlow) (y + h // 9) eyeGlow eyeGlow eyeC
                    -- the archer holds a tall bowstave at its side; it flexes
                    -- forward (the draw) while the shot is winding up
                    , if a.kind == 6 then
                        clipR (x + w - (if wind then 0 else w * 6 // 100)) (y + h * 12 // 100)
                            (max 1 (w * 7 // 100)) (max 1 (h * 66 // 100))
                            (shade 0 { r = 156, g = 120, b = 64 } f)
                      else
                        []
                    ]
        shield =
            -- the skjaldmaer's painted roundshield: covers her while she
            -- walks at you, swings ASIDE with the blow - that is the window
            if a.kind == 4 && dying == 12 then
                let
                    shW = max 2 (w * 92 // 100)
                    shX = if wind then x - shW * 60 // 100 else x + (w - shW) // 2
                    shY = y + h * 26 // 100
                    shH = max 2 (h * 40 // 100)
                    shC = if flash then rgb 255 120 100 else shade 0 { r = 152, g = 56, b = 44 } f
                    rimC = shade 0 { r = 196, g = 186, b = 158 } f
                in
                List.concat
                    [ clipR (shX + shW // 6) (shY - shH // 8) (max 1 (shW * 2 // 3)) (max 1 (shH // 8)) rimC
                    , clipR shX shY shW shH shC
                    , clipR (shX + shW // 6) (shY + shH) (max 1 (shW * 2 // 3)) (max 1 (shH // 8)) rimC
                    , clipR (shX + shW * 38 // 100) (shY + shH * 34 // 100) (max 1 (shW * 24 // 100)) (max 1 (shH * 30 // 100)) (shade 0 { r = 178, g = 182, b = 194 } f)
                    ]
            else
                []
        weapon =
            if a.kind == 1 || a.kind == 3 || a.kind == 5 then
                []
            else
                clipR (x + w - w // 8) armY (max 1 (w // 4)) (max 1 (h // 2)) (shade 0 { r = 160, g = 150, b = 130 } f)
        wound =
            if wounded && dying == 12 then
                clipR (x + w // 4) (y + h // 2) (max 1 (w // 3)) (max 1 (h // 5)) (rgb 150 22 26)
            else
                []
        aura =
            if wind && (a.kind == 1 || a.kind == 5) then
                clipR (x - w // 5) (y - h // 6) (max 1 (w // 4)) (max 1 (w // 4)) (if a.kind == 5 then rgb 170 255 190 else rgb 214 140 255)
            else
                []
    in
    if farDark then
        List.concat
            [ clipR (x + w // 4) (y + h // 6) eyeGlow eyeGlow eyeC
            , clipR (x + w - w // 4 - eyeGlow) (y + h // 6) eyeGlow eyeGlow eyeC
            ]
    else
        List.concat [ body, weapon, shield, wound, aura ]


-- ===== screen furniture =====


crossShapes : List Shape
crossShapes =
    -- four single-pixel ticks around dead center (160,100): a fine reticle
    -- that frames the aim point without a fat dot covering the target
    [ rect 160 96 1 1 (rgb 235 235 235)
    , rect 160 104 1 1 (rgb 235 235 235)
    , rect 156 100 1 1 (rgb 235 235 235)
    , rect 164 100 1 1 (rgb 235 235 235)
    ]


-- at one heart the dark starts closing in: a slow-breathing black-red
-- frame that has nothing to do with taking a hit (that one is bright)
dreadFrame : Model -> List Shape
dreadFrame m =
    if m.hp <= 2 && m.mode == Play then
        let
            th = 3 + (if modBy 2 (m.tick // 26) == 0 then 1 else 0)
        in
        [ rect 0 0 320 th (rgb 74 8 10)
        , rect 0 (200 - th) 320 th (rgb 74 8 10)
        , rect 0 0 th 200 (rgb 74 8 10)
        , rect (320 - th) 0 th 200 (rgb 74 8 10)
        ]
    else
        []


hurtFrame : Model -> List Shape
hurtFrame m =
    if m.hurtT > 0 then
        [ rect 0 0 320 5 (rgb 190 24 24)
        , rect 0 195 320 5 (rgb 190 24 24)
        , rect 0 0 5 200 (rgb 190 24 24)
        , rect 315 0 5 200 (rgb 190 24 24)
        ]
    else
        []


-- Vigdis' hands, bottom-right: each weapon has its own held pose and
-- fire animation. The animation IS the cooldown readout
weaponShapes : Model -> List Shape
weaponShapes m =
    let
        shaftC = rgb 148 118 82
        headC = rgb 214 218 228
        glowC = rgb 150 226 255
        handC = rgb 172 138 104
        kick = if m.cool > wcool m.weapon - 6 then 6 else 0
    in
    case m.weapon of
        0 ->
            -- seax: a lâmina curta descansa baixa; o golpe corta em arco
            if m.cool > wcool 0 - 8 then
                [ rect 218 148 44 10 (rgb 214 218 228)
                , rect 210 144 12 14 (rgb 230 234 240)
                , rect 250 156 14 22 handC
                ]
            else if m.cool > 6 then
                [ rect 250 138 10 40 (rgb 214 218 228)
                , rect 248 132 14 10 (rgb 230 234 240)
                , rect 250 176 14 20 handC
                ]
            else
                [ rect 244 162 10 30 (rgb 200 206 218)
                , rect 242 156 14 8 (rgb 224 228 236)
                , rect 246 190 14 10 handC
                ]

        2 ->
            -- hunting bow: limbs, string, and a nocked arrow when ready
            List.concat
                [ [ rect 244 128 6 66 (rgb 110 84 52)
                  , rect 238 126 12 6 (rgb 110 84 52)
                  , rect 238 190 12 6 (rgb 110 84 52)
                  , rect (240 - kick) 132 2 56 (rgb 210 206 190)
                  ]
                , if m.cool == 0 && m.arrows > 0 then
                    [ rect 214 158 34 3 (rgb 214 196 150)
                    , rect 210 156 6 7 headC
                    ]
                  else
                    []
                , [ rect 246 168 12 20 handC ]
                ]

        3 ->
            -- hewing axe held heavy; it leaves the hand on the throw
            if m.cool > wcool 3 - 14 then
                [ rect 232 178 26 22 handC ]
            else
                [ rect 246 138 9 60 (rgb 120 96 66)
                , rect 232 132 26 16 (rgb 205 210 220)
                , rect 236 148 16 6 (rgb 160 164 176)
                , rect 244 184 14 16 handC
                ]

        4 ->
            -- Surtr-fire: green glass, a fuse you can read
            let
                fl = modBy 2 (m.tick // 2)
            in
            if m.cool > wcool 4 - 14 then
                [ rect 232 178 26 22 handC ]
            else
                List.concat
                    [ [ rect 238 156 22 30 (rgb 96 130 70)
                      , rect 244 148 9 10 (rgb 74 100 56)
                      ]
                    , if m.flasks > 0 then
                        [ rect 246 138 5 10 (if fl == 0 then rgb 255 190 70 else rgb 235 120 40) ]
                      else
                        []
                    , [ rect 236 184 24 16 handC ]
                    ]

        _ ->
            if m.cool == 0 then
                [ rect 236 158 8 42 shaftC
                , rect 240 148 8 42 shaftC
                , rect 244 138 8 14 headC
                , rect 246 132 4 8 headC
                ]
            else if m.cool > 26 then
                [ rect 226 128 10 72 shaftC
                , rect 226 112 10 18 headC
                , rect 228 104 6 10 headC
                ]
            else if m.cool > 10 then
                [ rect 238 176 26 24 handC
                , rect 244 170 12 10 (rgb 190 156 118)
                ]
            else
                [ rect 240 150 8 50 glowC
                , rect 244 140 8 12 (rgb 240 252 255)
                ]


heartShape : Int -> Int -> Int -> List Shape
heartShape x y state =
    let
        c =
            if state == 2 then rgb 224 44 54
            else if state == 1 then rgb 150 40 52
            else rgb 52 40 46
    in
    [ rect x y 5 4 c
    , rect (x + 6) y 5 4 c
    , rect x (y + 3) 11 4 c
    , rect (x + 2) (y + 7) 7 3 c
    , rect (x + 4) (y + 10) 3 2 c
    ]


hudShapes : Model -> List Shape
hudShapes m =
    let
        hearts =
            List.concat
                (List.indexedMap
                    (\i _ ->
                        let
                            st =
                                if m.hp >= i * 2 + 2 then 2
                                else if m.hp == i * 2 + 1 then 1
                                else 0
                        in
                        heartShape (8 + i * 15) 8 st)
                    (List.repeat 3 0))
        runeC =
            if m.runeBlink > 0 && modBy 2 (m.runeBlink // 4) == 0 then
                rgb 255 70 70
            else if m.hasRune then
                rgb 178 120 255
            else
                rgb 70 66 84
        runeSlot =
            [ rect 250 6 16 16 (rgb 34 32 44)
            , rect 252 8 12 12 runeC
            ]
        goldHud =
            List.concat
                [ [ rect 216 10 8 8 (rgb 232 190 70) ]
                , pixTextR 212 10 1 (rgb 230 222 200) (String.fromInt m.gold)
                ]
        jarl =
            List.head (List.filter (\a -> a.kind == 2 && isDead a.st == False) m.actors)
        bossBar =
            case jarl of
                Just j ->
                    if j.st == ASleep then
                        []
                    else
                        [ rect 99 167 122 8 (rgb 30 26 30)
                        , rect 100 168 120 6 (rgb 60 30 34)
                        , rect 100 168 (max 1 (j.hp * 120 // 24)) 6 (rgb 190 40 40)
                        ]

                Nothing ->
                    []
    in
    List.concat [ hearts, armorHud m, faceShapes m, runeSlot, goldHud, bossBar, weaponHud m, miniMap m, pickupNote m ]


-- the discreet "what did I grab" line: low-centre, above the weapon, fades
-- out over its last ~24 ticks (lingers ~2.2s). Empty when nothing was picked up recently.
pickupNote : Model -> List Shape
pickupNote m =
    if m.pickT <= 0 then
        []
    else
        let
            g = min 100 (m.pickT * 100 // 24)
        in
        pixTextC 160 158 1 (rgb (150 + g * 70 // 100) (140 + g * 66 // 100) (110 + g * 40 // 100)) m.pickMsg


-- top-right: the whole barrow at 1.5px per cell (36px panel — between the
-- 2px \"too big\" and the 1px \"too small\"). Cell edges land on the exact
-- grid (v*3/2 both ends), so rows/columns alternate 1px and 2px — it reads
-- as parchment grain, not error. Walls in stone, shut doors in their own
-- colors (the purple one is what your rune is FOR), you as a steady white
-- arrowhead pointing where you face — and once you hold the rune, the
-- waystone glints gold: the rune knows the way home
miniMap : Model -> List Shape
miniMap m =
    let
        ox = 279
        oy = 25
        wallC = shade 0 (stoneRGB m.barrow) 46
        runs =
            List.map
                (\r ->
                    rect (ox + r.x * 3 // 2) (oy + r.y * 3 // 2)
                        (max 1 ((r.x + r.w) * 3 // 2 - r.x * 3 // 2))
                        (max 1 ((r.y + 1) * 3 // 2 - r.y * 3 // 2))
                        wallC)
                m.mapRuns
        doorDots =
            List.concatMap
                (\dr ->
                    if dr.openT == 0 then
                        []
                    else if dr.rune then
                        [ rect (ox + dr.cx * 3 // 2) (oy + dr.cy * 3 // 2) 2 2 (rgb 178 120 255) ]
                    else
                        [ rect (ox + dr.cx * 3 // 2) (oy + dr.cy * 3 // 2) 2 2 (rgb 176 136 88) ])
                m.doors
        way =
            if m.hasRune && modBy 2 (m.tick // 12) == 0 then
                List.filterMap
                    (\it ->
                        if it.kind == 3 && it.taken == False then
                            Just (rect (ox + it.x * 3 // 2048) (oy + it.y * 3 // 2048) 2 2 (rgb 255 224 130))
                        else
                            Nothing)
                    m.items
            else
                []
        -- marker center on the minimap; a fixed-size arrowhead rotated by the
        -- heading so it reads which way you face. Drawn as a rotated template
        -- (not by scaling dirAt's components) so integer truncation can't make
        -- it grow/shrink at diagonal headings — the size stays constant.
        -- heading is 240 steps of 1.5 degrees (index 0 = east), so the angle
        -- is heading * 3 / 2 degrees clockwise.
        cxm = ox + m.px * 3 // 2048 + 1
        cym = oy + m.py * 3 // 2048 + 1
        me =
            [ group
                [ Canvas.Translate cxm cym
                , Canvas.Rotate (m.heading * 3 // 2)
                , Canvas.Scale 75 75
                ]
                [ triangle 4 0 (0 - 2) (0 - 2) (0 - 2) 2 (rgb 250 250 250) ]
            ]
    in
    List.concat
        [ [ rect (ox - 2) (oy - 2) 40 40 (rgb 9 9 13)
          , rect (ox - 2) (oy - 2) 40 1 (rgb 74 72 92)
          , rect (ox - 2) (oy + 37) 40 1 (rgb 74 72 92)
          , rect (ox - 2) (oy - 2) 1 40 (rgb 74 72 92)
          , rect (ox + 37) (oy - 2) 1 40 (rgb 74 72 92)
          ]
        , runs
        , doorDots
        , way
        , me
        ]


-- Vigdis herself, Doom-style: the face keeps the score of the night.
-- Blood creeps in as the hearts go; a hit screws her eyes shut
faceShapes : Model -> List Shape
faceShapes m =
    let
        fx = 152
        fy = 4
        hurt = m.hurtT > 0
        blink = modBy 220 (m.tick + 37) < 8
        skin = if hurt then rgb 214 150 120 else rgb 208 170 134
        hair = rgb 196 150 74
        eye = rgb 40 44 60
        blood = rgb 150 22 26
        eyes =
            if hurt || blink then
                [ rect (fx + 3) (fy + 7) 3 1 eye, rect (fx + 10) (fy + 7) 3 1 eye ]
            else
                [ rect (fx + 3) (fy + 6) 3 2 eye, rect (fx + 10) (fy + 6) 3 2 eye ]
        mouth =
            if m.mode == Won then
                [ rect (fx + 5) (fy + 12) 6 1 blood, rect (fx + 4) (fy + 11) 2 1 blood, rect (fx + 10) (fy + 11) 2 1 blood ]
            else if hurt then
                [ rect (fx + 6) (fy + 11) 4 3 (rgb 60 22 22) ]
            else if m.hp <= 2 then
                [ rect (fx + 5) (fy + 12) 6 2 (rgb 96 40 40) ]
            else
                [ rect (fx + 5) (fy + 12) 6 1 (rgb 120 70 60) ]
        wounds =
            List.concat
                [ if m.hp <= 4 then [ rect (fx + 12) (fy + 4) 2 5 blood ] else []
                , if m.hp <= 2 then
                    [ rect (fx + 2) (fy + 9) 2 4 blood
                    , rect (fx + 7) (fy + 2) 3 2 blood
                    ]
                  else
                    []
                ]
        -- Armour rides on her head, Doom-style: no armour = bare hair; a
        -- little (leather, 1-4) = a boiled-hide cap; a full byrnie's worth
        -- (5-8) = an iron helm with the Norse nasal bar down the brow.
        -- Painted last so it sits over the hair (and any head wound).
        helm =
            if m.armor <= 0 then
                []
            else if m.armor <= 4 then
                [ rect fx fy 16 5 (rgb 120 84 52)
                , rect fx (fy + 4) 16 1 (rgb 152 112 70)
                , rect fx (fy + 3) 2 7 (rgb 98 68 44)
                , rect (fx + 14) (fy + 3) 2 7 (rgb 98 68 44)
                , rect (fx + 3) (fy + 1) 5 1 (rgb 150 110 70)
                ]
            else
                [ rect fx (fy - 1) 16 6 (rgb 150 158 176)
                , rect fx (fy + 4) 16 1 (rgb 196 204 220)
                , rect fx (fy + 3) 2 8 (rgb 128 136 154)
                , rect (fx + 14) (fy + 3) 2 8 (rgb 128 136 154)
                , rect (fx + 7) (fy + 4) 2 8 (rgb 174 182 200)
                , rect (fx + 3) fy 3 1 (rgb 208 216 232)
                ]
    in
    List.concat
        [ [ rect (fx - 2) (fy - 2) 20 20 (rgb 30 28 38)
          , rect (fx - 1) (fy - 1) 18 18 (rgb 16 15 20)
          , rect fx fy 16 4 hair
          , rect fx (fy + 3) 2 8 hair
          , rect (fx + 14) (fy + 3) 2 8 hair
          , rect (fx + 2) (fy + 3) 12 12 skin
          ]
        , eyes
        , mouth
        , wounds
        , helm
        ]


armorHud : Model -> List Shape
armorHud m =
    if m.armor <= 0 then
        []
    else
        List.concat
            [ [ rect 8 24 7 8 (rgb 150 158 176)
              , rect 9 30 5 3 (rgb 120 128 146)
              ]
            , pixText 19 25 1 (rgb 170 178 196) (String.fromInt m.armor)
            ]


-- bottom-left: the arsenal. Lit slot = in hand; unowned slots stay dark
-- and empty until you FIND the weapon out in the barrows
weaponHud : Model -> List Shape
weaponHud m =
    let
        slot =
            \i x owned icon ammo ->
                let
                    on = m.weapon == i
                    boxC = if on then rgb 60 58 76 else rgb 24 23 31
                    edgeC = if on then rgb 178 160 110 else rgb 52 50 62
                in
                List.concat
                    [ [ rect x 178 20 18 boxC
                      , rect x 178 20 1 edgeC
                      , rect x 195 20 1 edgeC
                      , rect x 178 1 18 edgeC
                      , rect (x + 19) 178 1 18 edgeC
                      ]
                    , if owned then icon else []
                    , if owned then ammo else []
                    ]
        seaxI = \x -> [ rect (x + 8) 181 3 9 (rgb 214 218 228), rect (x + 7) 189 5 4 (rgb 148 118 82) ]
        spearI = \x -> [ rect (x + 8) 181 2 10 (rgb 148 118 82), rect (x + 7) 180 4 3 (rgb 214 218 228) ]
        bowI = \x -> [ rect (x + 6) 181 2 11 (rgb 110 84 52), rect (x + 11) 182 1 9 (rgb 210 206 190), rect (x + 5) 180 6 2 (rgb 110 84 52) ]
        axeI = \x -> [ rect (x + 9) 181 2 11 (rgb 120 96 66), rect (x + 5) 180 8 4 (rgb 205 210 220) ]
        flaskI = \x -> [ rect (x + 6) 184 8 8 (rgb 96 130 70), rect (x + 9) 181 2 3 (rgb 255 190 70) ]
    in
    List.concat
        [ slot 0 8 True (seaxI 8) []
        , slot 1 30 m.hasSpear (spearI 30) []
        , slot 2 52 m.hasBow (bowI 52) (pixTextR 71 190 1 (rgb 200 196 180) (String.fromInt m.arrows))
        , slot 3 74 (m.axes > 0) (axeI 74) (pixTextR 93 190 1 (rgb 200 196 180) (String.fromInt m.axes))
        , slot 4 96 (m.flasks > 0) (flaskI 96) (pixTextR 115 190 1 (rgb 200 196 180) (String.fromInt m.flasks))
        ]


muteIcon : Model -> List Shape
muteIcon model =
    let
        c = if model.muted then rgb 120 110 110 else rgb 214 208 190
    in
    List.concat
        [ [ rect 300 8 5 6 c
          , rect 305 6 3 10 c
          ]
        , if model.muted then [ rect 297 4 14 2 (rgb 200 60 60) ] else [ rect 310 8 2 6 c ]
        ]


-- True on finger-only hardware: coarse pointer, nothing fine attached, no
-- hover. The pads (and the title's touch hint) key off the device capability,
-- so a desktop mouse never summons them and a phone shows them from the start.
padsWanted : Maybe Device -> Bool
padsWanted dev =
    case dev of
        Just d -> Device.touchOnly d
        Nothing -> False


touchPadShapes : Model -> List Shape
touchPadShapes m =
    if padsWanted m.dev && m.mode == Play then
        let
            p = padSpots m
            padC = rgb 40 42 52
            edgeC = rgb 92 96 116
            knobC = rgb 170 176 196
            mo = Maybe.withDefault { dx = 0, dy = 0 } m.padMove
            to = Maybe.withDefault 0 m.padTurn
        in
        List.concat
            -- Twin round analog sticks (modern mobile-FPS look): LEFT moves
            -- (2-axis), RIGHT looks/turns (rides on X). Sticks are self
            -- explanatory, so no labels; the two BUTTONS carry their meaning
            -- inside the face: ATK text on attack, cycle arrows on switch.
            [ [ circle p.mcx p.mcy 52 edgeC
              , circle p.mcx p.mcy 49 padC
              , circle (p.mcx + mo.dx * 38 // 60) (p.mcy + mo.dy * 38 // 60) 18 knobC
              ]
            , [ circle p.tcx p.tcy 52 edgeC
              , circle p.tcx p.tcy 49 padC
              , circle (p.tcx + to * 38 // 60) p.tcy 18 knobC
              ]
              -- ATTACK button (throws / swings the current weapon)
            , [ circle p.fx p.fy 26 (rgb 96 44 80)
              , circle p.fx p.fy 21 (rgb 150 70 130)
              ]
            , pixTextC p.fx (p.fy - 5) 2 (rgb 246 224 242) "ATK"
              -- SWITCH button: two opposing arrows = cycle to the next weapon
            , [ circle p.fx (p.fy - 62) 22 (rgb 44 52 84)
              , circle p.fx (p.fy - 62) 17 (rgb 74 86 130)
              , rect (p.fx - 10) (p.fy - 69) 13 4 (rgb 206 216 240)
              , triangle (p.fx + 3) (p.fy - 71) (p.fx + 3) (p.fy - 63) (p.fx + 10) (p.fy - 67) (rgb 206 216 240)
              , rect (p.fx - 3) (p.fy - 59) 13 4 (rgb 206 216 240)
              , triangle (p.fx - 3) (p.fy - 61) (p.fx - 3) (p.fy - 53) (p.fx - 10) (p.fy - 57) (rgb 206 216 240)
              ]
            ]
    else
        []


-- ===== screens =====


panel : Int -> Int -> Int -> Int -> List Shape
panel x y w h =
    [ rect x y w h (rgb 12 12 18)
    , rect x y w 2 (rgb 120 110 140)
    , rect x (y + h - 2) w 2 (rgb 120 110 140)
    , rect x y 2 h (rgb 120 110 140)
    , rect (x + w - 2) y 2 h (rgb 120 110 140)
    ]


titleShapes : Model -> List Shape
titleShapes m =
    let
        pulse = modBy 4 (m.tick // 24)
        fog =
            List.concat
                (List.indexedMap
                    (\i _ ->
                        [ rect 0 (30 + i * 26) 320 14 (rgb (12 + i * 3 + pulse) (12 + i * 3) (18 + i * 4 + pulse)) ])
                    (List.repeat 5 0))
        blink = modBy 210 (m.tick + 60) < 14
        eyes =
            if blink then
                []
            else
                [ rect 236 64 3 3 (rgb 120 230 255)
                , rect 243 64 3 3 (rgb 120 230 255)
                ]
        selY = if m.sel == 0 then 118 else 142
        -- the hint follows the hardware, not a past input: touch pads on a
        -- phone, keys on a desktop, decided from Device.touchOnly.
        controlsHint =
            if padsWanted m.dev then
                "LEFT STICK MOVE. RIGHT STICK LOOK."
            else
                "WASD MOVE. ARROWS TURN. SPACE THROW. M MUTE."
        descendHint =
            if padsWanted m.dev then "TAP TO DESCEND" else "ENTER TO DESCEND"
    in
    List.concat
        [ [ rect 0 0 320 200 (rgb 7 7 11) ]
        , fog
        , [ rect 0 172 320 28 (rgb 16 15 20) ]
        , eyes
        , pixTextC 160 26 4 (rgb 226 196 120) "MYRKHEIM"
        , pixTextC 160 52 1 (rgb 150 150 170) "THE DAWN RUNE IS STOLEN. THE SUN WAITS ON YOU."
        , pixTextC 160 70 1 (rgb 110 116 136) "A BARROW CRAWL BY THE MAR LANGUAGE"
        , panel 70 112 180 22
        , panel 70 136 180 22
        , pixTextC 160 118 1 (if m.sel == 0 then rgb 240 230 200 else rgb 130 130 148) "SAGA - RESTART AT EACH BARROW"
        , pixTextC 160 142 1 (if m.sel == 1 then rgb 240 230 200 else rgb 130 130 148) "EINHERJAR - ONE LIFE. VALHALLA."
        , [ rect 56 (selY + 2) 6 6 (rgb 226 196 120) ]
        , pixTextC 160 168 1 (rgb 120 126 146) controlsHint
        , pixTextC 160 180 1 (rgb 96 100 120) descendHint
        ]


introShapes : Model -> List Shape
introShapes m =
    List.concat
        [ [ rect 0 0 320 200 (rgb 5 5 8) ]
        , pixTextC 160 66 1 (rgb 130 130 150) ("BARROW " ++ String.fromInt (m.barrow + 1) ++ " OF " ++ String.fromInt barrowCount)
        , pixTextC 160 84 2 (rgb 226 196 120) (barrowName m.barrow)
        , pixTextC 160 112 1 (rgb 140 140 160) (barrowLine m.barrow)
        , if m.modeT > 40 then pixTextC 160 150 1 (rgb 96 100 120) (if padsWanted m.dev then "TAP" else "ANY KEY") else []
        ]


statLines : Model -> List Shape
statLines m =
    let
        secs = m.timeT // 60
        clock = String.fromInt (secs // 60) ++ ":" ++ (if modBy 60 secs < 10 then "0" else "") ++ String.fromInt (modBy 60 secs)
    in
    List.concat
        [ pixTextC 160 106 1 (rgb 200 196 180) ("TIME " ++ clock)
        , pixTextC 160 118 1 (rgb 232 190 70) ("GOLD " ++ String.fromInt (m.gold - m.snapGold))
        , pixTextC 160 130 1 (rgb 190 90 90) ("SLAIN " ++ String.fromInt (m.kills - m.snapKills))
        ]


clearedShapes : Model -> List Shape
clearedShapes m =
    List.concat
        [ panel 54 62 212 104
        , pixTextC 160 72 2 (rgb 226 196 120) "WAYSTONE REACHED"
        , pixTextC 160 92 1 (rgb 140 140 160) (barrowName m.barrow ++ " FALLS SILENT")
        , statLines m
        , pixTextC 160 144 1 (rgb 150 130 180)
            ("SECRETS " ++ String.fromInt m.secretsFound ++ "/" ++ String.fromInt m.secretsTotal)
        , if m.modeT > 20 then pixTextC 160 156 1 (rgb 96 100 120) "ANY KEY - DEEPER" else []
        ]


-- the death moment: the world stays in view while the dark closes over it
-- SLOWLY, like eyelids sliding shut from above and below — ~3.2s to meet,
-- a thin sliver of blood-red light at each lid's edge — and only on full
-- black does the barrow pronounce its verdict. The long dying groan plays
-- the whole time the eyes are closing. Color and shape carry the weight;
-- the frame itself never shakes or tilts.
dieShapes : Model -> List Shape
dieShapes m =
    let
        -- each lid grows to 100px (half the 200-tall screen) over 190 ticks
        -- (~3.2s at 60fps) — the deliberate, heavy slide of eyes giving up
        lid = min 100 (m.modeT * 100 // 190)
    in
    List.concat
        [ [ rect 0 0 320 (max 1 lid) (rgb 6 4 5) ]
        , [ rect 0 (200 - lid) 320 (max 1 lid) (rgb 6 4 5) ]
        , if lid < 100 then
            [ rect 0 lid 320 2 (rgb 150 20 22)
            , rect 0 (198 - lid) 320 2 (rgb 150 20 22)
            ]
          else
            []
        -- the eyes shut at 190; hold on pure black until 240 (a ~0.8s
        -- beat of silence) BEFORE the barrow pronounces its verdict
        , if m.modeT >= 240 then deadShapes m else []
        ]


-- a scrap of barrow-lore shown on death — a different one each time,
-- teaching a mechanic the player may have missed. Keyed off run stats so
-- it stays fixed while the death screen is up but varies between deaths.
-- Two short lines so each fits inside the panel (the pixel font has no
-- comma, so these break their clauses on periods).
deathHint : Model -> { a : String, b : String }
deathHint m =
    case modBy 6 (m.kills * 3 + m.barrow * 7 + m.gold + m.secretsFound) of
        0 -> { a = "CRACKED WALLS HIDE SECRET ROOMS.", b = "STRIKE ONE TO SMASH THROUGH." }
        1 -> { a = "THE VOLVA BLINKS ACROSS THE ROOM.", b = "WATCH WHERE SHE REAPPEARS. STRIKE FAST." }
        2 -> { a = "SHIELD-MAIDENS BLOCK HEAD-ON.", b = "HIT DURING THEIR WINDUP OR BURN THEM." }
        3 -> { a = "LOST IN THE DARK?", b = "THE MINIMAP TOP-RIGHT SHOWS THE WAY." }
        4 -> { a = "ARCHERS LOOSE ARROWS FROM AFAR.", b = "CLOSE THE GAP OR DUCK BEHIND A WALL." }
        _ -> { a = "VARGS HUNT IN PACKS.", b = "YOU HEAR THEM BARK BEFORE THEY POUNCE." }


deadShapes : Model -> List Shape
deadShapes m =
    let
        hint = deathHint m
    in
    List.concat
        [ panel 30 58 260 112
        , pixTextC 160 70 2 (rgb 200 60 60) (if m.hardcore then "VALHALLA AWAITS" else "THE BARROW KEEPS YOU")
        , pixTextC 160 92 1 (rgb 150 140 150)
            (if m.hardcore then "A GOOD DEATH. THE RUNE STAYS LOST." else "THE DEAD ARE PATIENT. TRY AGAIN.")
        , pixTextC 160 114 1 (rgb 150 146 120) hint.a
        , pixTextC 160 124 1 (rgb 150 146 120) hint.b
        , if canDismiss m then
            pixTextC 160 152 1 (rgb 96 100 120) (if m.hardcore then "ANY KEY - TITLE" else "ANY KEY - RISE AGAIN")
          else
            []
        ]


wonShapes : Model -> List Shape
wonShapes m =
    let
        show = m.modeT > 110
    in
    List.concat
        [ pixTextC 160 40 2 (rgb 250 236 170) "THE DAWN RUNE IS HOME"
        , if show then
            List.concat
                [ panel 44 92 232 76
                , pixTextC 160 100 1 (rgb 120 116 106) "THE SUN ROSE. THE BIRDS PRETENDED"
                , pixTextC 160 110 1 (rgb 120 116 106) "NOTHING HAD HAPPENED."
                , statLines2 m
                , pixTextC 160 156 1 (rgb 130 126 116) "ANY KEY - TITLE"
                ]
          else
            []
        ]


statLines2 : Model -> List Shape
statLines2 m =
    List.concat
        [ pixTextC 160 126 1 (rgb 90 86 80) ("GOLD " ++ String.fromInt m.gold)
        , pixTextC 160 138 1 (rgb 90 86 80) ("SLAIN " ++ String.fromInt m.kills ++ (if m.hardcore then " - EINHERJAR" else ""))
        ]


-- ===== pixel font (3x5 glyphs drawn as rects — same table as the other
-- Mar canvas games) =====


pixText : Int -> Int -> Int -> Color -> String -> List Shape
pixText x y s color str =
    List.concat
        (List.indexedMap
            (\i ch -> glyphShapes (x + i * 4 * s) y s color ch)
            (String.toList str))


pixTextC : Int -> Int -> Int -> Color -> String -> List Shape
pixTextC x y s color str =
    pixText (x - pixW (String.length str) s // 2) y s color str


pixTextR : Int -> Int -> Int -> Color -> String -> List Shape
pixTextR x y s color str =
    pixText (x - pixW (String.length str) s) y s color str


pixW : Int -> Int -> Int
pixW n s =
    n * 4 * s - s


glyphShapes : Int -> Int -> Int -> Color -> Char -> List Shape
glyphShapes gx gy s color ch =
    List.concat
        (List.indexedMap
            (\r bits -> rowShapes gx (gy + r * s) s color bits)
            (glyph ch))


rowShapes : Int -> Int -> Int -> Color -> Int -> List Shape
rowShapes rx ry s color bits =
    List.concat
        [ if bitOn bits 4 then [ rect rx ry s s color ] else []
        , if bitOn bits 2 then [ rect (rx + s) ry s s color ] else []
        , if bitOn bits 1 then [ rect (rx + 2 * s) ry s s color ] else []
        ]


bitOn : Int -> Int -> Bool
bitOn bits bit =
    modBy 2 (bits // bit) == 1


glyph : Char -> List Int
glyph ch =
    case ch of
        'A' -> [ 7, 5, 7, 5, 5 ]
        'B' -> [ 6, 5, 6, 5, 6 ]
        'C' -> [ 7, 4, 4, 4, 7 ]
        'D' -> [ 6, 5, 5, 5, 6 ]
        'E' -> [ 7, 4, 7, 4, 7 ]
        'F' -> [ 7, 4, 7, 4, 4 ]
        'G' -> [ 7, 4, 5, 5, 7 ]
        'H' -> [ 5, 5, 7, 5, 5 ]
        'I' -> [ 7, 2, 2, 2, 7 ]
        'J' -> [ 1, 1, 1, 5, 7 ]
        'K' -> [ 5, 6, 4, 6, 5 ]
        'L' -> [ 4, 4, 4, 4, 7 ]
        'M' -> [ 5, 7, 7, 5, 5 ]
        -- N is the lowercase ∩ shape (solid top, open bottom): at 3px
        -- wide a diagonal just fills the middle column and reads as M.
        'N' -> [ 7, 5, 5, 5, 5 ]
        'O' -> [ 7, 5, 5, 5, 7 ]
        'P' -> [ 7, 5, 7, 4, 4 ]
        'Q' -> [ 7, 5, 5, 7, 1 ]
        'R' -> [ 7, 5, 7, 6, 5 ]
        'S' -> [ 7, 4, 7, 1, 7 ]
        'T' -> [ 7, 2, 2, 2, 2 ]
        'U' -> [ 5, 5, 5, 5, 7 ]
        'V' -> [ 5, 5, 5, 5, 2 ]
        'W' -> [ 5, 5, 7, 7, 5 ]
        'X' -> [ 5, 5, 2, 5, 5 ]
        'Y' -> [ 5, 5, 2, 2, 2 ]
        'Z' -> [ 7, 1, 2, 4, 7 ]
        '0' -> [ 7, 5, 5, 5, 7 ]
        '1' -> [ 2, 6, 2, 2, 7 ]
        '2' -> [ 7, 1, 7, 4, 7 ]
        '3' -> [ 7, 1, 7, 1, 7 ]
        '4' -> [ 5, 5, 7, 1, 1 ]
        '5' -> [ 7, 4, 7, 1, 7 ]
        '6' -> [ 7, 4, 7, 5, 7 ]
        '7' -> [ 7, 1, 2, 2, 2 ]
        '8' -> [ 7, 5, 7, 5, 7 ]
        '9' -> [ 7, 5, 7, 1, 7 ]
        ':' -> [ 0, 2, 0, 2, 0 ]
        '-' -> [ 0, 0, 7, 0, 0 ]
        '.' -> [ 0, 0, 0, 0, 2 ]
        '!' -> [ 2, 2, 2, 0, 2 ]
        '?' -> [ 7, 1, 2, 0, 2 ]
        _ -> [ 0, 0, 0, 0, 0 ]


-- ===== wiring =====


subscriptions : Model -> Sub Msg
subscriptions model =
    Sub.batch
        [ Time.every (Time.millis (1000 // fps)) (\_ -> Tick)
        , Keyboard.watch KeysChanged
        , Gamepad.watch PadChanged
        , Device.watch DeviceChanged
        , if model.mode == Play then
            Sound.glide (drone model)
          else
            Sub.none
        , if model.mode == Play && model.combatT > 0 then
            Sound.loop warDrums
          else
            Sub.none
        ]


page : Page
page =
    Page.create
        { path = "/"
        , title = "Myrkheim"
        , init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }


main : Cmd ()
main =
    App.frontend [ page ]
