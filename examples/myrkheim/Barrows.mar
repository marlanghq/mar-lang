module Barrows exposing (..)

-- The five barrows as character maps, generated and validated by tools/. One
-- char per cell, so a level is text and a level editor is a text editor.



-- '#' stone  '%' carved  'T' torch wall  '.' floor  'd' plain door
-- 'D' rune door  'P' spawn  'X' waystone  'R' rune  'H' mead horn
-- 'G' gold ring  'E' draugr  'W' wraith  'J' the Jarl  'y' draug-archer
-- 'v' varg  'k' skjaldmaer  'q' volva  'p' bone pile


