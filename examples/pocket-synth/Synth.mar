module Synth exposing (..)

-- The instrument: a Patch and a pitch become a Sound. Oscillator, sub, body,
-- octave doubling and arpeggio are separate layers combined per note, and the
-- glide and polyphony rules live here too.

import Panel exposing (..)
import Types exposing (..)


-- Two octaves, C3..B4 (semitone index 0..23), plus the panel OCTAVE shift.


hzOf : Int -> Int
hzOf semi =
    case semi of
        0 -> 131
        1 -> 139
        2 -> 147
        3 -> 156
        4 -> 165
        5 -> 175
        6 -> 185
        7 -> 196
        8 -> 208
        9 -> 220
        10 -> 233
        11 -> 247
        12 -> 262
        13 -> 277
        14 -> 294
        15 -> 311
        16 -> 330
        17 -> 349
        18 -> 370
        19 -> 392
        20 -> 415
        21 -> 440
        22 -> 466
        23 -> 494
        _ -> 523


shiftHz : Int -> Int -> Int
shiftHz oct hz =
    if oct >= 2 then hz * 4
    else if oct == 1 then hz * 2
    else if oct == 0 then hz
    else if oct == 0 - 1 then hz // 2
    else hz // 4




waveOf : Int -> Sound.Wave
waveOf w =
    if w == 0 then Sound.Square
    else if w == 1 then Sound.Triangle
    else if w == 2 then Sound.Sawtooth
    else Sound.Noise


-- the square pulse-width shaping (a no-op for non-square waves)
shapeDuty : Patch -> Sound -> Sound
shapeDuty p s =
    if p.wave == 0 then Sound.duty p.duty s else s


-- The patch's TONE, applied to one voice. Sound.lowCut / Sound.highCut patch the
-- LAST voice of a Sound, so this belongs at each single-voice construction site,
-- never on an assembled chord: on a chord it would filter one layer and leave
-- the rest bright.
--
-- These are set per PRESET and not by a slider, and that is a framework limit
-- rather than taste: a held voice's identity includes its cuts, so moving a
-- cutoff while a note sounds would restart the note instead of sweeping it.
shapeCuts : Patch -> Sound -> Sound
shapeCuts p snd =
    let
        lowered = if p.lowCut > 0 then Sound.lowCut p.lowCut snd else snd
    in
    if p.highCut > 0 then Sound.highCut p.highCut lowered else lowered


-- one oscillator voice at `hz`, with the patch's shaping applied. No arp here:
-- the arpeggiator is built at the note level as a real sequence (see buildNote).
oscVoice : Patch -> Int -> Int -> Sound
oscVoice p vol hz =
    let
        base = shapeDuty p (Sound.tone (waveOf p.wave) hz p.len)

        bent =
            if p.bend == 0 then
                base
            else
                Sound.sweep (max 20 (hz * (100 + p.bend) // 100)) base

        wobbled =
            if p.vibD > 0 then Sound.vibrato p.vibD p.vibR bent else bent
    in
    shapeCuts p (Sound.volume vol wobbled)


-- a quiet sub-octave triangle, for body under the fundamental
subLayer : Patch -> Int -> Sound
subLayer p hz =
    shapeCuts p
        (Sound.volume (p.vol * 55 // 100)
            (Sound.tone Sound.Triangle (max 33 (hz // 2)) p.len))


-- a hammer-struck note: a short bright transient (the strike) over a body of
-- layers whose lengths are staggered: the upper, shorter ones die first, so the
-- tone loses brightness as well as volume. That is what makes the piano a piano.
--
-- Every layer DECAYS from the moment it is struck, which it did not always do.
-- The lengths were staggered but each layer held FLAT at full level and then
-- stopped, so the note was a rectangle that dropped in three audible steps and
-- cut off. A rectangle is an organ, not a string, no matter how many of them you
-- stack. The decay is one call per layer: `Sound.release ms` on a note that is
-- `ms` long puts the whole note inside its own release ramp, and the runtime
-- ramps exponentially, which is the curve a struck string actually follows.
struckBody : Patch -> Int -> Int -> Int -> Sound
struckBody p vol hz ms =
    let
        base = shapeDuty p (Sound.tone (waveOf p.wave) hz ms)
    in
    shapeCuts p
      (Sound.release ms
        (Sound.volume vol
            (if p.bend == 0 then
                base

             else
                Sound.sweep (max 20 (hz * (100 + p.bend) // 100)) base
            )
        ))


struckLayers : Patch -> Int -> List Sound
struckLayers p hz =
    let
        detHz = max 1 (hz * p.det // 1000)
    in
    List.concat
        [ -- the strike: one short bright transient. Never doubled and never
          -- bent: a hammer hits once, and detuning the attack would smear the
          -- very edge that makes the note read as struck.
          --
          -- 30ms, and it decays across all 30. It used to be 130ms holding FLAT
          -- at half the body's level, which is not a transient: at that length
          -- and that level the ear hears a separate pitched event, an octave-up
          -- sawtooth blip laid over the note. A real hammer transient is a few
          -- milliseconds of noise, so the honest direction was shorter and
          -- quieter, not a different wave.
          [ shapeCuts p
                (Sound.release 30
                    (Sound.volume (p.vol * 30 // 100)
                        (Sound.tone Sound.Sawtooth (max 40 (hz * 2)) 30)))
          ]
        , [ struckBody p p.vol hz p.len
          , struckBody p (p.vol * 66 // 100) hz (max 140 (p.len * 55 // 100))
          ]
        , if p.det > 0 then
            -- ENSEMBLE on a struck note is not an effect, it is what the
            -- instrument IS: a piano has two or three strings per note, tuned a
            -- hair apart on purpose, and the beating between them is why a piano
            -- sounds big instead of sounding like an organ. Push it and you get
            -- honky-tonk. Only the body doubles: the strings are the body.
            [ struckBody p (p.vol * 45 // 100) (hz + detHz) p.len
            , struckBody p (p.vol * 45 // 100) (hz - detHz) p.len
            ]

          else
            []
        , -- an octave above, short: it decays fastest of all, so the note loses
          -- brightness before it loses body: the upper partials of a real
          -- string die first, and that falling brightness IS the piano.
          [ octaveLayer p hz ]
        ]


-- Split out only so its length is written once: the layer's release has to match
-- its own span, and a decay that outlives its note (or ends before it) is the
-- one way to get this wrong.
octaveLayer : Patch -> Int -> Sound
octaveLayer p hz =
    let
        ms = max 110 (p.len * 30 // 100)
    in
    shapeCuts p
        (Sound.release ms
            (Sound.volume (p.vol * 40 // 100)
                (Sound.tone Sound.Triangle (max 40 (hz * 2)) ms)))


-- arpeggiator patterns: per-mille frequency ratios over the base note. Walked
-- as a real SEQUENCE of separate notes (looped while held), not the one-
-- oscillator chiptune pitch-blur, so you hear the chord climb, note by note.
arpSteps : Int -> List Int
arpSteps mode =
    if mode == 1 then [ 1000, 1260, 1498, 2000 ]                 -- up: major triad + octave
    else if mode == 2 then [ 1000, 1189, 1498, 2000 ]            -- up: minor triad + octave
    else if mode == 3 then [ 1000, 1260, 1498, 2000, 1498, 1260 ]  -- up then down, major
    else if mode == 4 then [ 1000, 2000, 4000, 2000 ]            -- octave bounce
    else if mode == 5 then [ 1000, 1260, 1498, 1888, 2000 ]      -- major 7, wide
    else [ 1000 ]


-- one arpeggiator step: a short patch-shaped note at `ratio` of the base pitch
arpStepSound : Patch -> Int -> Int -> Int -> Sound
arpStepSound p stepLen hz ratio =
    shapeCuts p
        (Sound.volume p.vol
            (shapeDuty p (Sound.tone (waveOf p.wave) (max 20 (hz * ratio // 1000)) stepLen)))


buildNote : Patch -> Int -> Sound
buildNote p hz0 =
    let
        hz = shiftHz p.oct hz0
    in
    if p.arp > 0 then
        -- a true arpeggiator: distinct notes strung in sequence; sustain loops it
        let
            steps = arpSteps p.arp
            stepLen = iclamp 90 240 (p.len // 6)
            run = Sound.sequence (List.map (\r -> arpStepSound p stepLen hz r) steps)
        in
        if p.sub then
            -- One sub-octave pedal UNDER the whole run, not one per step. Doubling
            -- every step an octave down just muddies the low register; a held root
            -- turns the arpeggio into a bass line with movement on top.
            --
            -- Its length is the run's own length ON PURPOSE. A HELD patch plays
            -- this through Sound.loop, and every voice of a looped sound has to
            -- total exactly the same ms: otherwise the channels slip a little
            -- further apart on each pass until they are playing different music.
            Sound.chord
                [ run
                , Sound.volume (p.vol * 55 // 100)
                    (Sound.tone Sound.Triangle
                        (max 33 (hz // 2))
                        (stepLen * List.length steps))
                ]

        else
            run

    else if p.struck then
        Sound.chord
            (List.concat
                [ struckLayers p hz
                  -- the sub decays with the note here, and only here: under a
                  -- SUSTAIN patch the same layer has to hold flat for as long as
                  -- the key is down, which is why the decay lives at this call
                  -- and not inside subLayer.
                , if p.sub then [ Sound.release p.len (subLayer p hz) ] else []
                ])

    else
        let
            detHz = max 1 (hz * p.det // 1000)
        in
        Sound.chord
            (List.concat
                [ [ oscVoice p p.vol hz ]
                , if p.det > 0 then
                    [ oscVoice p (p.vol * 45 // 100) (hz + detHz)
                    , oscVoice p (p.vol * 45 // 100) (hz - detHz)
                    ]
                  else
                    []
                , if p.sub then [ subLayer p hz ] else []
                ])


-- every semitone currently sounding, read straight off the two input mirrors:
-- each finger on the canvas mapped through the key under it (keyAt, -1 = not on a
-- key), plus each computer key mapped to its semitone: de-duplicated so a note
-- shared by both is one voice. The Sound subscriptions are rebuilt from this, so
-- a note sounds exactly while its finger/key is down, several at once = polyphony,
-- and a finger sliding to another key just changes its own semitone = glissando.
voices : Model -> List Int
voices model =
    let
        fromPointers =
            List.filter (\s -> s >= 0)
                (List.map (\pt -> keyAt model pt.x pt.y) model.pointers)

        fromKeys =
            List.filter (\s -> s >= 0)
                (List.map semiOfKey model.keys)
    in
    List.foldr
        (\s acc -> if List.member s acc then acc else s :: acc)
        []
        (fromPointers ++ fromKeys)


-- A held voice as a subscription. Which of the three lifetimes a note gets is a
-- function of the PATCH PARAMETERS alone, never of which preset is selected:
-- so every sound stays somewhere you could have walked to on the panel:
--
--   sustain off              -> Sound.once    rings once and decays, like a piano
--                                             (PLUCK and STRUCK on the VOICE button).
--   sustain + (arp | struck) -> Sound.loop    the re-attack IS the sound: an
--                                             arpeggio run, or the mandolin ROLL
--                                             that re-strikes while you hold it.
--   sustain, plain           -> Sound.voice one voice per key, held for as long
--                                             as that key is down: a true
--                                             organ/strings/pad sustain, with no
--                                             repeat, and polyphonic because a
--                                             voice's PITCH is part of its
--                                             identity: two keys are two voices.
--
-- HELD used to loop too, which meant holding a key re-attacked the note about
-- once a second. It sounded like a stuck loop rather than a held note, and the
-- only reason to accept it was that the held path rendered a bare tone and threw
-- the patch's timbre away. It applies duty/vibrato/filters now, so a held note
-- can be genuinely held without losing what makes it that patch.
--
-- It then spent a while on the WRONG held primitive. The one it used keyed a
-- voice by everything except its pitch, which is what an engine note wants (hand
-- it a new pitch and the running oscillator slides there) and is fatal for a
-- keyboard: two keys produced the same key, so they collapsed to one oscillator,
-- and releasing one slid the survivor to the other note. That primitive is
-- Sound.glide now, named for what it does, and a keyboard asks for Sound.voice.
--
-- The runtime fades a clean cut when the key is released early.
heldSound : Patch -> Int -> Sub Msg
heldSound patch semi =
    let
        s = buildNote patch (hzOf semi)
    in
    if patch.sustain == False then
        Sound.once s

    else if patch.arp > 0 || patch.struck then
        Sound.loop s

    else
        Sound.voice s


-- Which note GLIDE follows: the one that arrived LAST, which is what a
-- monophonic synth does and what your hands expect. Press a note, press a second
-- one, and the voice slides to the second: whether it is above or below.
--
-- Highest-note priority came first here and was wrong for a plain reason: it can
-- only ever slide UP. Press something lower while the first key is still down and
-- nothing happens, because the highest held note has not changed. Half the gesture
-- is dead, and that is not a convention, it is a missing feature.
--
-- The mirror does give us this, contrary to the first read of ADR-0005. A mirror
-- hands over the SET of keys down, with no ordering, but the model sees a mirror
-- BEFORE and AFTER each change, and the difference between two sets is exactly
-- "what just arrived". No press-order needs to come from the runtime.
--
-- ADR-0005's guarantee survives, and this is the line that matters: `glideTo` is
-- only ever used to CHOOSE AMONG notes the mirror currently reports. It is a
-- preference, never a claim about what is held, so it cannot strand a note. Drop
-- every key and `held` is empty, so there is no subscription and no sound, whatever
-- `glideTo` happens to remember.
retarget : Model -> Model -> Int
retarget before after =
    let
        held = voices after
        arrived = List.filter (\s -> List.member s (voices before) == False) held
    in
    case List.maximum arrived of
        -- something new: follow it. Several at once (a chord stab, two fingers
        -- landing in one frame) has no last, so take the top of them.
        Just semi ->
            semi

        Nothing ->
            if List.member after.glideTo held then
                after.glideTo

            else
                -- the followed note was released: slide to whatever is still down,
                -- or forget it when the keyboard is empty.
                case List.maximum held of
                    Just semi ->
                        semi

                    Nothing ->
                        0 - 1


-- The one sliding voice, or nothing while no key is down. The remembered note is
-- re-checked against the mirror here too, so a stale glideTo can never sound.
glideVoice : Model -> Patch -> List Int -> List (Sub Msg)
glideVoice model p held =
    if List.member model.glideTo held then
        [ Sound.glide (buildNote p (hzOf model.glideTo)) ]

    else
        []


-- GLIDE only reaches a sound that is genuinely HELD. A note that rings once
-- (PLUCK, STRUCK) is over before it could slide anywhere, and an arpeggio is a run
-- of SEPARATE notes, so there is nothing to slide between. Those are exactly the
-- modes that do not use Sound.voice, which is the primitive glide replaces.
--
-- Same rule the sliders follow: a control that cannot reach the sound in the
-- current mode is drawn dim and ignores taps.
glideReachable : Patch -> Bool
glideReachable p =
    p.sustain && p.struck == False && p.arp == 0


glideActive : Patch -> Bool
glideActive p =
    p.glide && glideReachable p


-- Voice-count gain, the thing every polysynth has and this one did not.
--
-- The audio bus sums voices LINEARLY, and at these pitches they really do add up
-- rather than average out: a chord holds only a handful of cycles per window, so
-- the phases stay put instead of cancelling. Measured on the ORGAN preset, which
-- asks for 0.62 of gain per note (0.40 voice + 0.22 sub): one note peaked ~0.30
-- at the bus, three notes peaked 1.05 to 1.29 depending on where the phases
-- landed. Past 1.0 the output is clipped, so a three-note chord was not merely
-- ~10dB louder than one note, it was distorting. Playing the same three notes one
-- after another never summed, which is why it only showed up on chords.
--
-- The scale is 1/sqrt(n), the usual choice, and what it holds constant is POWER:
-- n voices at a/sqrt(n) each sum to n * (a/sqrt n)^2 = a^2. So the chord sits at
-- the same LEVEL as a single note while its PEAK is still free to grow as the
-- phases line up: measured on the organ, peaks went 0.21 / 0.27 / 0.31 for one,
-- two and three notes with the level flat inside half a dB. That is the point: a
-- chord reads as fuller rather than louder, and the headroom is preserved.
-- Written as a table because the stdlib has no sqrt and, at this size, a table is
-- clearer than an approximation.
--
-- This is free at the runtime level precisely because volume is NOT part of a
-- held voice's identity (ADR-0024): joining or releasing a key re-levels the
-- voices that are already sounding by GLIDING their gain, never by restarting
-- them, so re-scaling mid-chord cannot click.
polyGain : Int -> Int
polyGain n =
    if n <= 1 then 1000        -- 1000 / sqrt n, per mille
    else if n == 2 then 707
    else if n == 3 then 577
    else if n == 4 then 500
    else if n == 5 then 447
    else if n == 6 then 408
    else if n == 7 then 378
    else if n == 8 then 354
    else 333                   -- 9 or more: ten fingers run out before this does


polyScaled : Patch -> Int -> Patch
polyScaled p n =
    { p | vol = max 1 (p.vol * polyGain n // 1000) }
