module Presets exposing (..)

-- The eight factory sounds, as data. A preset is just a Patch with a name, so
-- adding one is adding a record to a list -- no code elsewhere changes.

import Types exposing (..)


defaultPatch : Patch
defaultPatch =
    { wave = 1, duty = 50, oct = 0, det = 0, sub = True, len = 1500, bend = 0, vibD = 0, vibR = 5, arp = 0, vol = 60, struck = True, sustain = False, glide = False, lowCut = 0, highCut = 0 }


-- Twelve voices in two rows. Struck patches (piano, e-piano, bell) get a hammer
-- tick over a body that fades continuously from the strike onward, so they DECAY
-- like a real string instead of holding flat like the others.
presets : List Preset
presets =
    [ { name = "GRAND"
      , patch = { wave = 1, duty = 50, oct = 0, det = 0, sub = True, len = 1600, bend = 0, vibD = 0, vibR = 5, arp = 0, vol = 62, struck = True, sustain = False, glide = False, lowCut = 0, highCut = 0 }
      }
      -- vibD was 7 here and did nothing: struck notes never reached the LFO. It
      -- is 0 now rather than wired, because Sound.vibrato wobbles the PITCH and
      -- the electric-piano sound that 7 was reaching for is TREMOLO: amplitude,
      -- not pitch. Pitch wobble on a struck note reads as warped tape, not as a
      -- Rhodes. The honest fix is a Sound.tremolo the module does not have yet.
    , { name = "E-PIANO"
      , patch = { wave = 0, duty = 30, oct = 0, det = 0, sub = False, len = 950, bend = 0, vibD = 0, vibR = 5, arp = 0, vol = 52, struck = True, sustain = False, glide = False, lowCut = 0, highCut = 3500 }
      }
    , { name = "ORGAN"
      , patch = { wave = 0, duty = 50, oct = 0, det = 0, sub = True, len = 1400, bend = 0, vibD = 4, vibR = 6, arp = 0, vol = 40, struck = False, sustain = True, glide = False, lowCut = 0, highCut = 4000 }
      }
    , { name = "STRINGS"
      , patch = { wave = 2, duty = 50, oct = 0, det = 12, sub = False, len = 1500, bend = 0, vibD = 10, vibR = 5, arp = 0, vol = 38, struck = False, sustain = True, glide = False, lowCut = 120, highCut = 3000 }
      }
    , { name = "PLUCK"
      , patch = { wave = 1, duty = 50, oct = 1, det = 0, sub = False, len = 240, bend = 0 - 30, vibD = 0, vibR = 5, arp = 0, vol = 62, struck = False, sustain = False, glide = False, lowCut = 0, highCut = 0 }
      }
      -- The old BASS was an accidental raspberry, and each ingredient earned it:
      -- a narrow 38% pulse an octave down (thin and reedy where you want body),
      -- a sub-octave under THAT, and bend -5 gliding the pitch down across every
      -- note, which a 700ms sustain patch re-attacks twice a second. Low, buzzy,
      -- falling, in repeated bursts is how you synthesize a fart on purpose. Now
      -- it is a straight Moog-ish bass: 50% pulse for a fat fundamental, no
      -- glide, and a note long enough that holding one reads as held, not
      -- pulsing.
    , { name = "BASS"
      , patch = { wave = 0, duty = 50, oct = 0 - 1, det = 0, sub = True, len = 1300, bend = 0, vibD = 0, vibR = 5, arp = 0, vol = 55, struck = False, sustain = True, glide = False, lowCut = 0, highCut = 1200 }
      }
    , { name = "WOBBLE"
      , patch = { wave = 0, duty = 12, oct = 0 - 1, det = 0, sub = True, len = 1000, bend = 0, vibD = 60, vibR = 4, arp = 0, vol = 55, struck = False, sustain = True, glide = False, lowCut = 0, highCut = 900 }
      }
    , { name = "BELL"
      , patch = { wave = 1, duty = 50, oct = 1, det = 0, sub = False, len = 1100, bend = 0, vibD = 0, vibR = 5, arp = 0, vol = 46, struck = True, sustain = False, glide = False, lowCut = 0, highCut = 0 }
      }
      -- Was CHIME, a THIRD arpeggio next to ARP UP (the maj7 pattern is still a
      -- press of the ARP button away). NOI was the only oscillator with no
      -- preset, and until the runtime learned to pitch noise that was the right
      -- call: it sounded identical on all fourteen keys, so a preset would have
      -- been a dead switch. Now the note resamples the clip, so the low keys
      -- rumble and the high ones hiss, and the keyboard actually plays it: run
      -- your finger up for surf, hold the bottom for thunder. LENGTH, BEND and
      -- the LFO all shape it: noise follows the note now, so it bends and
      -- wobbles like any other wave. PULSE is the one that cannot: duty is the
      -- on/off ratio of a SQUARE's cycle, and noise has no cycle. The panel dims
      -- it here rather than letting you move a control that does nothing.
    , { name = "SURF"
      , patch = { wave = 3, duty = 50, oct = 0, det = 0, sub = False, len = 1400, bend = 0, vibD = 0, vibR = 5, arp = 0, vol = 45, struck = False, sustain = True, glide = False, lowCut = 0, highCut = 0 }
      }
    , { name = "ARP UP"
      , patch = { wave = 0, duty = 50, oct = 0, det = 0, sub = False, len = 900, bend = 0, vibD = 0, vibR = 5, arp = 1, vol = 48, struck = False, sustain = True, glide = False, lowCut = 0, highCut = 0 }
      }
      -- Was ARP OCT, a second arpeggio next to ARP UP (and CHIME is a third):
      -- three of twelve slots spent on one idea, and the octave pattern is still
      -- one press of the ARP button away, so nothing is actually lost. The row
      -- had no LEAD instead: the voice you play a melody ON. A narrow 25% pulse
      -- an octave up cuts through, a little ensemble thickens it, and the deep
      -- vibrato is what makes a lead sing rather than sit there.
    , { name = "LEAD"
      , patch = { wave = 0, duty = 25, oct = 1, det = 6, sub = False, len = 1300, bend = 0, vibD = 18, vibR = 6, arp = 0, vol = 50, struck = False, sustain = True, glide = False, lowCut = 0, highCut = 0 }
      }
    , { name = "UFO"
      , patch = { wave = 2, duty = 50, oct = 0, det = 25, sub = False, len = 1300, bend = 80, vibD = 80, vibR = 11, arp = 0, vol = 40, struck = False, sustain = True, glide = False, lowCut = 0, highCut = 0 }
      }
    ]


presetAt : Int -> Preset
presetAt i =
    case List.head (List.drop i presets) of
        Just p -> p
        Nothing ->
            { name = "GRAND", patch = defaultPatch }
