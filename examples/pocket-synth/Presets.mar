module Presets exposing (..)

-- The eight factory sounds, as data. A preset is just a Patch with a name, so
-- adding one is adding a record to a list -- no code elsewhere changes.

import Types exposing (..)


defaultPatch : Patch
defaultPatch =
    { wave = 1, duty = 50, oct = 0, det = 0, sub = True, len = 1500, bend = 0, vibD = 0, vibR = 5, tremD = 0, tremR = 6, arp = 0, vol = 60, struck = True, sustain = False, glide = False, lowCut = 0, highCut = 0 }


-- Twelve voices in two rows. Struck patches (piano, e-piano, bell) get a hammer
-- tick over a body that fades continuously from the strike onward, so they DECAY
-- like a real string instead of holding flat like the others.
--
-- `det` is in CENTS here (STRINGS 20, LEAD 10, UFO 43) and used to be a
-- per-mille slice of the frequency. The three numbers were re-derived rather than
-- re-tuned by ear: a per-mille of frequency is 1.73 cents, so each setting lands
-- within a cent of the RATIO the old arithmetic was asking for (12 -> 20.6,
-- 6 -> 10.4, 25 -> 42.8). What it could not do was deliver that ratio: whole-Hz
-- steps rounded it to something different on every key, so these are the
-- intervals the presets always meant and now get everywhere on the keyboard.
presets : List Preset
presets =
    [ { name = "GRAND"
      , patch = { wave = 1, duty = 50, oct = 0, det = 0, sub = True, len = 1600, bend = 0, vibD = 0, vibR = 5, tremD = 0, tremR = 6, arp = 0, vol = 62, struck = True, sustain = False, glide = False, lowCut = 0, highCut = 0 }
      }
      -- The Rhodes wobble, and it is TREMOLO: amplitude, not pitch. This used to
      -- ask for `vibD = 7`, which is a pitch wobble and reads as warped tape
      -- rather than as an electric piano -- and it did nothing anyway, because
      -- struck notes never reached the LFO. It sat at 0 with a comment saying the
      -- honest fix was a Sound.tremolo the module did not have. It has one now.
      -- 32% at 5 Hz is the shallow, quick throb of the real instrument; the depth
      -- only ever takes away, so the note still peaks where `vol` puts it.
    , { name = "E-PIANO"
      , patch = { wave = 0, duty = 30, oct = 0, det = 0, sub = False, len = 950, bend = 0, vibD = 0, vibR = 5, tremD = 32, tremR = 5, arp = 0, vol = 52, struck = True, sustain = False, glide = False, lowCut = 0, highCut = 3500 }
      }
    , { name = "ORGAN"
      , patch = { wave = 0, duty = 50, oct = 0, det = 0, sub = True, len = 1400, bend = 0, vibD = 4, vibR = 6, tremD = 0, tremR = 6, arp = 0, vol = 40, struck = False, sustain = True, glide = False, lowCut = 0, highCut = 4000 }
      }
    , { name = "STRINGS"
      , patch = { wave = 2, duty = 50, oct = 0, det = 20, sub = False, len = 1500, bend = 0, vibD = 10, vibR = 5, tremD = 0, tremR = 6, arp = 0, vol = 38, struck = False, sustain = True, glide = False, lowCut = 120, highCut = 3000 }
      }
      -- PLUCK is nearly twice as long as it was, and that is the DECAY stage
      -- paying for itself. At 240ms it was not short because a pluck is short; it
      -- was short because the note was a rectangle, and a long rectangle is an
      -- organ blip, so the only way to make this read as a pluck was to cut it
      -- off before the ear noticed it was flat. It falls exponentially across its
      -- own length now, so length buys RING instead of buying flatness, and the
      -- string can be left to sound.
    , { name = "PLUCK"
      , patch = { wave = 1, duty = 50, oct = 1, det = 0, sub = False, len = 420, bend = 0 - 30, vibD = 0, vibR = 5, tremD = 0, tremR = 6, arp = 0, vol = 62, struck = False, sustain = False, glide = False, lowCut = 0, highCut = 0 }
      }
      -- The old BASS was an accidental raspberry, and each ingredient earned it:
      -- a narrow 38% pulse an octave down (thin and reedy where you want body),
      -- a sub-octave under THAT, and bend -5 gliding the pitch down across every
      -- note, which a 700ms sustain patch re-attacks twice a second. Low, buzzy,
      -- falling, in repeated bursts is how you synthesize a fart on purpose. Now
      -- it is a straight Moog-ish bass: 50% pulse for a fat fundamental, no
      -- glide, and a note long enough that holding one reads as held, not
      -- pulsing.
    , { name = "BASS"
      , patch = { wave = 0, duty = 50, oct = 0 - 1, det = 0, sub = True, len = 1300, bend = 0, vibD = 0, vibR = 5, tremD = 0, tremR = 6, arp = 0, vol = 55, struck = False, sustain = True, glide = False, lowCut = 0, highCut = 1200 }
      }
    , { name = "WOBBLE"
      , patch = { wave = 0, duty = 12, oct = 0 - 1, det = 0, sub = True, len = 1000, bend = 0, vibD = 60, vibR = 4, tremD = 0, tremR = 6, arp = 0, vol = 55, struck = False, sustain = True, glide = False, lowCut = 0, highCut = 900 }
      }
    , { name = "BELL"
      , patch = { wave = 1, duty = 50, oct = 1, det = 0, sub = False, len = 1100, bend = 0, vibD = 0, vibR = 5, tremD = 0, tremR = 6, arp = 0, vol = 46, struck = True, sustain = False, glide = False, lowCut = 0, highCut = 0 }
      }
      -- Was CHIME, a THIRD arpeggio next to ARP UP (the maj7 pattern is still a
      -- press of the ARP button away). NOI was the only oscillator with no
      -- preset, and until the runtime learned to pitch noise that was the right
      -- call: it sounded identical on all fourteen keys, so a preset would have
      -- been a dead switch. Now the note resamples the clip, so the low keys
      -- rumble and the high ones hiss, and the keyboard actually plays it: run
      -- your finger up for surf, hold the bottom for thunder. LENGTH, BEND and
      -- the LFO all shape it: noise follows the note now, so it bends and
      -- wobbles like any other wave. PULSE is the one that cannot: duty is the
      -- on/off ratio of a SQUARE's cycle, and noise has no cycle. The panel dims
      -- it here rather than letting you move a control that does nothing.
    , { name = "SURF"
      , patch = { wave = 3, duty = 50, oct = 0, det = 0, sub = False, len = 1400, bend = 0, vibD = 0, vibR = 5, tremD = 0, tremR = 6, arp = 0, vol = 45, struck = False, sustain = True, glide = False, lowCut = 0, highCut = 0 }
      }
    , { name = "ARP UP"
      , patch = { wave = 0, duty = 50, oct = 0, det = 0, sub = False, len = 900, bend = 0, vibD = 0, vibR = 5, tremD = 0, tremR = 6, arp = 1, vol = 48, struck = False, sustain = True, glide = False, lowCut = 0, highCut = 0 }
      }
      -- Was ARP OCT, a second arpeggio next to ARP UP (and CHIME is a third):
      -- three of twelve slots spent on one idea, and the octave pattern is still
      -- one press of the ARP button away, so nothing is actually lost. The row
      -- had no LEAD instead: the voice you play a melody ON. A narrow 25% pulse
      -- an octave up cuts through, a little ensemble thickens it, and the deep
      -- vibrato is what makes a lead sing rather than sit there.
    , { name = "LEAD"
      , patch = { wave = 0, duty = 25, oct = 1, det = 10, sub = False, len = 1300, bend = 0, vibD = 18, vibR = 6, tremD = 0, tremR = 6, arp = 0, vol = 50, struck = False, sustain = True, glide = False, lowCut = 0, highCut = 0 }
      }
    , { name = "UFO"
      , patch = { wave = 2, duty = 50, oct = 0, det = 43, sub = False, len = 1300, bend = 80, vibD = 80, vibR = 11, tremD = 0, tremR = 6, arp = 0, vol = 40, struck = False, sustain = True, glide = False, lowCut = 0, highCut = 0 }
      }
    ]


presetAt : Int -> Preset
presetAt i =
    case List.head (List.drop i presets) of
        Just p -> p
        Nothing ->
            { name = "GRAND", patch = defaultPatch }
