module Main exposing (main)


-- Pocket Synth — a playable two-octave synthesizer.
--
-- The face is borrowed from the classic panel-of-knobs synths (the Minimoog's
-- three-section layout: OSCILLATOR / MODIFIERS / CONTROL): pick a preset, then
-- reach for the sliders and buttons to bend it into something else. Every
-- control maps 1:1 onto a Sound combinator, so the panel is also a live
-- diagram of the audio engine:
--
--   WAVE            -> Sound.tone's wave (Square / Triangle / Sawtooth / Noise)
--   PULSE           -> Sound.duty (square pulse width — the PWM knob)
--   OCTAVE          -> transposes the keyboard
--   ENSEMBLE        -> two extra voices detuned ± (Juno-style chorus)
--   SUB             -> a sub-octave triangle under every note
--   LENGTH          -> note duration (the envelope, chip style)
--   BEND            -> Sound.sweep (pitch glides up or down across the note)
--   LFO DEPTH/RATE  -> Sound.vibrato (cents, Hz) — off for struck notes
--   ARP             -> a real arpeggiator: Sound.sequence of chord tones, looped
--   VOLUME          -> Sound.volume
--
-- A control that cannot reach the sound in the current mode is drawn dim and
-- ignores taps (sliderActive). PULSE off a square wave is the permanent case;
-- the arpeggiator's are structural, because it replaces the note with a run of
-- steps and the one-note modifiers have nothing left to shape.
--
-- "Struck" presets (GRAND, E-PIANO, BELL) build the note from a bright hammer
-- transient over same-pitch layers of staggered length: as the short upper
-- layers fall silent the note loses amplitude and brightness, so it DECAYS like
-- a real string instead of holding flat. That is what makes the piano a piano.
--
-- A note sounds for as long as its key is HELD, not a fixed length: each held
-- key contributes a Sound subscription, recomputed from the Model, so pressing
-- starts it and releasing stops it. SUSTAIN patches (organ, strings, pads) hold
-- via Sound.loop while down; the rest ring out once like a piano (Sound.once,
-- which the runtime fades cleanly when you lift the key early). Polyphony is the
-- natural kind: the held voices are read straight off two input MIRRORS —
-- Canvas.watchPointers (every finger on the canvas: one note per finger, and a
-- finger sliding across keys bends its own note — glissando) and Keyboard.watch
-- (the computer keyboard: Z-row = low octave, Q-row = high octave). No per-finger
-- bookkeeping, and a stuck note is impossible by construction. The panel knobs
-- stay on the tap/drag OCCURRENCES (onTap/onDrag/onRelease) — a tap toggles, a
-- drag moves a slider; there is no "held" state to mirror there.


import Canvas exposing ( canvas, rect, circle, text, rgb, onTap, onDrag, onRelease, watchSize, watchPointers)
import Keyboard


-- ===== helpers =====




iclamp : Int -> Int -> Int -> Int
iclamp lo hi n =
    max lo (min hi n)


-- ===== the patch (everything the panel edits) =====


type alias Patch =
    { wave : Int        -- 0 square, 1 triangle, 2 sawtooth, 3 noise
    , duty : Int        -- square pulse width %, 5..95
    , oct : Int         -- keyboard transpose, -2..2
    , det : Int         -- ensemble detune, 0..30 (per-mille of pitch)
    , sub : Bool        -- sub-octave triangle layer
    , len : Int         -- note length ms, 80..1600 (arp on: also the step speed)
    , bend : Int        -- pitch bend %, -90..90 (0 = none)
    , vibD : Int        -- LFO depth in cents, 0..80
    , vibR : Int        -- LFO rate in Hz, 1..12
    , arp : Int         -- 0 off, 1 up-maj, 2 up-min, 3 up/down, 4 octaves, 5 maj7
    , vol : Int         -- 10..80
    , struck : Bool     -- True: hammer-struck (piano) — bright attack + a body that decays
    , sustain : Bool    -- True: sounds while HELD (loop); False: rings once then decays (piano)
    }


type alias Preset =
    { name : String, patch : Patch }


defaultPatch : Patch
defaultPatch =
    { wave = 1, duty = 50, oct = 0, det = 0, sub = True, len = 1500, bend = 0, vibD = 0, vibR = 5, arp = 0, vol = 60, struck = True, sustain = False }


-- Twelve voices in two rows. Struck patches (piano, e-piano, bell) get a bright
-- hammer transient over a body that steps down as its upper layers drop out —
-- so they DECAY like a real string, instead of holding flat like the others.
presets : List Preset
presets =
    [ { name = "GRAND"
      , patch = { wave = 1, duty = 50, oct = 0, det = 0, sub = True, len = 1600, bend = 0, vibD = 0, vibR = 5, arp = 0, vol = 62, struck = True, sustain = False }
      }
      -- vibD was 7 here and did nothing: struck notes never reached the LFO. It
      -- is 0 now rather than wired, because Sound.vibrato wobbles the PITCH and
      -- the electric-piano sound that 7 was reaching for is TREMOLO — amplitude,
      -- not pitch. Pitch wobble on a struck note reads as warped tape, not as a
      -- Rhodes. The honest fix is a Sound.tremolo the module does not have yet.
    , { name = "E-PIANO"
      , patch = { wave = 0, duty = 30, oct = 0, det = 0, sub = False, len = 950, bend = 0, vibD = 0, vibR = 5, arp = 0, vol = 52, struck = True, sustain = False }
      }
    , { name = "ORGAN"
      , patch = { wave = 0, duty = 50, oct = 0, det = 0, sub = True, len = 1400, bend = 0, vibD = 4, vibR = 6, arp = 0, vol = 40, struck = False, sustain = True }
      }
    , { name = "STRINGS"
      , patch = { wave = 2, duty = 50, oct = 0, det = 12, sub = False, len = 1500, bend = 0, vibD = 10, vibR = 5, arp = 0, vol = 38, struck = False, sustain = True }
      }
    , { name = "PLUCK"
      , patch = { wave = 1, duty = 50, oct = 1, det = 0, sub = False, len = 240, bend = 0 - 30, vibD = 0, vibR = 5, arp = 0, vol = 62, struck = False, sustain = False }
      }
      -- The old BASS was an accidental raspberry, and each ingredient earned it:
      -- a narrow 38% pulse an octave down (thin and reedy where you want body),
      -- a sub-octave under THAT, and bend -5 gliding the pitch down across every
      -- note — which a 700ms sustain patch re-attacks twice a second. Low, buzzy,
      -- falling, in repeated bursts is how you synthesize a fart on purpose. Now
      -- it is a straight Moog-ish bass: 50% pulse for a fat fundamental, no
      -- glide, and a note long enough that holding one reads as held, not
      -- pulsing.
    , { name = "BASS"
      , patch = { wave = 0, duty = 50, oct = 0 - 1, det = 0, sub = True, len = 1300, bend = 0, vibD = 0, vibR = 5, arp = 0, vol = 55, struck = False, sustain = True }
      }
    , { name = "WOBBLE"
      , patch = { wave = 0, duty = 12, oct = 0 - 1, det = 0, sub = True, len = 1000, bend = 0, vibD = 60, vibR = 4, arp = 0, vol = 55, struck = False, sustain = True }
      }
    , { name = "BELL"
      , patch = { wave = 1, duty = 50, oct = 1, det = 0, sub = False, len = 1100, bend = 0, vibD = 0, vibR = 5, arp = 0, vol = 46, struck = True, sustain = False }
      }
      -- Was CHIME, a THIRD arpeggio next to ARP UP (the maj7 pattern is still a
      -- press of the ARP button away). NOI was the only oscillator with no
      -- preset, and until the runtime learned to pitch noise that was the right
      -- call: it sounded identical on all fourteen keys, so a preset would have
      -- been a dead switch. Now the note resamples the clip, so the low keys
      -- rumble and the high ones hiss, and the keyboard actually plays it: run
      -- your finger up for surf, hold the bottom for thunder. LENGTH, BEND and
      -- the LFO all shape it — noise follows the note now, so it bends and
      -- wobbles like any other wave. PULSE is the one that cannot: duty is the
      -- on/off ratio of a SQUARE's cycle, and noise has no cycle. The panel dims
      -- it here rather than letting you move a control that does nothing.
    , { name = "SURF"
      , patch = { wave = 3, duty = 50, oct = 0, det = 0, sub = False, len = 1400, bend = 0, vibD = 0, vibR = 5, arp = 0, vol = 45, struck = False, sustain = True }
      }
    , { name = "ARP UP"
      , patch = { wave = 0, duty = 50, oct = 0, det = 0, sub = False, len = 900, bend = 0, vibD = 0, vibR = 5, arp = 1, vol = 48, struck = False, sustain = True }
      }
      -- Was ARP OCT, a second arpeggio next to ARP UP (and CHIME is a third):
      -- three of twelve slots spent on one idea, and the octave pattern is still
      -- one press of the ARP button away, so nothing is actually lost. The row
      -- had no LEAD instead — the voice you play a melody ON. A narrow 25% pulse
      -- an octave up cuts through, a little ensemble thickens it, and the deep
      -- vibrato is what makes a lead sing rather than sit there.
    , { name = "LEAD"
      , patch = { wave = 0, duty = 25, oct = 1, det = 6, sub = False, len = 1300, bend = 0, vibD = 18, vibR = 6, arp = 0, vol = 50, struck = False, sustain = True }
      }
    , { name = "UFO"
      , patch = { wave = 2, duty = 50, oct = 0, det = 25, sub = False, len = 1300, bend = 80, vibD = 80, vibR = 11, arp = 0, vol = 40, struck = False, sustain = True }
      }
    ]


presetAt : Int -> Preset
presetAt i =
    case List.head (List.drop i presets) of
        Just p -> p
        Nothing ->
            { name = "GRAND", patch = defaultPatch }


-- ===== model =====


type alias Pointer =
    { id : Int, x : Int, y : Int }


-- No "current preset" field. Which preset is lit is DERIVED from the patch
-- (selectedPreset), so the row cannot claim GRAND while the patch is something
-- else. Tapping a preset only loads its values; the moment you change one, the
-- lit button goes out on its own and the panel is simply showing a patch that
-- belongs to nobody.
type alias Model =
    { w : Int
    , h : Int
    , patch : Patch
    , keys : List Keyboard.Key   -- keys held on the computer keyboard (the mirror)
    , pointers : List Pointer    -- every finger on the canvas (the mirror): one
                                 -- note per finger over a key = polyphony, and a
                                 -- finger sliding bends its own note = glissando
    , dragCtl : Int              -- slider being dragged, -1 = none
    }


init : (Model, Cmd Msg)
init =
    ( { w = 900
      , h = 640
      , patch = (presetAt 0).patch
      , keys = []
      , pointers = []
      , dragCtl = 0 - 1
      }
    , Cmd.none
    )


type Msg
    = Resized Int Int
    | Tapped Int Int
    | Dragged Int Int
    | Released Int Int
    | KeysChanged { down : List Keyboard.Key }
    | PointersChanged (List Pointer)


-- ===== notes =====
-- Two octaves, C3..B4 (semitone index 0..23), plus the panel OCTAVE shift.


hzOf : Int -> Int
hzOf semi =
    case semi of
        0 -> 131
        1 -> 139
        2 -> 147
        3 -> 156
        4 -> 165
        5 -> 175
        6 -> 185
        7 -> 196
        8 -> 208
        9 -> 220
        10 -> 233
        11 -> 247
        12 -> 262
        13 -> 277
        14 -> 294
        15 -> 311
        16 -> 330
        17 -> 349
        18 -> 370
        19 -> 392
        20 -> 415
        21 -> 440
        22 -> 466
        23 -> 494
        _ -> 523


shiftHz : Int -> Int -> Int
shiftHz oct hz =
    if oct >= 2 then hz * 4
    else if oct == 1 then hz * 2
    else if oct == 0 then hz
    else if oct == 0 - 1 then hz // 2
    else hz // 4


-- ===== the audio engine: Patch + pitch -> Sound =====


waveOf : Int -> Sound.Wave
waveOf w =
    if w == 0 then Sound.Square
    else if w == 1 then Sound.Triangle
    else if w == 2 then Sound.Sawtooth
    else Sound.Noise


-- the square pulse-width shaping (a no-op for non-square waves)
shapeDuty : Patch -> Sound -> Sound
shapeDuty p s =
    if p.wave == 0 then Sound.duty p.duty s else s


-- one oscillator voice at `hz`, with the patch's shaping applied. No arp here:
-- the arpeggiator is built at the note level as a real sequence (see buildNote).
oscVoice : Patch -> Int -> Int -> Sound
oscVoice p vol hz =
    let
        base = shapeDuty p (Sound.tone (waveOf p.wave) hz p.len)

        bent =
            if p.bend == 0 then
                base
            else
                Sound.sweep (max 20 (hz * (100 + p.bend) // 100)) base

        wobbled =
            if p.vibD > 0 then Sound.vibrato p.vibD p.vibR bent else bent
    in
    Sound.volume vol wobbled


-- a quiet sub-octave triangle, for body under the fundamental
subLayer : Patch -> Int -> Sound
subLayer p hz =
    Sound.volume (p.vol * 55 // 100)
        (Sound.tone Sound.Triangle (max 33 (hz // 2)) p.len)


-- a hammer-struck note: a short bright transient (the strike) over a body of
-- same-pitch layers whose lengths are staggered — as the short upper layers
-- fall silent the tone loses both amplitude and brightness, so it DECAYS like a
-- real string instead of holding flat. This is what makes the piano a piano.
-- One body layer: the patch's wave, shaped by PULSE and BEND. Split out because
-- ENSEMBLE doubles THIS and nothing else.
struckBody : Patch -> Int -> Int -> Int -> Sound
struckBody p vol hz ms =
    let
        base = shapeDuty p (Sound.tone (waveOf p.wave) hz ms)
    in
    Sound.volume vol
        (if p.bend == 0 then
            base

         else
            Sound.sweep (max 20 (hz * (100 + p.bend) // 100)) base
        )


struckLayers : Patch -> Int -> List Sound
struckLayers p hz =
    let
        detHz = max 1 (hz * p.det // 1000)
    in
    List.concat
        [ -- the strike: one short bright transient. Never doubled and never
          -- bent — a hammer hits once, and detuning the attack would smear the
          -- very edge that makes the note read as struck.
          [ Sound.volume (p.vol * 50 // 100)
                (Sound.tone Sound.Sawtooth (max 40 (hz * 2)) 130)
          ]
        , [ struckBody p p.vol hz p.len
          , struckBody p (p.vol * 66 // 100) hz (max 140 (p.len * 55 // 100))
          ]
        , if p.det > 0 then
            -- ENSEMBLE on a struck note is not an effect, it is what the
            -- instrument IS: a piano has two or three strings per note, tuned a
            -- hair apart on purpose, and the beating between them is why a piano
            -- sounds big instead of sounding like an organ. Push it and you get
            -- honky-tonk. Only the body doubles: the strings are the body.
            [ struckBody p (p.vol * 45 // 100) (hz + detHz) p.len
            , struckBody p (p.vol * 45 // 100) (hz - detHz) p.len
            ]

          else
            []
        , -- an octave above, short: as it drops out the tone loses brightness as
          -- well as volume, which is the decay that makes a piano a piano
          [ Sound.volume (p.vol * 40 // 100)
                (Sound.tone Sound.Triangle (max 40 (hz * 2)) (max 110 (p.len * 30 // 100)))
          ]
        ]


-- arpeggiator patterns: per-mille frequency ratios over the base note. Walked
-- as a real SEQUENCE of separate notes (looped while held), not the one-
-- oscillator chiptune pitch-blur — so you hear the chord climb, note by note.
arpSteps : Int -> List Int
arpSteps mode =
    if mode == 1 then [ 1000, 1260, 1498, 2000 ]                 -- up: major triad + octave
    else if mode == 2 then [ 1000, 1189, 1498, 2000 ]            -- up: minor triad + octave
    else if mode == 3 then [ 1000, 1260, 1498, 2000, 1498, 1260 ]  -- up then down, major
    else if mode == 4 then [ 1000, 2000, 4000, 2000 ]            -- octave bounce
    else if mode == 5 then [ 1000, 1260, 1498, 1888, 2000 ]      -- major 7, wide
    else [ 1000 ]


-- one arpeggiator step: a short patch-shaped note at `ratio` of the base pitch
arpStepSound : Patch -> Int -> Int -> Int -> Sound
arpStepSound p stepLen hz ratio =
    Sound.volume p.vol
        (shapeDuty p (Sound.tone (waveOf p.wave) (max 20 (hz * ratio // 1000)) stepLen))


buildNote : Patch -> Int -> Sound
buildNote p hz0 =
    let
        hz = shiftHz p.oct hz0
    in
    if p.arp > 0 then
        -- a true arpeggiator: distinct notes strung in sequence; sustain loops it
        let
            steps = arpSteps p.arp
            stepLen = iclamp 90 240 (p.len // 6)
            run = Sound.sequence (List.map (\r -> arpStepSound p stepLen hz r) steps)
        in
        if p.sub then
            -- One sub-octave pedal UNDER the whole run, not one per step. Doubling
            -- every step an octave down just muddies the low register; a held root
            -- turns the arpeggio into a bass line with movement on top.
            --
            -- Its length is the run's own length ON PURPOSE. A HELD patch plays
            -- this through Sound.loop, and every voice of a looped sound has to
            -- total exactly the same ms — otherwise the channels slip a little
            -- further apart on each pass until they are playing different music.
            Sound.chord
                [ run
                , Sound.volume (p.vol * 55 // 100)
                    (Sound.tone Sound.Triangle
                        (max 33 (hz // 2))
                        (stepLen * List.length steps))
                ]

        else
            run

    else if p.struck then
        Sound.chord
            (List.concat
                [ struckLayers p hz
                , if p.sub then [ subLayer p hz ] else []
                ])

    else
        let
            detHz = max 1 (hz * p.det // 1000)
        in
        Sound.chord
            (List.concat
                [ [ oscVoice p p.vol hz ]
                , if p.det > 0 then
                    [ oscVoice p (p.vol * 45 // 100) (hz + detHz)
                    , oscVoice p (p.vol * 45 // 100) (hz - detHz)
                    ]
                  else
                    []
                , if p.sub then [ subLayer p hz ] else []
                ])


-- every semitone currently sounding, read straight off the two input mirrors:
-- each finger on the canvas mapped through the key under it (keyAt, -1 = not on a
-- key), plus each computer key mapped to its semitone — de-duplicated so a note
-- shared by both is one voice. The Sound subscriptions are rebuilt from this, so
-- a note sounds exactly while its finger/key is down, several at once = polyphony,
-- and a finger sliding to another key just changes its own semitone = glissando.
voices : Model -> List Int
voices model =
    let
        fromPointers =
            List.filter (\s -> s >= 0)
                (List.map (\pt -> keyAt model pt.x pt.y) model.pointers)

        fromKeys =
            List.filter (\s -> s >= 0)
                (List.map semiOfKey model.keys)
    in
    List.foldr
        (\s acc -> if List.member s acc then acc else s :: acc)
        []
        (fromPointers ++ fromKeys)


-- A held voice as a subscription. Which of the three lifetimes a note gets is a
-- function of the PATCH PARAMETERS alone — never of which preset is selected —
-- so every sound stays somewhere you could have walked to on the panel:
--
--   sustain off              -> Sound.once    rings once and decays, like a piano
--                                             (PLUCK and STRUCK on the VOICE button).
--   sustain + (arp | struck) -> Sound.loop    the re-attack IS the sound: an
--                                             arpeggio run, or the mandolin ROLL
--                                             that re-strikes while you hold it.
--   sustain, plain           -> Sound.hold one node held for as long as the key
--                                             is down — a true organ/strings/pad
--                                             sustain, with no repeat.
--
-- HELD used to loop too, which meant holding a key re-attacked the note about
-- once a second. It sounded like a stuck loop rather than a held note, and the
-- only reason to accept it was that the ambient bed rendered a bare tone and
-- threw the patch's timbre away. The bed applies duty/vibrato/filters now, so a
-- held note can be genuinely held without losing what makes it that patch.
--
-- The runtime fades a clean cut when the key is released early.
heldSound : Patch -> Int -> Sub Msg
heldSound patch semi =
    let
        s = buildNote patch (hzOf semi)
    in
    if patch.sustain == False then
        Sound.once s

    else if patch.arp > 0 || patch.struck then
        Sound.loop s

    else
        Sound.hold s


-- ===== layout =====
-- Reflow: everything hangs off w/h. Rows: header, presets, panel, keyboard.


-- the title bar is decoration, and on a landscape phone (~338px of viewport)
-- it costs a seventh of the whole screen while the keyboard starves. Drop it
-- there: the live preset is already spelled out, highlighted, in the preset
-- row right below. Portrait has the room, so it keeps the title.
headerH : Model -> Int
headerH m =
    if isShort m then 0 else 42


-- iPhone-14 landscape (~390 tall) is "short": collapse the preset grid to one
-- wide row so the keyboard still fits on screen. Portrait (~844) keeps two rows.
isShort : Model -> Bool
isShort m =
    m.h < 520


-- a phone in PORTRAIT is narrow: the panel's three columns are ~110px each,
-- far too tight for the OCT / SUB / ARP button row (which needs ~190px). On a
-- narrow screen that row moves to its own full-width line under the columns,
-- where 366px is plenty. Without this the SUB button is clipped by the screen
-- edge and ARP is drawn entirely off-canvas.
isNarrow : Model -> Bool
isNarrow m =
    m.w < 520


presetCols : Model -> Int
presetCols m =
    if isShort m then 12 else 6


-- Preset buttons are 34 tall on a 40 pitch (was 40 on 46). They are labels you
-- tap, not primary actions, and the height they give back goes to the keyboard.
presetRowH : Model -> Int
presetRowH m =
    if isShort m then 40 else 88


-- panel control rows are tighter on a short screen, to claw back vertical space
-- for the keyboard (landscape phones have very little height to spare).
panelRowH : Model -> Int
panelRowH m =
    if isShort m then 33 else 36


panelH : Model -> Int
panelH m =
    -- narrow needs no extra height: its button row sits one row lower but the
    -- wide layout's 168 already reaches past it.
    if isShort m then 130 else 168


-- the panel ends here; the keyboard gets whatever vertical space is left. On a
-- short screen the panel packs tight and the bottom gaps shrink, so even iOS
-- Safari's ~338px landscape viewport leaves a usable keyboard.
panelBottom : Model -> Int
panelBottom m =
    headerH m + presetRowH m + panelH m + (if isShort m then 8 else 18)


-- keyboard height: fill the leftover space, but CAP it so 14 narrow keys never
-- stretch into tall slivers (the portrait problem), and floor it so they stay
-- tappable (landscape). The cap is an ASPECT ratio, so it has to suit the
-- narrowest case: on a phone a white key is only ~26px wide, where 9x that was
-- a 9:1 sliver. 6x is about a real piano's proportion. On a wide screen `avail`
-- binds first, so this changes nothing there.
keyH : Model -> Int
keyH m =
    let
        avail = m.h - panelBottom m - (if isShort m then 10 else 14)
    in
    max 72 (min avail (whiteW m * 6))


-- the keyboard sits on the BOTTOM edge, under the thumbs. Capping the height
-- leaves slack on a tall portrait screen, and hanging the keys straight under
-- the panel would spend all of it as dead space below them.
kbTop : Model -> Int
kbTop m =
    max (panelBottom m) (m.h - keyH m - (if isShort m then 10 else 14))


type alias Rect2 =
    { x : Int, y : Int, w : Int, h : Int }


inR : Int -> Int -> Rect2 -> Bool
inR px py r =
    px >= r.x && px <= r.x + r.w && py >= r.y && py <= r.y + r.h


presetRect : Model -> Int -> Rect2
presetRect m i =
    let
        cols = presetCols m
        gap = 6
        row = i // cols
        col = i - row * cols
        cw = (m.w - 24 - gap * (cols - 1)) // cols
        x = 12 + col * (cw + gap)
        y = headerH m + 8 + row * 40
    in
    { x = x, y = y, w = cw, h = 34 }


-- panel geometry: three columns of controls
colX : Model -> Int -> Int
colX m c =
    12 + c * ((m.w - 24) // 3 + 4)


colW : Model -> Int
colW m =
    (m.w - 24) // 3 - 8


-- sliders (id: 0 pulse, 1 ensemble, 2 length, 3 bend, 4 lfo depth, 5 lfo rate, 6 volume)
sliderRect : Model -> Int -> Rect2
sliderRect m id =
    let
        y0 = headerH m + presetRowH m + 10
        rowH = panelRowH m
    in
    if id == 0 then { x = colX m 0 + 8, y = y0 + rowH + 26, w = colW m - 16, h = 22 }
    else if id == 1 then { x = colX m 0 + 8, y = y0 + rowH * 2 + 26, w = colW m - 16, h = 22 }
    else if id == 2 then { x = colX m 1 + 8, y = y0 + 26, w = colW m - 16, h = 22 }
    else if id == 3 then { x = colX m 1 + 8, y = y0 + rowH + 26, w = colW m - 16, h = 22 }
    else if id == 4 then { x = colX m 2 + 8, y = y0 + 26, w = colW m - 16, h = 22 }
    else if id == 5 then { x = colX m 2 + 8, y = y0 + rowH + 26, w = colW m - 16, h = 22 }
    else { x = colX m 1 + 8, y = y0 + rowH * 2 + 26, w = colW m - 16, h = 22 }


sliderRange : Int -> { lo : Int, hi : Int }
sliderRange id =
    if id == 0 then { lo = 5, hi = 95 }
    else if id == 1 then { lo = 0, hi = 30 }
    else if id == 2 then { lo = 80, hi = 1600 }
    else if id == 3 then { lo = 0 - 90, hi = 90 }
    else if id == 4 then { lo = 0, hi = 80 }
    else if id == 5 then { lo = 1, hi = 12 }
    else { lo = 10, hi = 80 }


sliderGet : Patch -> Int -> Int
sliderGet p id =
    if id == 0 then p.duty
    else if id == 1 then p.det
    else if id == 2 then p.len
    else if id == 3 then p.bend
    else if id == 4 then p.vibD
    else if id == 5 then p.vibR
    else p.vol


sliderSet : Int -> Int -> Patch -> Patch
sliderSet id v p =
    if id == 0 then { p | duty = v }
    else if id == 1 then { p | det = v }
    else if id == 2 then { p | len = v }
    else if id == 3 then { p | bend = v }
    else if id == 4 then { p | vibD = v }
    else if id == 5 then { p | vibR = v }
    else { p | vol = v }


sliderName : Int -> String
sliderName id =
    if id == 0 then "PULSE"
    else if id == 1 then "ENSEMBLE"
    else if id == 2 then "LENGTH"
    else if id == 3 then "BEND"
    else if id == 4 then "LFO DEPTH"
    else if id == 5 then "LFO RATE"
    else "VOLUME"


sliderIds : List Int
sliderIds =
    [ 0, 1, 2, 3, 4, 5, 6 ]


-- Which sliders actually reach the sound right now. One that moves, changes its
-- number, and changes nothing is the panel lying, so the dead ones are drawn dim
-- and ignore taps.
--
-- The three gaps are not the same kind of gap, and it is worth keeping them
-- straight:
--
--   PULSE off a square wave  — CANNOT work. Pulse width is the on/off ratio of a
--     square's cycle; a triangle or a sawtooth has no such thing to set. Nothing
--     to wire, now or ever.
--   Anything under ARP       — STRUCTURAL. The arpeggiator replaces the note with
--     a run of short steps, so the modifiers that shape ONE note have no note to
--     shape. SUB is the exception and is wired (see buildNote).
--   The LFO under STRUCK     — a DECISION. Sound.vibrato wobbles the PITCH, and a
--     struck note with a wobbling pitch reads as warped tape, not as an electric
--     piano. The Rhodes sound people expect is TREMOLO — amplitude, not pitch —
--     which the Sound module does not have. Rather than wire an effect that is
--     not the one this control implies, it stays off here.
sliderActive : Patch -> Int -> Bool
sliderActive p id =
    if id == 0 then p.wave == 0
    else if id == 1 then p.arp == 0
    else if id == 3 then p.arp == 0
    else if id == 4 then p.arp == 0 && p.struck == False
    else if id == 5 then p.arp == 0 && p.struck == False
    else True


-- VOICE: what the note DOES over time. Two independent switches in the patch —
-- `struck` picks the synthesis (hammered layers that decay, or a plain
-- oscillator) and `sustain` picks the lifetime (loops while held, or rings once)
-- — but a player hears one decision, so they ride one button.
--
-- They rode NO button until now, and that was the bug: a preset could set them,
-- the panel could not, so GRAND (struck, rings once) and ORGAN (plain, held)
-- were islands. No sequence of taps got you from one to the other. A preset has
-- to be a place you could have walked to yourself, or it is not a preset, it is
-- a mode.
--
-- Encoded 2*struck + sustain, so all four combinations are reachable, including
-- the one no preset uses (hammered AND held = a note that re-strikes while you
-- hold it, a mandolin roll).
voiceMode : Patch -> Int
voiceMode p =
    (if p.struck then 2 else 0) + (if p.sustain then 1 else 0)


-- The label offers only what the current mode can actually do.
--
-- With the arpeggiator on, buildNote never reads `struck` — the run of steps
-- REPLACES the note that flag would have shaped. Only the sustain half survives,
-- because it is read somewhere else entirely (heldSound picks Sound.loop or
-- Sound.once around whatever buildNote returned). So four labels would collapse
-- to two behaviours: PLUCK and STRUCK would sound identical, HELD and ROLL too.
--
-- Rather than let the button lie, it offers two states there. Nothing is blocked
-- and nothing is lost: `struck` keeps its stored value, quietly, and comes back
-- the moment ARP goes off — so trying an arpeggio does not cost you the hammer
-- you had picked.
voiceLabel : Patch -> String
voiceLabel p =
    if p.arp > 0 then
        if p.sustain then "HELD" else "PLUCK"

    else if p.struck then
        if p.sustain then "ROLL" else "STRUCK"

    else if p.sustain then
        "HELD"

    else
        "PLUCK"


-- Tapping VOICE: the full four-way cycle normally, and just the sustain flip
-- while the arpeggiator is on — the two states the label is showing.
nextVoice : Patch -> Patch
nextVoice p =
    if p.arp > 0 then
        { p | sustain = p.sustain == False }

    else
        setVoiceMode (if voiceMode p >= 3 then 0 else voiceMode p + 1) p


setVoiceMode : Int -> Patch -> Patch
setVoiceMode mode p =
    { p | struck = mode >= 2, sustain = mode == 1 || mode == 3 }


-- wave buttons live in column 0, row 0
waveRect : Model -> Int -> Rect2
waveRect m i =
    let
        y0 = headerH m + presetRowH m + 10
        bw = (colW m - 8 - 18) // 4
    in
    { x = colX m 0 + 8 + i * (bw + 6), y = y0 + 2, w = bw, h = 26 }


-- octave / sub / arp buttons live in column 2, bottom row (aligned with row 2)
octRowY : Model -> Int
octRowY m =
    if isNarrow m then
        -- its own line, below all three columns
        headerH m + presetRowH m + 10 + panelRowH m * 3 + 16
    else
        headerH m + presetRowH m + 10 + panelRowH m * 2 + 28


octDownRect : Model -> Rect2
octDownRect m =
    if isNarrow m then { x = 12, y = octRowY m, w = 44, h = 26 }
    else { x = colX m 2 + 8, y = octRowY m, w = 34, h = 26 }


octUpRect : Model -> Rect2
octUpRect m =
    if isNarrow m then { x = 12 + 52, y = octRowY m, w = 44, h = 26 }
    else { x = colX m 2 + 8 + 38, y = octRowY m, w = 34, h = 26 }


subRect : Model -> Rect2
subRect m =
    if isNarrow m then { x = 12 + 112, y = octRowY m, w = 52, h = 26 }
    else { x = colX m 2 + 8 + 86, y = octRowY m, w = 44, h = 26 }


voiceRect : Model -> Rect2
voiceRect m =
    if isNarrow m then { x = 12 + 176, y = octRowY m, w = 68, h = 26 }
    else { x = colX m 2 + 8 + 138, y = octRowY m, w = 68, h = 26 }


-- ARP takes whatever is left of the row, so its label always has room.
arpRect : Model -> Rect2
arpRect m =
    if isNarrow m then { x = 12 + 256, y = octRowY m, w = max 52 (m.w - 12 - (12 + 256)), h = 26 }
    else { x = colX m 2 + 8 + 214, y = octRowY m, w = max 52 (colW m - 230), h = 26 }


-- ===== keyboard geometry =====
-- 14 white keys (C3..B4). Black keys sit on the boundary between whites.


whiteSemis : List Int
whiteSemis =
    [ 0, 2, 4, 5, 7, 9, 11, 12, 14, 16, 17, 19, 21, 23 ]


-- black key: (semitone, index of the white key to its LEFT)
blackSemis : List { semi : Int, after : Int }
blackSemis =
    [ { semi = 1, after = 0 }
    , { semi = 3, after = 1 }
    , { semi = 6, after = 3 }
    , { semi = 8, after = 4 }
    , { semi = 10, after = 5 }
    , { semi = 13, after = 7 }
    , { semi = 15, after = 8 }
    , { semi = 18, after = 10 }
    , { semi = 20, after = 11 }
    , { semi = 22, after = 12 }
    ]


-- On a narrow phone the keyboard drops to ONE octave: 7 white keys at ~52px
-- instead of 14 at ~26px. Half a fingertip is not a key. Nothing becomes
-- unreachable, because OCT -/+ already transposes the whole instrument (and
-- the computer keyboard still spans both octaves on a machine that has one).
whiteCount : Model -> Int
whiteCount m =
    if isNarrow m then 7 else 14


visibleWhites : Model -> List Int
visibleWhites m =
    List.take (whiteCount m) whiteSemis


visibleBlacks : Model -> List { semi : Int, after : Int }
visibleBlacks m =
    if isNarrow m then List.take 5 blackSemis else blackSemis


whiteW : Model -> Int
whiteW m =
    (m.w - 24) // whiteCount m


whiteRect : Model -> Int -> Rect2
whiteRect m i =
    let
        top = kbTop m
    in
    { x = 12 + i * whiteW m, y = top, w = whiteW m - 2, h = keyH m }


-- Black keys are NOT centred on the seam between two whites, which is where a
-- quick drawing puts them. On a real piano they sit inside their GROUP — C#/D#
-- share the three whites C-D-E, F#/G#/A# share the four of F-G-A-B — spaced so
-- the white "tails" left between them all come out the SAME width. That evenness
-- is the comb the eye recognises as a piano.
--
-- Centring on the seam made the tails here alternate 64 and 41 px: C, E, F and B
-- fat, D, G and A thin, a 56% swing. On a real keyboard the tails land within a
-- millimetre of each other AND within a millimetre of the black key itself
-- (~14.4mm and ~13.2mm against a 13.7mm key), which is why the pattern reads as
-- regular even though the black keys are not evenly spaced.
--
-- For a group of n whites carrying n-1 blacks, the k-th black starts at
--     (k+1) * (n*ww - (n-1)*bw) / n  +  k*bw
-- from the group's left edge. The multiply happens BEFORE the divide so the
-- integer rounding does not pile up and leave the last tail short.
blackRect : Model -> Int -> Rect2
blackRect m after =
    let
        ww = whiteW m

        -- 55% of a white key's width, 52% of its length. A real piano sits at
        -- ~58% and ~60%, but drawn flat — no bevel, no shadow to slim them —
        -- black keys read heavier than those numbers suggest, so a touch under
        -- the acoustic ratio on both axes is what looks right on screen.
        bw = ww * 55 // 100

        -- where this key falls: which octave, and which of the five slots
        -- (0 C#, 1 D#, 3 F#, 4 G#, 5 A#)
        oct = after // 7
        pos = after - oct * 7

        inCDE = pos <= 1
        n = if inCDE then 3 else 4
        k = if inCDE then pos else pos - 3

        groupFirstWhite = oct * 7 + (if inCDE then 0 else 3)
        groupX = 12 + groupFirstWhite * ww
    in
    { x = groupX + ((k + 1) * (n * ww - (n - 1) * bw)) // n + k * bw
    , y = kbTop m
    , w = bw
    , h = keyH m * 52 // 100
    }


-- which key a canvas point lands on (black keys first: they sit on top)
keyAt : Model -> Int -> Int -> Int
keyAt m x y =
    let
        black =
            List.head
                (List.filter (\b -> inR x y (blackRect m b.after)) (visibleBlacks m))
    in
    case black of
        Just b ->
            b.semi

        Nothing ->
            let
                white =
                    List.head
                        (List.filter
                            (\i -> inR x y (whiteRect m i))
                            (List.range 0 (whiteCount m - 1)))
            in
            case white of
                Just i ->
                    Maybe.withDefault (0 - 1) (List.head (List.drop i (visibleWhites m)))

                Nothing ->
                    0 - 1


-- ===== computer keyboard mapping (DAW style, two rows) =====


semiOfKey : Keyboard.Key -> Int
semiOfKey k =
    case k of
        Keyboard.KeyZ -> 0
        Keyboard.KeyS -> 1
        Keyboard.KeyX -> 2
        Keyboard.KeyD -> 3
        Keyboard.KeyC -> 4
        Keyboard.KeyV -> 5
        Keyboard.KeyG -> 6
        Keyboard.KeyB -> 7
        Keyboard.KeyH -> 8
        Keyboard.KeyN -> 9
        Keyboard.KeyJ -> 10
        Keyboard.KeyM -> 11
        Keyboard.KeyQ -> 12
        Keyboard.Digit2 -> 13
        Keyboard.KeyW -> 14
        Keyboard.Digit3 -> 15
        Keyboard.KeyE -> 16
        Keyboard.KeyR -> 17
        Keyboard.Digit5 -> 18
        Keyboard.KeyT -> 19
        Keyboard.Digit6 -> 20
        Keyboard.KeyY -> 21
        Keyboard.Digit7 -> 22
        Keyboard.KeyU -> 23
        _ -> 0 - 1


-- ===== update =====


update : Msg -> Model -> (Model, Cmd Msg)
update msg model =
    case msg of
        Resized w h ->
            ( { model | w = w, h = h }, Cmd.none )

        Tapped x y ->
            press x y model

        Dragged x y ->
            -- only the panel sliders care about drags now; the musical keys are
            -- driven by the pointer mirror (a finger sliding across keys bends
            -- its own note there, per finger — no code needed here).
            --
            -- onDrag carries no finger id, so EVERY moving finger arrives here.
            -- Without the zone test, a finger resting on a key would drive
            -- whatever slider the OTHER hand grabbed. Panel drags live above the
            -- keyboard; anything at or below kbTop is a key, not a knob.
            if model.dragCtl >= 0 && y < kbTop model then
                ( dragSlider model.dragCtl x model, Cmd.none )
            else
                ( model, Cmd.none )

        Released _ _ ->
            -- a finger lifting is NOT enough to end a slider drag: onRelease has
            -- no id either, so the key hand lifting would cancel the knob hand's
            -- drag. The mirror ends it instead (see PointersChanged). Notes stop
            -- on their own — a lifted finger just leaves the mirror.
            ( model, Cmd.none )

        KeysChanged st ->
            ( { model | keys = st.down }, Cmd.none )

        PointersChanged ps ->
            -- recompute the drag from the WHOLE snapshot, the mirror's own rule:
            -- the drag is over exactly when no finger is left on the panel.
            let
                onPanel = List.filter (\pt -> pt.y < kbTop model) ps
            in
            ( { model
                | pointers = ps
                , dragCtl = if List.isEmpty onPanel then 0 - 1 else model.dragCtl
              }
            , Cmd.none
            )


-- a tap: keyboard first, then panel controls
press : Int -> Int -> Model -> (Model, Cmd Msg)
press x y model =
    let
        k = keyAt model x y
    in
    if k >= 0 then
        -- a key tap: the pointer mirror (watchPointers) already sounds it, so
        -- there is nothing to do here — panel taps and key taps stay separate.
        ( model, Cmd.none )
    else
        case tappedPreset model x y of
            Just i ->
                -- switch patch silently; the sound only plays when a key is pressed
                ( { model | patch = (presetAt i).patch }
                , Cmd.none
                )

            Nothing ->
                pressPanel x y model


-- Which preset the panel is ON, DERIVED: a preset is selected exactly while the
-- patch still equals it, index or -1. The Model used to STORE this, and that is
-- what made the row lie — the stored index stayed lit through every slider move,
-- so the panel claimed GRAND while the patch was somewhere else entirely.
-- Derived, a single edit un-lights it and tapping the preset again re-lights it,
-- with nothing to keep in sync. The field is gone: it existed only to be shown,
-- and once the display is computed there is nothing left for it to do.
selectedPreset : Model -> Int
selectedPreset model =
    case
        List.head
            (List.filter
                (\i -> (presetAt i).patch == model.patch)
                (List.range 0 (List.length presets - 1)))
    of
        Just i -> i
        Nothing -> 0 - 1


tappedPreset : Model -> Int -> Int -> Maybe Int
tappedPreset model x y =
    List.head
        (List.filter
            (\i -> inR x y (presetRect model i))
            (List.range 0 (List.length presets - 1)))


pressPanel : Int -> Int -> Model -> (Model, Cmd Msg)
pressPanel x y model =
    let
        wave =
            List.head
                (List.filter (\i -> inR x y (waveRect model i)) (List.range 0 3))

        -- a dimmed slider is not a target: tapping it must not jump its value to
        -- where the finger landed, or the panel would still be editing something
        -- that does nothing
        slider =
            List.head
                (List.filter
                    (\id -> sliderActive model.patch id && inR x y (sliderRect model id))
                    sliderIds)

        p = model.patch
    in
    case wave of
        Just wv ->
            ( { model | patch = { p | wave = wv } }, Cmd.none )

        Nothing ->
            case slider of
                Just id ->
                    ( dragSlider id x { model | dragCtl = id }, Cmd.none )

                Nothing ->
                    if inR x y (octDownRect model) then
                        ( { model | patch = { p | oct = max (0 - 2) (p.oct - 1) } }, Cmd.none )
                    else if inR x y (octUpRect model) then
                        ( { model | patch = { p | oct = min 2 (p.oct + 1) } }, Cmd.none )
                    else if inR x y (subRect model) then
                        ( { model | patch = { p | sub = p.sub == False } }, Cmd.none )
                    else if inR x y (voiceRect model) then
                        ( { model | patch = nextVoice p }, Cmd.none )
                    else if inR x y (arpRect model) then
                        ( { model | patch = { p | arp = if p.arp >= 5 then 0 else p.arp + 1 } }, Cmd.none )
                    else
                        ( model, Cmd.none )


dragSlider : Int -> Int -> Model -> Model
dragSlider id x model =
    let
        r = sliderRect model id
        rng = sliderRange id
        v = rng.lo + (iclamp r.x (r.x + r.w) x - r.x) * (rng.hi - rng.lo) // max 1 r.w
    in
    { model | patch = sliderSet id v model.patch }


-- ===== view =====


bgDark : Color
bgDark = rgb 24 22 28


panelBg : Color
panelBg = rgb 38 34 44


accent : Color
accent = rgb 255 176 84


textDim : Color
textDim = rgb 152 146 160


textMain : Color
textMain = rgb 236 230 224


view : Model -> View Msg
view model =
    canvas Crisp [ watchSize Resized, watchPointers PointersChanged, onTap Tapped, onDrag Dragged, onRelease Released ]
        (List.concat
            [ [ rect 0 0 model.w model.h bgDark ]
            , header model
            , presetShapes model
            , panelShapes model
            , keyboardShapes model
            ])


header : Model -> List Shape
header model =
    -- nothing to draw where headerH is 0 (landscape) — the row does not exist
    if isShort model then
        []
    else
        -- No caption naming the patch. The lit button already says which preset
        -- is loaded, and no lit button already says the patch is nobody's — a
        -- line of text repeating that would only be a second place to keep true.
        [ text 14 28 19 Canvas.Left accent "POCKET SYNTH" ]


presetShapes : Model -> List Shape
presetShapes model =
    let
        sel = selectedPreset model
    in
    List.concat
        (List.indexedMap
            (\i p ->
                let
                    on = i == sel
                    r = presetRect model i
                in
                [ rect r.x r.y r.w r.h (if on then rgb 70 54 40 else panelBg)
                , rect r.x r.y r.w 3 (if on then accent else rgb 58 54 66)
                , text (r.x + r.w // 2) (r.y + 22) 11 Canvas.Center
                    (if on then accent else textMain)
                    p.name
                ]
            )
            presets)


sectionLabel : Model -> Int -> String -> List Shape
sectionLabel m c label =
    [ text (colX m c + 8) (headerH m + presetRowH m + 4) 9 Canvas.Left textDim label ]


panelShapes : Model -> List Shape
panelShapes model =
    let
        p = model.patch

        panelTop = headerH model + presetRowH model + 6
    in
    List.concat
        [ [ rect 6 (panelTop - 8) (model.w - 12) (panelH model) panelBg ]
        , sectionLabel model 0 "OSCILLATOR"
        , sectionLabel model 1 "MODIFIERS"
        , sectionLabel model 2 "LFO + CONTROL"
        , waveButtons model
        , List.concat (List.map (\id -> sliderShapes model id) sliderIds)
        , octaveButtons model
        , toggleButtons model
        ]


waveButtons : Model -> List Shape
waveButtons model =
    let
        names = [ "SQR", "TRI", "SAW", "NOI" ]
    in
    List.concat
        (List.indexedMap
            (\i nm ->
                let
                    r = waveRect model i
                    on = model.patch.wave == i
                in
                [ rect r.x r.y r.w r.h (if on then rgb 70 54 40 else rgb 50 46 58)
                , text (r.x + r.w // 2) (r.y + 18) 10 Canvas.Center (if on then accent else textDim) nm
                ]
            )
            names)


sliderShapes : Model -> Int -> List Shape
sliderShapes model id =
    let
        r = sliderRect model id
        rng = sliderRange id
        v = sliderGet model.patch id
        fx = r.x + (v - rng.lo) * r.w // max 1 (rng.hi - rng.lo)

        -- Dimmed, not hidden: the value is still true and still worth reading,
        -- it just has nothing to act on until the mode changes. Hiding it would
        -- make the panel jump around every time you switch waves.
        on = sliderActive model.patch id
    in
    [ text r.x (r.y - 5) 9 Canvas.Left
        (if on then textDim else rgb 88 84 96)
        (sliderName id ++ "  " ++ String.fromInt v)
    , rect r.x (r.y + 8) r.w 5 (if on then rgb 56 52 64 else rgb 44 41 50)
    , rect r.x (r.y + 8) (max 2 (fx - r.x)) 5 (if on then rgb 120 90 60 else rgb 62 56 52)
    , circle fx (r.y + 10) 9 (if on then rgb 84 78 94 else rgb 56 52 62)
    , circle fx (r.y + 10) 6 (if on then accent else rgb 104 92 78)
    ]


octaveButtons : Model -> List Shape
octaveButtons model =
    let
        d = octDownRect model
        u = octUpRect model
        lbl = "OCT " ++ (if model.patch.oct > 0 then "+" else "") ++ String.fromInt model.patch.oct
    in
    [ rect d.x d.y d.w d.h (rgb 50 46 58)
    , text (d.x + d.w // 2) (d.y + 18) 12 Canvas.Center textMain "-"
    , rect u.x u.y u.w u.h (rgb 50 46 58)
    , text (u.x + u.w // 2) (u.y + 18) 12 Canvas.Center textMain "+"
    , text (d.x + 38) (d.y - 6) 9 Canvas.Left textDim lbl
    ]


toggleButtons : Model -> List Shape
toggleButtons model =
    let
        s = subRect model
        v = voiceRect model
        a = arpRect model
        arpName =
            if model.patch.arp == 1 then "ARP UP"
            else if model.patch.arp == 2 then "ARP MIN"
            else if model.patch.arp == 3 then "ARP U-D"
            else if model.patch.arp == 4 then "ARP OCT"
            else if model.patch.arp == 5 then "ARP MJ7"
            else "ARP OFF"
    in
    [ rect s.x s.y s.w s.h (if model.patch.sub then rgb 70 54 40 else rgb 50 46 58)
    , text (s.x + s.w // 2) (s.y + 18) 10 Canvas.Center (if model.patch.sub then accent else textDim) "SUB"

    -- VOICE is a selector, not a toggle: every mode is a real setting, so it is
    -- drawn in the neutral button colour like OCT rather than lit like SUB/ARP.
    , rect v.x v.y v.w v.h (rgb 50 46 58)
    , text (v.x + v.w // 2) (v.y + 18) 10 Canvas.Center textMain (voiceLabel model.patch)
    , text v.x (v.y - 6) 9 Canvas.Left textDim "VOICE"
    , rect a.x a.y a.w a.h (if model.patch.arp > 0 then rgb 70 54 40 else rgb 50 46 58)
    , text (a.x + a.w // 2) (a.y + 18) 10 Canvas.Center (if model.patch.arp > 0 then accent else textDim) arpName
    ]


isHeld : Model -> Int -> Bool
isHeld model semi =
    List.member semi (voices model)


keyboardShapes : Model -> List Shape
keyboardShapes model =
    List.concat
        [ List.concat
            (List.indexedMap
                (\i semi ->
                    let
                        r = whiteRect model i
                        on = isHeld model semi
                    in
                    [ rect r.x r.y r.w r.h (if on then rgb 255 214 150 else rgb 238 234 226)
                    , rect r.x (r.y + r.h - 5) r.w 5 (rgb 200 194 184)
                    ]
                )
                (visibleWhites model))
        , List.concat
            (List.map
                (\b ->
                    let
                        r = blackRect model b.after
                        on = isHeld model b.semi
                    in
                    [ rect r.x r.y r.w r.h (if on then rgb 150 110 50 else rgb 28 26 32)
                    , rect r.x (r.y + r.h - 4) r.w 4 (rgb 10 9 12)
                    ]
                )
                (visibleBlacks model))
        , [ text (model.w // 2) (kbTop model - 6) 9 Canvas.Center textDim
                (if isNarrow model then
                    "tap or drag the keys, OCT - / + shifts the range"
                 else
                    "tap or drag the keys, computer keys: Z-row low, Q-row high")
          ]
        ]


-- ===== wiring =====


subscriptions : Model -> Sub Msg
subscriptions model =
    -- one sound subscription per held voice: it starts when the key goes down
    -- and stops when the key comes up, so hold time is the note's duration.
    Sub.batch
        (Keyboard.watch KeysChanged
            :: List.map (\semi -> heldSound model.patch semi) (voices model)
        )


page : Page
page =
    Page.create
        { path = "/"
        , title = "Pocket Synth"
        , init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }


main : Cmd ()
main =
    App.frontend [ page ]
