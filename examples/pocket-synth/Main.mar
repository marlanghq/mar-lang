module Main exposing (main)

-- Pocket Synth: a playable two-octave synthesizer.
--
-- The face is borrowed from the classic panel-of-knobs synths (the Minimoog's
-- three-section layout: OSCILLATOR / MODIFIERS / CONTROL): pick a preset, then
-- reach for the sliders and buttons to bend it into something else. Every
-- control maps 1:1 onto a Sound combinator, so the panel is also a live
-- diagram of the audio engine:
--
--   WAVE            -> Sound.tone's wave (Square / Triangle / Sawtooth / Noise).
--                      Sound.Sine is the fifth and has no button: it is not a
--                      timbre you reach for here, it is what the SUB layer is
--                      MADE of, and giving it a button would offer a keyboard
--                      voice with no harmonics to shape (see subLayer)
--   PULSE           -> Sound.duty (square pulse width: the PWM knob)
--   OCTAVE          -> transposes the keyboard
--   ENSEMBLE        -> Sound.detune: two extra voices a fixed number of CENTS
--                      either side. On a held or plucked patch Sound.pan then
--                      spreads that pair left and right, because an ensemble is
--                      players in a room; on a STRUCK one it does not, because
--                      there it is the two or three strings of one piano note,
--                      and those are in one place (see buildNote for both)
--   SUB             -> a sub-octave SINE under every note: the fundamental with
--                      nothing on top, which is what body is made of
--   LENGTH          -> note duration, and with it the span the envelope falls
--                      across (Sound.decay for the fall, Sound.release for the
--                      tail): how long a struck or plucked note RINGS
--   BEND            -> Sound.sweep (pitch glides up or down across the note)
--   LFO DEPTH/RATE  -> Sound.vibrato (cents, Hz): off for struck notes
--   ARP             -> a real arpeggiator: Sound.sequence of chord tones, looped
--   VOLUME          -> Sound.volume
--   GLIDE           -> Sound.glide instead of Sound.voice: ONE monophonic voice
--                      that slides between notes (portamento), the way glide
--                      works on the synths this panel is borrowed from
--   TONE (presets)  -> Sound.lowCut / Sound.highCut, set per preset rather than
--                      by a slider: see shapeCuts for why that is not taste
--
-- A control that cannot reach the sound in the current mode is drawn dim and
-- ignores taps (sliderActive). PULSE off a square wave is the permanent case;
-- the arpeggiator's are structural, because it replaces the note with a run of
-- steps and the one-note modifiers have nothing left to shape.
--
-- "Struck" presets (GRAND, E-PIANO, BELL) build the note from a brief hammer tick
-- over layers of staggered length, each one DECAYING from the moment it is
-- struck (Sound.decay then Sound.release, one pair per layer, matched to that
-- layer's own span). The shortest layer is an octave up, so brightness falls
-- before body does, and the note thins out as it fades the way a real string
-- does. The decay stage is why the fall has two rates rather than one: a hammer
-- dumps most of its energy immediately and what is left rings on slowly, so the
-- note has a knock AND a tail. PLUCK patches fall too, across the whole note.
--
-- HELD patches (organ, strings, pads) do not, and cannot: they reach the sound
-- through Sound.voice, which holds one source for as long as the key is down and
-- so has no span to fall along. That is the one shape of this instrument the
-- envelope cannot draw, and it is stated in oscVoice rather than left to be
-- discovered.
--
-- A note sounds for as long as its key is HELD, not a fixed length: each held
-- key contributes a Sound subscription, recomputed from the Model, so pressing
-- starts it and releasing stops it. SUSTAIN patches (organ, strings, pads) hold
-- via Sound.voice while down, and the ones that re-attack as they hold (an
-- arpeggio, a mandolin ROLL) via Sound.loop; the rest ring out once like a piano
-- (Sound.once, which the runtime fades cleanly when you lift the key early).
-- heldSound is where those three lifetimes are chosen. Polyphony is the
-- natural kind: the held voices are read straight off two input MIRRORS:
-- Canvas.watchPointers (every finger on the canvas: one note per finger, and a
-- finger sliding across keys bends its own note: glissando) and Keyboard.watch
-- (the computer keyboard: Z-row = low octave, Q-row = high octave). No per-finger
-- bookkeeping, and a stuck note is impossible by construction. The panel knobs
-- stay on the tap/drag OCCURRENCES (onTap/onDrag/onRelease): a tap toggles, a
-- drag moves a slider; there is no "held" state to mirror there.

import Controls exposing (..)
import Draw exposing (..)
import Presets exposing (..)
import Synth exposing (..)
import Types exposing (..)
import Canvas exposing ( canvas, onDrag, onRelease, onTap, rect, watchPointers, watchSize )
import Keyboard


init : (Model, Cmd Msg)
init =
    ( { w = 900
      , h = 640
      , patch = (presetAt 0).patch
      , keys = []
      , pointers = []
      , dragCtl = 0 - 1
      , glideTo = 0 - 1
      }
    , Cmd.none
    )


-- One job per colour on a button, which is what the panel now holds to:
--
--   accent    engaged: this setting is on, or this is the selected one
--   textMain  a control you can press, whether or not it is engaged
--   textOff   a control you cannot press in the current mode
--   textDim   NOT a button state at all: captions, section titles, the hint line
--
-- It used to be muddled. The PRESET row already drew unselected buttons in
-- textMain, but the wave row and the toggles drew their off state in textDim, so
-- the same idea had two colours; and because textDim (152) sits between textMain
-- (236) and textOff (88), the difference that actually matters, can I press this
--, was carried by the SMALLER gap. A button that was merely off looked much like
-- one that was unavailable, and the unavailable GLIDE looked broken.
--
-- Turning off buttons white does not lose the engaged/idle read: that is carried
-- twice already, by the accent text AND the lit pill behind it. It also matches
-- hardware, where the legend is screen-printed and always legible, and what
-- changes is the lamp.


view : Model -> View Msg
view model =
    canvas Crisp [ watchSize Resized, watchPointers PointersChanged, onTap Tapped, onDrag Dragged, onRelease Released ]
        (List.concat
            [ [ rect 0 0 model.w model.h bgDark ]
            , header model
            , presetShapes model
            , panelShapes model
            , keyboardShapes model
            ])




subscriptions : Model -> Sub Msg
subscriptions model =
    -- one sound subscription per held voice: it starts when the key goes down
    -- and stops when the key comes up, so hold time is the note's duration.
    --
    -- The patch is scaled by how many voices are sounding (polyScaled), because
    -- the bus sums them and nothing downstream is going to catch it.
    let
        held = voices model
        p = model.patch
    in
    if glideActive p then
        -- GLIDE is ONE source, so there is no voice count to normalise and no
        -- chord to play: the whole point is that the single voice slides.
        Sub.batch
            (Keyboard.watch KeysChanged :: glideVoice model p held)

    else
        Sub.batch
            (Keyboard.watch KeysChanged
                :: List.map (\semi -> heldSound (polyScaled p (List.length held)) semi) held
            )


page : Page
page =
    Page.create
        { path = "/"
        , title = "Pocket Synth"
        , init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }


main : Cmd ()
main =
    App.frontend [ page ]
