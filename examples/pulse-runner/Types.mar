module Types exposing (..)

-- The vocabulary: what mode the game is in, what an obstacle is, what a cue
-- is, and the model itself.





type Mode
    = Title
    | Run
    | Dead
    | Win


-- Level pieces, positioned in SIXTEENTHS (u) on the music grid.
--   Spk u lift : a spike; lift 0 = on the ground, 1 = on top of a 1-block
--   Blk u w h  : a block, w sixteenths wide, h blocks (15 px) tall, land on
--                top of it; hit its side and you die
--   Gap u w    : a pit in the ground, w sixteenths wide, fall in and you die
type Ob
    = Spk Int Int
    | Blk Int Int Int
    | Gap Int Int


type Cue
    = CueDeath
    | CueCheck
    | CueWin
    | CueLead Int
    | CueBeat Int             -- one beat of the groove, keyed by world beat


type Msg
    = Resized Int Int
    | Tick
    | Tapped Int Int
    | Released Int Int
    | KeysChanged { down : List Keyboard.Key }
    | PadChanged { connected : Bool, leftX : Int, leftY : Int, rightX : Int, rightY : Int, down : List Gamepad.Button }


type alias Model =
    { w : Int
    , h : Int
    , mode : Mode
    , hardcore : Bool        -- chosen on the title screen
    , sel : Int              -- title selection: 0 = hardcore, 1 = checkpoints
    , tick : Int             -- global animation clock (title blink etc.)
    , runT : Int             -- ticks since (re)spawn: also the music phase
    , px : Int               -- player world x (left edge)
    , pyBot : Int            -- player bottom y, fixed-point (x16)
    , vy : Int               -- vertical speed, fixed-point
    , grounded : Bool
    , airT : Int             -- ticks since takeoff: drives the mid-air spin
    , jumpHeld : Bool        -- jump input held: touch sets it directly, keyboard
                             -- + gamepad derive it via syncHeld (see below)
    , keysDown : List Keyboard.Key   -- raw held set: keyboard mirror
    , padDown : List Gamepad.Button  -- raw held set: gamepad mirror
    , lastCp : Int           -- last checkpoint index crossed (0 = start)
    , attempts : Int
    , deathT : Int           -- ticks since death (drives the shatter burst)
    , deathX : Int
    , deathY : Int
    , muted : Bool
    , sfx : List Cue
    }
