module Main exposing (main)


-- PULSE RUNNER — a brutal one-button rhythm runner in the tradition of the
-- early-2010s "impossible" auto-runners: you are a small orange square racing
-- right at constant speed over spikes, blocks and pits, and every obstacle
-- sits on the beat grid of the soundtrack. Jump on the beat and you live.
-- Touch anything pointy and you shatter. Built with ZERO language changes.
--
-- MUSIC SYNC, the whole trick: game-rate Time.every ticks ride
-- requestAnimationFrame (vsync-locked, ~16.7 ms at 60 Hz), so 30 ticks are
-- ~500 ms — one beat at 120 BPM. The square moves 2 px/tick, so one beat is
-- exactly 60 px and one sixteenth note is 15 px. Level data is in SIXTEENTHS
-- on that grid, and every obstacle is placed FROM THE BEAT YOU JUMP ON: a
-- single spike for jump-beat B sits at 4B+2 (so the takeoff window is
-- centered on the kick), a pit at 4B+1, a block's mount at 4B+3, doubles at
-- 4B+1 (jump a hair early — the four hard moments). An offline bot
-- restricted to jumping ONLY on beat ticks completes the whole level: hop on
-- the kick and you live.
--
-- The WHOLE soundtrack is world-driven: the game loop fires the groove one
-- beat at a time (grooveBeat, keyed by the beat you just crossed) and the
-- lead as one-shot cues at the exact jump positions. Nothing rides a free
-- tape — if the tab is hidden and rAF stops, the music stops WITH the game
-- and resumes in phase, and the arrangement grows with the level section.
-- Checkpoints sit exactly on loop boundaries (every 32 beats), and spawns
-- re-seed the beat cue — so after any death you are back on beat.
--
-- Modes: HARDCORE (death sends you back to the very start) and CHECKPOINTS
-- (death sends you back to the last flag you crossed).
--
-- Controls: Space / Up / W = jump (hold to keep hopping), M = mute.
--   Gamepad: A = jump, Start = start. Touch: tap and hold anywhere = jump.
--
-- Run: mar dev examples/pulse-runner


import Canvas exposing
    ( canvas, rect, triangle, group, rgb
    , onTap, watchSize, onRelease
    )
import Time


-- ===== logical screen (scaled to fit the window, pixels stay chunky) =====


gameW : Int
gameW = 400                -- 2:1 stage: fills an 18:9 phone edge-to-edge, same
                           -- on every device (fixed camera; more track shown,
                           -- but the same amount on all screens so difficulty
                           -- is device-independent — you still jump on the beat)


gameH : Int
gameH = 200


fps : Int
fps = 60


-- ===== the beat grid ties physics and music together =====
-- Ticks ride requestAnimationFrame (vsync-locked, ~16.7 ms at 60 Hz), so
-- 30 ticks = ~500 ms = one beat at 120 BPM. The square moves 2 px/tick, so a
-- beat is 60 px and a sixteenth note is 15 px. The jump impulse is tuned so
-- a full hop lasts ~29 ticks: one hop = one beat — holding jump makes the
-- square hop on the kick.


spd : Int
spd = 2                   -- px per tick, constant — this game never slows down


fp : Int
fp = 16                   -- fixed-point scale for vertical physics


grav : Int
grav = 4                  -- gravity, fp per tick^2


jumpV : Int
jumpV = 60                -- jump impulse, fp per tick (hop = ~1 beat, 26 px high)


pw : Int
pw = 13                   -- the square's side


groundY : Int
groundY = 164             -- ground surface y


unitPx : Int
unitPx = 15               -- one sixteenth note, in px


beatPx : Int
beatPx = 60               -- one beat, in px (4 sixteenths)


loopPx : Int
loopPx = 1920             -- one music loop = 32 beats — checkpoints live here


finishX : Int
finishX = 17280           -- 288 beats = 9 loops


playerScreenX : Int
playerScreenX = 70        -- the square stays here; the world scrolls


-- ===== small Int helpers (no Basics in Mar) =====




iclamp : Int -> Int -> Int -> Int
iclamp lo hi v = max lo (min hi v)



range : Int -> List Int
range n =
    List.indexedMap (\i _ -> i) (List.repeat n 0)


-- ===== types =====


type Mode
    = Title
    | Run
    | Dead
    | Win


-- Level pieces, positioned in SIXTEENTHS (u) on the music grid.
--   Spk u lift : a spike; lift 0 = on the ground, 1 = on top of a 1-block
--   Blk u w h  : a block, w sixteenths wide, h blocks (15 px) tall — land on
--                top of it; hit its side and you die
--   Gap u w    : a pit in the ground, w sixteenths wide — fall in and you die
type Ob
    = Spk Int Int
    | Blk Int Int Int
    | Gap Int Int


type Cue
    = CueDeath
    | CueCheck
    | CueWin
    | CueLead Int
    | CueBeat Int             -- one beat of the groove, keyed by world beat


type Msg
    = Resized Int Int
    | Tick
    | Tapped Int Int
    | Released Int Int
    | KeysChanged { down : List Keyboard.Key }
    | PadChanged { connected : Bool, leftX : Int, leftY : Int, rightX : Int, rightY : Int, down : List Gamepad.Button }


type alias Model =
    { w : Int
    , h : Int
    , mode : Mode
    , hardcore : Bool        -- chosen on the title screen
    , sel : Int              -- title selection: 0 = hardcore, 1 = checkpoints
    , tick : Int             -- global animation clock (title blink etc.)
    , runT : Int             -- ticks since (re)spawn — also the music phase
    , px : Int               -- player world x (left edge)
    , pyBot : Int            -- player bottom y, fixed-point (x16)
    , vy : Int               -- vertical speed, fixed-point
    , grounded : Bool
    , airT : Int             -- ticks since takeoff — drives the mid-air spin
    , jumpHeld : Bool        -- jump input held: touch sets it directly, keyboard
                             -- + gamepad derive it via syncHeld (see below)
    , keysDown : List Keyboard.Key   -- raw held set — keyboard mirror
    , padDown : List Gamepad.Button  -- raw held set — gamepad mirror
    , lastCp : Int           -- last checkpoint index crossed (0 = start)
    , attempts : Int
    , deathT : Int           -- ticks since death (drives the shatter burst)
    , deathX : Int
    , deathY : Int
    , muted : Bool
    , sfx : List Cue
    }


-- ===== the level, placed from the beats you JUMP on =====
-- SIX loops of 32 beats; jump-beat B -> single at 4B+2, pit at 4B+1, block
-- mount at 4B+3, on-block hop spike at 4B+2 (lift 1), doubles at 4B+1.
-- The difficulty ramps with the music: loop 1 teaches hopping on the kick;
-- loop 2 adds platforms and pits; loop 3 runs 4-beat chains; loop 4 mixes
-- everything; loop 5 packs the same tricks tighter (double-hop block rides,
-- back-to-back chains); loop 6 is the gauntlet — doubles into pits and a
-- FIVE-beat chain. Checkpoint flags sit at beats 32/64/96/128/160 — loop
-- boundaries, which is what keeps respawns on beat. The whole thing is
-- completable jumping ONLY on beats — proven offline by sim.mjs in this
-- directory (`node sim.mjs`; re-run it whenever obs or the physics
-- constants change). When in doubt, trust the kick.


obs : List Ob
obs =
    [ -- loop 1: singles on the kick (jump-beats 8, 12, 16, 20, 23, 24, 28)
      Spk 34 0, Spk 50 0, Spk 66 0, Spk 82 0, Spk 94 0, Spk 98 0, Spk 114 0

      -- loop 2: platforms and pits
    , Blk 139 12 1, Spk 146 1          -- mount on 34, hop the spike on 36
    , Gap 161 2                        -- 40
    , Spk 174 0, Spk 178 0             -- 43-44 chain
    , Spk 186 0                        -- 46
    , Spk 193 0, Spk 194 0             -- 48: first double (a hair early!)
    , Spk 210 0                        -- 52
    , Gap 217 2                        -- 54
    , Spk 226 0, Spk 230 0, Spk 234 0  -- 56-57-58 chain
    , Spk 246 0                        -- 61

      -- loop 3: beat chains
    , Spk 266 0                        -- 66
    , Gap 273 2                        -- 68
    , Spk 282 0, Spk 286 0, Spk 290 0, Spk 294 0   -- 70-73 four-chain
    , Blk 307 12 1, Spk 314 1          -- mount on 76, hop on 78
    , Spk 330 0                        -- 82
    , Gap 337 2                        -- 84
    , Spk 345 0, Spk 346 0             -- 86 double
    , Spk 354 0, Spk 358 0, Spk 362 0, Spk 366 0   -- 88-91 four-chain
    , Spk 378 0                        -- 94

      -- loop 4: the finale
    , Spk 394 0                        -- 98
    , Gap 401 2                        -- 100
    , Spk 410 0, Spk 414 0, Spk 418 0  -- 102-104 chain
    , Spk 425 0, Spk 426 0             -- 106 double
    , Blk 435 16 1, Spk 442 1, Spk 450 1  -- mount 108, hops 110 and 112
    , Spk 465 0, Spk 466 0             -- 116 double
    , Gap 473 2                        -- 118
    , Spk 482 0, Spk 486 0, Spk 490 0  -- 120-122 chain
    , Spk 498 0                        -- 124

      -- loop 5: everything again, tighter
    , Spk 522 0                        -- 130
    , Spk 529 0, Spk 530 0             -- 132 double
    , Gap 537 2                        -- 134
    , Spk 546 0, Spk 550 0, Spk 554 0  -- 136-138 chain
    , Spk 565 0, Spk 566 0             -- 141 double
    , Blk 579 16 1, Spk 586 1, Spk 594 1  -- mount 144, hops 146 and 148
    , Spk 601 0, Spk 602 0             -- 150 double right off the block
    , Gap 609 2                        -- 152
    , Spk 618 0, Spk 622 0, Spk 626 0  -- 154-156 chain
