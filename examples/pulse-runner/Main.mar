      -- loop 6: the gauntlet
    , Spk 649 0, Spk 650 0             -- 162 double
    , Gap 657 2                        -- 164
    , Spk 665 0, Spk 666 0             -- 166 double
    , Spk 674 0, Spk 678 0, Spk 682 0, Spk 686 0, Spk 690 0   -- 168-172 FIVE-chain
    , Spk 701 0, Spk 702 0             -- 175 double
    , Blk 715 20 1, Spk 722 1, Spk 730 1  -- long ride: mount 178, hops 180 and 182
    , Gap 745 2                        -- 186
    , Spk 754 0, Spk 758 0, Spk 762 0  -- 188-190 closing chain

      -- loop 7: the crossing — back-to-back pits and a SIX-chain
    , Spk 777 0, Spk 778 0             -- 194 double
    , Gap 785 2                        -- 196
    , Gap 793 2                        -- 198: second pit one breath later
    , Spk 802 0, Spk 806 0, Spk 810 0, Spk 814 0, Spk 818 0, Spk 822 0   -- 200-205 SIX-chain
    , Spk 833 0, Spk 834 0             -- 208 double
    , Spk 842 0                        -- 210
