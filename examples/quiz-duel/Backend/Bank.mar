module Backend.Bank exposing
    ( BankQ
    , byId
    , byTheme
    , themeCards
    , themeExists
    , sampleQids
    )


import Shared


-- The question bank — static Mar data, backend-only. It never becomes
-- a database table: there's nothing per-user to store, keeping it in
-- code means no seeding step, and (crucially) the `correct` index
-- lives ONLY on the server. The serve service copies a question into
-- a Shared.Question WITHOUT `correct`, so a client that inspects the
-- network traffic can't read the answer key.
--
-- Each duel samples 10 of a theme's 125 questions via a deterministic
-- shuffle (sampleQids), so a rematch on the same theme reshuffles
-- rather than replaying the identical set.


type alias BankQ =
    { id      : Int
    , theme   : String
    , text    : String
    , a       : String
    , b       : String
    , c       : String
    , d       : String
    , correct : Int    -- index of the right option: 0=a 1=b 2=c 3=d
    }


-- Theme keys in display order. The key is the stable id sent over the
-- wire; Shared.themeLabel turns it into pt-BR for the screen.
themeKeys : List String
themeKeys =
    [ "futebol", "games", "geografia", "ciencia", "cinema", "musica" ]


-- One ThemeCard per theme, with a live question count. Drives the
-- theme picker on the New Challenge screen.
--
-- A function (not a bare value) on purpose: the runtime force-evaluates
-- top-level values in file order at module load, and this one reaches
-- `bank` (defined lower). Deferring it behind a `()` param means it
-- runs at request time, once `bank` is fully initialized.
themeCards : () -> List Shared.ThemeCard
themeCards _ =
    List.map
        (\key -> { name = key, count = List.length (byTheme key) })
        themeKeys


themeExists : String -> Bool
themeExists key =
    List.any (\k -> k == key) themeKeys


byTheme : String -> List BankQ
byTheme theme =
    List.filter (\q -> q.theme == theme) bank


byId : Int -> Maybe BankQ
byId id =
    List.head (List.filter (\q -> q.id == id) bank)


-- ====================================================================
-- DETERMINISTIC SAMPLING
-- ====================================================================
--
-- sampleQids picks `questionsPerDuel` ids from a theme in a
-- seed-dependent pseudo-random order. Same seed → same 10 (so a
-- refresh mid-creation is stable); different seed → different draw.
-- The caller seeds from Time.toMillis + userId, so two duels created
-- at the same instant by different players still diverge.
--
-- Implementation: assign every question an Int sort-key derived from
-- (seed, id) via a multiplicative hash, sort ascending by it, take
-- the first 10. Every intermediate stays under 2^31 so the products
-- never overflow Int (int64).
sampleQids : String -> Int -> List Int
sampleQids theme seed =
    byTheme theme
        |> List.sortBy (\q -> shuffleKey seed q.id)
        |> List.take Shared.questionsPerDuel
        |> List.map (\q -> q.id)


-- Knuth multiplicative mix, folded into a Park-Miller LCG step. The
-- inner imodP keeps the base below 2^31 BEFORE the * 48271, so the
-- widest product is ~2^31 * 48271 ≈ 1.0e14, comfortably within Int.
shuffleKey : Int -> Int -> Int
shuffleKey seed qid =
    let
        base = Shared.imodP (seed + qid * 2654435761) 2147483647
    in
    Shared.imodP (base * 48271) 2147483647


