module Main exposing (main)


-- VORTEX — a tube shooter. You are a claw on the near rim of a geometric
-- well, one kind of thing climbs the lanes toward you, and you shoot it
-- before it arrives. That is the whole game.
--
-- It got here by subtraction. The first version was a faithful Tempest 2000
-- clone: five enemies, four power-ups, a superzapper, spikes, jump, warp
-- tokens, a bonus round. All of it worked and none of it was the reason the
-- thing was fun. What was fun was the well — the sense of looking INTO
-- something and of a shape rushing out of it — and every system on top was
-- another rule standing between a player and that. So they are gone. What is
-- left is one enemy, one gun, and a shape that changes every level.
--
-- WHY THE CAMERA IS THE WHOLE GAME. A tube shooter lives or dies on one
-- illusion: that the well is a solid object you are looking into, not a ring
-- of lines you are sliding along. Three things sell it, and all three are in
-- `project` and `camera`:
--
--   1. A real perspective divide. A point at depth z lands at
--      `far + (rim - far) * D / (D + z)`. That hyperbola is why something at
--      the far end crawls and the same thing at your feet is on you before
--      you finish the thought — constant speed in the well, accelerating on
--      screen. A linear interpolation gets the picture right and the FEEL
--      completely wrong.
--
--   2. The far end is not the middle of the screen. It leans AWAY from where
--      you stand on the rim, so walking around the ring swings the whole tube
--      the other way. That parallax is what makes it read as a solid you are
--      orbiting. Pin the vanishing point to the centre and the same geometry
--      turns back into a flat ring.
--
--   3. And nothing else moves. The camera answers the player and no one
--      else: the lean is a function of where you stand, so a still player is
--      a still screen. An earlier version turned the web on a free-running
--      counter and wobbled the vanishing point on a sine, and both were
--      wrong the same way — motion that is not a reaction to you is not a
--      camera, it is a screensaver. Each web has its own fixed orientation,
--      set once on arrival, and holds it.
--
-- What it never does is shake. Death and impact change the OBJECT — colour,
-- shape, the web going white — and leave the frame where it is.
--
-- ARITHMETIC. Mar has no floats, so everything here is fixed point at 1024,
-- and every angle is a BRAD: one 256th of a turn, so wrapping is `modBy 256`
-- rather than a division by 360. `sinQuarter` is a pasted table (regenerate
-- with tools/gen_tables.py); no trig runs at runtime, and a given run plays
-- identically on the web and on iOS.
--
-- Controls: left/right (or A/D) walk the rim, space or Z fires, enter starts.
--   Touch: a stick on the bottom left — grab anywhere in that half and push,
--   and how far you push is how fast you walk — and fire on the bottom right.
--
-- Run: mar dev examples/vortex   (port 3042)


import Device
import Canvas exposing
    ( canvas, rect, triangle, circle, group, rgb, rgba
    , onTap, watchSize, watchPointers
    )
import Keyboard
import Random
import Sound
import Time

-- ============================================================ fixed point


-- Everything scaled lives in units of `one`. A "unit vector" is 1024 long, a
-- depth of `zFar` is the far end of the well, and a multiply-then-divide by
-- `one` is how any two scaled numbers combine.
one : Int
one = 1024


fps : Int
fps = 60


-- ============================================================ trig


-- One quarter turn of sine, 65 entries, scaled by `one`. Generated by
-- tools/gen_tables.py — do not hand-edit.
sinQuarter : List Int
sinQuarter =
    [0, 25, 50, 75, 100, 125, 150, 175, 200, 224, 249, 273, 297, 321
    , 345, 369, 392, 415, 438, 460, 483, 505, 526, 548, 569, 590, 610
    , 630, 650, 669, 688, 706, 724, 742, 759, 775, 792, 807, 822, 837
    , 851, 865, 878, 891, 903, 915, 926, 936, 946, 955, 964, 972, 980
    , 987, 993, 999, 1004, 1009, 1013, 1016, 1019, 1021, 1023, 1024
    , 1024
    ]


-- Read entry i of the quarter table. A linked list has no random access, so
-- this is a drop-and-take; the table is 65 long and the callers are few
-- enough per frame that the walk does not show up.
quarterAt : Int -> Int
quarterAt i =
    case List.head (List.drop (clamp 0 64 i) sinQuarter) of
        Just v -> v
        Nothing -> 0


-- sin of a BRAD angle: 256 brads to the turn, result scaled by `one`.
-- Quadrant by quadrant off the one quarter the table holds.
sinB : Int -> Int
sinB a =
    let
        t = modBy 256 a
    in
    if t < 64 then
        quarterAt t

    else if t < 128 then
        quarterAt (128 - t)

    else if t < 192 then
        0 - quarterAt (t - 128)

    else
        0 - quarterAt (256 - t)


cosB : Int -> Int
cosB a =
    sinB (a + 64)


-- Integer square root by Newton's method. Used for line thickness — a line
-- needs a perpendicular of a known length, and that is the only place in the
-- game that needs a magnitude rather than an angle.
isqrt : Int -> Int
isqrt n =
    if n <= 0 then
        0

    else
        isqrtStep n (max 1 (n // 2)) 20


isqrtStep : Int -> Int -> Int -> Int
isqrtStep n guess fuel =
    let
        next = (guess + n // guess) // 2
    in
    if fuel <= 0 || next >= guess then
        guess

    else
        isqrtStep n next (fuel - 1)


-- ============================================================ points


type alias Pt =
    { x : Int
    , y : Int
    }


-- A point on the unit circle at brad angle a, scaled to radius r.
polar : Int -> Int -> Pt
polar a r =
    { x = cosB a * r // one
    , y = sinB a * r // one
    }


-- Rotate a point about the origin by a brad angle. This is how the whole web
-- spins: one rotation applied to the rim, and every projected thing inherits
-- it because everything is expressed in rim coordinates.
rotate : Int -> Pt -> Pt
rotate a p =
    let
        c = cosB a
        s = sinB a
    in
    { x = (p.x * c - p.y * s) // one
    , y = (p.x * s + p.y * c) // one
    }


midpoint : Pt -> Pt -> Pt
midpoint a b =
    { x = (a.x + b.x) // 2
    , y = (a.y + b.y) // 2
    }


-- ============================================================ the web
--
-- A web is a rim: a list of points in web space, where the radius is `webR`.
-- Consecutive points bound a LANE, which is the whole coordinate system of
-- the game — every enemy and every shot lives in some lane at some depth.
--
-- A closed web wraps (lane N-1 borders lane 0) and you can walk it forever;
-- an open one has two ends you cannot walk past. That difference is one
-- boolean here and it changes how a level plays more than the shape does.


webR : Int
webR = 1000


type alias Web =
    { rim : List Pt
    , closed : Bool
    , ink : { r : Int, g : Int, b : Int }
    }


-- A ring of n evenly spaced points.
ringRim : Int -> List Pt
ringRim n =
    List.map (\i -> polar (i * 256 // n) webR) (List.range 0 (n - 1))


-- A closed polygon with `sides` corners, sampled at `per` points per side, so
-- a square gets lanes along its edges rather than one enormous lane per side.
polyRim : Int -> Int -> List Pt
polyRim sides per =
    List.concatMap
        (\s ->
            let
                a = corner sides s
                b = corner sides (s + 1)
            in
            List.map
                (\k -> lerpPt a b (k * one // per))
                (List.range 0 (per - 1))
        )
        (List.range 0 (sides - 1))


corner : Int -> Int -> Pt
corner sides s =
    polar (s * 256 // sides - 64) webR


lerpPt : Pt -> Pt -> Int -> Pt
lerpPt a b t =
    { x = a.x + (b.x - a.x) * t // one
    , y = a.y + (b.y - a.y) * t // one
    }


-- A star: alternating long and short radii.
starRim : Int -> Int -> List Pt
starRim points inner =
    List.map
        (\i ->
            polar (i * 256 // (points * 2))
                (if modBy 2 i == 0 then webR else webR * inner // 100)
        )
        (List.range 0 (points * 2 - 1))


-- An open horizontal line: the shape that taught everyone the difference
-- between a tube you can circle and a wall you can be cornered against.
-- An open horizontal line: the shape that taught everyone the difference
-- between a tube you can circle and a wall you can be cornered against.
--
-- It sits BELOW the middle on purpose. The lanes converge upward toward the
-- vanishing point, so the near wall is low and wide and the far one is high
-- and short — you are looking up a slope at things coming down it, which is
-- what this level is in the arcade and what makes it read at a glance.
lineRim : Int -> List Pt
lineRim n =
    List.map
        (\i -> { x = 0 - webR + 2 * webR * i // (n - 1), y = webR // 2 })
        (List.range 0 (n - 1))


-- A shallow open bowl: a line bent enough that its two ends feel far away.
--
-- The arc sweeps the BOTTOM of the circle (brads 24 through 104, which is
-- 34 to 146 degrees) so it cups upward like a valley you are standing in.
-- Swept across the top instead it is a dome, and a dome with the tube behind
-- it is a shape nobody can read.
bowlRim : Int -> List Pt
bowlRim n =
    List.map
        (\i -> polar (modBy 256 (24 + 80 * i // (n - 1))) webR)
        (List.range 0 (n - 1))


-- Sixteen webs, then the sequence repeats with a new ink. That is the shape
-- of the original's level list and it is worth keeping: by the time a shape
-- comes back around you know it, and the game is counting on you knowing it.
webCount : Int
webCount = 16


webFor : Int -> Web
webFor level =
    let
        shape = modBy webCount level
        cycle = level // webCount
    in
    { rim = rimFor shape
    , closed = closedFor shape
    , ink = inkFor cycle
    }


-- THE ORDER IS THE DIFFICULTY CURVE.
--
-- There are no difficulty settings in this game and the numbers barely move —
-- what changes between levels is the PLACE. So the order these arrive in is
-- the whole ramp, and it has one rule: a CLOSED web is a kinder web. It has
-- no ends, you can walk it forever, and nothing can ever corner you. An open
-- one has two ends, and being backed into one with something coming is the
-- hardest thing here.
--
-- Ranked, easiest first:
--
--   RINGS are the kindest. Regular, symmetric, endless — the shape teaches
--     you the well and asks nothing else.
--   POLYGONS next. Still closed and still regular, but the corners make the
--     lanes uneven, so a lane is no longer just "one step".
--   STARS are harder, and the deeper the notch the harder: the rim zigzags,
--     so left stops meaning left on the screen. Ordered by their inner
--     radius, mildest first.
--   OPEN shapes are the hardest of all, because you can be backed into an
--     end with something walking at you.
--
-- The old list ran ring, square, LINE-16, STAR-6: the widest open shape and
-- then the deep star, third and fourth, back to back. Two cliffs in a row,
-- landing exactly where someone is still learning what the well is. Now the
-- first four are all regular and closed, the first star is the shallow one,
-- and nothing open turns up until the seventh.
rimFor : Int -> List Pt
rimFor shape =
    case shape of
        0 -> ringRim 16
        1 -> polyRim 4 4
        2 -> ringRim 13
        3 -> polyRim 6 3
        4 -> starRim 8 62
        5 -> ringRim 12
        6 -> lineRim 12
        7 -> polyRim 3 5
        8 -> starRim 7 58
        9 -> bowlRim 14
        10 -> ringRim 15
        11 -> starRim 6 55
        12 -> polyRim 5 3
        13 -> lineRim 16
        14 -> starRim 5 48
        _ -> bowlRim 16


closedFor : Int -> Bool
closedFor shape =
    case shape of
        6 -> False
        9 -> False
        13 -> False
        15 -> False
        _ -> True


inkFor : Int -> { r : Int, g : Int, b : Int }
inkFor cycle =
    case modBy 6 cycle of
        0 -> { r = 90, g = 130, b = 255 }
        1 -> { r = 255, g = 90, b = 170 }
        2 -> { r = 120, g = 255, b = 140 }
        3 -> { r = 255, g = 180, b = 60 }
        4 -> { r = 180, g = 120, b = 255 }
        _ -> { r = 90, g = 235, b = 255 }


-- ============================================================ lanes


type alias Lane =
    { a : Pt
    , b : Pt
    , mid : Pt
    }


-- Turn a rim into its lanes. A closed web gets one more lane than an open one
-- with the same points, because the last point joins back to the first.
lanesOf : Web -> List Lane
lanesOf web =
    let
        pts = web.rim
        n = List.length pts
        at =
            \i ->
                case List.head (List.drop (modBy n i) pts) of
                    Just p -> p
                    Nothing -> { x = 0, y = 0 }

        count =
            if web.closed then n else n - 1
    in
    List.map
        (\i ->
            let
                a = at i
                b = at (i + 1)
            in
            { a = a, b = b, mid = midpoint a b }
        )
        (List.range 0 (count - 1))


laneAt : List Lane -> Int -> Lane
laneAt lanes i =
    case List.head (List.drop (max 0 i) lanes) of
        Just l -> l
        Nothing -> { a = { x = 0, y = 0 }, b = { x = 0, y = 0 }, mid = { x = 0, y = 0 } }


-- Walking the rim. On a closed web the ends join; on an open one you stop.
stepLane : Bool -> Int -> Int -> Int -> Int
stepLane closed count lane dir =
    if closed then
        modBy (max 1 count) (lane + dir)

    else
        clamp 0 (count - 1) (lane + dir)


-- ============================================================ the camera
--
-- `camD` is how far the eye sits from the rim, in the same units as depth.
-- Small values give a violent, wide-angle well; large ones flatten it toward
-- an orthographic ring. This number is the single biggest lever on how the
-- game feels, which is why it is named and not inlined.
--
-- It started at 340, which put the far end at a quarter of the rim's size and
-- made the well read as a shallow dish rather than a shaft. At 200 the far
-- end is a sixth, the lane walls converge hard, and there is visibly a long
-- way for something to come from — which is the point, because that distance
-- is the only warning the game gives you.


camD : Int
camD = 200


zFar : Int
zFar = 1000


type alias Cam =
    { cx : Int          -- screen centre
    , cy : Int
    , scale : Int       -- web units to screen pixels, scaled by `one`
    , spin : Int        -- brads the web is turned by (fixed per level)
    , vx : Int          -- vanishing point, offset from centre, in web units
    , vy : Int
    , camZ : Int        -- how far the eye has travelled INTO the well
    }


-- The perspective factor at depth z: `one` at the rim, shrinking toward the
-- far end. Everything the projection does is this one hyperbola.
depthK : Cam -> Int -> Int
depthK cam z =
    let
        d = z - cam.camZ
    in
    one * camD // max 40 (camD + d)


-- Project a web-space point at depth z onto the screen. The point slides from
-- its rim position toward the vanishing point as it recedes.
project : Cam -> Pt -> Int -> Pt
project cam p z =
    let
        k = depthK cam z
        r = rotate cam.spin p
        vx = cam.vx
        vy = cam.vy
    in
    { x = cam.cx + (vx + (r.x - vx) * k // one) * cam.scale // one
    , y = cam.cy + (vy + (r.y - vy) * k // one) * cam.scale // one
    }


-- ============================================================ drawing lines
--
-- Canvas has rectangles, circles and triangles but no line, and a tube
-- shooter is nothing but lines at arbitrary angles. A line is therefore a
-- quad — two triangles — built from the perpendicular of its own direction.
-- That needs a magnitude, which is the one place `isqrt` earns its keep, and
-- no angle at all.
--
-- The perpendicular is computed in FIXED POINT and rounded, and that detail is
-- the whole function. Done in plain integers, `-dy * halfWidth / length` is
-- zero for any line more than a couple of pixels long — the width the line
-- wants is under one pixel per axis, truncation takes it to nothing, and the
-- two triangles collapse into a line of zero area that draws nothing at all.
-- Most of the web simply did not appear. Rounding through 8.8 fixes the
-- common case; the `both zero` fallback covers a line so close to axis
-- aligned that even the rounded component underflows.


-- Round an 8.8 fixed-point number to the nearest whole one, away from zero.
round8 : Int -> Int
round8 v =
    if v >= 0 then
        (v + 128) // 256

    else
        0 - ((0 - v + 128) // 256)


seg : Pt -> Pt -> Int -> { r : Int, g : Int, b : Int } -> Int -> List Shape
seg p q w ink alpha =
    let
        dx = q.x - p.x
        dy = q.y - p.y
        len = max 1 (isqrt (dx * dx + dy * dy))
        hw = max 1 w

        rx = round8 (0 - dy * hw * 256 // len)
        ry = round8 (dx * hw * 256 // len)

        -- A line that is very nearly horizontal or vertical gets its
        -- perpendicular by hand rather than by arithmetic that has run out of
        -- room.
        px =
            if rx == 0 && ry == 0 then
                (if abs dx >= abs dy then 0 else hw)

            else
                rx

        py =
            if rx == 0 && ry == 0 then
                (if abs dx >= abs dy then hw else 0)

            else
                ry

        col = rgba ink.r ink.g ink.b alpha
    in
    [ triangle (p.x + px) (p.y + py) (p.x - px) (p.y - py) (q.x + px) (q.y + py) col
    , triangle (q.x + px) (q.y + py) (q.x - px) (q.y - py) (p.x - px) (p.y - py) col
    ]

-- ============================================================ actors


type alias Shot =
    { lane : Int
    , z : Int
    }


-- Two kinds, and two is the ceiling.
--
-- The FLIPPER climbs, and flips lane to lane on the way. Deep in the well it
-- flips fast, in a direction of its own; near the rim it flips slowly, and
-- toward you. It is the game's verb: something is coming, get in front of it.
--
-- The TANKER is the same idea asked as a question. It only climbs — no flip,
-- no drift, no hunt — and when you shoot it, it becomes two flippers, one to
-- each side. That is its entire behaviour, and it earns its keep because it
-- adds no new movement to read and one new decision to make: kill it deep and
-- the halves have the whole well to hunt you across, kill it late and they
-- arrive on top of you. Shooting it is never simply good.
--
-- A third creature would be a third thing to learn. This game is asking you
-- to learn a place, not a bestiary.
type Kind
    = Flipper
    | Tanker


type alias Foe =
    { kind : Kind
    , lane : Int
    , z : Int
    , t : Int       -- private clock, drives the flip cadence
    , dir : Int     -- which way it drifts while it is still deep
    , rim : Int     -- `climbing`, or frames of stay left once it is up here
    }


-- ON THE RIM.
--
-- Something that gets all the way up does NOT end your run on the spot. It
-- takes the rim and comes along it for you, which is the best thing in this
-- game to watch and the thing you actually play against — and it costs a life
-- only if it reaches you.
--
-- What that needs, and what it did not have, is an ending. A rim-walker moves
-- slower than you do, so a player who keeps running is never caught; and you
-- cannot shoot one either, because a shot goes down the lane you are standing
-- in and standing in its lane is how you die. So it sat there, immortal, and
-- a level only clears when the well is empty: the round could not end. I fixed
-- that by making arrival itself fatal, which did stop the deadlock and threw
-- away the chase to do it.
--
-- The fuse is what lets both be true. It has a few seconds up here and then it
-- burns out, so the well always empties on its own and the chase is still a
-- chase. Running away works. Standing still is what costs you.
rimStay : Int
rimStay = 260


-- Frames per lane while it walks the rim. Four times your own, so getting
-- clear is meant to work.
rimPeriod : Int
rimPeriod = 16


-- Depth at which a thing counts as having arrived.
rimDepth : Int
rimDepth = 24


-- `rim` holds the frames of stay left, and this while it is still climbing.
-- One field with two readings, but they are the same fact — how much of its
-- welcome is left, and "not yet" — and a separate flag would be a second thing
-- to keep in step with it.
climbing : Int
climbing = 0 - 1


type alias Spark =
    { p : Pt
    , z : Int
    , t : Int
    , ink : { r : Int, g : Int, b : Int }
    }


-- ============================================================ model


type Phase
    = Title
    | Playing
    | Dying
    | Warping
    | Over


-- A thumb on the walking half of the screen. `ox` is where it landed, `x`
-- where it is now, and the difference between them is the whole control.
--
-- It is a stick, not a pair of buttons and not a position: the rim of a
-- closed web has no ends, so a control that maps THIS far along the strip to
-- THAT lane runs out of strip on a shape you can walk forever. Deflection
-- means speed, and speed has no end to run out of.
type alias Stick =
    { ox : Int
    , oy : Int
    , x : Int
    , y : Int
    }


type alias Model =
    { w : Int
    , h : Int
    , frame : Int
    , phase : Phase
    , level : Int
    , web : Web
    , lanes : List Lane
    , laneCount : Int
    , lane : Int            -- where the claw stands
    , walk : Int            -- frames until the claw may step again
    , cool : Int            -- frames until the gun may fire again
    , shots : List Shot
    , foes : List Foe
    , sparks : List Spark
    , score : Int
    , lives : Int
    , spin : Int            -- this web's fixed orientation
    , leanX : Int           -- where the far end has leaned to
    , leanY : Int
    , camZ : Int            -- how far the eye has travelled into the well
    , phaseT : Int
    , left : Int            -- enemies this level still has to send
    , spawn : Int           -- frames until the next one enters
    , seed : Random.Seed
    , keys : List Keyboard.Key
    , touch : List Keyboard.Key
    , stick : Maybe Stick   -- the walking thumb, if one is down
    , padTilt : Int         -- left stick X on a controller, -100..100, deadzoned
    , padDown : List Gamepad.Button
    , pads : Bool           -- draw the touch controls: this is a finger device
    , sfx : List Cue
    }


type Cue
    = CFire
    | CHit Kind Int      -- what died, and the depth it died at
    | CDie
    | CClear


-- ============================================================ init


init : (Model, Cmd Msg)
init =
    ( enterLevel 0 fresh, Cmd.none )


fresh : Model
fresh =
    let
        web = webFor 0
        lanes = lanesOf web
    in
    { w = 960
    , h = 600
    , frame = 0
    , phase = Title
    , level = 0
    , web = web
    , lanes = lanes
    , laneCount = List.length lanes
    , lane = 0
    , walk = 0
    , cool = 0
    , shots = []
    , foes = []
    , sparks = []
    , score = 0
    , lives = 3
    , spin = 0
    , leanX = 0
    , leanY = 0
    , camZ = 0
    , phaseT = 0
    , left = 0
    , spawn = 60
    , seed = Random.initialSeed 20260804
    , keys = []
    , touch = []
    , stick = Nothing
    , padTilt = 0
    , padDown = []
    , pads = False
    , sfx = []
    }


-- Start a level: new shape, new lanes, claw back on the web.
enterLevel : Int -> Model -> Model
enterLevel level m =
    let
        web = webFor level
        lanes = lanesOf web
        count = List.length lanes
        -- Every level gets its own orientation so the same sixteen shapes do
        -- not all arrive square-on. But that only makes sense for a CLOSED
        -- web: a ring has no ends, so any angle is as good as another. An
        -- open one has two, and where they are is part of what the shape
        -- means — a wall you can be cornered against is a wall along the
        -- BOTTOM, and left on the keyboard has to mean left on the screen.
        -- Spun 104 degrees, the flat level became a near-vertical cliff you
        -- climbed sideways, which is the one thing it must never be.
        spin = if web.closed then modBy 256 (level * 37) else 0
        start = modBy (max 1 count) (count // 4)
        anchor = rotate spin (laneAt lanes start).mid
    in
    { m
        | level = level
        , web = web
        , lanes = lanes
        , spin = spin
        , laneCount = count
        , lane = start
        -- snapped, not eased: arriving on a new web is not the player
        -- walking, so the camera should already be where it belongs
        , leanX = 0 - anchor.x * 34 // 100
        , leanY = 0 - anchor.y * 34 // 100
        , shots = []
        , foes = []
        , camZ = 0
        , phase = if m.phase == Title then Title else Playing
        , phaseT = 0
        , left = quota level
        , spawn = 60
    }


-- ============================================================ messages


type Msg
    = Tick
    | KeysChanged { down : List Keyboard.Key }
    | Resized Int Int
    | Tapped Int Int
    | Pointers (List { id : Int, x : Int, y : Int })
    | DeviceChanged Device
    | PadChanged { connected : Bool, leftX : Int, leftY : Int, rightX : Int, rightY : Int, down : List Gamepad.Button }


held : Keyboard.Key -> Model -> Bool
held key m =
    List.member key m.keys || List.member key m.touch


update : Msg -> Model -> (Model, Cmd Msg)
update msg model =
    let
        m = step msg model
    in
    ( { m | sfx = [] }
    , Cmd.batch (List.map (\c -> Sound.play (cue c)) m.sfx)
    )


step : Msg -> Model -> Model
step msg m =
    case msg of
        Resized w h ->
            { m | w = max 1 w, h = max 1 h }

        Tapped _ _ ->
            case m.phase of
                Title -> newRun m
                Over -> newRun m
                Playing -> m
                Dying -> m
                Warping -> m

        KeysChanged st ->
            let
                fresher = List.filter (\k -> not (List.member k m.keys)) st.down
            in
            List.foldl press { m | keys = st.down } fresher

        Pointers ps ->
            readTouch m ps

        DeviceChanged d ->
            { m | pads = Device.touchOnly d }

        -- The pad arrives as a whole snapshot, same as the keyboard, so it gets
        -- the same treatment: store the held set, and fold the press EDGE over
        -- the buttons that were not down last time. That is what makes a tap
        -- fire instantly and a button on the title screen start a run, without
        -- either rule being written twice.
        PadChanged st ->
            let
                fresher = List.filter (\b -> not (List.member b m.padDown)) st.down
            in
            List.foldl padPress { m | padDown = st.down, padTilt = st.leftX } fresher

        Tick ->
            tick { m | frame = m.frame + 1 }


newRun : Model -> Model
newRun m =
    enterLevel 0 { m | score = 0, lives = 3, phase = Playing, sparks = [] }


-- Touch: a band across the bottom, walking on the left of it and firing on
-- the right, and nothing anywhere else — the middle and top of the screen is
-- the well and must never be under a thumb.
--
-- WHY A STICK AND NOT TWO ARROWS. The claw walks the rim at one speed, so a
-- left button and a right button say everything there is to say about it, and
-- that is exactly the problem: two squares big enough to hit are two squares
-- big enough to be in the way, and the game is a thing you read. A stick is
-- one control, it is smaller than either button was, and it earns its
-- footprint by being ANALOG — a nudge crawls you one lane over, a shove
-- sprints you across the web.
--
-- It also does not need to be aimed. You grab it anywhere in the walking
-- half; wherever the thumb lands becomes the centre and the rest is
-- deflection. Nothing to hunt for and nothing to slide off.
--
-- The geometry is computed ONCE, here, and both the hit test and the drawing
-- read it. That is not tidiness: it is the only way a control can be where it
-- looks. An earlier version split the screen by fractions in the hit test and
-- drew boxes from the same fractions somewhere else, which is two copies of
-- one truth, and they were 38% of the screen tall because nobody was looking
-- at the number in both places at once.
--
-- Sizes come off the SHORT side of the screen, so the control is the same
-- physical size in portrait and landscape. A thumb does not get bigger when
-- you turn the phone.
type alias Rect =
    { x : Int
    , y : Int
    , w : Int
    , h : Int
    }


type alias Zones =
    { walk : Rect       -- grab the stick anywhere in here
    , fire : Rect       -- and hold anywhere in here to shoot
    , rail : Rect       -- the drawn track, centred in `walk`
    , fireX : Int       -- and the drawn fire button
    , fireY : Int
    , fireR : Int
    }


-- Pixels of deflection that mean full speed, and the slop at the middle where
-- nothing happens at all. Without the dead zone the claw creeps whenever a
-- resting thumb breathes.
stickRange : Model -> Int
stickRange m =
    clamp 56 120 (min m.w m.h * 20 // 100)


stickDead : Int
stickDead = 10


zonesOf : Model -> Zones
zonesOf m =
    let
        band = clamp 92 190 (min m.w m.h * 28 // 100)
        top = m.h - band
        split = m.w * 58 // 100
        mid = top + band // 2
        railW = 2 * stickRange m
        fireR = clamp 28 50 (min m.w m.h * 9 // 100)
    in
    { walk = { x = 0, y = top, w = split, h = band }
    , fire = { x = split, y = top, w = m.w - split, h = band }
    , rail = { x = (split - railW) // 2, y = mid - 3, w = railW, h = 6 }
    , fireX = split + (m.w - split) // 2
    , fireY = mid
    , fireR = fireR
    }


inside : { id : Int, x : Int, y : Int } -> Rect -> Bool
inside p r =
    p.x >= r.x && p.x < r.x + r.w && p.y >= r.y && p.y < r.y + r.h


-- Fold this frame's pointers into the walking thumb and the firing one.
--
-- `watchPointers` is a MIRROR of what is currently down, not a stream of
-- events, so "the thumb let go" is a pointer that stopped being in the list
-- and the stick simply goes away. The origin is kept from the frame the thumb
-- arrived, which is what makes the control relative.
readTouch : Model -> List { id : Int, x : Int, y : Int } -> Model
readTouch m ps =
    let
        z = zonesOf m
        walking = List.head (List.filter (\p -> inside p z.walk) ps)
    in
    { m
        | touch =
            if List.any (\p -> inside p z.fire) ps then
                [ Keyboard.Space ]

            else
                []
        , stick =
            case walking of
                Nothing ->
                    Nothing

                Just p ->
                    case m.stick of
                        Just s -> Just { s | x = p.x, y = p.y }
                        Nothing -> Just { ox = p.x, oy = p.y, x = p.x, y = p.y }
    }


-- How far the stick is pushed, in pixels, positive to the right. Zero inside
-- the dead zone or with no thumb down.
stickPush : Model -> Int
stickPush m =
    case m.stick of
        Nothing ->
            0

        Just s ->
            let
                d = clamp (0 - stickRange m) (stickRange m) (s.x - s.ox)
            in
            if abs d < stickDead then
                0

            else
                d


-- A finger has no key-down edge the way a keyboard does — `press` only ever
-- sees KeysChanged — so holding the fire pad did precisely nothing. That was
-- the whole of "not playable on a phone": you could walk and never shoot.
--
-- It repeats rather than firing once per tap, because a shot cap already
-- limits the rate and tapping eight times a second is not a thing thumbs do.
press : Keyboard.Key -> Model -> Model
press key m =
    case m.phase of
        Title ->
            if starts key then newRun m else m

        Over ->
            if starts key then newRun m else m

        Playing ->
            if fires key then fire m else m

        Dying ->
            m

        Warping ->
            m


-- ANY key starts a run. A screen whose only job is to be dismissed should not
-- have a secret handshake: it used to take Enter or Space, the caption named
-- only Enter, and everything else did nothing at all with no way to know why.
-- `press` already dispatches per phase, so this widening cannot reach the keys
-- that steer during play.
starts : Keyboard.Key -> Bool
starts _ =
    True


fires : Keyboard.Key -> Bool
fires key =
    key == Keyboard.Space || key == Keyboard.KeyZ


-- ============================================================ the controller
--
-- A tube shooter is the one genre that was BUILT for a knob: the arcade
-- cabinet had a spinner and nothing else, and Tempest 2000 shipped its own
-- rotary controller whose encoder is wired straight into the pad's left and
-- right. So a controller here is not a second-class port of the keyboard, it
-- is closer to the original than either of the other two inputs.
--
-- It goes through the SAME places the other inputs do rather than getting its
-- own paths: the d-pad joins the walk as a digital direction, the left stick
-- joins it as an analog one, and any face or shoulder button is the trigger.
-- Nothing here decides what firing or walking means, it only says which
-- hardware is asking.


-- Any button starts a run, matching `starts` on the keyboard: a screen whose
-- job is to be dismissed takes whatever the player happens to press.
padPress : Gamepad.Button -> Model -> Model
padPress btn m =
    case m.phase of
        Title ->
            newRun m

        Over ->
            newRun m

        Playing ->
            if padFires btn then fire m else m

        Dying ->
            m

        Warping ->
            m


-- Every face button and every shoulder is fire. There is one verb in this
-- game, so there is no button left over to mean something else, and a player
-- who guesses wrong is right anyway.
padFires : Gamepad.Button -> Bool
padFires btn =
    btn == Gamepad.A || btn == Gamepad.B || btn == Gamepad.X || btn == Gamepad.Y
        || btn == Gamepad.L1 || btn == Gamepad.R1
        || btn == Gamepad.L2 || btn == Gamepad.R2


padHolding : Model -> Bool
padHolding m =
    List.any padFires m.padDown


-- The d-pad, digital: one lane per `walkFrames`, exactly like a key.
padDir : Model -> Int
padDir m =
    if List.member Gamepad.Left m.padDown then
        0 - 1

    else if List.member Gamepad.Right m.padDown then
        1

    else
        0


-- How far the left stick is pushed, 0..100, past the runtime's own deadzone.
-- The mirror already zeroes anything under a quarter deflection, so the live
-- range is 25..100 and this stretches it back over the whole ramp — otherwise
-- the gentlest push you can even express would already be a third of the way
-- to full speed.
padLock : Int -> Int
padLock tilt =
    clamp 0 100 ((abs tilt - 25) * 100 // 75)


-- ============================================================ firing


-- HOLDING FIRES, AND THE CEILING IS EIGHT.
--
-- Which is the arcade's answer, and it is a better one than a slow trigger.
-- There, holding the button fires continuously and you get eight shots in the
-- air, no more; players who know the game tap instead, not because tapping is
-- faster but because holding empties the allowance and leaves you with nothing
-- in hand when something surfaces on top of you. The limit is a QUANTITY you
-- are spending, not a speed you are waiting on.
--
-- So both are here. Holding gives you a steady stream off `fireEvery`; a tap
-- fires the instant you press, so a fast finger still beats the stream and
-- runs into the ceiling instead. `held` reads the keyboard and the touch pad
-- through the same list, so there is one rule and not one per device — the
-- two used to disagree, with the pad auto-firing off the global frame counter
-- and the key firing only on the press edge.
maxShots : Int
maxShots = 8


-- Frames between shots while the button is DOWN. A shot clears the well in
-- about 22 frames, so this is roughly two in flight at a time: a stream, but
-- one you can still see the end of.
fireEvery : Int
fireEvery = 12


shotSpeed : Int
shotSpeed = 46


fire : Model -> Model
fire m =
    if List.length m.shots >= maxShots then
        m

    else
        { m
            | shots = { lane = m.lane, z = 0 } :: m.shots
            , cool = fireEvery
            , sfx = CFire :: m.sfx
        }


-- One shot per `fireEvery` while the button is held, on either device.
holdFire : Model -> Model
holdFire m =
    if m.cool <= 0 && (held Keyboard.Space m || held Keyboard.KeyZ m || padHolding m) then
        fire m

    else
        { m | cool = max 0 (m.cool - 1) }


moveShots : Model -> Model
moveShots m =
    { m | shots = List.filter (\s -> s.z < zFar) (List.map (\s -> { s | z = s.z + shotSpeed }) m.shots) }


-- ============================================================ the frame


tick : Model -> Model
tick m =
    case m.phase of
        Title ->
            attractStep m

        Over ->
            -- Nothing moves. The eye used to back out of the well here, and
            -- that was the frame going somewhere the player did not send it,
            -- which is the one thing this camera has never done. Everything
            -- that happens now happens to the web and to the sky.
            { m | phaseT = m.phaseT + 1 }

        Playing ->
            { m | phaseT = m.phaseT + 1 }
                |> walkStep
                |> holdFire
                |> moveShots
                |> moveFoes
                |> collide
                |> spawnStep
                |> ageSparks
                |> leanStep
                |> clearCheck

        Dying ->
            let
                t = m.phaseT + 1
            in
            if t > 80 then
                if m.lives <= 0 then
                    { m | phase = Over, phaseT = 0 }

                else
                    enterLevel m.level m

            else
                ageSparks { m | phaseT = t }

        Warping ->
            warpStep (moveShots (ageSparks m))


-- Holding a direction walks the rim at a fixed rate. The rate is in FRAMES
-- per lane rather than lanes per frame so it is the same on every web: a
-- sixteen-lane ring and a twelve-lane one take the same time to cross a lane,
-- not the same time to cross the whole shape.
walkFrames : Int
walkFrames = 4


-- Frames per lane at the slowest and fastest the stick will go. The slow end
-- is deliberately slower than the keyboard: a key has one speed and you pick
-- your moment, while a stick lets you creep one lane over without committing,
-- which is the thing a pair of buttons could never do.
stickSlow : Int
stickSlow = 15


stickFast : Int
stickFast = 3


walkStep : Model -> Model
walkStep m =
    let
        keyDir =
            if held Keyboard.ArrowLeft m || held Keyboard.KeyA m then
                0 - 1

            else if held Keyboard.ArrowRight m || held Keyboard.KeyD m then
                1

            else
                0

        push = stickPush m

        hat = padDir m

        tilt = m.padTilt

        -- Four ways to ask for the same thing, in the order you would be
        -- holding them: a key, then the d-pad, then either analog control.
        -- They are not summed — whichever one is live wins outright, so a
        -- controller left resting against something cannot fight a hand on
        -- the keyboard.
        dir =
            if keyDir /= 0 then
                keyDir

            else if hat /= 0 then
                hat

            else if tilt /= 0 then
                if tilt < 0 then 0 - 1 else 1

            else if push < 0 then
                0 - 1

            else if push > 0 then
                1

            else
                0

        -- A key is a key: one lane every `walkFrames`, always. So is a d-pad,
        -- for the same reason — a switch has one position. Both analog
        -- controls ramp instead, and how far you push is how fast you go.
        period =
            if keyDir /= 0 || hat /= 0 then
                walkFrames

            else if tilt /= 0 then
                stickSlow - (stickSlow - stickFast) * padLock tilt // 100

            else if push == 0 then
                walkFrames

            else
                let
                    span = max 1 (stickRange m - stickDead)
                    lock = clamp 0 100 ((abs push - stickDead) * 100 // span)
                in
                stickSlow - (stickSlow - stickFast) * lock // 100

    in
    if dir == 0 then
        { m | walk = 0 }

    else if m.walk > 0 then
        { m | walk = m.walk - 1 }

    else
        { m | lane = stepLane m.web.closed m.laneCount m.lane dir, walk = period }


-- The camera moves when YOU move, and at no other time.
--
-- This used to advance `phaseT` too, on the grounds that it ran once a frame.
-- So did `attractStep`, and on the title screen both ran, so the phase clock
-- went up by TWO every frame and only ever held even values by the time a
-- frame ended — and odd ones when the pilot read it. Every `modBy n phaseT`
-- in the attract was therefore testing a number that could never be zero:
-- the demo could not fire, the web changed twice as fast as `attractWebFrames`
-- says, and the death pause lasted half of what `Dying` asks for. One stray
-- increment, three symptoms, none of which looked like a clock. A step named
-- for the lean now does the lean, and each phase advances its own clock once.
--
-- What actually moves in a tube shooter is the LEAN — the far end pushing
-- away from wherever you are standing — and that is a function of your
-- position, so it stops dead when you do. It is eased rather than snapped
-- because the claw jumps a whole lane at a time; following that instantly
-- would make the well twitch once per step.
leanStep : Model -> Model
leanStep m =
    let
        anchor = rotate m.spin (laneAt m.lanes m.lane).mid
        pull = 34
        tx = 0 - anchor.x * pull // 100
        ty = 0 - anchor.y * pull // 100
    in
    { m
        | leanX = m.leanX + (tx - m.leanX) // 8
        , leanY = m.leanY + (ty - m.leanY) // 8
    }


-- ============================================================ the enemy
--
-- Everything the game asks of you is in these numbers. Deep in the well it
-- mostly climbs, drifting a lane now and then in a direction of its own that
-- has nothing to do with you: far enough away to be a shape you can lead, and
-- slow enough to be worth aiming at. The hunt only starts near the rim, which
-- is why the last stretch of a lane is the frightening part rather than all
-- of it. The first two levels have no drift at all — meeting one that comes
-- straight at you is how you learn what a lane is.


foeInk : Kind -> { r : Int, g : Int, b : Int }
foeInk kind =
    case kind of
        Flipper -> { r = 255, g = 80, b = 90 }
        Tanker -> { r = 255, g = 190, b = 70 }


pointsFor : Kind -> Int
pointsFor kind =
    case kind of
        Flipper -> 150
        Tanker -> 100


-- How long the well takes to cross is the difficulty dial. Three units a
-- frame is about five and a half seconds at the start — long enough to pick
-- which lane deserves the shot, short enough that ignoring one costs you.
foeSpeed : Kind -> Int -> Int
foeSpeed kind level =
    case kind of
        Flipper -> 3 + level // 4
        -- slower, because the threat is not that it arrives, it is what it
        -- leaves behind when it does not
        Tanker -> 2 + level // 5


-- Where the well changes character. Past this the flipping is fast, aimless
-- and far away; inside it the flipping is slow, aimed at you, and worth
-- reading. The threat near the rim is that it ARRIVES, not that it is
-- unpredictable, so the last stretch is deliberately the calm one.
huntDepth : Int
huntDepth = 300


-- Move everything, then drop whatever burned out on the rim. `rim` reaching
-- zero is the end of a stay and nothing else can produce it: a climber sits at
-- `climbing`, which is below zero, so this test cannot fire on the way up.
moveFoes : Model -> Model
moveFoes m =
    { m | foes = List.filter (\f -> f.rim /= 0) (List.map (\f -> moveFoe m f) m.foes) }


moveFoe : Model -> Foe -> Foe
moveFoe m f =
    let
        z = max 0 (f.z - foeSpeed f.kind m.level)
        t = f.t + 1
        nearRim = z < huntDepth
        -- Two cadences, and the deep one must always be the quicker of the
        -- two or the whole arrangement below stops meaning anything. It is
        -- also the one that has to ARRIVE gently: levels one and two have no
        -- deep flipping at all, so whatever number this starts at is a step
        -- change the player feels on level three and nowhere else. It used to
        -- start at 46 and that step was far too big — the well went from still
        -- to busy in one level. Starting at 76 and tightening five frames a
        -- level puts level three back near the old feel and still reaches a
        -- properly frantic floor by the time anyone gets there.
        period =
            if nearRim then
                max 66 (96 - m.level * 3)

            else
                max 34 (86 - m.level * 5)
    in
    if f.rim >= 0 then
        -- Up here it does not climb any more. It walks the rim toward you and
        -- its welcome runs out, and both kinds do it — a tanker that made the
        -- trip has earned the same right to come and get you.
        { f
            | rim = f.rim - 1
            , t = t
            , lane =
                if modBy rimPeriod t == 0 then
                    towardPlayer m f.lane

                else
                    f.lane
        }

    else if z <= rimDepth then
        -- It made it. It takes the rim and starts its stay.
        { f | z = 0, rim = rimStay, t = 0 }

    else if f.kind == Tanker then
        -- while it is in the well it only ever climbs
        { f | z = z, t = t }

    else if t < period then
        { f | z = z, t = t }

    else if nearRim then
        -- IT STILL HUNTS UP HERE, IT JUST STOPS BEING QUICK ABOUT IT.
        --
        -- This used to be the fast half, and that was the mistake. A creature
        -- that re-aims every third of a second inside the last stretch of the
        -- well is not something you dodge, it is something you guess: you
        -- commit to a lane, it corrects, and the correction lands before you
        -- have finished stepping. Losing to that reads as unfair, because it
        -- is — the game asked for a decision and then took the decision back.
        --
        -- Slow it down here and the same move becomes a threat you can
        -- answer. It will come for you, about once every second and a half,
        -- so the lane it is in is worth reading and the step you take away
        -- from it is worth taking.
        { f | z = z, t = 0, lane = towardPlayer m f.lane }

    else if m.level < 2 then
        { f | z = z, t = 0 }

    else
        -- DEEP DOWN IS WHERE THE MOVEMENT LIVES NOW.
        --
        -- Fast, and in a direction of its own rather than toward you. Far away
        -- the flipping costs you nothing to watch, which is exactly why it
        -- belongs here: it fills the well with motion, it spreads the wave
        -- across the whole web instead of letting every creature converge on
        -- the one lane you happen to be standing in, and by the time any of it
        -- is close enough to matter it has already settled.
        { f | z = z, t = 0, lane = stepLane m.web.closed m.laneCount f.lane f.dir }


-- One lane closer to the claw, the short way round.
towardPlayer : Model -> Int -> Int
towardPlayer m lane =
    towardLane m m.lane lane


towardLane : Model -> Int -> Int -> Int
towardLane m target lane =
    if lane == target then
        lane

    else
        let
            n = max 1 m.laneCount
            ahead = modBy n (target - lane)
            behind = modBy n (lane - target)
            dir =
                if not m.web.closed then
                    if target > lane then 1 else 0 - 1

                else if ahead <= behind then
                    1

                else
                    0 - 1
        in
        stepLane m.web.closed m.laneCount lane dir


-- ============================================================ collisions


hitRange : Int
hitRange = 46


collide : Model -> Model
collide m =
    let
        hit = \s f -> f.lane == s.lane && abs (f.z - s.z) < hitRange

        struck = List.filter (\f -> List.any (\s -> hit s f) m.shots) m.foes
        survivors = List.filter (\f -> not (List.any (\s -> hit s f) m.shots)) m.foes
        spent = List.filter (\s -> List.any (\f -> hit s f) m.foes) m.shots
        halves = List.concatMap (\f -> splitOf m f) struck

        -- It costs a life when it REACHES you, not when it reaches the rim.
        -- Something that surfaced somewhere else is a thing walking the rim
        -- toward you on a fuse (see `rimStay`), which is a fight; killing you
        -- for it landing anywhere at all was a scoreboard.
        --
        -- Read from `survivors` and not from `m.foes`, so a shot that lands on
        -- the same frame still saves you: you killed it, so it never arrived.
        caught = List.any (\f -> f.lane == m.lane && f.z <= rimDepth) survivors
    in
    if caught then
        { m
            | phase = Dying
            , phaseT = 0
            , lives = m.lives - 1
            , sparks = { p = (laneAt m.lanes m.lane).mid, z = 0, t = 0, ink = { r = 255, g = 255, b = 255 } } :: m.sparks
            , sfx = CDie :: m.sfx
        }

    else
        { m
            | foes = survivors ++ halves
            , shots = List.filter (\s -> not (List.member s spent)) m.shots
            , score = m.score + List.sum (List.map (\f -> pointsFor f.kind) struck)
            , sparks = List.map (\f -> foeSpark m f) struck ++ m.sparks
            -- One cue per KILL rather than one per volley: the sound is about
            -- the creature now, so a shot that takes two of them at different
            -- depths has to say so twice.
            , sfx = List.map (\f -> CHit f.kind f.z) struck ++ m.sfx
        }


-- A tanker is two enemies wearing one coat. They come out at the depth it
-- died at, one lane to each side, already moving apart — which is what makes
-- WHEN you shoot it the only interesting thing about it.
splitOf : Model -> Foe -> List Foe
splitOf m f =
    if f.kind /= Tanker then
        []

    else
        [ { kind = Flipper, lane = stepLane m.web.closed m.laneCount f.lane 1, z = f.z, t = 0, dir = 1, rim = climbing }
        , { kind = Flipper, lane = stepLane m.web.closed m.laneCount f.lane (0 - 1), z = f.z, t = 0, dir = 0 - 1, rim = climbing }
        ]


-- An explosion belongs where the thing that made it was standing, which means
-- it needs the DEPTH as well as the lane. Without it every kill flashes at the
-- near rim no matter how far down the well it happened.
foeSpark : Model -> Foe -> Spark
foeSpark m f =
    { p = (laneAt m.lanes f.lane).mid
    , z = f.z
    , t = 0
    , ink = foeInk f.kind
    }


-- HOW BIG A KILL IS.
--
-- Sized off `foeR` rather than off a number of its own, because a burst is the
-- thing that died coming apart: it has to read against the SHAPE, not against
-- the screen. Left to its own numbers it drifted to nearly nine times the
-- creature by the end of its life, which is not an explosion, it is a wipe:
-- the burst covered the lanes either side of it, so you could not see what was
-- climbing next in the exact moment you had just made room to look.
--
-- It starts INSIDE the outline and tops out near four times it. Both ends
-- matter: starting smaller than the shape is what makes the first frame look
-- like the creature bursting rather than a circle appearing over it.
sparkR0 : Int
sparkR0 = foeR * 55 // 100


sparkGrow : Int
sparkGrow = 16


ageSparks : Model -> Model
ageSparks m =
    { m | sparks = List.filter (\s -> s.t < 24) (List.map (\s -> { s | t = s.t + 1 }) m.sparks) }


-- ============================================================ spawning


-- How many the level sends, how many can be in the well at once, and how
-- often one arrives. Three numbers, and between them they are the entire
-- difficulty curve.
quota : Int -> Int
quota level =
    10 + level * 2


-- How many may be in the well at once. One fewer than it was through the
-- early levels, where the well filling up is what makes a shape unreadable
-- before you have learned it; the ceiling means the late game is unchanged.
waveSize : Int -> Int
waveSize level =
    min 10 (3 + level)


-- The first two levels are pure flippers: you learn the lane before you learn
-- the choice. After that a quarter of what arrives is a tanker, rising to a
-- third — enough that every wave has one, never so many that the well is
-- mostly things waiting to become other things.
kindFor : Int -> Int -> Kind
kindFor level roll =
    if level < 2 then
        Flipper

    else if roll < min 34 (22 + level * 2) then
        Tanker

    else
        Flipper


spawnStep : Model -> Model
spawnStep m =
    if m.spawn > 0 then
        { m | spawn = m.spawn - 1 }

    else if m.left <= 0 then
        m

    else if List.length m.foes >= waveSize m.level then
        { m | spawn = 20 }

    else
        let
            (laneRoll, s1) = Random.step (Random.int 0 (max 1 m.laneCount - 1)) m.seed
            (dirRoll, s2) = Random.step (Random.int 0 1) s1
            (kindRoll, s3) = Random.step (Random.int 0 99) s2
        in
        { m
            | seed = s3
            , left = m.left - 1
            , spawn = max 18 (70 - m.level * 3)
            , foes =
                { kind = kindFor m.level kindRoll
                , lane = laneRoll
                , z = zFar
                , t = 0
                , dir = if dirRoll == 0 then 1 else 0 - 1
                , rim = climbing
                }
                    :: m.foes
        }


-- ============================================================ clearing


-- A level ends when its quota has been sent and killed, not on a timer. That
-- is what makes a web feel like a place with a population rather than a tap.
clearCheck : Model -> Model
clearCheck m =
    if m.left <= 0 && List.isEmpty m.foes then
        { m | phase = Warping, phaseT = 0, camZ = 0, shots = [], sfx = CClear :: m.sfx }

    else
        m


-- The dive. `camZ` walks from zero to past the far end and the perspective
-- does the rest: the rim swells past the edges of the screen, the far end
-- rushes up, and the next web is waiting on the other side. It is the one
-- moment the camera gets to show what it is.
warpSpeed : Int
warpSpeed = 13


warpStep : Model -> Model
warpStep m =
    let
        camZ = m.camZ + warpSpeed
    in
    if camZ >= zFar + camD then
        enterLevel (m.level + 1) { m | score = m.score + 100 }

    else
        { m | phaseT = m.phaseT + 1, camZ = camZ }


-- ============================================================ attract mode
--
-- The title screen is the game playing itself, which is what an arcade
-- cabinet did with the minute nobody was holding it: a demo pilot walks the
-- rim and shoots, on a well that changes shape every few seconds so you see
-- there is more than one. It costs almost nothing because every part of it
-- already exists — same tick, same enemy, same camera — with the keyboard
-- swapped for a small pilot and lives swapped for nothing at all.
--
-- It also means the camera on the title moves for exactly the reason it moves
-- in play: someone is walking.


attractWebFrames : Int
attractWebFrames = 60 * 7


-- The title is STAGED, in three beats: the letters arrive on an empty well,
-- the screen holds while you read them, and only then does the game start
-- playing itself. Running the logo and the demo together made one beat out of
-- two, and the logo was the half that lost — six letters flying in over a
-- firefight is six letters nobody looks at.
--
-- The wait is a wait, not an intermission: the well and the sky are up and
-- lit the whole time, so the first beat is already the game's picture, just
-- without anything happening in it yet.
--
-- Title is entered once, at load, and `newRun` leaves for good, so `phaseT`
-- here is a clock that starts when the program does. Which is what makes a
-- one-shot opening a comparison rather than a state machine.
attractStart : Int
attractStart = logoLands + 50


attractStep : Model -> Model
attractStep m =
    let
        n = m.phaseT + 1
    in
    if modBy attractWebFrames n == 0 then
        let
            next = enterLevel (m.level + 1) m
        in
        { next | phase = Title, phaseT = n }

    else if n < attractStart then
        -- The logo's beat. Nothing is spawned, nothing walks, and the camera
        -- holds still for exactly the reason it holds still in play: nobody
        -- is moving.
        { m | phaseT = n }

    else
        -- The attract screen never runs dry. In play, a level sends its quota
        -- and stops, and the quiet at the end is part of the shape of a
        -- level. On the title that same quiet is just an empty tube with
        -- nobody looking at it, so the quota is topped straight back up.
        { m | phaseT = n, left = max m.left 4 }
            |> attractPilot
            |> moveShots
            |> moveFoes
            |> attractCollide
            |> spawnStep
            |> ageSparks
            |> leanStep


-- The pilot walks to whatever is closest to getting out, and shoots it.
--
-- It fires when it is ON the target's lane, not on a timer, and that is the
-- whole difference between a demo that looks like someone playing and one
-- that looks like someone walking into things. Firing by clock sends the
-- shots down whichever lane the claw is crossing at the time, so the enemy it
-- is walking toward arrives untouched and bursts on top of it — which is
-- exactly what it looked like.
--
-- There was also a slow cadence here, put in when the attract well kept going
-- empty. That was the wrong fix for the wrong cause: the well emptied because
-- the level's quota ran out, which `attractStep` tops up now. The slow pilot
-- outlived the problem it was invented for, and left a demo that could not
-- defend itself.
attractFireEvery : Int
attractFireEvery = 10


attractPilot : Model -> Model
attractPilot m =
    let
        target =
            case List.sortBy .z m.foes of
                f :: _ -> f.lane
                [] -> m.lane

        aimed = m.lane == target
    in
    { m
        | lane = if m.walk > 0 then m.lane else towardLane m target m.lane
        , walk = if m.walk > 0 then m.walk - 1 else walkFrames
        , shots =
            if aimed && modBy attractFireEvery m.phaseT == 0 && List.length m.shots < maxShots then
                { lane = m.lane, z = 0 } :: m.shots

            else
                m.shots
    }


-- The same collision as the game, minus the part that costs a life: anything
-- that reaches the rim simply bursts and is gone.
attractCollide : Model -> Model
attractCollide m =
    let
        hit = \s f -> f.lane == s.lane && abs (f.z - s.z) < hitRange
        reached = \f -> f.lane == m.lane && f.z <= rimDepth
        gone = List.filter (\f -> List.any (\s -> hit s f) m.shots || reached f) m.foes
    in
    { m
        -- Same rules as the real thing, minus the part that costs a life:
        -- something that reaches the pilot simply bursts. Rim-walkers that
        -- reach anywhere ELSE stay and hunt, exactly as they do in play, and
        -- their own fuse takes them off.
        | foes =
            List.filter (\f -> not (List.any (\s -> hit s f) m.shots) && not (reached f)) m.foes
                ++ List.concatMap (\f -> splitOf m f) (List.filter (\f -> List.any (\s -> hit s f) m.shots) m.foes)
        , shots = List.filter (\s -> not (List.any (\f -> hit s f) m.foes)) m.shots
        , sparks = List.map (\f -> foeSpark m f) gone ++ m.sparks
    }

-- ============================================================ the logo
--
-- Six letters as polylines in a 100x100 box, drawn with the same `seg` the
-- web is drawn with, because a bitmap font next to a vector game looks
-- borrowed. They arrive out of the vanishing point on a stagger, which is
-- the one move this game already knows how to make.


logoStrokes : Int -> List (List Pt)
logoStrokes i =
    case i of
        0 ->
            -- V
            [ [ { x = 0, y = 0 }, { x = 50, y = 100 }, { x = 100, y = 0 } ] ]

        1 ->
            -- O
            [ [ { x = 22, y = 0 }, { x = 78, y = 0 }, { x = 100, y = 26 }
              , { x = 100, y = 74 }, { x = 78, y = 100 }, { x = 22, y = 100 }
              , { x = 0, y = 74 }, { x = 0, y = 26 }, { x = 22, y = 0 }
              ]
            ]

        2 ->
            -- R
            [ [ { x = 0, y = 100 }, { x = 0, y = 0 }, { x = 66, y = 0 }
              , { x = 96, y = 26 }, { x = 66, y = 52 }, { x = 0, y = 52 }
              ]
            , [ { x = 52, y = 52 }, { x = 100, y = 100 } ]
            ]

        3 ->
            -- T
            [ [ { x = 0, y = 0 }, { x = 100, y = 0 } ]
            , [ { x = 50, y = 0 }, { x = 50, y = 100 } ]
            ]

        4 ->
            -- E
            [ [ { x = 100, y = 0 }, { x = 0, y = 0 }, { x = 0, y = 100 }, { x = 100, y = 100 } ]
            , [ { x = 0, y = 52 }, { x = 72, y = 52 } ]
            ]

        _ ->
            -- X
            [ [ { x = 0, y = 0 }, { x = 100, y = 100 } ]
            , [ { x = 100, y = 0 }, { x = 0, y = 100 } ]
            ]


-- Frames between one letter setting off and the next, and frames for one
-- letter to make the trip. The staging below reads its cue off these two
-- rather than off a number typed twice, so the beat cannot drift away from
-- the animation it is waiting for.
-- Frames for a line to fade up, and how long the verdict holds the screen
-- alone before the numbers follow it. Short on purpose: the title screen is
-- somewhere you linger and this is somewhere you want to leave.
overFade : Int
overFade = 14


overHold : Int
overHold = 18


logoStagger : Int
logoStagger = 7


logoTravel : Int
logoTravel = 40


-- The frame the last of the six is home.
logoLands : Int
logoLands = 5 * logoStagger + logoTravel


-- Colour cycling rather than motion: the letters hold still once they land
-- and shift hue on a beat, which is where this genre's title screens have
-- always lived.
logoInk : Int -> Int -> { r : Int, g : Int, b : Int }
logoInk i frame =
    let
        phase = modBy 256 (frame * 2 + i * 26)
        wave = \o -> 128 + sinB (modBy 256 (phase + o)) * 110 // one
    in
    { r = clamp 40 255 (wave 0)
    , g = clamp 40 255 (wave 85)
    , b = clamp 90 255 (wave 170)
    }


logoShapes : Model -> Cam -> List Shape
logoShapes m cam =
    let
        -- the letters come from where the well goes
        van = project cam { x = 0, y = 0 } zFar

        cell = clamp 24 54 (m.w // 15)
        gap = cell * 5 // 4
        left = m.w // 2 - (gap * 5 + cell) // 2
        top = m.h // 6
    in
    List.concatMap
        (\i ->
            let
                -- each letter has its own arrival, staggered, and once it is
                -- home it stays home
                p = clamp 0 100 ((m.phaseT - i * logoStagger) * 100 // logoTravel)
                hx = left + gap * i
                x = van.x + (hx - van.x) * p // 100
                y = van.y + (top - van.y) * p // 100
                size = cell * p // 100
                ink = logoInk i m.frame
                w = max 1 (size // 12)
            in
            if size < 3 then
                []

            else
                List.concatMap
                    (\stroke -> polyline stroke x y size w ink)
                    (logoStrokes i)
        )
        (List.range 0 5)


-- Draw a stroke of the letter box scaled into place.
polyline : List Pt -> Int -> Int -> Int -> Int -> { r : Int, g : Int, b : Int } -> List Shape
polyline pts x y size w ink =
    let
        at = \q -> { x = x + q.x * size // 100, y = y + q.y * size // 100 }
    in
    List.concat
        (List.indexedMap
            (\i q ->
                case List.head (List.drop (i + 1) pts) of
                    Just r -> seg (at q) (at r) w ink 100
                    Nothing -> []
            )
            pts
        )

-- ============================================================ camera


-- THE PICTURE FILLS WHAT IT IS GIVEN.
--
-- The scale used to be `min w h / 2.5`, which is the right answer for a circle
-- and the wrong one for anything else. Half the webs are OPEN — a fan, a line,
-- a bowl — and their rim is wider than it is tall, so on a phone held
-- sideways the game drew itself into a third of the screen and left the rest
-- black. You could not tell which lane a thing was in because the whole thing
-- was a postage stamp.
--
-- So it measures the rim it actually has and fits THAT. The rim is the widest
-- the web ever gets: everything deeper converges on the vanishing point, and
-- the lean is capped at a third of the way there, so nothing can reach past
-- the near edge. Fitting the rim therefore fits the whole picture.
--
-- The box it fits into is what is left after the readouts and the controls,
-- not the glass. In landscape the touch band is a quarter of the height, and
-- centring on the screen put the near rim — the part you play on — underneath
-- your own thumbs.
camera : Model -> Cam
camera m =
    let
        -- The real box the drawing occupies, as min/max and not as a radius.
        -- Half the shapes are not centred on the origin — a fan has its rim
        -- along the bottom and its far end up at the vanishing point — so a
        -- fit measured as `max |y|` reserves room on a side that has nothing
        -- on it and draws the shape small AND low.
        --
        -- Three kinds of point bound it: the two ends of every lane, and every
        -- vanishing point the lean can reach. The lean is a third of the way
        -- back from a lane's middle, so those are known in advance, and using
        -- the whole set rather than the CURRENT one is what keeps the fit
        -- fixed for the level — measuring the live lean would rescale the
        -- picture as you walked, which is a zoom, and this camera does not
        -- zoom.
        grow = \p b ->
            { x0 = min b.x0 p.x, x1 = max b.x1 p.x
            , y0 = min b.y0 p.y, y1 = max b.y1 p.y
            }

        box =
            List.foldl
                (\l b ->
                    let
                        mid = rotate m.spin l.mid
                    in
                    grow (rotate m.spin l.a)
                        (grow (rotate m.spin l.b)
                            (grow { x = 0 - mid.x * 34 // 100, y = 0 - mid.y * 34 // 100 } b))
                )
                { x0 = 0, x1 = 0, y0 = 0, y1 = 0 }
                m.lanes

        spanX = max 1 (box.x1 - box.x0)
        spanY = max 1 (box.y1 - box.y0)

        -- The controls are drawn small and the ZONES they answer for are
        -- large, so only the marks need clearing, not the whole band.
        top = 54
        bottom =
            if m.pads then
                (zonesOf m).fireR * 2 + 24

            else
                28

        boxW = max 40 (m.w * 92 // 100)
        boxH = max 40 (m.h - top - bottom)
        fit = min (boxW * one // spanX) (boxH * one // spanY)
    in
    -- Everything here is either fixed for the level (`spin` and the fit, which
    -- are the shape's own) or a value `leanStep` moved because the player
    -- moved. No term is a function of the frame counter, which is the whole
    -- point: a still player means a still camera.
    -- and the box's own middle is put in the middle of the space, which is
    -- what stops an off-centre shape from sitting off-centre on the glass
    { cx = m.w // 2 - (box.x0 + box.x1) // 2 * fit // one
    , cy = top + boxH // 2 - (box.y0 + box.y1) // 2 * fit // one
    , scale = max 24 fit
    , spin = m.spin
    , vx = m.leanX
    , vy = m.leanY
    , camZ = m.camZ
    }


-- ============================================================ view


-- How much of the game is left showing on the title. The demo is a rehearsal
-- happening behind the logo, and at full strength it was indistinguishable
-- from the real thing — you look up and think you are already playing. Dimmed
-- it stays legible as a game without ever being mistaken for yours.
attractDim : Int
attractDim = 46


view : Model -> View Msg
view m =
    let
        cam = camera m

        -- The whole game, as one layer. It has to be one layer rather than a
        -- fade per shape, because `Canvas.Alpha` on a group composites the
        -- group ONCE — fading each shape instead would let every line show
        -- through every line it crosses, and a wireframe crossed with itself
        -- at half strength is a mess.
        play =
            webShapes m cam
                ++ foeShapes m cam
                ++ shotShapes m cam
                ++ clawShapes m cam
                ++ sparkShapes m cam
    in
    canvas Crisp
        [ onTap Tapped, watchSize Resized, watchPointers Pointers ]
        (backdrop m
            ++ skyShapes m cam
            ++ (if m.phase == Title then
                    [ group [ Canvas.Alpha attractDim ] play ]

                else
                    play
               )
            ++ padShapes m
            ++ hud m
            ++ titleShapes m cam
        )


backdrop : Model -> List Shape
backdrop m =
    [ rect 0 0 m.w m.h (rgb 4 4 10) ]


-- ============================================================ the sky
--
-- Stars streaming out of the vanishing point. They earn their place for a
-- reason beyond decoration: the well is a wireframe with nothing inside it,
-- so the space between the lanes was flat black and read as EMPTY. A field of
-- points falling down the same hyperbola as the lanes fills it with something
-- unmistakably far away, and the tube stops being a shape drawn on a
-- background and becomes a shape you are looking through.
--
-- This moves on its own, which the camera never does, and that is not a
-- contradiction of the rule. The camera still answers only the player: the
-- vanishing point stays exactly where the player left it, and the frame never
-- shifts. What moves is content, the same way an enemy climbing a lane is
-- content.


-- The sky is the one thing in this game that moves without being asked, all
-- the way through every level and the dive between them. So it is also the
-- one thing whose STOPPING means something, and it stops when the run does.
-- `phaseT` counts frames since the run ended, so subtracting it pins the sky
-- to the exact frame you died on: no easing, no drift, a full stop.
skyFrame : Model -> Int
skyFrame m =
    if m.phase == Over then m.frame - m.phaseT else m.frame


skyCount : Int
skyCount = 120


-- A star's life measured in depth, and how much of it goes by each frame. The
-- cycle overshoots `zFar` on purpose: a star that stopped at the rim would
-- wink out mid-screen, so it keeps coming until it is past the edge.
skyCycle : Int
skyCycle = 1200


skySpeed : Int
skySpeed = 5


skyFade : Int
skyFade = 300


-- Where each star sits on the plane of the rim, as an offset from the
-- vanishing point. Computed ONCE — a top-level value in Mar is evaluated when
-- the program loads — so none of this trigonometry runs during a frame.
--
-- The two strides are what spread the field. 97 and 256 are coprime, so the
-- angles walk the whole turn without landing twice; so do 613 and 1900 for the
-- radii; and because the strides differ, a star's angle tells you nothing
-- about its distance. It is a lattice rather than a scatter, which at
-- fifty-six points looks more even than random actually does.
sky : List Pt
sky =
    List.map
        (\i ->
            let
                ang = modBy 256 (i * 97)
                rad = 260 + modBy 2400 (i * 613)
            in
            { x = rad * cosB ang // one, y = rad * sinB ang // one }
        )
        (List.range 0 (skyCount - 1))


skyShapes : Model -> Cam -> List Shape
skyShapes m cam =
    List.indexedMap
        (\i p ->
            let
                -- Spaced evenly through the cycle by index, so stars arrive at
                -- a steady rate. Random phases would clump, and a clump of
                -- stars arriving together reads as something happening.
                -- Depth is measured from the EYE, and the eye's own travel is
                -- part of what advances it.
                --
                -- It used to be measured from the rim, which made the sky a
                -- fixed slab sitting in the well — and the dive between levels
                -- takes the camera `zFar + camD` forward, past the whole slab.
                -- Halfway down, every star was behind the eye, and the ones
                -- being born were born behind it too, so the sky emptied and
                -- stayed empty for the rest of the best-looking move in the
                -- game. Adding `camZ` here makes it a shell the eye carries:
                -- a star always recycles in FRONT, and the dive rushes them
                -- past faster because the eye is closing on them as well.
                age = modBy skyCycle (skyFrame m * skySpeed + cam.camZ + i * skyCycle // skyCount)
                d = zFar - age
                k = one * camD // max 40 (camD + d)

                -- The web's projection minus the spin: a shape's orientation
                -- belongs to that shape, and a sky that turned with it would
                -- be a sky bolted to the level.
                x = cam.cx + (cam.vx + p.x * k // one) * cam.scale // one
                y = cam.cy + (cam.vy + p.y * k // one) * cam.scale // one

                sz = clamp 1 4 (k * 4 // one)

                -- The far end sits at a sixth of the scale, so an opacity
                -- taken straight off the perspective factor leaves a distant
                -- star at nothing — and the distant ones ARE the effect, being
                -- the ones close to the vanishing point that the field appears
                -- to pour out of. So the ramp starts well clear of zero and
                -- only widens from there.
                lit = min 64 (18 + k * 46 // one)

                -- Fading out the last stretch is what keeps the wrap-around
                -- invisible: by the time a star's turn comes round again it
                -- has dimmed away rather than blinked out wherever it happened
                -- to be standing.
                fade = min one (one * (skyCycle - age) // skyFade)
                a = lit * fade // one
            in
            rect (x - sz // 2) (y - sz // 2) sz sz (rgba 150 175 225 a)
        )
        sky


-- The web: the far outline, the lane walls, then the near rim on top.
-- Drawing the far end first and brightening as it comes forward is the whole
-- of the depth cueing — no fog, no shading, just three weights of one colour.
-- Blend two inks, `k` per cent of the way from the first to the second.
mixInk : { r : Int, g : Int, b : Int } -> { r : Int, g : Int, b : Int } -> Int -> { r : Int, g : Int, b : Int }
mixInk from to k =
    { r = from.r + (to.r - from.r) * k // 100
    , g = from.g + (to.g - from.g) * k // 100
    , b = from.b + (to.b - from.b) * k // 100
    }


-- THE LIGHTS GO OUT AROUND YOU.
--
-- The ending happens to the OBJECT, which is the rule the rest of the game
-- follows. Two earlier attempts got that half right and still fell flat, and
-- both failed the same way: they treated the web as ONE thing. Draining every
-- line to grey together, or backing the eye out so the whole picture shrank,
-- says "the game stopped" — a switch being thrown, over in an instant, with
-- nothing to watch and nothing that belongs to the run that just ended.
--
-- A wave says something. The far side of the well goes dark first and the
-- darkness closes on you a ring at a time, so the LAST thing still lit is the
-- lane you were standing in when it got you. That is the one piece of the
-- picture that is about this particular death, and the ending now points at
-- it for a second and a half before letting it go too. The frame never moves
-- and nothing is added to the screen: the place simply stops being lit, from
-- the outside in.
deadInk : { r : Int, g : Int, b : Int }
deadInk = { r = 30, g = 32, b = 42 }


-- Frames between one ring of the web going out and the next, and frames for
-- one of them to fade. Sixteen lanes is eight rings from the far side, so the
-- whole sweep runs about 70 frames.
outStep : Int
outStep = 6


outFade : Int
outFade = 22


-- How far round the ring boundary `i` sits from the lane the claw was holding.
-- On a closed web that is the short way round; on an open one there is only
-- one way to count.
ringDist : Model -> Int -> Int
ringDist m i =
    let
        n = max 1 m.laneCount
    in
    if m.web.closed then
        min (modBy n (i - m.lane + n)) (modBy n (m.lane - i + n))

    else
        abs (i - m.lane)


-- The ink of one piece of the web right now. Every line of the web asks for
-- its own, which is what lets the sweep exist at all: a single colour for the
-- whole shape can only ever fade as one thing.
inkAt : Model -> Int -> { r : Int, g : Int, b : Int }
inkAt m i =
    case m.phase of
        Over ->
            let
                n = max 1 m.laneCount
                edge = if m.web.closed then n // 2 else n
                startAt = (edge - ringDist m i) * outStep
            in
            mixInk m.web.ink deadInk (clamp 0 100 ((m.phaseT - startAt) * 100 // outFade))

        _ ->
            m.web.ink


webShapes : Model -> Cam -> List Shape
webShapes m cam =
    let
        ink = m.web.ink
        near = List.map (\l -> project cam l.a 0) m.lanes
        far = List.map (\l -> project cam l.a zFar) m.lanes

        edges =
            \pts alpha w ->
                List.concat
                    (List.indexedMap
                        (\i p ->
                            case List.head (List.drop (modBy (List.length pts) (i + 1)) pts) of
                                Just q ->
                                    if not m.web.closed && i == List.length pts - 1 then
                                        []

                                    else
                                        seg p q w (inkAt m i) alpha

                                Nothing ->
                                    []
                        )
                        pts
                    )

        -- A wall with something behind it is drawn brighter, and brighter the
        -- nearer that something is. This is the cheapest possible answer to
        -- the only question the game asks — WHICH lane is it coming up — and
        -- it puts the answer on the lane instead of on a readout. Walls are
        -- lane BOUNDARIES, so boundary i belongs to lane i and to the lane
        -- before it, and both count.
        neighbour = \i ->
            if m.web.closed then
                modBy (max 1 m.laneCount) (i - 1 + m.laneCount)

            else
                i - 1

        -- The strongest claim on a wall: how solid the nearest thing behind it
        -- is, AND what colour that thing is.
        -- ...but only while the run is on. The highlight exists to answer
        -- "which lane is it coming up", and once you are dead that is not a
        -- question anyone is asking. Leaving it on made the ending incoherent:
        -- half the web dimming on the sweep while the other half stayed lit
        -- bright red, still warning a player who has nothing left to do about
        -- it. Off, the web goes out as one shape and the creatures still on
        -- the rim keep their own colour against it, which is the picture the
        -- ending wants: the place is dark, and they are what is left in it.
        threat = \i ->
            if m.phase == Over then
                { t = 0, tint = inkAt m i }

            else
            List.foldl
                (\f acc ->
                    let
                        s = solidity cam f.z
                    in
                    if (f.lane == i || f.lane == neighbour i) && s > acc.t then
                        { t = s, tint = foeInk f.kind }

                    else
                        acc
                )
                { t = 0, tint = inkAt m i }
                m.foes


        -- Opacity alone was too polite for the job, and thickness alone is a
        -- blunt way to say it. So the wall takes on the COLOUR of what is
        -- behind it — the lane wears what is in it, which also tells you
        -- WHICH creature without you having to find it first — and gets
        -- heavier only in the last moment, when the thing is right on top of
        -- the rim and heavy is the correct amount of shouting.
        wall = \i p q ->
            let
                th = threat i
            in
            if th.t == 0 then
                seg p q 1 (inkAt m i) 30

            else
                -- A TINT, not a repaint: two fifths of the way to the
                -- creature's colour at the very most, and the wall never goes
                -- fully opaque. The web has to stay the web — if a lit lane
                -- reads as a different object then the shape you are meant to
                -- be learning comes apart every time something climbs it.
                seg p q
                    (if th.t > 85 then 2 else 1)
                    (mixInk (inkAt m i) th.tint (th.t * 40 // 100))
                    (30 + th.t * 50 // 100)

        walls =
            List.concat
                (List.indexedMap
                    (\i p ->
                        case List.head (List.drop i far) of
                            Just q -> wall i p q
                            Nothing -> []
                    )
                    near
                )
    in
    edges far 62 1 ++ walls ++ edges near 100 2


-- How solid a thing at depth z is: barely there at the far end, solid at your
-- feet. It is the cheapest depth cue there is and it does something size
-- alone cannot — with two enemies in the same lane, size tells you they are
-- at different depths but not by how much, while opacity reads as "this one
-- is the problem" at a glance.
--
-- The floor is 40 rather than 0 because an enemy you cannot see is not
-- atmosphere, it is an ambush. It has to be dim, not absent.
--
-- The fade lives entirely in the BACK HALF: anything nearer than `fadeFrom`
-- is fully solid. Ramping all the way to the rim looked reasonable and was
-- backwards — the perspective curve is nearly flat far away and steep close
-- up, so a fade anchored at the rim barely moved across the whole far half
-- and then did all its work in the last stretch, where the thing is already
-- big and obvious. The distinction worth drawing is between two SMALL shapes
-- at the far end, so that is where the whole 40-to-100 range now goes.
fadeFrom : Int
fadeFrom = 500


solidity : Cam -> Int -> Int
solidity cam z =
    let
        near = one * camD // (camD + fadeFrom)
        far = one * camD // (camD + zFar)
    in
    clamp 40 100 (40 + (depthK cam z - far) * 60 // max 1 (near - far))


-- The radius an enemy is drawn at, in WELL units, through both factors like
-- everything else. The explosion reads off this too, so the two can never
-- drift apart.
foeR : Int
foeR = 109


-- A flipper is two linked chevrons; a tanker is a squat diamond. Both are
-- outlines rather than fills, so a thing far down the well reads as the same
-- creature as one at your feet, only smaller.
--
-- They have to be told apart at a glance and at any size, which is why the
-- difference is SHAPE first and colour second: a chevron is pinched in the
-- middle and a diamond is not, and that survives being six pixels across.
foeShapes : Model -> Cam -> List Shape
foeShapes m cam =
    List.concatMap
        (\f ->
            let
                p = project cam (laneAt m.lanes f.lane).mid f.z
                -- In WELL units, through both factors, like everything else.
                -- Held in screen pixels it was one size on every screen, so
                -- the bigger the well got the smaller the enemy read against
                -- it — which is most of why one was hard to place in a lane.
                r = max 2 (foeR * depthK cam f.z // one * cam.scale // one)
                w = max 1 (r // 5)
                ink = foeInk f.kind

                -- A rim-walker whose stay is nearly up blinks out. Without the
                -- tell it just vanishes mid-chase, which reads as the game
                -- losing it rather than as the thing giving up.
                leaving = f.rim >= 0 && f.rim < 72 && modBy 12 f.rim < 6
                solid =
                    if leaving then
                        solidity cam f.z * 35 // 100

                    else
                        solidity cam f.z
                -- the chevron's far half was already dimmer to suggest the
                -- fold; that stays a RATIO so the fold survives the fade
                folded = solid * 60 // 100
            in
            case f.kind of
                Flipper ->
                    let
                        a = { x = p.x - r, y = p.y }
                        b = { x = p.x, y = p.y - r * 3 // 4 }
                        c = { x = p.x + r, y = p.y }
                        d = { x = p.x, y = p.y + r * 3 // 4 }
                    in
                    seg a b w ink solid ++ seg b c w ink solid
                        ++ seg c d w ink folded
                        ++ seg d a w ink folded

                Tanker ->
                    let
                        a = { x = p.x - r, y = p.y }
                        b = { x = p.x, y = p.y - r * 2 // 3 }
                        c = { x = p.x + r, y = p.y }
                        d = { x = p.x, y = p.y + r * 2 // 3 }
                    in
                    seg a b w ink solid ++ seg b c w ink solid
                        ++ seg c d w ink solid
                        ++ seg d a w ink solid
                        -- a bar across the waist: this is the one that is
                        -- carrying something
                        ++ seg { x = p.x - r // 2, y = p.y } { x = p.x + r // 2, y = p.y } w ink (solid * 70 // 100)
        )
        m.foes


shotShapes : Model -> Cam -> List Shape
shotShapes m cam =
    List.concatMap
        (\s ->
            let
                lane = laneAt m.lanes s.lane
                head = project cam lane.mid s.z
                tail = project cam lane.mid (min zFar (s.z + 60))
            in
            seg tail head 2 { r = 255, g = 255, b = 210 } 100
        )
        m.shots


-- The claw is built from its OWN lane and goes through the same projection as
-- the web, so it is always welded to the lane it occupies: it foreshortens
-- with the lane, leans with the camera, and cannot drift off the rim the way
-- a screen-space sprite would.
--
-- How FAR into the well it reaches is measured against the lane's WIDTH, not
-- against a depth in well units. That distinction is the whole of it. A fixed
-- depth makes the claw a fraction of the lane's LENGTH on screen, and lane
-- length swings wildly between shapes — short on a sixteen-lane ring, very
-- long on an open bowl whose far end is a small arc a long way off. The claw
-- came out compact on one web and stretched into a tall spindly thing on the
-- next, on a shape that had not changed. Measured against width it is about
-- as deep as it is wide wherever it stands, which is what a claw is.
clawShapes : Model -> Cam -> List Shape
clawShapes m cam =
    if m.phase == Over then
        []

    else
        let
            lane = laneAt m.lanes m.lane
            a = project cam lane.a 0
            b = project cam lane.b 0
            mid = project cam lane.mid 0
            deep = project cam lane.mid zFar

            -- how wide its lane is, on screen
            wx = b.x - a.x
            wy = b.y - a.y
            width = max 4 (isqrt (wx * wx + wy * wy))

            -- and which way "into the well" points from here, and how much of
            -- that run the claw is allowed to take
            dx = deep.x - mid.x
            dy = deep.y - mid.y
            run = max 1 (isqrt (dx * dx + dy * dy))

            -- A claw is SHALLOW. It hugs the rim; it does not reach into the
            -- well. Both terms of this min matter and they matter in
            -- different places: on a ring the lane is short and the run term
            -- wins, which is the proportion that looked right all along; on
            -- an open bowl the lane runs a long way to a small far arc and
            -- the run term explodes, so the width term takes over. Getting
            -- this wrong in either direction is loud — too deep and the claw
            -- is a wedge of pie, too shallow and you cannot see which lane
            -- you are in.
            depth = min (run * 26 // 100) (width * 60 // 100)

            into = \p amount -> { x = p.x + dx * amount // run, y = p.y + dy * amount // run }

            -- outer prongs pulled a little toward the middle, and a notch
            -- between them: the crab silhouette this genre has always used
            ain = into (lerpPt a mid (one // 4)) (depth * 80 // 100)
            bin = into (lerpPt b mid (one // 4)) (depth * 80 // 100)
            tip = into mid (depth * 30 // 100)

            stroke = clamp 2 3 (width // 40)
            ink = { r = 255, g = 240, b = 90 }
        in
        seg a ain stroke ink 100
            ++ seg b bin stroke ink 100
            ++ seg ain tip stroke ink 100
            ++ seg bin tip stroke ink 100
            -- a dim bar across the mouth, so the lane you occupy is legible
            -- even when the claw is edge-on at the far side of the ring
            ++ seg a b 2 ink 45


sparkShapes : Model -> Cam -> List Shape
sparkShapes m cam =
    List.concatMap
        (\s ->
            let
                p = project cam s.p s.z
                k = depthK cam s.z

                -- The burst grows in WELL units and then goes through BOTH
                -- factors the web goes through — perspective and `cam.scale`.
                -- It used to skip the scale, which made it a size in screen
                -- pixels: correct at one window size and wrong at every other.
                -- The well is drawn off the short side of the screen, so on a
                -- phone it shrinks by a third and an explosion that ignored
                -- the scale did not, and every kill bloomed a third too big.
                -- Same class of mistake as a claw measured in pixels.
                r = max 1 ((sparkR0 + s.t * sparkGrow) * k // one * cam.scale // one)
                a = max 0 (100 - s.t * 4)
            in
            [ circle p.x p.y r (rgba s.ink.r s.ink.g s.ink.b a)
            , circle p.x p.y (max 1 (r // 2)) (rgba 255 255 255 (max 0 (70 - s.t * 5)))
            ]
        )
        m.sparks


-- The touch controls, drawn only on a device with no pointer, from the very
-- rectangles `padKeys` tests against. A pad lights while a finger is on it,
-- because a control with no feedback is indistinguishable from a broken one.
-- The stick and the fire button. Neither is a box you have to hit — the zones
-- they answer for are much larger than the marks that stand for them — so
-- they are drawn small and dim on purpose. What you are looking at is the
-- well; these are the reminder of where your thumbs go, not the controls.
padShapes : Model -> List Shape
padShapes m =
    if not m.pads || m.phase == Title || m.phase == Over then
        []

    else
        let
            z = zonesOf m
            r = z.rail
            push = stickPush m
            held = m.stick /= Nothing

            -- The knob sits at the middle of the rail and moves by the
            -- DEFLECTION, not to where the thumb is: the thumb may be
            -- anywhere in the walking half, and the knob showing its offset
            -- rather than its position is what says "this is a stick".
            knobR = r.h * 3
            knobX = r.x + r.w // 2 + clamp (0 - r.w // 2) (r.w // 2) push
            knobY = r.y + r.h // 2

            firing = List.member Keyboard.Space m.touch
        in
        [ rect r.x r.y r.w r.h (rgba 150 170 220 (if held then 26 else 12))
        , circle knobX knobY knobR (rgba 215 230 255 (if held then 62 else 26))
        , circle z.fireX z.fireY z.fireR (rgba 255 240 90 (if firing then 42 else 14))
        , circle z.fireX z.fireY (z.fireR // 3) (rgba 255 240 90 (if firing then 92 else 34))
        ]


-- ============================================================ hud


hud : Model -> List Shape
hud m =
    if m.phase == Title then
        []

    else
        -- All three on the top line. The lives used to sit in the bottom-left
        -- corner, which on a phone is under the stick and under the thumb
        -- holding it — the one number you check when things are going badly,
        -- in the one place you cannot see.
        [ Canvas.text 16 28 18 Canvas.Left (rgb 210 220 255) (String.fromInt m.score)
        , Canvas.text 16 50 15 Canvas.Left (rgb 255 240 90)
            (String.repeat (max 0 m.lives) "/")
        , Canvas.text (m.w - 16) 28 18 Canvas.Right (rgb 210 220 255)
            ("LEVEL " ++ String.fromInt (m.level + 1))
        ]


titleShapes : Model -> Cam -> List Shape
titleShapes m cam =
    case m.phase of
        Title ->
            logoShapes m cam
                ++ (if m.phaseT < logoLands then
                        -- While the letters are still in the air the screen is
                        -- theirs. Captions sitting under a logo that has not
                        -- arrived are a screen that finished before it started.
                        []

                    else
                        [ Canvas.text (m.w // 2) (m.h // 6 + 82) 15 Canvas.Center (rgb 150 165 200)
                            (if m.pads then
                                "slide left to walk the rim - hold right to fire"

                             else
                                "arrows walk the rim - space fires"
                            )
                        , Canvas.text (m.w // 2) (m.h - 26) 17 Canvas.Center
                            (rgb 255 240 90)
                            (if modBy 66 m.frame < 44 then
                                (if m.pads then "tap to start" else "press any key")

                             else
                                ""
                            )
                        ]
                   )

        Over ->
            -- THE TEXT DOES NOT MOVE.
            --
            -- Third attempt at this screen, and the first two failed the same
            -- way: they were flourishes laid ON TOP of the scene. Draining the
            -- whole web to grey, backing the eye out, and then the verdict
            -- flying up the well out of the vanishing point. Each one read as
            -- a trick rather than an ending.
            --
            -- The scene already has something happening in it: the place going
            -- dark around the lane that got you. That is the animation. The
            -- text is a VERDICT, and a verdict does not need an entrance, it
            -- needs to be legible and to arrive at the right moment. So it
            -- holds still, at one size, in one place, and only fades up out of
            -- the backdrop so it does not slam on. Three beats in reading
            -- order, and nothing travels.
            let
                -- sized off the screen width, because at a fixed 36 this line
                -- ran edge to edge on a phone and looked like a mistake
                big = clamp 20 36 (m.w // 13)
                hx = m.w // 2
                hy = m.h // 2 - 10

                -- fading up FROM the backdrop rather than by alpha: one colour
                -- per shape is all a canvas text takes, and the backdrop is a
                -- flat known colour, so a mix is the same picture for less
                fade = \c k ->
                    let
                        d = mixInk { r = 4, g = 4, b = 10 } c (clamp 0 100 k)
                    in
                    rgb d.r d.g d.b

                lead = m.phaseT * 100 // overFade
                rest = (m.phaseT - overHold) * 100 // overFade
            in
            [ Canvas.text hx hy big Canvas.Center
                (fade { r = 255, g = 110, b = 110 } lead) "THE WELL KEEPS YOU"
            ]
                ++ (if rest <= 0 then
                        []

                    else
                        [ Canvas.text hx (hy + 40) 18 Canvas.Center
                            (fade { r = 210, g = 220, b = 255 } rest)
                            ("SCORE " ++ String.fromInt m.score)
                        , Canvas.text hx (hy + 62) 13 Canvas.Center
                            (fade { r = 150, g = 155, b = 175 } rest)
                            ("REACHED LEVEL " ++ String.fromInt (m.level + 1))
                        ]
                   )
                ++ (if rest < 100 then
                        []

                    else
                        [ Canvas.text hx (hy + 94) 15 Canvas.Center (rgb 255 240 90)
                            (if modBy 66 m.frame < 44 then
                                (if m.pads then "tap to play again" else "press any key")

                             else
                                ""
                            )
                        ]
                   )

        _ ->
            []


-- ============================================================ sound


-- THE LEVEL-CLEAR DIVE.
--
-- The warp runs `zFar + camD` at `warpSpeed`, which is 92 frames — a second
-- and a half. It used to get 300 milliseconds of sound: a beep that had
-- finished while you were still falling, and then silence for the rest of the
-- best-looking move in the game.
--
-- This one runs the whole way and is built like the thing it is scoring. Four
-- voices, each summing to the same 1500ms so nothing straggles: the tube as a
-- rush that keeps steepening, wind past the mouth of it, a figure climbing
-- out over the top, and a low note landing at the bottom.
--
-- Modifiers belong to a VOICE — `sequence` and `chord` are structure and
-- nothing else — so the volume and the shaping go on each tone rather than on
-- the list holding them.
-- TURNED DOWN, AND THE REASON IS THAT VOICES SUM. Each of the four here was
-- set at a level that sounds right on its own — 24, 12, 26, 30 — and a chord
-- plays them at once, so what arrives is closer to their total than to any one
-- of them, and the level change came out shouting next to a kill at 22. Every
-- voice came down by about the same fraction, which keeps the balance between
-- them and only moves the whole thing.
clearNote : Int -> Int -> Sound
clearNote hz ms =
    Sound.volume 16 (Sound.duty 25 (Sound.tone Sound.Square hz ms))


clearCue : Sound
clearCue =
    Sound.chord
        [ -- The tube. Flat for a beat, then a climb that keeps steepening,
          -- which is the curve the camera is riding: `holdPitch` is the
          -- moment before the floor drops out.
          Sound.volume 15
            (Sound.attack 40
                (Sound.lowCut 90
                    (Sound.holdPitch 240
                        (Sound.sweep 1500 (Sound.tone Sound.Sawtooth 140 1500)))))

        , -- Wind past the mouth of the well. Quiet on purpose — it is the
          -- texture that makes the sweep sound like travel and not like a
          -- test tone.
          Sound.volume 8
            (Sound.highCut 2400
                (Sound.sweep 2000 (Sound.tone Sound.Noise 260 1500)))

        , -- The fanfare: a major triad walking up two octaves and arriving on
          -- a held note that shimmers. It starts late, so the first thing you
          -- hear is the fall and the tune is what comes out of it.
          Sound.sequence
            [ Sound.rest 300
            , clearNote (Sound.e 4) 110
            , clearNote (Sound.gs 4) 110
            , clearNote (Sound.b 4) 110
            , clearNote (Sound.e 5) 110
            , clearNote (Sound.gs 5) 110
            , clearNote (Sound.b 5) 110
            , Sound.volume 17
                (Sound.arp [ Sound.gs 6, Sound.b 6 ]
                    (Sound.duty 25 (Sound.tone Sound.Square (Sound.e 6) 540)))
            ]

        , -- And a low note under the arrival, so the landing has a floor.
          Sound.sequence
            [ Sound.rest 1180
            , Sound.volume 19
                (Sound.release 200 (Sound.tone Sound.Triangle (Sound.e 3) 320))
            ]
        ]


-- How far away a kill was, 0 at your feet and 100 at the far end. Every part
-- of the kill sound reads off this one number.
farness : Int -> Int
farness z =
    clamp 0 100 (z * 100 // zFar)


-- The body of a kill: a burst, not a note. Noise instead of a square is the
-- whole difference between a pop and a beep, and the high cut takes off what
-- fizz is left. Mixed at 22 down to 14 so it sits above the shot (15) and well
-- under your own death (44): the reward should be louder than the action that
-- earns it and quieter than losing.
hitPop : Int -> Sound
hitPop f =
    Sound.volume (22 - f * 8 // 100)
        (Sound.attack 2
            (Sound.release 18
                (Sound.highCut 2600
                    (Sound.sweep (140 + f * 120 // 100)
                        (Sound.tone Sound.Noise (300 + f * 320 // 100) (80 - f * 35 // 100))))))


cue : Cue -> Sound
cue c =
    case c of
        CFire ->
            -- This one plays five times a second now that holding the button
            -- fires, so it is the sound you hear most and the one that had to
            -- stop asking for attention. Three things were making it nag:
            --
            --   * it swept UP, 880 to 1400. A rise reads as an alert — it is
            --     what a warning does — and a discharge should be leaving you,
            --     not arriving. Down is the whole difference.
            --   * a square at that pitch is all odd harmonics, which is the
            --     buzz. Triangle says the same thing without the fizz, and a
            --     high cut takes off what is left.
            --   * and it was mixed at 22, louder than it has any business
            --     being next to a hit at 30. The reward should be louder than
            --     the action that earns it.
            Sound.volume 15
                (Sound.attack 4
                    (Sound.release 30
                        (Sound.highCut 3200
                            (Sound.sweep 420 (Sound.tone Sound.Triangle 900 55)))))

        -- A KILL SOUNDS LIKE WHERE IT HAPPENED, AND LIKE WHAT DIED.
        --
        -- It used to be one sound, always: a square at 520 mixed at 30, which
        -- is louder than anything in the game except your own death, and all
        -- odd harmonics, the same buzz already taken off the shot. And being
        -- one sound is what made it repetitive. Not the timbre: the IDENTITY.
        -- `cue` is a pure function of the tag, so two kills a second apart were
        -- the same bytes.
        --
        -- The fix is not a die roll. The kill already knows the depth it
        -- happened at, so the variation comes from the world: something taken
        -- at the far end is a short high tick, quiet because it was far; the
        -- same thing at your feet is lower, longer and fuller. Two kills at
        -- different depths stop sounding alike, and the difference MEANS
        -- something, which a random detune never could.
        CHit Flipper z ->
            hitPop (farness z)

        -- The tanker gets the same pop with a second voice under it. Killing
        -- one is not the same event as killing a flipper: it splits, so the
        -- news is worse, and the ear should hear that before the eye finds the
        -- two halves.
        CHit Tanker z ->
            let
                f = farness z
            in
            Sound.chord
                [ hitPop f
                , Sound.volume (16 - f * 6 // 100)
                    (Sound.attack 3
                        (Sound.release 40
                            (Sound.lowCut 60
                                (Sound.sweep (70 + f * 40 // 100)
                                    (Sound.tone Sound.Triangle (150 + f * 90 // 100) (170 - f * 60 // 100))))))
                ]

        CDie ->
            Sound.volume 44 (Sound.sweep 60 (Sound.tone Sound.Noise 400 420))

        CClear ->
            clearCue


-- ============================================================ wiring


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.batch
        [ Time.every (Time.millis (1000 // fps)) (\_ -> Tick)
        , Keyboard.watch KeysChanged
        , Gamepad.watch PadChanged
        , Device.watch DeviceChanged
        ]


page : Page
page =
    Page.create
        { path = "/"
        , title = "Vortex"
        , init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }


main : Cmd ()
main =
    App.frontend [ page ]
