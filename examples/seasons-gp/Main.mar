module Main exposing (main)


-- SEASONS GP — a pseudo-3D endless racer in the tradition of early-80s
-- endurance racers, drawn somewhere between the NES and the SNES: gradient
-- skies, two parallax mountain ranges that reshuffle every year, snow-capped
-- peaks, roadside trees and bushes, shaded two-tone cars. Built with ZERO
-- language changes — a `Time.every` tick drives the sim, `Keyboard`/`Gamepad`
-- feed input, touch steers on mobile, and the whole scene is rects: the road
-- is 64 horizontal strips with true 1/z perspective (all Int fixed-point).
--
-- You race forever through repeating conditions, dodging slower traffic,
-- drifting outward in curves. Each SEASON is a timed stage: reach the
-- checkered flags before the clock runs out. Four seasons make a year —
-- SPRING (gentle), SUMMER (heavy traffic), AUTUMN (night: you only see
-- taillights), WINTER (snow: the wheel goes sluggish, the car gets away from
-- you) — then a new year starts, a bit harder: faster rivals, denser traffic,
-- sharper curves, a tighter clock. An F1-style gantry counts the race in:
-- three red lights, then lights out and away you go.
--
-- Controls: arrows/WASD steer, Space or Up = gas, Down = brake, M = mute.
--   Gamepad: stick or d-pad steers, A = gas, B = brake, Start = start.
--   Touch:   two-thumb pads (shown after your first touch) in the LETTERBOX
--            around the picture — drag STEER (left) to turn, hold GAS / BRAKE
--            (right). Steering is independent of the throttle, so you can turn
--            while coasting or braking. Tap top-right corner to mute.
--
-- Run: mar dev examples/seasons-gp


import Canvas exposing
    ( canvas, rect, group, rgb
    , onTap, watchSize, onDrag, onRelease
    )
import Time


-- ===== logical screen (scaled to fit the window, pixels stay chunky) =====


gameW : Int
gameW = 320


gameH : Int
gameH = 200


horizonY : Int
horizonY = 72


-- ===== road geometry (Int fixed-point) =====
-- The road is NSTRIPS horizontal strips, strip 0 nearest (bottom). A flat road
-- of constant world width projects to straight edges, so the strip's half-width
-- shrinks LINEARLY toward the horizon; the 1/z nonlinearity lives in each
-- strip's world distance zOf (used for stripe bands, sprites and the flags):
--   zOf i = zNear * NSTRIPS / (NSTRIPS - i)      (near 300 .. far 19200)


nstrips : Int
nstrips = 64


stripH : Int
stripH = 2


zNear : Int
zNear = 300


viewDist : Int
viewDist = 19200          -- zNear * nstrips


roadHalfW : Int
roadHalfW = 1000          -- world units; on screen the bottom strip is +-120px


halfWNearPx : Int
halfWNearPx = 120


-- ===== tuning =====


fps : Int
fps = 60


maxSpeed : Int
maxSpeed = 240            -- also the km/h shown on the HUD


-- Where the mountain parallax accumulator (mtnOff) wraps. NOT arbitrary: each
-- ridge shifts by mtnOff/divisor inside its own mod, so the wrap is invisible
-- only if the drop lands on a whole number of that ridge's periods. Far ridge =
-- mtnOff/2 in mod 520 -> needs multiples of 1040; peaks = mtnOff/4 in mod 560 ->
-- needs multiples of 2240; LCM(1040, 2240) = 29120 (29120/2 = 28*520, /4 = 13*560).
-- If you change a ridge's mod or divisor (see mountainShapes), recompute this.
mtnWrap : Int
mtnWrap = 29120


accel : Int
accel = 1                 -- speed gained per tick on the gas (gentle: ~4s to top)


coastDecel : Int
coastDecel = 1


brakeDecel : Int
brakeDecel = 4


crashSpeed : Int
crashSpeed = 24


grassEdge : Int
grassEdge = 850           -- world-x beyond which the car's outer edge is on grass


passPlane : Int
passPlane = 260           -- world-rel at which a rival draws level with the player


steerMax : Int
steerMax = 26             -- world units per tick at full lock


phaseLen : Int
phaseLen = 260000         -- world units per season (~45s flat out)


playerCarY : Int
playerCarY = 170          -- top of the player sprite (34x23)


countStart : Int
countStart = 240          -- start-light countdown, in ticks (4s)


-- ===== seasons =====
-- 0 SPRING, 1 SUMMER, 2 AUTUMN (night), 3 WINTER (snow/ice)


seasonCount : Int
seasonCount = 4


seasonName : Int -> String
seasonName ix =
    case ix of
        0 -> "SPRING"
        1 -> "SUMMER"
        2 -> "AUTUMN"
        _ -> "WINTER"


isNight : Int -> Bool
isNight ix =
    ix == 2


isIce : Int -> Bool
isIce ix =
    ix == 3


-- time budget per season, shrinking with the years (ms)
budgetMs : Int -> Int
budgetMs year =
    1000 * max 38 (54 - year * 2)


-- rival cruising speed: quick enough that overtakes stay readable, slow
-- enough that a car ahead leaves you time to pick a side
rivalBase : Int -> Int
rivalBase year =
    min 186 (126 + 8 * (year - 1))


-- average gap between spawned rivals (world units); summer is rush hour
spawnGapBase : Int -> Int -> Int
spawnGapBase year phaseIx =
    let
        base = max 4200 (9000 - 700 * (year - 1))
    in
    if phaseIx == 1 then base * 7 // 10 else base


-- how hard the road is allowed to bend, per year
curveMax : Int -> Int
curveMax year =
    min 99 (56 + 9 * year)


-- ===== palette (16-bit flavoured, one set per season) =====


bezel : Color
bezel = rgb 10 10 14


hudBg : Color
hudBg = rgb 12 12 16


hudWhite : Color
hudWhite = rgb 236 240 236


hudAmber : Color
hudAmber = rgb 244 196 72


hudRed : Color
hudRed = rgb 240 72 60


hudDim : Color
hudDim = rgb 130 136 142


barBg : Color
barBg = rgb 34 34 40


ink : Color
ink = rgb 16 16 20


tailRed : Color
tailRed = rgb 252 64 48


glassC : Color
glassC = rgb 30 34 44


wheelC : Color
wheelC = rgb 20 20 24


bodyWhite : Color
bodyWhite = rgb 236 240 244


bodyLower : Color
bodyLower = rgb 168 176 188


stripeBlue : Color
stripeBlue = rgb 48 96 232


dustBrown : Color
dustBrown = rgb 150 120 80


dustSnow : Color
dustSnow = rgb 244 248 252


gantryC : Color
gantryC = rgb 40 44 52


lightOff : Color
lightOff = rgb 70 22 22


lightOn : Color
lightOn = rgb 248 48 40


lightGo : Color
lightGo = rgb 48 220 72


snowCap : Color
snowCap = rgb 242 246 250


cabinLit : Color
cabinLit = rgb 252 220 120


-- Smooth sky gradient: each row's colour is a lerp from the season's top colour
-- down to its horizon haze, drawn as many overlapping 2px bands (gradientSky)
-- so there are no hard steps. skyColorAt gives the sky colour at a logical y.
skyColorAt : Int -> Int -> Color
skyColorAt ix y =
    let
        yy = iclamp 0 horizonY y
        mix = \a b -> a + (b - a) * yy // horizonY
    in
    case ix of
        0 -> rgb (mix 96 200) (mix 152 234) (mix 236 250)
        1 -> rgb (mix 30 200) (mix 96 214) (mix 224 252)
        2 -> rgb (mix 6 48) (mix 6 32) (mix 22 78)
        _ -> rgb (mix 128 224) (mix 152 234) (mix 182 242)


grassAOf : Int -> Color
grassAOf ix =
    case ix of
        0 -> rgb 84 160 56
        1 -> rgb 172 152 66
        2 -> rgb 26 36 24
        _ -> rgb 220 228 234


roadAOf : Int -> Color
roadAOf ix =
    case ix of
        0 -> rgb 108 108 116
        1 -> rgb 122 118 112
        2 -> rgb 48 48 62
        _ -> rgb 142 148 158


rumbleAOf : Int -> Color
rumbleAOf ix =
    case ix of
        2 -> rgb 132 44 40
        _ -> rgb 216 60 52


rumbleBOf : Int -> Color
rumbleBOf ix =
    case ix of
        2 -> rgb 148 148 150
        _ -> rgb 236 236 228


dashOf : Int -> Color
dashOf ix =
    case ix of
        2 -> rgb 150 150 160
        _ -> rgb 228 228 220


-- the two mountain layers, per season
farOf : Int -> Color
farOf ix =
    case ix of
        0 -> rgb 96 156 122
        1 -> rgb 172 140 92
        2 -> rgb 16 16 38
        _ -> rgb 178 194 208


mtnOf : Int -> Color
mtnOf ix =
    case ix of
        0 -> rgb 58 118 90
        1 -> rgb 138 106 66
        2 -> rgb 24 26 48
        _ -> rgb 152 168 186


sunOf : Int -> Color
sunOf ix =
    case ix of
        0 -> rgb 252 224 96
        1 -> rgb 252 208 64
        2 -> rgb 216 220 232
        _ -> rgb 240 240 224


cloudC : Color
cloudC = rgb 244 248 252


-- headlight-lit road (autumn night only): a touch lighter than the night road
litA : Color
litA = rgb 78 78 96


litB : Color
litB = rgb 70 70 86


-- rival car bodies: 3 kinds (body / shaded lower / roof highlight)
kindBody : Int -> Color
kindBody k =
    case k of
        0 -> rgb 200 56 48
        1 -> rgb 56 160 168
        _ -> rgb 224 168 48


kindDark : Int -> Color
kindDark k =
    case k of
        0 -> rgb 120 24 20
        1 -> rgb 24 96 104
        _ -> rgb 150 104 24


kindLite : Int -> Color
kindLite k =
    case k of
        0 -> rgb 236 104 92
        1 -> rgb 108 200 208
        _ -> rgb 248 208 104


-- roadside scenery colours
trunkC : Color
trunkC = rgb 96 64 40


leafOf : Int -> Color
leafOf ix =
    case ix of
        0 -> rgb 56 148 60
        1 -> rgb 120 136 52
        2 -> rgb 20 30 20
        _ -> rgb 236 242 246


-- ===== model =====


type Mode
    = Title
    | Race
    | Over


type Cue
    = CueLight
    | CueGo
    | CueCrash
    | CueSkid
    | CueWhoosh
    | CueScreech
    | CueCheck
    | CueYear
    | CueBeep
    | CueOver


type alias Rival =
    { z : Int                -- absolute world z
    , x : Int                -- lane offset, world units (-720..720)
    , spd : Int              -- world units per tick (x2 scale, see step)
    , kind : Int             -- 0..2 body colour
    , counted : Bool         -- already counted as passed
    }


type alias Model =
    { w : Int
    , h : Int
    , mode : Mode
    , tick : Int
    , seed : Random.Seed
    , year : Int
    , phaseIx : Int
    , camZ : Int
    , phaseStartZ : Int
    , timeLeft : Int         -- ms
    , countT : Int           -- start-light countdown ticks (0 = racing)
    , rev : Int              -- neutral rev on the grid (0..100), follows the throttle blip
    , goT : Int              -- ticks the green "GO" lights stay lit after the start
    , speed : Int
    , playerX : Int          -- world units
    , playerVx : Int
    , leftK : Bool
    , rightK : Bool
    , gasK : Bool
    , brakeK : Bool
    , keysDown : List Keyboard.Key   -- whole held set (Keyboard.watch); diffed for press edges
    , padLeft : Bool
    , padRight : Bool
    , padGas : Bool
    , padBrake : Bool
    , padX : Int             -- analog stick -100..100
    , padDown : List Gamepad.Button  -- whole held set (Gamepad.watch); diffed for press edges
    , touching : Bool        -- a finger is on the steer pad
    , touchX : Int           -- world-space steer target while touching
    , tGas : Bool            -- touch: gas pedal held
    , tBrake : Bool          -- touch: brake pedal held
    , dev : Maybe Device     -- live device capabilities (Device.watch); pads show on touch-only hardware
    , curve : Int            -- current bend (-99..99)
    , curveTarget : Int
    , nextCurveAt : Int      -- camZ at which to roll a new bend
    , nextSpawnAt : Int
    , rivals : List Rival
    , passed : Int
    , crashT : Int           -- ticks of post-crash flash / immunity
    , slipT : Int            -- grip-slip timer: rises while fast in a sharp curve
    , mtnOff : Int           -- mountain parallax offset (px, wraps)
    , bannerT : Int
    , bannerTop : String
    , bannerBot : String
    , lastWarnSec : Int
    , muted : Bool
    , sfx : List Cue
    }


freshModel : Model
freshModel =
    { w = 800
    , h = 500
    , mode = Title
    , tick = 0
    , seed = Random.initialSeed 20261
    , year = 1
    , phaseIx = 0
    , camZ = 0
    , phaseStartZ = 0
    , timeLeft = 0
    , countT = 0
    , rev = 0
    , goT = 0
    , speed = 0
    , playerX = 0
    , playerVx = 0
    , leftK = False
    , rightK = False
    , gasK = False
    , brakeK = False
    , keysDown = []
    , padLeft = False
    , padRight = False
    , padGas = False
    , padBrake = False
    , padX = 0
    , padDown = []
    , touching = False
    , touchX = 0
    , tGas = False
    , tBrake = False
    , dev = Nothing
    , curve = 14
    , curveTarget = 14
    , nextCurveAt = 4000
    , nextSpawnAt = 6000
    , rivals = []
    , passed = 0
    , crashT = 0
    , slipT = 0
    , mtnOff = 0
    , bannerT = 0
    , bannerTop = ""
    , bannerBot = ""
    , lastWarnSec = 99
    , muted = False
    , sfx = []
    }


init : (Model, Cmd Msg)
init =
    ( freshModel, Cmd.none )


-- ===== tiny basics (Mar ships no min/max/abs/mod) =====


absI : Int -> Int
absI n =
    if n < 0 then 0 - n else n




iclamp : Int -> Int -> Int -> Int
iclamp lo hi v =
    if v < lo then lo else if v > hi then hi else v


mod2 : Int -> Int
mod2 n =
    n - (n // 2) * 2



range : Int -> List Int
range n =
    List.indexedMap (\i _ -> i) (List.repeat n 0)


-- Threads a Random.Seed through the sim so curves and traffic are random but
-- the model stays a plain record (time travel still works). A thin adapter over
-- the stdlib: value first out of Random.step, seed flipped to the front so the
-- (seed, value) call sites below stay exactly as they were.
rnd : Random.Seed -> Int -> (Random.Seed, Int)
rnd seed n =
    let
        (v, s2) = Random.step (Random.int 0 (max 1 n - 1)) seed
    in
    ( s2, v )


-- a rect clipped to the logical screen: the scaled canvas group does not clip,
-- so anything that can wander past the edge (mountains, clouds, scenery,
-- flags) goes through here instead of spilling onto the bezel.
clampRX : Int -> Int -> Int -> Int -> Color -> List Shape
clampRX x y w h color =
    let
        x1 = max 0 x
        x2 = min gameW (x + w)
    in
    if x2 > x1 then [ rect x1 y (x2 - x1) h color ] else []


-- ===== update =====


type Msg
    = Resized Int Int
    | Tick
    | Tapped Int Int
    | Dragged Int Int
    | Released Int Int
    | KeysChanged { down : List Keyboard.Key }
    | PadChanged { connected : Bool, leftX : Int, leftY : Int, rightX : Int, rightY : Int, down : List Gamepad.Button }
    | DeviceChanged Device


update : Msg -> Model -> (Model, Cmd Msg)
update msg model =
    case msg of
        Resized w h ->
            ( { model | w = w, h = h }, Cmd.none )

        Tick ->
            case model.mode of
                Race -> emit (stepRace model)
                Title -> ( { model | tick = model.tick + 1, camZ = model.camZ + 36 }, Cmd.none )
                Over -> ( { model | tick = model.tick + 1 }, Cmd.none )

        Tapped x y ->
            if inMuteZone model x y then
                toggleMute model
            else
                case model.mode of
                    Race -> ( applyTouch model x y, Cmd.none )
                    -- The pads are gated on Device.touchOnly (see
                    -- touchControlsShapes), so on a phone they're already on
                    -- screen the moment the race begins — no provisional flag,
                    -- and a desktop mouse click never summons them.
                    _ -> emit (startRace model)

        Dragged x y ->
            if model.mode == Race then
                ( applyTouch model x y, Cmd.none )
            else
                ( model, Cmd.none )

        Released x y ->
            ( releaseTouch model x y, Cmd.none )

        KeysChanged st ->
            let
                held = \k -> List.member k st.down
                pressed = \k -> held k && (List.member k model.keysDown == False)
                -- steering / throttle are HELD state: rebuild the bools from the
                -- whole set on every change (a key leaving the set releases it, so
                -- KeyUp is gone). keysDown is stored to diff for the press edges.
                m1 =
                    { model
                        | keysDown = st.down
                        , leftK = held Keyboard.ArrowLeft || held Keyboard.KeyA
                        , rightK = held Keyboard.ArrowRight || held Keyboard.KeyD
                        , gasK = held Keyboard.ArrowUp || held Keyboard.KeyW || held Keyboard.Space
                        , brakeK = held Keyboard.ArrowDown || held Keyboard.KeyS
                    }
                -- M mutes on the press edge, any mode (never re-fires while held)
                (m2, muteCmd) =
                    if pressed Keyboard.KeyM then toggleMute m1 else ( m1, Cmd.none )
                -- Enter / Space start the race on the press edge, off the track
                (m3, startCmd) =
                    if m2.mode /= Race && (pressed Keyboard.Enter || pressed Keyboard.Space) then
                        emit (startRace m2)
                    else
                        ( m2, Cmd.none )
            in
            ( m3, Cmd.batch [ muteCmd, startCmd ] )

        PadChanged p ->
            let
                held = \b -> List.member b p.down
                pressed = \b -> held b && (List.member b model.padDown == False)
                -- d-pad + face buttons are HELD state; the left stick X is the
                -- analog steer (-100..100, same deadzone read downstream).
                m1 =
                    { model
                        | padDown = p.down
                        , padX = p.leftX
                        , padLeft = held Gamepad.Left
                        , padRight = held Gamepad.Right
                        , padGas = held Gamepad.A || held Gamepad.X
                        , padBrake = held Gamepad.B
                    }
            in
            -- Start / A launch the race on the press edge, off the track
            if m1.mode /= Race && (pressed Gamepad.Start || pressed Gamepad.A) then
                emit (startRace m1)
            else
                ( m1, Cmd.none )

        DeviceChanged d ->
            ( { model | dev = Just d }, Cmd.none )


-- --- touch controls: analog STEER pad (left) + GAS / BRAKE pedals (right) ---
-- The runtime gives us one (x,y) stream per finger but no pointer id, so we route
-- each touch by WHERE it lands: a press/drag in a pad sets that control. Two
-- thumbs work because they sit in different zones. A release clears whichever
-- HALF of the screen it lifted from (each thumb owns a half → unambiguous in
-- practice). Steering is DECOUPLED from the throttle — you can turn while
-- coasting or braking.
--
-- The pads live in SCREEN space, in the LETTERBOX around the picture — never
-- on top of the game. Wide side bezels (landscape phone) put the steer pad in
-- the left bezel and the pedals in the right one; a tall bottom bezel
-- (portrait) puts a control row under the picture; only when the window has
-- no spare room (small desktop window) do compact pads fall back onto the
-- picture's lower corners.


type alias PRect =
    { x : Int, y : Int, w : Int, h : Int }


inR : Int -> Int -> PRect -> Bool
inR px py r =
    px >= r.x && px <= r.x + r.w && py >= r.y && py <= r.y + r.h


padRects : Model -> { steer : PRect, gas : PRect, brake : PRect }
padRects m =
    let
        lay = layout m
        gh = gameH * lay.scale // 100
        sideW = lay.ox
        botH = m.h - (lay.oy + gh)
        botY = lay.oy + gh
    in
    if sideW >= 100 then
        -- landscape: the lower part of each side bezel. Gas sits at the
        -- bottom (where the right thumb rests), brake right above it.
        -- A 28px OUTER margin keeps both pads off the phone's very edge
        -- (holding the rim is awkward); the inner edges stay where they were.
        let
            pw = sideW - 40
            py = max (lay.oy + gh // 2) (m.h - 280)
            ph = m.h - py - 16
        in
        { steer = { x = 28, y = py, w = pw, h = ph }
        , gas = { x = m.w - sideW + 12, y = py + ph // 2 + 6, w = pw, h = ph // 2 - 6 }
        , brake = { x = m.w - sideW + 12, y = py, w = pw, h = ph // 2 - 12 }
        }
    else if botH >= 100 then
        -- portrait: a control row anchored to the BOTTOM of the screen (where
        -- the thumbs rest), under the raised picture — steer on the left,
        -- brake then gas on the right. Sizes are CAPPED in absolute pixels
        -- (a tablet's huge bottom bezel must not inflate the pedals into
        -- billboards); pedals anchor to the right EDGE so thumbs always
        -- find them regardless of screen width.
        let
            ph = min 150 (botH - 24)
            py = m.h - ph - 12
            half = m.w // 2
            sw = min 340 (half - 40)
            pw = min 165 (half // 2 - 20)
        in
        { steer = { x = 28, y = py, w = sw, h = ph }
        , gas = { x = m.w - 28 - pw, y = py, w = pw, h = ph }
        , brake = { x = m.w - 28 - pw - 10 - pw, y = py, w = pw, h = ph }
        }
    else
        -- no bezel worth using (tablet landscape: the picture fills the
        -- screen). Compact FIXED-SIZE pads overlaid on the picture's bottom
        -- corners, in screen coordinates — never scaled by the stage (a 3.7x
        -- iPad scale once inflated these into half-screen slabs).
        let
            ph = 92
            py = m.h - ph - 16
            sw = min 300 (m.w * 30 // 100)
            pw = 96
        in
        { steer = { x = 16, y = py, w = sw, h = ph }
        , gas = { x = m.w - 16 - pw, y = py, w = pw, h = ph }
        , brake = { x = m.w - 16 - pw - 8 - pw, y = py, w = pw, h = ph }
        }


-- pad x -> world steer target: pad centre = straight, edges = full lock
steerFromPad : Int -> PRect -> Int
steerFromPad x r =
    iclamp (0 - 1200) 1200 ((x - r.x - r.w // 2) * 2400 // max 1 r.w)


applyTouch : Model -> Int -> Int -> Model
applyTouch model x y =
    let
        r = padRects model
    in
    if inR x y r.steer then
        { model | touching = True, touchX = steerFromPad x r.steer }
    else if inR x y r.gas then
        { model | tGas = True, tBrake = False }
    else if inR x y r.brake then
        { model | tBrake = True, tGas = False }
    else
        model


releaseTouch : Model -> Int -> Int -> Model
releaseTouch model x y =
    if x < model.w // 2 then
        { model | touching = False }
    else
        { model | tGas = False, tBrake = False }


inMuteZone : Model -> Int -> Int -> Bool
inMuteZone model x y =
    let
        lay = layout model
        lx = (x - lay.ox) * 100 // max 1 lay.scale
        ly = (y - lay.oy) * 100 // max 1 lay.scale
    in
    lx > 292 && ly < 20


toggleMute : Model -> (Model, Cmd Msg)
toggleMute model =
    let
        m2 = model.muted == False
    in
    ( { model | muted = m2 }, Sound.setMuted m2 )


startRace : Model -> Model
startRace model =
    { model
        | mode = Race
        , year = 1
        , phaseIx = 0
        , camZ = 0
        , phaseStartZ = 0
        , timeLeft = budgetMs 1
        , countT = countStart
        , rev = 0
        , speed = 0
        , playerX = 0
        , playerVx = 0
        , touching = False
        , tGas = False
        , tBrake = False
        , curve = 0
        , curveTarget = 0
        , nextCurveAt = 3000
        , nextSpawnAt = 5000
        , rivals = []
        , passed = 0
        , crashT = 0
        , slipT = 0
        , mtnOff = 0
        , bannerT = 100
        , bannerTop = "SPRING"
        , bannerBot = "YEAR 1"
        , lastWarnSec = 99
        , seed = Random.initialSeed (model.tick * 7919 + 13)
        , sfx = []
    }


-- drain queued cues into play commands (sounds never live in the model, so the
-- dev-dock time travel keeps working)
emit : Model -> (Model, Cmd Msg)
emit model =
    if List.length model.sfx == 0 then
        ( model, Cmd.none )
    else
        ( { model | sfx = [] }
        , Cmd.batch (List.map (\c -> Sound.play (cueSound c)) model.sfx)
        )


-- ===== the race tick =====


stepRace : Model -> Model
stepRace model =
    if model.countT > 0 then
        stepCountdown model
    else
        model
            |> stepSpeed
            |> stepSteer
            |> stepWorld
            |> stepCurve
            |> stepGrip
            |> stepRivals
            |> stepCollide
            |> stepCheckpoint
            |> stepClock


-- the start gantry: three red lights come on one second apart, then lights
-- out — GO. The car is held on the grid (engine idling) and the clock waits.
stepCountdown : Model -> Model
stepCountdown m =
    let
        c2 = m.countT - 1
        cues =
            if c2 == 180 || c2 == 120 || c2 == 60 then
                CueLight :: m.sfx
            else if c2 == 0 then
                CueGo :: m.sfx
            else
                m.sfx
    in
    { m
        | countT = c2
        , tick = m.tick + 1
        , goT = if c2 == 0 then 55 else m.goT
        , rev = if gasHeld m then min 100 (m.rev + 6) else max 0 (m.rev - 5)
        , bannerT = max 0 (m.bannerT - 1)
        , sfx = cues
    }


gasHeld : Model -> Bool
gasHeld m =
    m.gasK || m.padGas || m.tGas


brakeHeld : Model -> Bool
brakeHeld m =
    m.brakeK || m.padBrake || m.tBrake


stepSpeed : Model -> Model
stepSpeed m =
    let
        -- how far the car's outer edge has crossed onto the grass (0 = fully on
        -- the road). The drag grows with it, so clipping the verge with a wheel
        -- costs a little and burying the car in the grass costs a lot.
        offEdge = absI m.playerX - grassEdge
        onGrass = offEdge > 0
        s1 =
            if brakeHeld m then
                max 0 (m.speed - brakeDecel)
            else if gasHeld m then
                min maxSpeed (m.speed + accel)
            else
                max 0 (m.speed - coastDecel)
        drag = min 8 (2 + offEdge // 60)
        s2 =
            if m.crashT > 40 then crashSpeed
            else if onGrass && s1 > 65 then max 65 (s1 - drag)
            else s1
        skid =
            onGrass && s2 > 55 && mod2 (m.tick // 4) == 0
    in
    { m
        | speed = s2
        , sfx = if skid then CueSkid :: m.sfx else m.sfx
    }


-- steering: keys/d-pad are full lock, the stick is analog, touch chases the
-- finger. The curve throws the car toward the outside (drift) - hard enough that
-- a bend needs real counter-steer, unlike a straight. In WINTER the wheel answers
-- more slowly (ice), so you have to turn in earlier - but the curve does NOT
-- throw any harder than dry (that combo was brutal). Losing grip (smoke) commits
-- the car to the corner: steering to the opposite side barely bites and it washes
-- further out.
stepSteer : Model -> Model
stepSteer m =
    let
        keyDir =
            (if m.leftK || m.padLeft then 0 - 1 else 0)
                + (if m.rightK || m.padRight then 1 else 0)
        stickV =
            if absI m.padX > 24 then m.padX * steerMax // 100 else 0
        target0 =
            if m.touching then
                iclamp (0 - steerMax) steerMax ((m.touchX - m.playerX) // 8)
            else if keyDir /= 0 then
                keyDir * steerMax
            else
                stickV
        sliding = m.slipT > 26
        -- under slip, steering AGAINST the bend (target and curve opposite signs)
        -- loses most of its authority - you can't just flick out of the slide
        target =
            if sliding && target0 * m.curve < 0 then target0 * 2 // 5 else target0
        ease = if isIce m.phaseIx then 9 else 3
        vx = m.playerVx + (target - m.playerVx) // ease
        -- steering authority follows speed: ZERO when stopped (you can't turn a
        -- parked car), rising fast then saturating near 94 at top speed. It's
        -- hyperbolic, not linear — low speeds already steer well, but there's
        -- always some influence and no motion means no turn.
        eff = 118 * m.speed // (m.speed + 60)
        -- smaller divisor = the curve flings harder; a slide (smoke) drops grip
        -- another notch so it washes toward the outside. NOT stronger in winter —
        -- the ice penalty is the laggy wheel (ease) alone; doubling both was brutal
        fling = 5 - (if sliding then 1 else 0)
        drift = (0 - m.curve) * m.speed // (fling * 180)
        px = iclamp (0 - 1350) 1350 (m.playerX + vx * eff // 100 + drift)
    in
    { m | playerVx = vx, playerX = px }


stepWorld : Model -> Model
stepWorld m =
    let
        dz = m.speed // 2
    in
    { m
        | tick = m.tick + 1
        , camZ = m.camZ + dz
        , mtnOff = modBy mtnWrap (m.mtnOff + m.curve * dz // 900 + mtnWrap)
        , crashT = max 0 (m.crashT - 1)
        , bannerT = max 0 (m.bannerT - 1)
        , goT = max 0 (m.goT - 1)
    }


stepCurve : Model -> Model
stepCurve m =
    let
        -- the road bends toward its target 2 units/tick — fast enough that even a
        -- tight target is reached before the segment ends (so sharp curves bite)
        c =
            if m.curve < m.curveTarget then min m.curveTarget (m.curve + 2)
            else if m.curve > m.curveTarget then max m.curveTarget (m.curve - 2)
            else m.curve
    in
    if m.camZ >= m.nextCurveAt then
        let
            (s2, roll) = rnd m.seed 100
            (s3, mag) = rnd s2 (curveMax m.year)
            (s4, sharpRoll) = rnd s3 100
            (s5, len) = rnd s4 9000
            -- ~18% of turns are TIGHT (target near the ±99 clamp); the rest gentle
            sharp = sharpRoll >= 82
            baseMag = if sharp then 74 + mag // 3 else 24 + mag // 2
            tgt =
                if roll < 34 then 0
                else if roll < 67 then 0 - baseMag
                else baseMag
        in
        { m | curve = c, curveTarget = iclamp (0 - 99) 99 tgt, nextCurveAt = m.camZ + 5000 + len, seed = s5 }
    else
        { m | curve = c }


-- Grip: hold a sharp curve at high speed and the tyres start to slide — the slip
-- timer ramps up; past a threshold it squeals (CueScreech) and puffs smoke (see
-- smokeShapes). While the tyres are scrubbing it also bleeds a little speed each
-- tick, which eases you back under the slide threshold (self-correcting) so you
-- can't just hold the throttle through it. It decays fast once you straighten out.
stepGrip : Model -> Model
stepGrip m =
    let
        sliding = absI m.curve > 52 && m.speed > 165
        slipT2 = if sliding then min 100 (m.slipT + 3) else max 0 (m.slipT - 5)
        screeching = slipT2 > 26
        screech = screeching && modBy 14 m.tick == 0
        speed2 = if screeching then max 0 (m.speed - (1 + slipT2 // 100)) else m.speed
    in
    { m
        | slipT = slipT2
        , speed = speed2
        , sfx = if screech then CueScreech :: m.sfx else m.sfx
    }


stepRivals : Model -> Model
stepRivals m =
    let
        moved =
            List.map
                (\r ->
                    let
                        rel = r.z - m.camZ
                        close = m.speed - r.spd
                        -- ease the final APPROACH only. Closing z is constant, but the
                        -- 1/z projection makes a near rival ahead BALLOON — so while
                        -- you're gaining (close > 0) and the rival is still AHEAD of the
                        -- pass line, damp the closing (down to ~45% right at the pass) so
                        -- it glides in instead of rushing. The moment it's level or behind
                        -- (rel <= passPlane) it drops back at its natural speed: without
                        -- the rel > passPlane guard a rival you just overtook recedes at
                        -- <half speed, so it clings to your tail and clips you from
                        -- behind. Far rivals keep full speed; smooth at the edge.
                        near = iclamp 0 100 ((rel - passPlane) * 100 // 940)
                        damp = 45 + near * 55 // 100
                        rivDz =
                            if close > 0 && rel > passPlane && rel < passPlane + 940 then
                                m.speed // 2 - close * damp // 200
                            else
                                r.spd // 2
                    in
                    { r | z = r.z + rivDz }
                )
                m.rivals
        kept =
            List.filter (\r -> r.z > m.camZ - 2600 && r.z < m.camZ + viewDist + 4000) moved
        -- count the CROSSINGS this tick, at the PLAYER's plane (camZ+passPlane),
        -- not the camera, so the pass registers the instant a rival draws level
        -- with you — the whoosh fires right then. (Culling must never un-count a
        -- pass; a crash can still let a rival repass, which counts back down.)
        line = m.camZ + passPlane
        crossedFwd =
            List.length (List.filter (\r -> r.counted == False && r.z < line) kept)
        crossedBack =
            List.length (List.filter (\r -> r.counted && r.z > line) kept)
        counted =
            List.map
                (\r ->
                    if r.counted == False && r.z < line then { r | counted = True }
                    else if r.counted && r.z > line then { r | counted = False }
                    else r
                )
                kept
        delta = crossedFwd - crossedBack
        -- passing a car at speed earns a doppler whoosh
        sfx2 = if crossedFwd > 0 && m.speed > 150 then CueWhoosh :: m.sfx else m.sfx
    in
    if m.camZ >= m.nextSpawnAt && List.length counted < 8 then
        let
            (s2, laneIx) = rnd m.seed 5
            (s3, jitter) = rnd s2 240
            (s4, dspd) = rnd s3 34
            (s5, kind) = rnd s4 3
            (s6, gap) = rnd s5 900
            lane = (laneIx - 2) * 350 + jitter - 120
            -- never stack a fresh rival beside one still near the spawn
            -- horizon: two abreast at speed would be an unavoidable wall
            nearSpawn =
                List.head (List.filter (\r -> r.z > m.camZ + viewDist - 3200) counted)
            lane2 =
                case nearSpawn of
                    Nothing -> lane
                    Just r ->
                        if r.x > 0 then 0 - (300 + jitter) else 300 + jitter
            rival =
                { z = m.camZ + viewDist
                , x = iclamp (0 - 720) 720 lane2
                , spd = rivalBase m.year + dspd + (if isNight m.phaseIx then 10 else 0)
                , kind = kind
                , counted = False
                }
        in
        { m
            | rivals = rival :: counted
            , passed = max 0 (m.passed + delta)
            , nextSpawnAt = m.camZ + spawnGapBase m.year m.phaseIx + gap
            , seed = s6
            , sfx = sfx2
        }
    else
        { m | rivals = counted, passed = max 0 (m.passed + delta), sfx = sfx2 }


-- a rival crossing our nose while overlapping our lane = crash: the speed dies
-- (no lives, just lost seconds), the rival is shoved ahead, the car flashes
-- for a moment (colour only — the screen never shakes) and you are briefly
-- immune.
stepCollide : Model -> Model
stepCollide m =
    if m.crashT > 0 then
        m
    else
        let
            hit =
                List.filter
                    (\r ->
                        r.z - m.camZ > 60 && r.z - m.camZ < 400
                            && absI (r.x - m.playerX) < 320
                    )
                    m.rivals
        in
        case List.head hit of
            Nothing ->
                m

            Just r ->
                -- both cars lose speed and the one you hit is nudged just a
                -- little ahead (a bump, not flung away) and slowed to a crawl,
                -- so it stays in view while you recover and re-pass it.
                { m
                    | speed = crashSpeed
                    , crashT = 50
                    , rivals =
                        List.map
                            (\q ->
                                if q.z == r.z && q.x == r.x then
                                    { q | z = q.z + 180, spd = min q.spd 48 }
                                else
                                    q
                            )
                            m.rivals
                    , sfx = CueCrash :: m.sfx
                }


stepCheckpoint : Model -> Model
stepCheckpoint m =
    if m.camZ - m.phaseStartZ >= phaseLen then
        let
            nextIx = modBy seasonCount (m.phaseIx + 1)
            wrapped = nextIx == 0
            year2 = if wrapped then m.year + 1 else m.year
        in
        { m
            | phaseIx = nextIx
            , year = year2
            , phaseStartZ = m.camZ
            , timeLeft = budgetMs year2
            , bannerT = 120
            , bannerTop = if wrapped then "YEAR " ++ String.fromInt year2 else "CHECKPOINT!"
            , bannerBot = seasonName nextIx
            , lastWarnSec = 99
            , sfx = (if wrapped then CueYear else CueCheck) :: m.sfx
        }
    else
        m


stepClock : Model -> Model
stepClock m =
    let
        t2 = m.timeLeft - (1000 // fps)
        sec = (t2 + 999) // 1000
    in
    if t2 <= 0 then
        { m | timeLeft = 0, mode = Over, sfx = CueOver :: m.sfx }
    else if sec <= 10 && sec < m.lastWarnSec then
        { m | timeLeft = t2, lastWarnSec = sec, sfx = CueBeep :: m.sfx }
    else
        { m | timeLeft = t2 }


-- ===== sound =====
-- The engine is a Sub: a Sound.hold — ONE continuously-held triangle
-- oscillator that the sound runtime retunes in place (Sound.hold keys ignore
-- freq, so a new pitch each frame glides the same node — see soundBedSet), a
-- smooth rev with no clicks/crossfade. The pitch simulates a 2-SPEED GEARBOX:
-- within each gear the "rpm" climbs, then at the single shift it dips and climbs
-- again — and because the runtime glides the transition, it sounds like a quick
-- downshift rather than a step. The gear floor creeps up so 2nd sits higher.
-- Volume tracks speed (kept fairly low). Mute via Sound.setMuted.
engineSound : Int -> Sound
engineSound speed =
    let
        gears = 2
        gw = maxSpeed // gears                    -- speed band per gear (120)
        gear = min (gears - 1) (speed // gw)     -- current gear, 0..1
        within = speed - gear * gw               -- position inside the gear
        hz = 60 + gear * 45 + within * 3 // 5     -- climbs within a gear, small dip at the one shift
    in
    Sound.volume (9 + speed // 20) (Sound.tone Sound.Triangle hz 400)


-- What the engine bed should sound like right now. On the grid (countT > 0) the
-- car is in neutral: the pitch and volume follow the throttle blip (rev) with no
-- gears and no motion. Once the lights go out it's the gearbox tracking speed.
-- Both are a single triangle voice, so the runtime glides seamlessly from the
-- last rev pitch into the launch — no restart, no click.
engineNote : Model -> Sound
engineNote m =
    if m.countT > 0 then
        Sound.volume (9 + m.rev // 7) (Sound.tone Sound.Triangle (60 + m.rev * 3 // 2) 400)
    else
        engineSound m.speed


cueSound : Cue -> Sound
cueSound cue =
    case cue of
        CueLight ->
            Sound.volume 50 (Sound.duty 50 (Sound.tone Sound.Square (Sound.a 4) 120))

        CueGo ->
            Sound.volume 55 (Sound.duty 50 (Sound.tone Sound.Square (Sound.a 5) 340))

        CueCrash ->
            Sound.chord
                [ Sound.volume 85 (Sound.tone Sound.Noise 0 300)
                , Sound.volume 60 (Sound.sweep 50 (Sound.tone Sound.Sawtooth 320 260))
                ]

        CueSkid ->
            Sound.volume 26 (Sound.tone Sound.Noise 0 45)

        CueWhoosh ->
            -- a car flashing past at speed: a doppler down-sweep + a noise swish
            Sound.chord
                [ Sound.volume 32 (Sound.sweep 190 (Sound.tone Sound.Sawtooth 560 260))
                , Sound.volume 22 (Sound.sweep 40 (Sound.tone Sound.Noise 0 240))
                ]

        CueScreech ->
            -- tyres losing grip: a wavering high squeal over a scrubbing noise
            Sound.chord
                [ Sound.volume 24 (Sound.vibrato 45 15 (Sound.tone Sound.Square 1150 220))
                , Sound.volume 20 (Sound.tone Sound.Noise 0 220)
                ]

        CueCheck ->
            Sound.sequence
                [ Sound.duty 25 (Sound.tone Sound.Square (Sound.g 5) 80)
                , Sound.duty 25 (Sound.tone Sound.Square (Sound.c 6) 80)
                , Sound.duty 25 (Sound.tone Sound.Square (Sound.e 6) 200)
                ]

        CueYear ->
            Sound.sequence
                [ Sound.duty 25 (Sound.tone Sound.Square (Sound.c 5) 80)
                , Sound.duty 25 (Sound.tone Sound.Square (Sound.e 5) 80)
                , Sound.duty 25 (Sound.tone Sound.Square (Sound.g 5) 80)
                , Sound.duty 25 (Sound.tone Sound.Square (Sound.c 6) 90)
                , Sound.vibrato 20 7 (Sound.duty 50 (Sound.tone Sound.Square (Sound.e 6) 320))
                ]

        CueBeep ->
            Sound.volume 45 (Sound.duty 50 (Sound.tone Sound.Square (Sound.e 5) 70))

        CueOver ->
            Sound.sequence
                [ Sound.tone Sound.Triangle (Sound.c 4) 220
                , Sound.tone Sound.Triangle (Sound.g 3) 220
                , Sound.vibrato 18 5 (Sound.tone Sound.Triangle (Sound.e 3) 600)
                ]


-- ===== view =====


type alias Layout =
    { scale : Int, ox : Int, oy : Int }


layout : Model -> Layout
layout model =
    let
        s = max 60 (min (model.w * 100 // gameW) (model.h * 100 // gameH))
        slack = model.h - gameH * s // 100
    in
    { scale = s
    , ox = (model.w - gameW * s // 100) // 2
    -- Portrait phones: seat the picture in the UPPER area (top margin = 1/6 of
    -- the vertical slack) instead of dead centre, leaving the roomy space below
    -- for the touch pads (bottom-anchored in padRects). Landscape stays centred.
    , oy = if model.h > model.w then slack // 6 else slack // 2
    }


view : Model -> View Msg
view model =
    let
        lay = layout model
        scene =
            case model.mode of
                Title -> titleShapes model
                Race -> raceShapes model
                Over -> overShapes model
    in
    canvas Pixelated [ watchSize Resized, onTap Tapped, onDrag Dragged, onRelease Released ]
        (List.concat
            [ [ rect 0 0 model.w model.h bezel
              , group [ Canvas.Translate lay.ox lay.oy, Canvas.Scale lay.scale lay.scale ]
                    (List.concat [ scene, muteIcon model ])
              ]
            , touchControlsShapes model
            ])


-- On-screen touch controls, revealed once the player has used touch: an analog
-- STEER pad (with a knob that tracks your finger) and GAS / BRAKE pedals.
-- Drawn at ROOT level in SCREEN coordinates, in the letterbox around the
-- picture (see padRects) — they never cover the game.
-- True on finger-only hardware (phone / tablet): coarse pointer, no fine
-- pointer attached, no hover. Desktop and touch-laptops read False, so a mouse
-- click never summons the pads — the capability, not a past tap, is the gate.
padsWanted : Maybe Device -> Bool
padsWanted dev =
    case dev of
        Just d -> Device.touchOnly d
        Nothing -> False


touchControlsShapes : Model -> List Shape
touchControlsShapes m =
    if padsWanted m.dev && m.mode == Race then
        let
            r = padRects m
            knobW = max 12 (r.steer.w // 8)
            travel = max 1 (r.steer.w - knobW - 8)
            kx = r.steer.x + (r.steer.w - knobW) // 2
                + (if m.touching then m.touchX else 0) * travel // 2400
            gasCol = if m.tGas then rgb 74 178 96 else rgb 26 58 36
            brakeCol = if m.tBrake then rgb 196 74 74 else rgb 70 32 32
        in
        List.concat
            [ [ rect r.steer.x r.steer.y r.steer.w r.steer.h (rgb 30 34 48)
              , rect r.steer.x r.steer.y r.steer.w 2 (rgb 88 98 128)
              , rect kx (r.steer.y + r.steer.h // 4) knobW (r.steer.h // 2)
                    (if m.touching then rgb 150 200 255 else rgb 70 78 104)
              ]
            , pixTextC (r.steer.x + r.steer.w // 2) (r.steer.y + 8) 2 (rgb 120 132 168) "STEER"
            , [ rect r.brake.x r.brake.y r.brake.w r.brake.h brakeCol
              , rect r.brake.x r.brake.y r.brake.w 2 (rgb 130 70 70)
              ]
            , pixTextC (r.brake.x + r.brake.w // 2) (r.brake.y + r.brake.h // 2 - 5) 2 hudWhite "BRAKE"
            , [ rect r.gas.x r.gas.y r.gas.w r.gas.h gasCol
              , rect r.gas.x r.gas.y r.gas.w 2 (rgb 70 130 90)
              ]
            , pixTextC (r.gas.x + r.gas.w // 2) (r.gas.y + r.gas.h // 2 - 5) 2 hudWhite "GAS"
            ]
    else
        []


-- --- strips: the road ---


stripY : Int -> Int
stripY i =
    gameH - (i + 1) * stripH


zOf : Int -> Int
zOf i =
    zNear * nstrips // (nstrips - i)


bendPx : Int -> Int -> Int
bendPx curve i =
    curve * i * i // 4000


roadCenterPx : Int -> Int -> Int
roadCenterPx curve i =
    160 + bendPx curve i


halfWPx : Int -> Int
halfWPx i =
    halfWNearPx * (nstrips - i) // nstrips


-- Per-strip geometry (screen y, world-z, half-width, i squared) is a pure
-- function of the strip INDEX — it carries no model state — so the whole
-- 64-entry table is built ONCE at load rather than recomputing stripY / zOf /
-- halfWPx / i*i for every strip every frame (zOf and halfWPx each cost a
-- divide; that was ~128 divides a frame doing identical work). The road loop
-- maps over this table; only the two model-dependent bits (band from camZ, the
-- bend from curve) are computed per frame. Model-independent, so it's safe as a
-- top-level value (nstrips is defined far above; stripY/zOf/halfWPx are
-- functions, immune to the top-level eval-order trap).
type alias StripCell =
    { y : Int, z : Int, hw : Int, isq : Int }


stripGeom : List StripCell
stripGeom =
    List.map
        (\i -> { y = stripY i, z = zOf i, hw = halfWPx i, isq = i * i })
        (range nstrips)


-- The road. The four season colours (asphalt, the two rumble shades, dash)
-- depend only on phaseIx, so they're derived ONCE per frame here and threaded
-- into every strip — they used to be re-derived inside each strip (~256
-- redundant colour lookups a frame). The ground is one solid rect (drawn in
-- sceneShapes) so the field never seams; each strip is drawn 1px TALLER (sh) so
-- neighbours overlap and no sub-pixel gaps show at non-integer canvas zoom.
roadStrips : Model -> List Shape
roadStrips m =
    let
        roadCol = roadAOf m.phaseIx
        rumA = rumbleAOf m.phaseIx
        rumB = rumbleBOf m.phaseIx
        dashCol = dashOf m.phaseIx
    in
    List.concat
        (List.map (stripCellShapes m.camZ m.curve roadCol rumA rumB dashCol) stripGeom)


stripCellShapes : Int -> Int -> Color -> Color -> Color -> Color -> StripCell -> List Shape
stripCellShapes camZ curve roadCol rumA rumB dashCol cell =
    let
        y = cell.y
        band = mod2 ((camZ + cell.z) // 700)
        cx = 160 + curve * cell.isq // 4000    -- = roadCenterPx via the precomputed i squared
        hw = cell.hw
        rumble = if band == 0 then rumA else rumB
        rw = max 2 (hw // 9)
        dw = max 1 (hw // 26)
        sh = stripH + 1
    in
    List.concat
        [ [ rect (cx - hw) y (hw * 2) sh roadCol ]
        , if hw > 9 then
            [ rect (cx - hw) y rw sh rumble
            , rect (cx + hw - rw) y rw sh rumble
            ]
          else
            []
        , if band == 0 && hw > 16 then
            [ rect (cx - hw // 3 - dw) y dw sh dashCol
            , rect (cx + hw // 3) y dw sh dashCol
            ]
          else
            []
        ]


-- how far the car visually points into the steer, in degrees: the eased wheel
-- velocity scaled by the SAME speed authority the physics uses — so a parked
-- car holding the wheel stays straight, and on ice the nose swings lazily
-- (playerVx lags behind the stick there). Kept DISCREET: full lock at top
-- speed is only ~7 deg — a hint of yaw, not a spin.
playerYaw : Model -> Int
playerYaw m =
    let
        eff = 118 * m.speed // (m.speed + 60)
    in
    iclamp (0 - 7) 7 (m.playerVx * eff // 350)


-- the headlights: at night a pool of lighter road projects UP the road AHEAD of
-- the car — from the car's lane (near plane) toward the vanishing point,
-- following the curve, brightest nearby and reaching partway up; the far road
-- and edges stay dark.
-- A headlight cone thrown AHEAD of the car: its apex sits at the nose (narrow)
-- and it fans out up the road, like a beam spreading from the lamps. It bends
-- with the curve and is capped to the middle of the lane, so the road edges and
-- grass stay dark - clearly light cast forward, not the whole road lit up. Only
-- strips ahead of the sprite are drawn (nearer strips sit under the car).
headlightShapes : Model -> List Shape
headlightShapes m =
    if isNight m.phaseIx && m.mode /= Title then
        let
            yaw = playerYaw m
            -- apex glued to the nose: rotating the sprite around its centre
            -- moves the nose sideways by ~sin(yaw) * 11px
            cxp = 160 + m.playerX * halfWNearPx // roadHalfW + yaw // 5
        in
        List.concat
            (List.map
                (\j ->
                    let
                        i = j + 14
                        y = stripY i
                        band = mod2 ((m.camZ + zOf i) // 700)
                        -- bolted to the nose HEADING: the beam sweeps with the
                        -- car's yaw (each strip is 2px further up, so the tilt
                        -- grows with distance — slightly steeper than true tan
                        -- so the sweep reads on screen). It still does NOT
                        -- follow the road's curve: on a bend the untouched
                        -- beam points off toward the outside, like real lamps
                        cx = cxp + 2 * j * yaw // 14
                        -- narrow at the nose, fanning out, but never past the middle
                        -- of the lane
                        w = min (halfWPx i) (10 + j * 6)
                    in
                    if w < 4 then
                        []
                    else
                        clampRX (cx - w // 2) y w (stripH + 1) (if band == 0 then litA else litB)
                )
                (range 22))
    else
        []


-- --- roadside scenery: trees and bushes (world-spaced, projected) ---


sceneryShapes : Model -> List Shape
sceneryShapes m =
    List.concat
        (List.map
            (\k ->
                let
                    slot = (m.camZ + zNear) // 1900 + 1 + k
                    zp = slot * 1900
                    rel = zp - m.camZ
                in
                if rel < zNear || rel > viewDist then
                    []
                else
                    let
                        h = modBy 100 (slot * 73 + 31)
                        i = iclamp 0 (nstrips - 1) (nstrips - viewDist // max zNear rel)
                        sc = nstrips - i
                        y = stripY i
                        hw = halfWPx i
                        cx = roadCenterPx m.curve i
                        off = hw + 8 + (10 + modBy 26 h) * sc // nstrips
                        sx = if mod2 slot == 0 then cx - off else cx + off
                    in
                    if h < 52 then
                        treeShapes m sx y sc
                    else if h < 86 then
                        bushShapes m sx y sc
                    else
                        []
            )
            (range 8))


treeShapes : Model -> Int -> Int -> Int -> List Shape
treeShapes m sx y sc =
    let
        th = max 3 (26 * sc // nstrips)
        tw = max 1 (4 * sc // nstrips)
        fw = max 3 (16 * sc // nstrips)
        fh = max 2 (9 * sc // nstrips)
        leaf = leafOf m.phaseIx
    in
    List.concat
        [ clampRX (sx - tw // 2) (y - th) tw th trunkC
        , clampRX (sx - fw // 2) (y - th - fh) fw fh leaf
        , clampRX (sx - fw * 2 // 5) (y - th - fh * 2 + 1) (fw * 4 // 5) fh leaf
        , clampRX (sx - fw // 4) (y - th - fh * 3 + 2) (fw // 2) (max 1 (fh - 1)) leaf
        ]


bushShapes : Model -> Int -> Int -> Int -> List Shape
bushShapes m sx y sc =
    let
        bw = max 3 (12 * sc // nstrips)
        bh = max 2 (5 * sc // nstrips)
    in
    List.concat
        [ clampRX (sx - bw // 2) (y - bh) bw bh (leafOf m.phaseIx)
        , clampRX (sx - bw // 3) (y - bh * 2 + 1) (bw * 2 // 3) bh (leafOf m.phaseIx)
        ]


-- --- backdrop: gradient sky, sun/moon, stars, clouds, mountain ranges ---


skyShapes : Model -> List Shape
skyShapes m =
    List.concat
        [ gradientSky m
        , celestialShapes m
        , cloudShapes m
        , mountainShapes m
        ]


-- 24 overlapping 3px bands from the top of the screen to the horizon (24*3 = 72
-- = horizonY); each row gets its lerped colour, so the sky is a smooth ramp and
-- the +1px overlap avoids sub-pixel seams at non-integer zoom. 3px bands (was
-- 2px/37) cut a third of the sky rects with no visible banding at this scale.
gradientSky : Model -> List Shape
gradientSky m =
    List.map
        (\k -> rect 0 (k * 3) gameW 4 (skyColorAt m.phaseIx (k * 3)))
        (range 24)


celestialShapes : Model -> List Shape
celestialShapes m =
    let
        sun = sunOf m.phaseIx
    in
    if isNight m.phaseIx then
        List.concat
            [ [ rect 252 24 10 10 sun
              , rect 254 26 4 6 (skyColorAt m.phaseIx 26)
              ]
            , List.concat
                (List.map
                    (\k -> [ rect (modBy 316 (k * 37 + 11)) (20 + modBy 34 (k * 23 + 5)) 1 1 hudWhite ])
                    (range 7))
            ]
    else if m.phaseIx == 1 then
        [ rect 246 24 16 16 sun, rect 242 28 24 8 sun, rect 250 20 8 24 sun ]
    else
        [ rect 252 24 10 10 sun ]


cloudShapes : Model -> List Shape
cloudShapes m =
    if isNight m.phaseIx then
        []
    else
        List.concat
            (List.map
                (\k ->
                    let
                        -- drift by time + a small bounded lean into the CURRENT
                        -- curve. NOT the mtnOff accumulator: it wraps at 960 and
                        -- 960/8 isn't a multiple of 400, so each wrap teleported the
                        -- whole sky. curve is bounded (±99) and eases smoothly to 0,
                        -- so no accumulation, no wrap, no jump. (+400 keeps it >= 0.)
                        x = modBy 400 (k * 150 + m.tick // 24 + 400 - m.curve // 4) - 40
                        y = 24 + k * 11
                    in
                    List.concat
                        [ clampRX x y 26 6 cloudC
                        , clampRX (x + 5) (y - 3) 14 3 cloudC
                        ]
                )
                (range 3))


-- two parallax mountain ranges. The far ridge drifts at quarter speed; the
-- near range at half speed. Peak shapes and heights are hashed with the YEAR,
-- so every new year the horizon is a different range; spring keeps snow caps
-- on the tallest peaks, winter turns the whole range pale, and at night a
-- couple of cabin lights glow at the foot of the hills.
mountainShapes : Model -> List Shape
mountainShapes m =
    List.concat
        [ List.concat
            (List.map
                (\k ->
                    let
                        -- /4 in mod 560: mtnWrap must be a multiple of 4*560=2240
                        x = modBy 560 (k * 140 + 960 - m.mtnOff // 4) - 80
                        h = 6 + modBy 5 (k * 3 + m.year)
                    in
                    List.concat
                        [ clampRX x (horizonY - h) 92 h (farOf m.phaseIx)
                        , clampRX (x + 22) (horizonY - h - 3) 48 3 (farOf m.phaseIx)
                        ]
                )
                (range 4))
        , List.concat
            (List.map (\k -> peakShapes m k) (range 8))
        ]


peakShapes : Model -> Int -> List Shape
peakShapes m k =
    let
        -- /2 in mod 520: mtnWrap must be a multiple of 2*520=1040
        x = modBy 520 (k * 67 + 960 - m.mtnOff // 2) - 70
        style = modBy 3 (k * 5 + m.year * 3 + 2)
        h = 11 + modBy 13 (k * 9 + m.year * 7 + 3)
        c = mtnOf m.phaseIx
        tall = h > 17
        capped = tall && (m.phaseIx == 0 || m.phaseIx == 1 && h > 21)
        night = isNight m.phaseIx
        cabin = night && modBy 3 (k * 11 + m.year) == 0
    in
    List.concat
        [ if style == 0 then
            -- a sharp peak: three narrowing steps
            List.concat
                [ clampRX x (horizonY - h * 2 // 3) 36 (h * 2 // 3) c
                , clampRX (x + 8) (horizonY - h + 3) 20 (h - 3) c
                , clampRX (x + 14) (horizonY - h) 8 4 (if capped then snowCap else c)
                ]
          else if style == 1 then
            -- a long ridge with a shoulder bump
            List.concat
                [ clampRX x (horizonY - h * 2 // 3) 52 (h * 2 // 3) c
                , clampRX (x + 10) (horizonY - h + 2) 24 (h - 2) c
                , clampRX (x + 34) (horizonY - h // 2) 14 (h // 2) c
                , if capped then clampRX (x + 14) (horizonY - h + 2) 14 3 snowCap else []
                ]
          else
            -- twin peaks
            List.concat
                [ clampRX x (horizonY - h + 2) 14 (h - 2) c
                , clampRX (x + 18) (horizonY - h + 5) 12 (h - 5) c
                , clampRX (x + 2) (horizonY - h) 8 3 (if capped then snowCap else c)
                , clampRX (x - 6) (horizonY - h // 2) 40 (h // 2) c
                ]
        , if cabin then
            clampRX (x + 20) (horizonY - 3) 2 2 cabinLit
          else
            []
        ]


-- --- sprites ---


rivalShapes : Model -> Rival -> List Shape
rivalShapes m r =
    let
        rel = r.z - m.camZ
    in
    if rel < zNear || rel > viewDist then
        []
    else
        let
            i = iclamp 0 (nstrips - 1) (nstrips - viewDist // max zNear rel)
            sc = nstrips - i
            y = stripY i
            cw = max 5 (46 * sc // nstrips)
            ch = max 4 (28 * sc // nstrips)
            cx = roadCenterPx m.curve i + r.x * halfWPx i // roadHalfW - cw // 2
            cy = y - ch + stripH
            lw = max 1 (cw // 5)
            band = max 1 (ch // 4)
            night = isNight m.phaseIx
        in
        if night && sc < 26 then
            -- deep in the dark: taillights only
            [ rect cx (cy + ch - lw) lw lw tailRed
            , rect (cx + cw - lw) (cy + ch - lw) lw lw tailRed
            ]
        else
            List.concat
                [ [ rect (cx + 1) (cy + ch - 1) (cw - 2) 2 ink
                  , rect cx cy cw ch (if night then kindDark r.kind else kindBody r.kind)
                  , rect cx (cy + ch - band) cw band (kindDark r.kind)
                  , rect (cx + cw // 5) cy (cw * 3 // 5) (max 1 (ch // 4)) glassC
                  ]
                , if cw > 14 && night == False then
                    [ rect (cx + cw // 4) (cy + ch // 3) (cw // 2) (max 1 (ch // 6)) (kindLite r.kind) ]
                  else
                    []
                , if cw > 9 then
                    [ rect (cx - 1) (cy + ch - max 2 (ch // 4)) 2 (max 2 (ch // 4)) wheelC
                    , rect (cx + cw - 1) (cy + ch - max 2 (ch // 4)) 2 (max 2 (ch // 4)) wheelC
                    ]
                  else
                    []
                , [ rect cx (cy + ch - lw) lw lw tailRed
                  , rect (cx + cw - lw) (cy + ch - lw) lw lw tailRed
                  ]
                ]


-- checkered flags across the road at the end of the season
flagShapes : Model -> List Shape
flagShapes m =
    let
        rel = m.phaseStartZ + phaseLen - m.camZ
    in
    if m.mode == Title || rel < zNear || rel > viewDist then
        []
    else
        let
            i = iclamp 0 (nstrips - 1) (nstrips - viewDist // max zNear rel)
            sc = nstrips - i
            y = stripY i
            cx = roadCenterPx m.curve i
            hw = halfWPx i
            poleH = max 3 (16 * sc // nstrips)
            poleW = max 1 (3 * sc // nstrips)
            bandH = max 2 (6 * sc // nstrips)
            cell = max 2 (hw // 4)
        in
        List.concat
            [ clampRX (cx - hw - poleW - 2) (y - poleH) poleW poleH hudWhite
            , clampRX (cx + hw + 2) (y - poleH) poleW poleH hudWhite
            , List.concat
                (List.map
                    (\k ->
                        clampRX (cx - hw + k * cell) (y - poleH) cell bandH
                            (if mod2 k == 0 then ink else hudWhite)
                    )
                    (range 8))
            ]


-- The car is drawn around its own centre and the whole sprite ROTATES with the
-- steer (playerYaw), SNES-style — the nose points into the corner instead of
-- the car sliding sideways while facing straight up. The rects keep their old
-- straight-pose pixels at yaw 0. The 1px body `lean` stays on top as chassis
-- roll. Dust puffs are ground debris, so they stay outside the rotated group.
playerShapes : Model -> List Shape
playerShapes m =
    let
        cx = 160 + m.playerX * halfWNearPx // roadHalfW
        y = playerCarY
        yaw = playerYaw m
        flash = m.crashT > 0 && mod2 (m.tick // 3) == 0
        body = if flash then hudRed else bodyWhite
        -- the body only leans while ACTUALLY rolling — a stopped car holding
        -- the wheel shouldn't animate a turn it can't make
        lean =
            if m.speed <= 0 then 0
            else if m.playerVx > 8 then 1
            else if m.playerVx < 0 - 8 then 0 - 1
            else 0
        braking = brakeHeld m || m.crashT > 0 || m.countT > 0
        onGrass = absI m.playerX > grassEdge
        dust = onGrass && m.speed > 50 && mod2 (m.tick // 3) == 0
        dustC = if isIce m.phaseIx then dustSnow else dustBrown
        car =
            [ rect (0 - 15) 9 30 3 ink
            , rect (0 - 16) 4 5 7 wheelC
            , rect 11 4 5 7 wheelC
            , rect (0 - 16) (0 - 7) 5 6 wheelC
            , rect 11 (0 - 7) 5 6 wheelC
            , rect (0 - 15 + lean) (0 - 11) 30 20 body
            , rect (0 - 15 + lean) 4 30 5 bodyLower
            , rect (0 - 15 + lean) (0 - 4) 30 4 stripeBlue
            , rect (0 - 9 + lean) (0 - 10) 18 5 glassC
            , rect (0 - 7 + lean) (0 - 11) 14 2 hudWhite
            , rect (0 - 14) 6 6 2 (if braking then tailRed else kindDark 0)
            , rect 8 6 6 2 (if braking then tailRed else kindDark 0)
            ]
    in
    List.concat
        [ [ group [ Canvas.Translate cx (y + 11), Canvas.Rotate yaw ] car ]
        , if dust then
            [ rect (cx - 20) (y + 16) 3 3 dustC
            , rect (cx + 17) (y + 18) 3 3 dustC
            ]
          else
            []
        ]


-- tyre smoke while the car is sliding (slipT high): pale puffs billowing out
-- behind the rear wheels, growing and fading as they drift toward the camera.
smokeShapes : Model -> List Shape
smokeShapes m =
    if m.slipT > 26 && m.mode == Race then
        let
            cx = 160 + m.playerX * halfWNearPx // roadHalfW
        in
        List.concat
            (List.map
                (\k ->
                    let
                        age = modBy 20 (m.tick + k * 6)        -- 0..19 puff lifetime
                        side = if mod2 k == 0 then 0 - 18 else 14
                        drift = if mod2 k == 0 then 0 - age // 2 else age // 2
                        px = cx + side + drift
                        py = playerCarY + 16 + age
                        sz = 3 + age // 4
                        sh = 235 - age * 5
                    in
                    [ rect px py sz sz (rgb sh sh (sh + 4)) ]
                )
                (range 8))
    else
        []


snowShapes : Model -> List Shape
snowShapes m =
    if isIce m.phaseIx then
        List.concat
            (List.map
                (\k ->
                    [ rect (modBy 318 (k * 97 + m.tick // 2 + k * k * 13))
                        (modBy 198 (k * 61 + m.tick * (1 + mod2 k)))
                        2 2 hudWhite
                    ]
                )
                (range 9))
    else
        []


-- --- the start gantry: three red lights come on one by one, then all three
-- flash GREEN for the GO (no "GO" text — the green lights are the signal) ---


gantryShapes : Model -> List Shape
gantryShapes m =
    if m.mode == Race && (m.countT > 0 || m.goT > 0) then
        let
            green = m.countT == 0
            col = if green then lightGo else lightOn
            lit1 = green || m.countT <= 180
            lit2 = green || m.countT <= 120
            lit3 = green || m.countT <= 60
        in
        [ rect 118 22 84 18 gantryC
        , rect 126 26 16 10 (if lit1 then col else lightOff)
        , rect 152 26 16 10 (if lit2 then col else lightOff)
        , rect 178 26 16 10 (if lit3 then col else lightOff)
        ]
    else
        []


-- --- HUD ---


hudShapes : Model -> List Shape
hudShapes m =
    let
        sec = (m.timeLeft + 999) // 1000
        timeC = if sec <= 10 then hudRed else hudWhite
        prog = iclamp 0 150 ((m.camZ - m.phaseStartZ) * 150 // phaseLen)
    in
    List.concat
        [ [ rect 0 0 gameW 17 hudBg ]
        , pixText 4 2 1 timeC ("TIME " ++ String.fromInt sec)
        , pixTextC 160 2 1 hudAmber (seasonName m.phaseIx ++ " YR " ++ String.fromInt m.year)
        , pixTextR 288 2 1 hudWhite ("SPD " ++ String.fromInt m.speed)
        , [ rect 4 10 152 4 barBg
          , rect 5 11 prog 2 hudAmber
          ]
        , pixTextR 288 9 1 hudDim ("CARS " ++ String.fromInt m.passed)
        ]


bannerShapes : Model -> List Shape
-- kept high in the sky (above the horizon, below the start gantry) so it never
-- covers the road or the oncoming traffic; dark drop shadow for legibility.
bannerShapes m =
    if m.bannerT > 0 && m.mode == Race then
        List.concat
            [ pixTextC 161 49 2 ink m.bannerTop
            , pixTextC 160 48 2 hudWhite m.bannerTop
            , pixTextC 161 61 2 ink m.bannerBot
            , pixTextC 160 60 2 hudAmber m.bannerBot
            ]
    else
        []


muteIcon : Model -> List Shape
muteIcon m =
    List.concat
        [ [ rect 300 4 5 6 hudWhite
          , rect 305 2 3 10 hudWhite
          ]
        , if m.muted then
            [ rect 310 4 6 2 hudRed
            , rect 310 8 6 2 hudRed
            ]
          else
            [ rect 310 5 2 4 hudDim
            , rect 313 3 2 8 hudDim
            ]
        ]


-- --- screens ---


sceneShapes : Model -> List Shape
sceneShapes m =
    List.concat
        [ skyShapes m
        , [ rect 0 horizonY gameW (gameH - horizonY) (grassAOf m.phaseIx) ]
        , roadStrips m
        , headlightShapes m
        , sceneryShapes m
        , flagShapes m
        , List.concat
            (List.map (\r -> rivalShapes m r)
                (List.sortBy (\r -> 0 - r.z) m.rivals))
        , playerShapes m
        , smokeShapes m
        , snowShapes m
        ]


raceShapes : Model -> List Shape
raceShapes m =
    List.concat
        [ sceneShapes m
        , gantryShapes m
        , hudShapes m
        , bannerShapes m
        ]


titleShapes : Model -> List Shape
titleShapes m =
    let
        blink = mod2 (m.tick // 30) == 0
    in
    List.concat
        [ sceneShapes m
        , [ rect 0 0 gameW 17 hudBg
          , rect 44 116 232 20 hudBg
          , rect 44 140 232 34 hudBg
          ]
        , pixTextC 163 31 5 ink "SEASONS"
        , pixTextC 160 28 5 hudWhite "SEASONS"
        , pixTextC 162 60 2 ink "GRAND PRIX"
        , pixTextC 160 58 2 hudAmber "GRAND PRIX"
        , if blink then pixTextC 160 122 1 hudWhite "TAP OR PRESS ENTER" else []
        , pixTextC 160 144 1 hudDim "STEER: ARROWS  GAS: SPACE  BRAKE: DOWN"
        , pixTextC 160 154 1 hudDim "TOUCH: DRAG TO STEER - GAMEPAD SUPPORTED"
        , pixTextC 160 164 1 hudAmber "REACH THE FLAGS BEFORE TIME RUNS OUT"
        ]


overShapes : Model -> List Shape
overShapes m =
    let
        blink = mod2 (m.tick // 30) == 0
        kmTen = m.camZ // 6000
        km = String.fromInt (kmTen // 10) ++ "." ++ String.fromInt (modBy 10 kmTen)
    in
    -- the game FREEZES in place (Over mode stops the sim) and the messages
    -- overlay the frozen scene, so you can see how close to the flags you were:
    -- the progress bar (HUD) and the checkered flags on the road stay visible.
    -- The panel is kept high (over the sky) so the road below is unobscured.
    List.concat
        [ sceneShapes m
        , hudShapes m
        , [ rect 60 26 200 52 hudBg ]
        , pixTextC 161 33 3 ink "TIME UP"
        , pixTextC 160 32 3 hudRed "TIME UP"
        , pixTextC 160 52 1 hudWhite ("YEAR " ++ String.fromInt m.year ++ " - " ++ seasonName m.phaseIx)
        , pixTextC 160 62 1 hudAmber (String.fromInt m.passed ++ " CARS - " ++ km ++ " KM")
        , if blink then pixTextC 160 72 1 hudWhite "TAP OR PRESS ENTER" else []
        ]


-- ===== pixel font (3x5 glyphs drawn as rects — same table as the other Mar
-- canvas games; Canvas.text would use the system sans and break the retro look)


pixText : Int -> Int -> Int -> Color -> String -> List Shape
pixText x y s color str =
    List.concat
        (List.indexedMap
            (\i ch -> glyphShapes (x + i * 4 * s) y s color ch)
            (String.toList str))


pixTextC : Int -> Int -> Int -> Color -> String -> List Shape
pixTextC x y s color str =
    pixText (x - pixW (String.length str) s // 2) y s color str


pixTextR : Int -> Int -> Int -> Color -> String -> List Shape
pixTextR x y s color str =
    pixText (x - pixW (String.length str) s) y s color str


pixW : Int -> Int -> Int
pixW n s =
    n * 4 * s - s


glyphShapes : Int -> Int -> Int -> Color -> Char -> List Shape
glyphShapes gx gy s color ch =
    List.concat
        (List.indexedMap
            (\r bits -> rowShapes gx (gy + r * s) s color bits)
            (glyph ch))


rowShapes : Int -> Int -> Int -> Color -> Int -> List Shape
rowShapes rx ry s color bits =
    List.concat
        [ if bitOn bits 4 then [ rect rx ry s s color ] else []
        , if bitOn bits 2 then [ rect (rx + s) ry s s color ] else []
        , if bitOn bits 1 then [ rect (rx + 2 * s) ry s s color ] else []
        ]


bitOn : Int -> Int -> Bool
bitOn bits v =
    mod2 (bits // v) == 1


glyph : Char -> List Int
glyph ch =
    case ch of
        'A' -> [ 7, 5, 7, 5, 5 ]
        'B' -> [ 6, 5, 6, 5, 6 ]
        'C' -> [ 7, 4, 4, 4, 7 ]
        'D' -> [ 6, 5, 5, 5, 6 ]
        'E' -> [ 7, 4, 7, 4, 7 ]
        'F' -> [ 7, 4, 7, 4, 4 ]
        'G' -> [ 7, 4, 5, 5, 7 ]
        'H' -> [ 5, 5, 7, 5, 5 ]
        'I' -> [ 7, 2, 2, 2, 7 ]
        'J' -> [ 1, 1, 1, 5, 7 ]
        'K' -> [ 5, 6, 4, 6, 5 ]
        'L' -> [ 4, 4, 4, 4, 7 ]
        'M' -> [ 5, 7, 7, 5, 5 ]
        'N' -> [ 5, 7, 7, 7, 5 ]
        'O' -> [ 7, 5, 5, 5, 7 ]
        'P' -> [ 7, 5, 7, 4, 4 ]
        'Q' -> [ 7, 5, 5, 7, 1 ]
        'R' -> [ 7, 5, 7, 6, 5 ]
        'S' -> [ 7, 4, 7, 1, 7 ]
        'T' -> [ 7, 2, 2, 2, 2 ]
        'U' -> [ 5, 5, 5, 5, 7 ]
        'V' -> [ 5, 5, 5, 5, 2 ]
        'W' -> [ 5, 5, 7, 7, 5 ]
        'X' -> [ 5, 5, 2, 5, 5 ]
        'Y' -> [ 5, 5, 2, 2, 2 ]
        'Z' -> [ 7, 1, 2, 4, 7 ]
        '0' -> [ 7, 5, 5, 5, 7 ]
        '1' -> [ 2, 6, 2, 2, 7 ]
        '2' -> [ 7, 1, 7, 4, 7 ]
        '3' -> [ 7, 1, 7, 1, 7 ]
        '4' -> [ 5, 5, 7, 1, 1 ]
        '5' -> [ 7, 4, 7, 1, 7 ]
        '6' -> [ 7, 4, 7, 5, 7 ]
        '7' -> [ 7, 1, 2, 2, 2 ]
        '8' -> [ 7, 5, 7, 5, 7 ]
        '9' -> [ 7, 5, 7, 1, 7 ]
        ':' -> [ 0, 2, 0, 2, 0 ]
        '-' -> [ 0, 0, 7, 0, 0 ]
        '.' -> [ 0, 0, 0, 0, 2 ]
        '!' -> [ 2, 2, 2, 0, 2 ]
        _ -> [ 0, 0, 0, 0, 0 ]


-- ===== wiring =====


subscriptions : Model -> Sub Msg
subscriptions model =
    Sub.batch
        [ Time.every (Time.millis (1000 // fps)) (\_ -> Tick)
        , Keyboard.watch KeysChanged
        , Gamepad.watch PadChanged
        , Device.watch DeviceChanged
        , if model.mode == Race then
            Sound.hold (engineNote model)
          else
            Sub.none
        ]


page : Page
page =
    Page.create
        { path = "/"
        , title = "Seasons GP"
        , init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }


main : Cmd ()
main =
    App.frontend [ page ]
