module Main exposing (main)

-- SEASONS GP: a pseudo-3D endless racer in the tradition of early-80s
-- endurance racers, drawn somewhere between the NES and the SNES: gradient
-- skies, two parallax mountain ranges that reshuffle every year, snow-capped
-- peaks, roadside trees and bushes, shaded two-tone cars. Built with ZERO
-- language changes: a `Time.every` tick drives the sim, `Keyboard`/`Gamepad`
-- feed input, touch steers on mobile, and the whole scene is rects: the road
-- is 64 horizontal strips with true 1/z perspective (all Int fixed-point).
--
-- You race forever through repeating conditions, dodging slower traffic,
-- drifting outward in curves. Each SEASON is a timed stage: reach the
-- checkered flags before the clock runs out. Four seasons make a year:
-- SPRING (gentle), SUMMER (heavy traffic), AUTUMN (night: you only see
-- taillights), WINTER (snow: the wheel goes sluggish, the car gets away from
-- you), then a new year starts, a bit harder: faster rivals, denser traffic,
-- sharper curves, a tighter clock. An F1-style gantry counts the race in:
-- three red lights, then lights out and away you go.
--
-- Controls: arrows/WASD steer, Space or Up = gas, Down = brake, M = mute.
--   Gamepad: stick or d-pad steers, A = gas, B = brake, Start = start.
--   Touch:   two-thumb pads (shown after your first touch) in the LETTERBOX
--            around the picture: drag STEER (left) to turn, hold GAS / BRAKE
--            (right). Steering is independent of the throttle, so you can turn
--            while coasting or braking. Tap top-right corner to mute.
--
-- Run: mar dev examples/seasons-gp

import Balance exposing (..)
import Draw exposing (..)
import Hud exposing (..)
import Palette exposing (..)
import Sfx exposing (..)
import Sim exposing (..)
import Types exposing (..)
import Canvas exposing ( canvas, group, onDrag, onRelease, onTap, rect, watchSize )
import Time


view : Model -> View Msg
view model =
    let
        lay = layout model
        scene =
            case model.mode of
                Title -> titleShapes model
                Race -> raceShapes model
                Over -> overShapes model
    in
    canvas Pixelated [ watchSize Resized, onTap Tapped, onDrag Dragged, onRelease Released ]
        (List.concat
            [ [ rect 0 0 model.w model.h bezel
              , group [ Canvas.Translate lay.ox lay.oy, Canvas.Scale lay.scale lay.scale ]
                    (List.concat [ scene, muteIcon model ])
              ]
            , touchControlsShapes model
            ])




subscriptions : Model -> Sub Msg
subscriptions model =
    Sub.batch
        [ Time.every (Time.millis (1000 // fps)) (\_ -> Tick)
        , Keyboard.watch KeysChanged
        , Gamepad.watch PadChanged
        , Device.watch DeviceChanged
        , if model.mode == Race then
            Sound.glide (engineNote model)
          else
            Sub.none
        ]


page : Page
page =
    Page.create
        { path = "/"
        , title = "Seasons GP"
        , init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }


main : Cmd ()
main =
    App.frontend [ page ]
