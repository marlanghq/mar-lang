{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "mar",
  "scopeName": "source.mar",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#chars"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.mar",
          "match": "--.*$"
        },
        {
          "name": "comment.block.mar",
          "begin": "\\{-",
          "end": "-\\}"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.mar",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.mar",
          "match": "\\\\."
        }
      ]
    },
    "chars": {
      "comment": "Char literal, 'a', '\\n', '\\u{1F600}'. Only matches when there's exactly one char/escape between the apostrophes, so identifiers ending in ' (Elm-style names like `foo'`) don't get mis-highlighted.",
      "name": "string.quoted.single.mar",
      "match": "'(\\\\u\\{[0-9a-fA-F]+\\}|\\\\.|[^'\\\\])'",
      "captures": {
        "0": {
          "name": "string.quoted.single.mar"
        }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.mar",
          "match": "\\b(case|of|if|then|else|let|in)\\b"
        },
        {
          "name": "keyword.declaration.mar",
          "match": "\\b(module|exposing|import|as|type|alias|where|port)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "comment": "Builtin types. `Decimal` (not Float, Mar has no binary floats) and the Canvas/Sound/Device vocabulary belong here; anything absent still gets the generic capitalized-identifier rule below.",
          "name": "support.type.mar",
          "match": "\\b(Int|Decimal|String|Bool|Char|List|Maybe|Result|Dict|Set|Time|Duration|Order|Task|Cmd|Sub|View|KeyedView|Page|Path|Attr|Width|Height|Size|Inline|Canvas|Color|Shape|Transform|Align|Blend|Pointer|Device|Sound|Service|ExposedService|Entity|Column|Constraint|Auth|AdminSession|Method)\\b"
        },
        {
          "name": "constant.language.mar",
          "match": "\\b(True|False|Nothing|Ok|Err|Just|LT|EQ|GT)\\b"
        },
        {
          "comment": "Capitalized identifier, type or constructor",
          "name": "entity.name.type.mar",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "comment": "`//` is integer division and must come before `/` (decimal division) so it lexes as one token, not two.",
      "name": "keyword.operator.mar",
      "match": "(\\+\\+|->|<-|\\|>|<\\||==|//|/=|<=|>=|<|>|::|&&|\\|\\||\\+|-|\\*|/|=|\\\\)"
    },
    "numbers": {
      "patterns": [
        {
          "comment": "Decimal literal, exact base-10, not a float. `/` on two of these yields a Decimal.Division that the caller resolves; `//` is the integer division.",
          "name": "constant.numeric.decimal.mar",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.mar",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "comment": "Module-qualified identifier",
          "match": "\\b([A-Z][A-Za-z0-9_]*)\\.([a-z][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "entity.name.namespace.mar"
            },
            "2": {
              "name": "variable.other.mar"
            }
          }
        },
        {
          "comment": "Bare globals, in scope everywhere with no import and no module prefix. They have no qualified spelling (`Basics.not` does not compile), so without this rule they read as ordinary local names.",
          "name": "support.function.mar",
          "match": "\\b(always|linkTo|not|max|min|clamp|abs|modBy|remainderBy)\\b"
        },
        {
          "name": "variable.other.mar",
          "match": "\\b[a-z][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
